<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Version from git tags server/vX.Y.Z (see docs/01-architecture.md). -->
    <MinVerTagPrefix>server/v</MinVerTagPrefix>
  </PropertyGroup>

  <ItemGroup>
    <!-- One version type for agent and central server (SUSyphos.Contracts); the central server calls it AgentVersion where it was born. -->
    <Using Include="SUSyphos.Contracts.SemanticVersion" Alias="AgentVersion" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" />
    <PackageReference Include="MailKit" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="MinVer" PrivateAssets="all" />
    <PackageReference Include="System.DirectoryServices.Protocols" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SUSyphos.Common\SUSyphos.Common.csproj" />
    <ProjectReference Include="..\SUSyphos.Contracts\SUSyphos.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Help pages of the dashboard (Markdown), compiled into the assembly and rendered by HelpCatalog. -->
    <EmbeddedResource Include="Help\Topics\*.md" LogicalName="Help.%(Filename).md" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SUSyphos.TestSupport" />
    <InternalsVisibleTo Include="SUSyphos.IntegrationTests" />
  </ItemGroup>

</Project>
