@if (Text is not null)
{
    @* Shown at the top; when the page comes back further down (kept scroll position), app.js repeats it in view. *@
    <p class="@(IsError ? "error" : "notice") page-message" role="@(IsError ? "alert" : "status")">@Text</p>
}

@code {
    [Parameter]
    public string? Text { get; set; }

    [Parameter]
    public bool IsError { get; set; }
}
