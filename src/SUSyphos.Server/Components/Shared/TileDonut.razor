@using SUSyphos.Server.Rollouts
@* A distribution of states in a tile: a 64 px donut with the total in the middle and a legend with the counts. *@
<div class="tile-donut">
    <Donut Parts="@(Charts.Sorted(Parts).Select(p => (p.Class, p.Value)).ToList())" Size="DonutSize.Tile" Caption="@Caption" />
    <DonutLegend Parts="@Parts" />
</div>

@code {
    /// <summary>The parts as status class (ok, pend, queue, fail, neutral), label, count and an optional link.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<DonutPart> Parts { get; set; } = [];

    [Parameter]
    public string? Caption { get; set; }
}
