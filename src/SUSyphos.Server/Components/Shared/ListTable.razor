@typeparam TRow
@* A list with search, column filters, sorting, pages and page size from the address (TableQuery); the page supplies
   the cells of each row. Headers come from the columns, so a list is declared once. *@
@if ((Page.Total > 0 || Tools is not null) && Search is not null)
{
    <TableTools Table="Table" Placeholder="@Search" Labels="TablePaging.Labels(Columns)" GroupOptions="GroupOptions" View="Page.View" Options="Page.Options">@Tools</TableTools>
}
<div class="scroll">
    <table>
        <thead>
            <tr>
                @Leading
                @foreach (var column in Columns)
                {
                    <SortHeader Table="Table" Column="@column.Key" Label="@column.Label" Sortable="column.Sortable" Class="@column.Class" Options="@(Page.Total > 0 ? Page.Options.GetValueOrDefault(column.Key) : null)" />
                }
                @ExtraHeader
            </tr>
        </thead>
        <tbody>
            @if (Page.Rows.Count == 0)
            {
                <tr><td colspan="@(Columns.Count + ExtraColumns)" class="note">@(Page.Total == 0 ? Empty : "Nothing matches the search or filters.")</td></tr>
            }
            @foreach (var (group, rows) in TablePaging.Groups(Page, Table, Columns))
            {
                <GroupRow Name="@group" Count="@rows.Count" Columns="@(Columns.Count + ExtraColumns)" />
                @foreach (var row in rows)
                {
                    @Row(row)
                    @if (Details is not null && RowKey is not null && Table.Open == RowKey(row))
                    {
                        <tr class="details-row"><td colspan="@(Columns.Count + ExtraColumns)">@Details(row)</td></tr>
                    }
                }
            }
        </tbody>
    </table>
</div>
@if (Page.Total > 0)
{
    <Pager Table="Table" Page="PageInfo.Of(Page)" Noun="@Noun" />
}

@code {
    [Parameter, EditorRequired]
    public TableQuery Table { get; set; } = default!;

    [Parameter, EditorRequired]
    public TablePage<TRow> Page { get; set; } = default!;

    [Parameter, EditorRequired]
    public IReadOnlyList<TableColumn<TRow>> Columns { get; set; } = [];

    /// <summary>Cells of one row, including the &lt;tr&gt;.</summary>
    [Parameter, EditorRequired]
    public RenderFragment<TRow> Row { get; set; } = default!;

    /// <summary>Placeholder of the search field; null for a list without search bar.</summary>
    [Parameter]
    public string? Search { get; set; }

    [Parameter]
    public IReadOnlyList<(string Key, string Label)>? GroupOptions { get; set; }

    /// <summary>Controls in the row of the search field, e.g. switches that show hidden entries.</summary>
    [Parameter]
    public RenderFragment? Tools { get; set; }

    /// <summary>Text when the list has no rows at all.</summary>
    [Parameter]
    public string Empty { get; set; } = "No entries yet.";

    [Parameter]
    public string Noun { get; set; } = "entries";

    /// <summary>Header cells before the columns, e.g. one for row checkboxes; counted in <see cref="ExtraColumns"/>.</summary>
    [Parameter]
    public RenderFragment? Leading { get; set; }

    /// <summary>Header cells after the columns, e.g. an empty one for row buttons.</summary>
    [Parameter]
    public RenderFragment? ExtraHeader { get; set; }

    [Parameter]
    public int ExtraColumns { get; set; }

    /// <summary>Details shown in an expanded row right below the row whose key is open (TableQuery.Open).</summary>
    [Parameter]
    public RenderFragment<TRow>? Details { get; set; }

    /// <summary>Key of a row in the address, for expanded rows.</summary>
    [Parameter]
    public Func<TRow, string>? RowKey { get; set; }
}
