@* The "Status" part of a detail box (docs/06-dashboard.md, section 8 "Detail views", Marc 2026-11-13): one row per
   state, like the pre-flight checks. The pill stands in its own column, then the name, a short value with a muted
   explanation after " · ", and the link on the right. Rows that need attention come first (fail, then queue and pend,
   then ok and neutral); facts without a state belong in a FactGrid. *@
@if (Rows.Count > 0)
{
    <div class="status-part">
        @if (ShowLabel)
        {
            <div class="section-label">Status</div>
        }
        <ul class="status-list">
            @foreach (var row in Ordered)
            {
                <li class="help-scope">
                    <StatusTag Text="@row.Pill" Kind="@row.Kind" Detail="@row.PillDetail" />
                    <span class="status-name">@row.Name</span>
                    <span class="status-text">@row.Text@if (row.Explanation is { Length: > 0 }) { <small> · @row.Explanation</small> }@row.Extra</span>
                    <span class="status-act">@row.Action</span>
                </li>
            }
        </ul>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<StatusRow> Rows { get; set; } = [];

    /// <summary>Shows the "Status" label above the rows (off where the box holds nothing else).</summary>
    [Parameter]
    public bool ShowLabel { get; set; } = true;

    private IEnumerable<StatusRow> Ordered => Rows.OrderBy(r => StatusRow.Order(r.Kind));
}