@using SUSyphos.Server.Rollouts
@{
    var parts = Parts ?? Charts.Parts(Counts);
    var total = parts.Sum(p => p.Value);
}
<svg class="donut @(Small ? "small" : null)" viewBox="0 0 140 140" role="img" aria-label="@(Parts is null ? Charts.Describe(Counts) : Charts.Describe(Parts))">
    <g transform="rotate(-90 70 70)" fill="none" stroke-width="18">
        <circle class="track" cx="70" cy="70" r="@Radius"></circle>
        @foreach (var (cls, offset, length) in Charts.Segments(parts, Circumference))
        {
            <circle class="@cls" cx="70" cy="70" r="@Radius" stroke-dasharray="@($"{Charts.Number(length)} {Charts.Number(Circumference)}")" stroke-dashoffset="@Charts.Number(-offset)"></circle>
        }
    </g>
    @if (!Small)
    {
        <g>
            <text x="70" y="68" text-anchor="middle" font-size="22" font-weight="600">@total</text>
            <text class="caption" x="70" y="86" text-anchor="middle" font-size="10">@Caption</text>
        </g>
    }
</svg>

@code {
    private const double Radius = 54;
    private static readonly double Circumference = 2 * Math.PI * Radius;

    /// <summary>A small donut for table cells, without the total in the middle.</summary>
    [Parameter]
    public bool Small { get; set; }

    /// <summary>Deployment states (server × update); ignored when <see cref="Parts"/> is given.</summary>
    [Parameter]
    public DeploymentCounts Counts { get; set; } = DeploymentCounts.Empty;

    /// <summary>Any other split as CSS class (ok, pend, queue, warn, fail, none) and count, e.g. servers by status.</summary>
    [Parameter]
    public IReadOnlyList<(string Class, int Value)>? Parts { get; set; }

    /// <summary>What the number in the middle counts.</summary>
    [Parameter]
    public string Caption { get; set; } = "server × update";
}
