@using SUSyphos.Server.Rollouts
<svg class="donut @(Small ? "small" : null)" viewBox="0 0 140 140" role="img" aria-label="@Charts.Describe(Counts)">
    <g transform="rotate(-90 70 70)" fill="none" stroke-width="18">
        <circle class="track" cx="70" cy="70" r="@Radius"></circle>
        @foreach (var (cls, offset, length) in Charts.Segments(Counts, Circumference))
        {
            <circle class="@cls" cx="70" cy="70" r="@Radius" stroke-dasharray="@($"{Charts.Number(length)} {Charts.Number(Circumference)}")" stroke-dashoffset="@Charts.Number(-offset)"></circle>
        }
    </g>
    @if (!Small)
    {
        <g>
            <text x="70" y="68" text-anchor="middle" font-size="22" font-weight="600">@Counts.Total</text>
            <text class="caption" x="70" y="86" text-anchor="middle" font-size="10">server × update</text>
        </g>
    }
</svg>

@code {
    private const double Radius = 54;
    private static readonly double Circumference = 2 * Math.PI * Radius;

    /// <summary>A small donut for table cells, without the total in the middle.</summary>
    [Parameter]
    public bool Small { get; set; }

    [Parameter, EditorRequired]
    public DeploymentCounts Counts { get; set; } = DeploymentCounts.Empty;
}
