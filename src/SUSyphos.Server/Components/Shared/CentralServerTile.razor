@* The central server tile of the overview and the SUSyphos page: up to date or update available, with the running and the newer version. *@
<VersionTile Title="Central server" Href="@Href" State="@(Update is null ? "Up to date" : "Update available")" Kind="@(Update is null ? "ok" : "queue")"
             Current="@SUSyphos.Server.Administration.ServerVersion.Display" Available="@Update?.Version"
             Footer="@(Update is { } available ? $"found {DisplayTime.FormatDate(available.FoundAtUtc)}, download on the SUSyphos page" : "no newer release found")" />

@code {
    /// <summary>The newer release found by the check; null when this central server runs the newest one.</summary>
    [Parameter]
    public SUSyphos.Server.AgentPackages.ServerUpdate? Update { get; set; }

    [Parameter]
    public string Href { get; set; } = SUSyphos.Server.Components.Pages.SusyphosPage.Route + "#server";
}
