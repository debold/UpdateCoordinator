@* Paging links (a range of pages around the current one) and the number of rows per page. *@
<div class="pager" data-help="tables#pages">
    <span>@Summary</span>
    @if (Page.Total > TableQuery.PageSizes[0])
    {
        <form method="get" class="page-size">
            @foreach (var field in Table.HiddenFieldsExcept(Table.SizeField))
            {
                <input type="hidden" name="@field.Key" value="@field.Value" />
            }
            <label for="@(Table.IdPrefix)page-size">Rows per page</label>
            <select id="@(Table.IdPrefix)page-size" name="@Table.SizeField" data-auto-submit>
                @foreach (var size in TableQuery.PageSizes)
                {
                    <option value="@size" selected="@(size == Page.PageSize)">@size</option>
                }
            </select>
            @* Without the dashboard script the choice is applied with this button; app.js submits on change and hides it. *@
            <button type="submit" class="ghost" data-auto-submit-button>Show</button>
        </form>
    }
    @if (Page.Pages > 1)
    {
        <nav class="pages" aria-label="Pages">
            @if (Page.Page > 1)
            {
                <a href="@Table.PageLink(Page.Page - 1)" aria-label="Previous page">‹</a>
            }
            @foreach (var number in Numbers())
            {
                @if (number == 0)
                {
                    <span class="gap">…</span>
                }
                else if (number == Page.Page)
                {
                    <span class="current" aria-current="page">@number</span>
                }
                else
                {
                    <a href="@Table.PageLink(number)">@number</a>
                }
            }
            @if (Page.Page < Page.Pages)
            {
                <a href="@Table.PageLink(Page.Page + 1)" aria-label="Next page">›</a>
            }
        </nav>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public TableQuery Table { get; set; } = default!;

    [Parameter, EditorRequired]
    public PageInfo Page { get; set; } = default!;

    [Parameter]
    public string Noun { get; set; } = "entries";

    private string Summary
    {
        get
        {
            if (Page.Matching == 0)
            {
                return Page.Total == 0 ? $"No {Noun}" : $"No match among {Page.Total} {Noun}";
            }

            var first = ((Page.Page - 1) * Page.PageSize) + 1;
            var last = Math.Min(Page.Page * Page.PageSize, Page.Matching);
            var filtered = Page.Matching < Page.Total ? $" (filtered from {Page.Total})" : string.Empty;
            return $"{first}–{last} of {Page.Matching} {Noun}{filtered}";
        }
    }

    /// <summary>1, the current page with two neighbours, the last page; 0 marks a gap.</summary>
    private IEnumerable<int> Numbers()
    {
        var shown = new SortedSet<int> { 1, Page.Pages };
        for (var n = Page.Page - 2; n <= Page.Page + 2; n++)
        {
            if (n >= 1 && n <= Page.Pages)
            {
                shown.Add(n);
            }
        }

        var previous = 0;
        foreach (var n in shown)
        {
            if (n - previous > 1)
            {
                yield return 0;
            }

            yield return n;
            previous = n;
        }
    }
}
