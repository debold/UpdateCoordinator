@using SUSyphos.Contracts.Agents
@using SUSyphos.Server.Assignment
@* Central agent settings of a group or a server, inside its form: what applies and from where, the values set on this
   level (empty removes one) and "Override" for another setting. Collapsed, so the dialog stays short. *@
<details class="agent-settings" data-help="@Help" open="@(Own.Count > 0)">
    <summary data-help-term="Agent settings">Agent settings <span class="note">@(Own.Count == 0 ? "all inherited" : $"{Own.Count} set here")</span></summary>
    <table class="compact">
        <thead><tr><th>Setting</th><th>Applies</th><th>From</th></tr></thead>
        <tbody>
            @foreach (var (definition, value, source) in Explained)
            {
                <tr><td>@definition.Label</td><td>@AgentSettingValues.Display(definition, value)</td><td class="note">@source</td></tr>
            }
        </tbody>
    </table>
    @if (Own.Count > 0)
    {
        <div class="form-row wrap">
            @foreach (var (key, value) in Own)
            {
                var definition = AgentSettings.Find(key)!;
                <label class="field"><span>@definition.Label @(definition.Unit.Length > 0 ? $"({definition.Unit})" : null)</span><AgentSettingField Definition="definition" Name="@AgentSettingValues.FieldName(key)" Value="@value" Placeholder="Inherit" /></label>
            }
        </div>
        <p class="help">Empty a field (or choose "Inherit") to take the value from @(ParentLabel) again.</p>
    }
    @if (AgentSettings.All.Any(d => !Own.ContainsKey(d.Key)))
    {
        <div class="form-row">
            <label class="field"><span>Override</span>
                <select name="@AgentSettingValues.NewKeyField" data-help-term="Override">
                    <option value="">Choose a setting…</option>
                    @foreach (var definition in AgentSettings.All.Where(d => !Own.ContainsKey(d.Key)))
                    {
                        <option value="@definition.Key">@definition.Label@(definition.Unit.Length > 0 ? $" ({definition.Unit})" : null)</option>
                    }
                </select>
            </label>
            <label class="field"><span>Value</span><input name="@AgentSettingValues.NewValueField" maxlength="200" placeholder="e.g. 30, on, Debug" data-help-term="Value" /></label>
        </div>
    }
</details>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<(AgentSettingDefinition Definition, string Value, string Source)> Explained { get; set; } = [];

    /// <summary>Values set on this level.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyDictionary<string, string> Own { get; set; } = new Dictionary<string, string>();

    /// <summary>Where values come from when not set here, e.g. "the groups or the system default".</summary>
    [Parameter]
    public string ParentLabel { get; set; } = "the system default";

    [Parameter, EditorRequired]
    public string Help { get; set; } = string.Empty;
}
