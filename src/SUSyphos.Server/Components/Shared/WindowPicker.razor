@using SUSyphos.Contracts.Agents
@* Maintenance window picker: one row per window (weekday toggles, from, to) with remove, an add button, a week preview and
   a plain-language summary. No free text, so a window cannot be mistyped. app.js redraws the preview on every change; the buttons post the enclosing form without
   saving (WindowPickerForm.ReadEdit); the page shows the rows again with the change and an updated preview. *@
<div class="window-picker gated inverse" data-inherited="@InheritedJson" data-help="maintenance-windows#editor">
    @if (AllowInherit)
    {
        <label class="check gate"><input type="checkbox" data-help-term="Inherit" name="@WindowPickerForm.InheritField(Prefix)" value="yes" checked="@_inherited" /> @InheritLabel</label>
    }
    <div class="gated-body">
    @if (_rows.Count == 0)
    {
        <p class="note">No window of its own yet.</p>
    }
    @for (var index = 0; index < _rows.Count; index++)
    {
        var row = _rows[index];
        var number = index;
        <div class="window-row">
            <div class="days" role="group" aria-label="Weekdays of window @(number + 1)">
                @foreach (var day in WindowPickerForm.WeekOrder)
                {
                    <label class="day"><input type="checkbox" data-help-term="weekday" name="@WindowPickerForm.DaysField(Prefix, number)" value="@((int)day)" checked="@row.Days.Contains(day)" /><span>@WindowPickerForm.ShortName(day)</span></label>
                }
            </div>
            <label>from
                <select name="@WindowPickerForm.FromField(Prefix, number)" aria-label="Start of window @(number + 1)">
                    @foreach (var time in WindowPickerForm.Times(row.Start, includeEndOfDay: false))
                    {
                        <option value="@WindowPickerForm.Format(time)" selected="@(time == row.Start)">@WindowPickerForm.Format(time)</option>
                    }
                </select>
            </label>
            <label>to
                <select name="@WindowPickerForm.ToField(Prefix, number)" aria-label="End of window @(number + 1)">
                    @foreach (var time in WindowPickerForm.Times(row.End, includeEndOfDay: true))
                    {
                        <option value="@WindowPickerForm.Format(time)" selected="@(time == row.End)">@WindowPickerForm.Format(time)</option>
                    }
                </select>
            </label>
            @* One drop-down for the week rule, like the column filters: the closed state says which weeks apply. *@
            <details class="week-choice" data-help-term="weeks of the month">
                <summary aria-label="Weeks of the month of window @(number + 1)"><span class="week-summary">@WindowPickerForm.WeekSummary(row)</span></summary>
                <div class="week-pop">
                    <label class="field"><span>Weeks of the month</span>
                        <select name="@WindowPickerForm.WeekModeField(Prefix, number)" aria-label="Weeks of the month of window @(number + 1)">
                            <option value="every" selected="@(WindowPickerForm.WeekMode(row) == "every")">every week</option>
                            <option value="only" selected="@(WindowPickerForm.WeekMode(row) == "only")">only in</option>
                            <option value="except" selected="@(WindowPickerForm.WeekMode(row) == "except")">all except</option>
                        </select>
                    </label>
                    <span class="weeks" role="group" aria-label="Weeks of window @(number + 1)">
                        @foreach (var choice in WindowPickerForm.WeekChoices)
                        {
                            <label class="day"><input type="checkbox" name="@WindowPickerForm.WeeksField(Prefix, number)" value="@choice.Value" checked="@((row.Weeks ?? row.ExceptWeeks ?? []).Contains(choice.Week))" /><span>@choice.Label</span></label>
                        }
                    </span>
                    <span class="note">Counts the weekday in the month: "only in 2nd" on Tuesday is the second Tuesday.</span>
                </div>
            </details>
            <span class="note select-days" hidden="@(row.Days.Count > 0)">select days</span>
            <button type="submit" name="@WindowPickerForm.ActionField(Prefix)" value="remove:@number" formnovalidate class="danger" aria-label="Remove window @(number + 1)" data-help-term="Remove">Remove</button>
        </div>
    }
    <div class="actions">
        @if (_rows.Count < MaintenanceWindow.MaxWindows)
        {
            <button type="submit" name="@WindowPickerForm.ActionField(Prefix)" value="add" formnovalidate>Add window</button>
        }
        <button type="submit" name="@WindowPickerForm.ActionField(Prefix)" value="preview" formnovalidate class="js-hide">Refresh preview</button>
        @if (Draft is not null)
        {
            <span class="note">Not saved yet.</span>
        }
    </div>
    </div>
    <div class="week" aria-hidden="true">
        @foreach (var day in WindowPickerForm.WeekOrder)
        {
            <span>@WindowPickerForm.ShortName(day)</span>
            @for (var hour = 0; hour < 24; hour++)
            {
                <span class="hour @(_cover[(int)day, hour] ? "on" : null)" data-day="@((int)day)" data-hour="@hour"></span>
            }
        }
    </div>
    <div class="window-summary">@Summary</div>
    @if (_openings.Count > 0)
    {
        <div class="window-openings note">Next openings (server time, from today): @string.Join(", ", _openings.Select(o => o.ToString("ddd yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture)))</div>
    }
</div>

@code {
    private List<WindowDraft> _rows = [];
    private bool[,] _cover = new bool[7, 24];
    private bool _inherited;
    private IReadOnlyList<DateTime> _openings = [];

    /// <summary>Prefix of the form fields; read back with <see cref="WindowPickerForm.Read"/>.</summary>
    [Parameter, EditorRequired]
    public string Prefix { get; set; } = "Windows";

    /// <summary>Windows saved at this level; null or empty when inherited.</summary>
    [Parameter]
    public IReadOnlyList<MaintenanceWindow>? Windows { get; set; }

    /// <summary>Rows as entered after one of the picker buttons; shown instead of <see cref="Windows"/>.</summary>
    [Parameter]
    public WindowPickerState? Draft { get; set; }

    /// <summary>Windows that apply when this level inherits; shown in the preview.</summary>
    [Parameter]
    public IReadOnlyList<MaintenanceWindow>? InheritedWindows { get; set; }

    [Parameter]
    public bool AllowInherit { get; set; }

    [Parameter]
    public bool Inherited { get; set; }

    [Parameter]
    public string InheritLabel { get; set; } = "Inherit";

    protected override void OnParametersSet()
    {
        _rows = Draft is { } draft ? [.. draft.Drafts] : [.. (Windows ?? []).Select(w => new WindowDraft(w.Days, w.Start, w.End) { Weeks = w.Weeks, ExceptWeeks = w.ExceptWeeks })];
        _inherited = AllowInherit && (Draft?.Inherit ?? Inherited);
        var own = WindowPickerForm.ToWindows(_rows);
        var effective = _inherited ? InheritedWindows ?? [] : own;
        _cover = WindowPickerForm.Coverage(effective);
        _openings = effective.Any(w => w.HasWeekRule) ? WindowPickerForm.NextOpenings(effective, DateTime.Now, 6) : [];
        Summary = effective.Count == 0
            ? "No window: installations never start."
            : $"{(_inherited ? "Inherited: " : string.Empty)}installations may start {WindowPickerForm.Describe(effective)} (server time). A window that ends before it starts runs past midnight.";
    }

    private string Summary { get; set; } = string.Empty;

    /// <summary>Inherited windows for the preview app.js draws while "inherit" is ticked: days as numbers, start and end in minutes.</summary>
    private string InheritedJson => System.Text.Json.JsonSerializer.Serialize((InheritedWindows ?? []).Select(w => new
    {
        days = w.Days.Select(d => (int)d),
        start = (int)w.Start.TotalMinutes,
        end = (int)w.End.TotalMinutes,
    }));
}
