@inherits LayoutComponentBase
@using SUSyphos.Contracts.Agents
@inject ServerDbContext Db
@inject SUSyphos.Server.AgentPackages.AgentPackageAdministration ServerUpdates

<div class="shell">
    <AuthorizeView Policy="@AdminRoles.Policies.Read">
        <Authorized>
            <nav class="nav" aria-label="Main">
                <span class="brand"><img src="susyphos-mark-white.svg" alt="" width="28" height="28" />SUSyphos</span>
                <NavLink href="/" Match="NavLinkMatch.All"><span class="nav-label"><Icon Name="@PageIcons.Overview" />Overview</span></NavLink>

                <NavLink href="/servers"><span class="nav-label"><Icon Name="@PageIcons.Servers" />Servers</span></NavLink>
                <NavLink href="/updates"><span class="nav-label"><Icon Name="@PageIcons.Updates" />Updates</span></NavLink>
                <AuthorizeView Policy="@AdminRoles.Policies.Operate" Context="operate">
                    <NavLink href="/approvals"><span class="nav-label"><Icon Name="@PageIcons.Approvals" />Approvals</span> @if (_waiting > 0) { <span class="pill">@_waiting</span> }</NavLink>
                    <NavLink href="/agents"><span class="nav-label"><Icon Name="@PageIcons.Agents" />Agents</span></NavLink>
                </AuthorizeView>
                <AuthorizeView Policy="@AdminRoles.Policies.Administer" Context="admin">
                    <span class="section">Administration</span>
                    <NavLink href="/administration/users"><span class="nav-label"><Icon Name="@PageIcons.Identity" />Identity</span></NavLink>
                    <NavLink href="/administration/groups"><span class="nav-label"><Icon Name="@PageIcons.ServerGroups" />Server groups</span></NavLink>
                    <NavLink href="/administration/rules"><span class="nav-label"><Icon Name="@PageIcons.AssignmentRules" />Assignment rules</span></NavLink>
                    <NavLink href="/administration/release-rules"><span class="nav-label"><Icon Name="@PageIcons.ReleaseRules" />Release rules</span></NavLink>
                    <NavLink href="/administration/agent-settings"><span class="nav-label"><Icon Name="@PageIcons.AgentSettings" />Agent settings</span></NavLink>
                    <NavLink href="/administration/maintenance"><span class="nav-label"><Icon Name="@PageIcons.MaintenanceWindows" />Maintenance windows</span></NavLink>
                    <NavLink href="/administration/certificate"><span class="nav-label"><Icon Name="@PageIcons.Certificate" />TLS certificate</span></NavLink>
                    <NavLink href="/administration/notifications"><span class="nav-label"><Icon Name="@PageIcons.Notifications" />Notifications</span></NavLink>
                    <NavLink href="/administration/backup"><span class="nav-label"><Icon Name="@PageIcons.Backup" />Backup</span></NavLink>
                    <NavLink href="/administration/audit"><span class="nav-label"><Icon Name="@PageIcons.AuditLog" />Audit log</span></NavLink>
                </AuthorizeView>
                <NavLink href="/help" Match="NavLinkMatch.Prefix" class="nav-help"><span class="nav-label"><Icon Name="@PageIcons.Help" />Help</span></NavLink>
                <form method="post" action="@DashboardServiceCollectionExtensions.LogoutPath" class="account">
                    <AntiforgeryToken />
                    <input type="hidden" name="_handler" value="logout" />
                    Signed in as <span class="user">@context.User.Identity?.Name</span>
                    <button type="submit">Sign out</button>
                    <span class="version" title="@ServerVersion.Full">Version @ServerVersion.Display@if (_serverUpdate is { } update) { <a href="/agents#server" class="update">@update.Version available</a> }</span>
                </form>
            </nav>
        </Authorized>
    </AuthorizeView>

    <main>
        @Body
    </main>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private int _waiting;
    private SUSyphos.Server.AgentPackages.ServerUpdate? _serverUpdate;

    protected override async Task OnInitializedAsync()
    {
        // Count for the navigation badge: servers and ring transitions that wait for a human decision.
        if (AuthenticationState is not null && (await AuthenticationState).User.Identity?.IsAuthenticated == true)
        {
            var servers = await Db.Clients.CountAsync(c => c.State == RegistrationState.Pending);
            var transitions = await Db.RolloutRings
                .Where(r => r.State == RingRolloutState.AwaitingApproval || r.State == RingRolloutState.Alarm)
                .CountAsync(r => Db.Rollouts.Any(o => o.UpdateId == r.UpdateId && o.Revision == r.Revision && o.State == RolloutState.Active));
            _serverUpdate = await ServerUpdates.GetServerUpdateAsync(CancellationToken.None);
            _waiting = servers + transitions + await Db.Groups.CountAsync(g => g.LeasesHalted) + await Db.Clients.CountAsync(c => c.State == RegistrationState.Blocked);
        }
    }
}
