@inherits LayoutComponentBase
@using SUSyphos.Contracts.Agents
@inject SUSyphos.Server.Agents.ActionResults ActionResults
@inject ServerDbContext Db
@inject SUSyphos.Server.AgentPackages.AgentPackageAdministration ServerUpdates
@inject SUSyphos.Server.Administration.DebugMode Debug
@inject SUSyphos.Server.Administration.MyRequests MyRequestList

<div class="shell">
    <AuthorizeView Policy="@AdminRoles.Policies.Read">
        <Authorized>
            <nav class="nav" aria-label="Main">
                <span class="brand"><img src="susyphos-mark-white.svg" alt="" width="28" height="28" />SUSyphos</span>
                <NavLink href="/" Match="NavLinkMatch.All"><span class="nav-label"><Icon Name="@PageIcons.Overview" />Overview</span></NavLink>

                <NavLink href="/servers"><span class="nav-label"><Icon Name="@PageIcons.Servers" />Servers</span></NavLink>
                <NavLink href="/updates"><span class="nav-label"><Icon Name="@PageIcons.Updates" />Updates</span></NavLink>
                <NavLink href="/software"><span class="nav-label"><Icon Name="@PageIcons.Software" />Software</span></NavLink>
                <NavLink href="/operating-systems"><span class="nav-label"><Icon Name="@PageIcons.OperatingSystems" />Operating systems</span></NavLink>
                <AuthorizeView Policy="@AdminRoles.Policies.Operate" Context="operate">
                    <NavLink href="/approvals"><span class="nav-label"><Icon Name="@PageIcons.Approvals" />Approvals</span> @if (_waiting > 0) { <span class="pill">@_waiting</span> }</NavLink>
                </AuthorizeView>
                <AuthorizeView Policy="@AdminRoles.Policies.Administer" Context="admin">
                    <span class="section">Administration</span>
                    <NavLink href="/administration/release-rules"><span class="nav-label"><Icon Name="@PageIcons.ReleaseRules" />Release rules</span></NavLink>
                    <NavLink href="/administration/maintenance"><span class="nav-label"><Icon Name="@PageIcons.MaintenanceWindows" />Maintenance windows</span></NavLink>
                    <NavLink href="/administration/groups"><span class="nav-label"><Icon Name="@PageIcons.ServerGroups" />Server groups</span></NavLink>
                    <NavLink href="/administration/rules"><span class="nav-label"><Icon Name="@PageIcons.AssignmentRules" />Assignment rules</span></NavLink>
                    <NavLink href="/administration/agent-settings"><span class="nav-label"><Icon Name="@PageIcons.AgentSettings" />Agent settings</span></NavLink>
                    <NavLink href="@SUSyphos.Server.Components.Pages.SusyphosPage.Route"><span class="nav-label"><Icon Name="@PageIcons.Susyphos" />SUSyphos</span></NavLink>
                    <NavLink href="/administration/users"><span class="nav-label"><Icon Name="@PageIcons.Identity" />Identity</span></NavLink>
                    <NavLink href="/administration/notifications"><span class="nav-label"><Icon Name="@PageIcons.Notifications" />Notifications</span></NavLink>
                    <NavLink href="/administration/certificate"><span class="nav-label"><Icon Name="@PageIcons.Certificate" />TLS certificate</span></NavLink>
                    <NavLink href="/administration/backup"><span class="nav-label"><Icon Name="@PageIcons.Backup" />Backup</span></NavLink>
                    <NavLink href="/administration/audit"><span class="nav-label"><Icon Name="@PageIcons.AuditLog" />Audit log</span></NavLink>
                </AuthorizeView>
                <NavLink href="/help" Match="NavLinkMatch.Prefix" class="nav-help" target="_blank" rel="noopener"><span class="nav-label"><Icon Name="@PageIcons.Help" />Help</span></NavLink>
                @* My requests (Marc, 2026-11-20, mockup variants 1 and 2): the user's own remote actions; the dashboard script
                   refreshes the list every 10 seconds and shows a message when one finishes; without script, the state on load. *@
                <details class="my-requests" data-my-requests="@SUSyphos.Server.Administration.MyRequests.Path" data-menu>
                    <summary class="nav-label"><Icon Name="@PageIcons.Requests" />My requests <span class="pill@(_myOpen == 0 ? " idle" : null)" data-my-count>@(_myOpen > 0 ? (MarkupString)$"<span class=\"pulse\"></span>{_myOpen}" : (MarkupString)"0")</span></summary>
                    <div class="menu-pop my-requests-pop" data-my-list>
                        @if (_myRequests.Count == 0)
                        {
                            <p class="note">No requests of yours in the last hour.</p>
                        }
                        @foreach (var request in _myRequests)
                        {
                            <div class="my-request" data-id="@request.Id" data-open="@(request.Open ? "1" : "0")">
                                <span class="pill @request.StateClass">@request.State</span>
                                <div><a href="@request.ServerLink">@request.Server</a>: @request.Action<div class="note">@request.Step@if (request.Detail is { Length: > 0 } detail) { <text> · @detail</text> }</div>@if (request.Download is { } download) { <a href="@download">Download logs</a> }</div>
                            </div>
                        }
                    </div>
                </details>
                <form method="post" action="@DashboardServiceCollectionExtensions.LogoutPath" class="account">
                    <AntiforgeryToken />
                    <input type="hidden" name="_handler" value="logout" />
                    Signed in as <span class="user">@context.User.Identity?.Name</span>
                    <button type="submit">Sign out</button>
                    <span class="version" title="@ServerVersion.Full">Version @ServerVersion.Display@if (_serverUpdate is { } update) { <a href="@(SUSyphos.Server.Components.Pages.SusyphosPage.Route)#server" class="update">@update.Version available</a> }</span>
                </form>
            </nav>
        </Authorized>
    </AuthorizeView>

    <main>
        @if (_centralDebug is { } debug)
        {
            @* Always visible while it runs, on every page (Marc, 2026-11-21: an active debug mode is presented prominently). *@
            <div class="debug-band" role="status"><Icon Name="scroll-text" Size="16" /><span>The central server is in <b>debug mode</b> until @DisplayTime.Format(debug.UntilUtc), switched on by @debug.By: it logs at Debug.</span><a href="@(SUSyphos.Server.Components.Pages.SusyphosPage.Route)#debug">Turn off or extend</a></div>
        }
        @Body
    </main>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private int _waiting;
    private SUSyphos.Server.AgentPackages.ServerUpdate? _serverUpdate;
    private SUSyphos.Server.Administration.DebugState? _centralDebug;
    private IReadOnlyList<SUSyphos.Server.Administration.MyRequest> _myRequests = [];
    private int _myOpen;

    protected override async Task OnInitializedAsync()
    {
        // Count for the navigation badge: servers, ring transitions and failed remote actions that wait for a human.
        if (AuthenticationState is not null && (await AuthenticationState).User.Identity?.IsAuthenticated == true)
        {
            var servers = await Db.Clients.CountAsync(c => c.State == RegistrationState.Pending);
            var transitions = await Db.RolloutRings
                .Where(r => r.State == RingRolloutState.AwaitingApproval || r.State == RingRolloutState.Alarm)
                .CountAsync(r => Db.Rollouts.Any(o => o.UpdateId == r.UpdateId && o.Revision == r.Revision && o.State == RolloutState.Active));
            _serverUpdate = await ServerUpdates.GetServerUpdateAsync(CancellationToken.None);
            _centralDebug = await Debug.CentralAsync(CancellationToken.None);
            if ((await AuthenticationState).User.Identity?.Name is { Length: > 0 } user)
            {
                _myRequests = await MyRequestList.ListAsync(user, CancellationToken.None);
                _myOpen = _myRequests.Count(r => r.Open);
            }
            _waiting = servers + transitions + await Db.Groups.CountAsync(g => g.LeasesHalted) + await Db.Clients.CountAsync(c => c.State == RegistrationState.Blocked)
                + await ActionResults.OpenFailuresAsync(CancellationToken.None);
        }
    }
}
