@page "/administration/maintenance"
@attribute [Authorize(Policy = AdminRoles.Policies.Administer)]
@inherits DashboardPageBase
@using SUSyphos.Contracts.Agents
@using SUSyphos.Server.Assignment
@inject AssignmentService Assignment
@inject AssignmentAdministration Administration
@inject SUSyphos.Server.Agents.BlackoutPeriods Blackouts
@inject TimeProvider Time

<PageTitle>Maintenance windows</PageTitle>

<PageHeader Title="Maintenance windows and reboots" Subtitle="System defaults for every server without own or group settings" Help="maintenance-windows" Crumbs="@([("Administration", null), ("Maintenance windows", null)])" />
<StatusMessage Text="@Message" IsError="@MessageIsError" />

<div class="grid-side">
    <form method="post" @formname="maintenance" @onsubmit="SaveAsync" class="box">
        <AntiforgeryToken />
        <header class="box-head"><h2>Maintenance windows<HelpLink To="maintenance-windows#windows" Label="Maintenance windows" /></h2><span class="hint">Local server time; a window that ends before it starts runs past midnight</span></header>
        <div class="box-body">
            <WindowPicker Prefix="Windows" Windows="@_current" Draft="@_windowDraft" />
        </div>
        <footer class="box-foot">
            <span class="note">Delivered to the agents with their next heartbeat.</span>
            <span class="actions"><a class="btn" href="/administration/maintenance">Discard changes</a><button type="submit" class="primary">Save windows</button></span>
        </footer>
    </form>

    <div class="stack">
    <form method="post" @formname="reboot" @onsubmit="SaveRebootAsync" class="box">
        <AntiforgeryToken />
        <header class="box-head"><h2>Reboots<HelpLink To="maintenance-windows#reboots" Label="Reboots" /></h2></header>
        <div class="box-body form">
            <label class="field"><span>System default</span>
                <select name="Reboot">
                    @foreach (var policy in Enum.GetValues<RebootPolicy>())
                    {
                        <option value="@policy" selected="@(policy == _reboot)">@RebootPolicyText.Label(policy)</option>
                    }
                </select>
            </label>
            <p class="note">
                Agents never restart a server unless its effective policy allows it: the server's own policy, otherwise its groups (one group with "Never" wins),
                otherwise this default. Inside the maintenance window the agent restarts only while the window stays open for 30 more minutes, warns 5 minutes ahead and
                restarts at most once per 6 hours. A server can always forbid reboots locally with the registry value AllowReboot = 0.
            </p>
        </div>
        <footer class="box-foot"><span></span><button type="submit" class="primary">Save reboot policy</button></footer>
    </form>

    <form method="post" @formname="automatic-updates" @onsubmit="SaveAutomaticUpdatesAsync" class="box">
        <AntiforgeryToken />
        <header class="box-head"><h2>Windows Automatic Updates and update source<HelpLink To="maintenance-windows#automatic-updates" Label="Windows Automatic Updates and update source" /></h2></header>
        <div class="box-body form">
            <label class="field"><span>System default</span>
                <select name="AutomaticUpdates">
                    <option value="leave" selected="@(!_manageAutomaticUpdates)">Leave unchanged, only warn</option>
                    <option value="prevent" selected="@_manageAutomaticUpdates">Keep Windows from installing on its own</option>
                </select>
            </label>
            <p class="note">
                With "keep Windows from installing on its own" the agent sets "Configure Automatic Updates" to option 3 (download, notify before
                install) on servers where no group policy controls it, and restores the setting when it is switched off. Group policy always wins.
                Groups can override this default ("leave unchanged" in one group wins).
            </p>
            <label class="field"><span>Other Microsoft products</span>
                <select name="MicrosoftUpdate">
                    <option value="windows" selected="@(!_useMicrosoftUpdate)">Windows Update only</option>
                    <option value="microsoft" selected="@_useMicrosoftUpdate">Microsoft Update: also SQL Server, Office and other Microsoft products</option>
                </select>
            </label>
            <p class="note">
                With Microsoft Update the agent registers the Microsoft Update service (like "Receive updates for other Microsoft products") and
                searches and installs through it, also on servers that otherwise use WSUS. Switched off, it removes only a registration it made itself.
                Groups can override this default ("Windows Update only" in one group wins).
            </p>
        </div>
        <footer class="box-foot"><span></span><button type="submit" class="primary">Save</button></footer>
    </form>
    </div>
</div>

<form method="post" @formname="blackouts" @onsubmit="ChangeBlackoutAsync" class="box">
    <AntiforgeryToken />
    <header class="box-head"><h2>Blackout periods<HelpLink To="maintenance-windows#blackouts" Label="Blackout periods" /></h2><span class="hint">No installation starts anywhere during these times, like a planned global pause; search and reporting continue</span></header>
    <div class="scroll">
        <table>
            <thead><tr><th>Start</th><th>End</th><th>Reason</th><th>State</th><th class="n">Actions</th></tr></thead>
            <tbody>
                @if (_blackouts.Count == 0)
                {
                    <tr><td colspan="5" class="note">No blackout period planned.</td></tr>
                }
                @foreach (var period in _blackouts)
                {
                    var now = Time.GetUtcNow().UtcDateTime;
                    <tr>
                        <td class="nowrap">@Format(period.StartUtc)</td>
                        <td class="nowrap">@Format(period.EndUtc)</td>
                        <td>@period.Reason</td>
                        <td>
                            @if (period.EndUtc <= now)
                            {
                                <span class="pill neutral">ended</span>
                            }
                            else if (period.StartUtc <= now)
                            {
                                <span class="pill fail">active</span>
                            }
                            else
                            {
                                <span class="pill queue">planned</span>
                            }
                        </td>
                        <td class="n"><button type="submit" name="BlackoutAction" value="remove:@period.Id" class="danger">Remove</button></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="box-body form">
        <div class="form-row">
            <div class="field"><span class="field-label">Start</span><span class="date-time"><input name="BlackoutStartDate" type="date" aria-label="Start date" /><select name="BlackoutStartTime" aria-label="Start time">@foreach (var time in WindowPickerForm.Times(null, includeEndOfDay: false)) { <option value="@WindowPickerForm.Format(time)">@WindowPickerForm.Format(time)</option> }</select></span></div>
            <div class="field"><span class="field-label">End</span><span class="date-time"><input name="BlackoutEndDate" type="date" aria-label="End date" /><select name="BlackoutEndTime" aria-label="End time">@foreach (var time in WindowPickerForm.Times(null, includeEndOfDay: false)) { <option value="@WindowPickerForm.Format(time)">@WindowPickerForm.Format(time)</option> }</select></span></div>
            <label class="field"><span>Reason</span><input name="BlackoutReason" maxlength="@SUSyphos.Server.Agents.BlackoutPeriods.MaxReasonLength" placeholder="e.g. year-end freeze" /></label>
        </div>
    </div>
    <footer class="box-foot"><span class="note">At most @SUSyphos.Server.Agents.BlackoutPeriods.MaxLength.TotalDays days each; changes are audited.</span><button type="submit" name="BlackoutAction" value="add" class="primary">Add blackout period</button></footer>
</form>

@code {
    [SupplyParameterFromForm(FormName = "reboot")]
    private string? Reboot { get; set; }

    [SupplyParameterFromForm(FormName = "automatic-updates")]
    private string? AutomaticUpdates { get; set; }

    [SupplyParameterFromForm(FormName = "automatic-updates")]
    private string? MicrosoftUpdate { get; set; }

    private bool _useMicrosoftUpdate;

    [CascadingParameter]
    private Microsoft.AspNetCore.Http.HttpContext? HttpContext { get; set; }

    private IReadOnlyList<MaintenanceWindow> _current = [];
    private RebootPolicy _reboot;
    private bool _manageAutomaticUpdates;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private WindowPickerState? _windowDraft;

    private async Task SaveAsync()
    {
        // Add, remove and preview of the picker show the rows again without saving.
        if (HttpContext?.Request.HasFormContentType == true && WindowPickerForm.ReadEdit(HttpContext.Request.Form, "Windows") is { } draft)
        {
            _windowDraft = draft;
            await LoadAsync();
            return;
        }

        var windows = HttpContext?.Request.HasFormContentType == true ? WindowPickerForm.Read(HttpContext.Request.Form, "Windows", out _) : string.Empty;
        var outcome = await Administration.SetSystemWindowsAsync(windows, await GetActorAsync(), CancellationToken.None);
        ShowResult(outcome.Error, "The system default was saved and is delivered to the agents.");
        await LoadAsync();
    }

    private async Task SaveRebootAsync()
    {
        var outcome = RebootPolicyText.TryParse(Reboot, out var policy) && policy is { } value
            ? await Administration.SetSystemRebootPolicyAsync(value, await GetActorAsync(), CancellationToken.None)
            : new Outcome("The reboot policy is invalid.");
        ShowResult(outcome.Error, "The reboot policy was saved and is delivered to the agents.");
        await LoadAsync();
    }

    private async Task SaveAutomaticUpdatesAsync()
    {
        var outcome = AutomaticUpdates switch
        {
            "prevent" => await Administration.SetSystemManageAutomaticUpdatesAsync(true, await GetActorAsync(), CancellationToken.None),
            "leave" => await Administration.SetSystemManageAutomaticUpdatesAsync(false, await GetActorAsync(), CancellationToken.None),
            _ => new Outcome("The Automatic Updates setting is invalid."),
        };
        if (outcome.Succeeded)
        {
            outcome = MicrosoftUpdate switch
            {
                "microsoft" => await Administration.SetSystemMicrosoftUpdateAsync(true, await GetActorAsync(), CancellationToken.None),
                "windows" => await Administration.SetSystemMicrosoftUpdateAsync(false, await GetActorAsync(), CancellationToken.None),
                null => Outcome.Ok,
                _ => new Outcome("The Microsoft Update setting is invalid."),
            };
        }

        ShowResult(outcome.Error, "The update source settings were saved and are delivered to the agents.");
        await LoadAsync();
    }

    [SupplyParameterFromForm(FormName = "blackouts")] private string? BlackoutAction { get; set; }
    [SupplyParameterFromForm(FormName = "blackouts")] private string? BlackoutStartDate { get; set; }
    [SupplyParameterFromForm(FormName = "blackouts")] private string? BlackoutStartTime { get; set; }
    [SupplyParameterFromForm(FormName = "blackouts")] private string? BlackoutEndDate { get; set; }
    [SupplyParameterFromForm(FormName = "blackouts")] private string? BlackoutEndTime { get; set; }

    /// <summary>Date and 24-hour time entered in the time zone of the central server, as UTC; null if either is missing or invalid.</summary>
    private static DateTime? ParseLocal(string? date, string? time) =>
        DateTime.TryParseExact($"{date} {time}", "yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var local)
            ? DisplayTime.ToUtc(local)
            : null;
    [SupplyParameterFromForm(FormName = "blackouts")] private string? BlackoutReason { get; set; }

    private IReadOnlyList<SUSyphos.Server.Agents.BlackoutPeriod> _blackouts = [];

    private async Task ChangeBlackoutAsync()
    {
        var actor = await GetActorAsync();
        Outcome outcome;
        if (BlackoutAction == "add")
        {
            outcome = ParseLocal(BlackoutStartDate, BlackoutStartTime) is { } start && ParseLocal(BlackoutEndDate, BlackoutEndTime) is { } end
                ? await Blackouts.AddAsync(start, end, BlackoutReason, actor, CancellationToken.None)
                : new Outcome("Enter start and end as date and time.");
        }
        else if (BlackoutAction?.StartsWith("remove:", StringComparison.Ordinal) == true && Guid.TryParse(BlackoutAction["remove:".Length..], out var id))
        {
            outcome = await Blackouts.RemoveAsync(id, actor, CancellationToken.None);
        }
        else
        {
            outcome = new Outcome("Invalid request.");
        }

        ShowResult(outcome.Error, BlackoutAction == "add" ? "The blackout period was added." : "The blackout period was removed.");
        await LoadAsync();
    }

    private static string Format(DateTime value) => DisplayTime.Format(value);

    private async Task LoadAsync()
    {
        _blackouts = await Blackouts.ListAsync(CancellationToken.None);
        _current = await Assignment.GetSystemWindowsAsync(CancellationToken.None);
        _reboot = await Assignment.GetSystemRebootPolicyAsync(CancellationToken.None);
        _manageAutomaticUpdates = await Assignment.GetSystemManageAutomaticUpdatesAsync(CancellationToken.None);
        _useMicrosoftUpdate = await Assignment.GetSystemMicrosoftUpdateAsync(CancellationToken.None);
    }
}
