@page "/administration/rules"
@attribute [Authorize(Policy = AdminRoles.Policies.Administer)]
@inherits DashboardPageBase
@using SUSyphos.Server.Assignment
@inject ServerDbContext Db
@inject AssignmentAdministration Administration
@inject NavigationManager Navigation

<PageTitle>Assignment rules</PageTitle>

<PageHeader Title="Assignment rules" Icon="@PageIcons.AssignmentRules" Subtitle="Ring: a manual assignment on the server wins, else the matching ring rule with the lowest priority number, else the final ring. Groups: every matching group rule applies, in addition to manual memberships." Help="assignment-rules" Crumbs="@([("Administration", null), ("Assignment rules", null)])" />
<StatusMessage Text="@Message" IsError="@MessageIsError" />

<ActionBand>
    <a class="btn primary" href="@Path?dialog=new"><Icon Name="plus" Size="16" />New rule…</a>
</ActionBand>

<Box Title="Rules" Help="assignment-rules#list" Flush="true" Hint="All conditions of a rule must match; a rule with several roles matches servers with any of them">
    <ListTable Table="_table" Page="_page" Columns="Columns" Search="Search domain or host name pattern" Noun="rules" Empty="No rule yet: servers go to the final ring." ExtraColumns="1">
        <ExtraHeader><th class="n">Actions</th></ExtraHeader>
        <Row Context="rule">
                    <tr>
                        <td class="n">@rule.Priority</td>
                        <td><a href="@TargetLink(rule)">@TargetName(rule)</a></td>
                        <td>@foreach (var role in AssignmentAdministration.RuleRoles(rule.Role)) { <span class="tag">@role</span> }</td>
                        <td>@rule.Domain</td>
                        <td class="mono">@rule.HostNamePattern</td>
                        <td class="n"><a href="/servers?rule=@rule.Id" title="Approved servers whose role, domain and host name match this rule">@_matches.GetValueOrDefault(rule.Id)</a></td>
                        <td class="n"><span class="row-actions">
                            <a class="btn icon-button" href="@Path?dialog=edit&id=@rule.Id" title="Edit rule @rule.Priority" aria-label="Edit rule @rule.Priority" data-help-term="Edit"><Icon Name="pencil" Size="16" /></a>
                            <ActionMenu Label="More" Icon="ellipsis" Compact="true" Align="right" Title="@($"More for rule {rule.Priority}")">
                                <MenuItem Href="@($"/servers?rule={rule.Id}")" Icon="server">Show matching servers</MenuItem>
                                <MenuSeparator />
                                <MenuItem Href="@($"{Path}?dialog=delete&id={rule.Id}")" Icon="trash-2" Danger="true">Delete rule…</MenuItem>
                            </ActionMenu>
                        </span></td>
                    </tr>
        </Row>
    </ListTable>
</Box>

@if (_dialog is "new" or "edit" && (_dialog == "new" || Editing is not null))
{
    var rule = Editing;
    var selectedRoles = Roles ?? (AssignmentAdministration.RuleRoles(rule?.Role).ToArray());
    var target = Target ?? (rule is null ? PrefillTarget : $"{(rule.Target == AssignmentTarget.Ring ? "ring" : "group")}:{rule.TargetId}");
    <Dialog Title="@(rule is null ? "New assignment rule" : "Edit assignment rule")" CloseHref="@Path" Wide="true" Help="assignment-rules#dialog">
        <form method="post" @formname="rule-dialog" @onsubmit="SaveAsync">
            <AntiforgeryToken />
            <input type="hidden" name="Mode" value="@(rule is null ? "create" : "edit")" />
            <input type="hidden" name="Id" value="@rule?.Id" />
            <div class="dialog-body">
                @if (MessageIsError)
                {
                    <p class="error" role="alert">@Message</p>
                }
                <div class="form-row">
                    <label class="field"><span>Assigns</span>
                        <select name="Target">
                            <optgroup label="Rings">
                                @foreach (var ring in _rings)
                                {
                                    <option value="ring:@ring.Id" selected="@(target == $"ring:{ring.Id}")">Ring @ring.Name</option>
                                }
                            </optgroup>
                            @if (_groups.Count > 0)
                            {
                                <optgroup label="Groups">
                                    @foreach (var group in _groups)
                                    {
                                        <option value="group:@group.Id" selected="@(target == $"group:{group.Id}")">Group @group.Name</option>
                                    }
                                </optgroup>
                            }
                        </select>
                    </label>
                    <label class="field"><span>Priority (lower wins)</span><input name="Priority" type="number" min="0" max="10000" value="@(Priority ?? (rule?.Priority ?? _nextPriority).ToString(System.Globalization.CultureInfo.InvariantCulture))" /></label>
                </div>
                <div class="field">
                    <span class="field-label">Roles (any of them)</span>
                    <MultiSelect Name="Roles" Options="@([.. _knownRoles.Take(MultiSelect.MaxOptions).Select(r => (r, r))])" Selected="@selectedRoles" Placeholder="Any role" />
                    <span class="help">Roles detected on the servers and the built-in roles. Other roles can be defined on the agents (Inventory:RoleRules).</span>
                </div>
                <div class="form-row">
                    <label class="field"><span>Domain</span><input name="Domain" maxlength="253" value="@(Domain ?? rule?.Domain)" placeholder="e.g. lab.local" /></label>
                    <label class="field"><span>Host name pattern</span><input name="HostNamePattern" maxlength="63" value="@(HostNamePattern ?? rule?.HostNamePattern)" placeholder="e.g. SQL* or WEB0?" /></label>
                </div>
                @{
                    var changes = PreviewChanges(rule, target);
                }
                <fieldset class="preview">
                    <legend>What changes (@changes.Count(c => c.Class != "neutral") of @_approved.Count approved servers)</legend>
                    @if (changes.Count == 0)
                    {
                        <p class="help">No approved server matches these conditions. Every condition must match; a rule needs at least one.</p>
                    }
                    <ul class="plain">
                        @foreach (var change in changes.Take(15))
                        {
                            <li>
                                <a href="/servers/@change.Client.Id">@change.Client.HostName</a>
                                @if (change.From is { } from && change.To is { } to)
                                {
                                    <RingTag Name="@from.Name" Order="@from.Order" /><span aria-hidden="true"> → </span><RingTag Name="@to.Name" Order="@to.Order" />
                                }
                                <span class="pill @change.Class">@change.Change</span>
                            </li>
                        }
                    </ul>
                    @if (changes.Count > 15)
                    {
                        <p class="help">and @(changes.Count - 15) more.</p>
                    }
                    <p class="help">Saving applies the rule to every approved server at once; a ring set by hand on a server always wins.</p>
                </fieldset>
            </div>
            <div class="dialog-foot"><a class="btn" href="@Path">Cancel</a><button type="submit" name="Preview" value="yes">Preview</button><button type="submit" class="primary">@(rule is null ? "Create rule" : "Save")</button></div>
        </form>
    </Dialog>
}
else if (_dialog == "delete" && Editing is { } doomed)
{
    <Dialog Title="Delete assignment rule?" CloseHref="@Path" Help="assignment-rules#list">
        <form method="post" @formname="rule-dialog" @onsubmit="SaveAsync">
            <AntiforgeryToken />
            <input type="hidden" name="Mode" value="delete" />
            <input type="hidden" name="Id" value="@doomed.Id" />
            <div class="dialog-body"><p>Servers assigned by this rule (@TargetName(doomed)) are recalculated at once and may move to another ring or leave the group.</p></div>
            <div class="dialog-foot"><a class="btn" href="@Path">Cancel</a><button type="submit" class="danger">Delete rule</button></div>
        </form>
    </Dialog>
}

@code {
    private const string Path = "/administration/rules";

    /// <summary>Roles the agent detects with its built-in rules.</summary>
    private static readonly string[] BuiltInRoles = ["DomainController", "Exchange", "SqlServer", "ClusterNode", "HyperVHost"];

    [SupplyParameterFromForm(FormName = "rule-dialog")]
    private string? Mode { get; set; }

    [SupplyParameterFromForm(FormName = "rule-dialog")]
    private string? Id { get; set; }

    [SupplyParameterFromForm(FormName = "rule-dialog")]
    private string? Priority { get; set; }

    [SupplyParameterFromForm(FormName = "rule-dialog")]
    private string? Target { get; set; }

    [SupplyParameterFromForm(FormName = "rule-dialog")]
    private string[]? Roles { get; set; }

    [SupplyParameterFromForm(FormName = "rule-dialog")]
    private string? Domain { get; set; }

    [SupplyParameterFromForm(FormName = "rule-dialog")]
    private string? HostNamePattern { get; set; }

    [SupplyParameterFromForm(FormName = "rule-dialog")]
    private string? Preview { get; set; }

    [SupplyParameterFromQuery(Name = "dialog")]
    private string? DialogName { get; set; }

    [SupplyParameterFromQuery(Name = "id")]
    private string? DialogId { get; set; }

    private string? _dialog;
    private List<AssignmentRuleEntity> _rules = [];
    private TableQuery _table = default!;
    private TablePage<AssignmentRuleEntity> _page = default!;
    private IReadOnlyList<TableColumn<AssignmentRuleEntity>>? _columns;

    private IReadOnlyList<TableColumn<AssignmentRuleEntity>> Columns => _columns ??=
    [
        new("priority", "Priority", r => r.Priority, Class: "n"),
        new("assigns", "Assigns", r => TargetName(r), r => [TargetName(r)]),
        new("roles", "Roles", r => r.Role, r => AssignmentAdministration.RuleRoles(r.Role).ToArray() is { Length: > 0 } roles ? roles : [string.Empty]),
        new("domain", "Domain", r => r.Domain, r => [r.Domain ?? string.Empty]),
        new("pattern", "Host name pattern", r => r.HostNamePattern),
        new("servers", "Servers", r => _matches.GetValueOrDefault(r.Id), Class: "n"),
    ];

    /// <summary>Approved servers each rule matches (conditions only; a manual ring or a rule with a lower number may decide first).</summary>
    private Dictionary<int, int> _matches = [];

    /// <summary>Target of a new rule when the dialog is opened for a group (?target=group:7); only matching options are selected.</summary>
    [SupplyParameterFromQuery(Name = "target")]
    private string? PrefillTarget { get; set; }
    private int _nextPriority = SUSyphos.Server.Administration.RulePriority.First;
    private List<RingEntity> _rings = [];
    private List<GroupEntity> _groups = [];
    private List<string> _knownRoles = [];

    private AssignmentRuleEntity? Editing => int.TryParse(DialogId, System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out var id) ? _rules.FirstOrDefault(r => r.Id == id) : null;

    protected override async Task OnInitializedAsync()
    {
        _dialog = DialogName;
        await LoadAsync();
    }

    private async Task SaveAsync()
    {
        if (Preview == "yes" && Mode is "create" or "edit")
        {
            // Show what the rule would change, without saving; the dialog keeps everything typed.
            _dialog = DialogName;
            await LoadAsync();
            return;
        }

        var actor = await GetActorAsync();
        var invariant = System.Globalization.CultureInfo.InvariantCulture;
        Outcome outcome;
        string success;
        if (Mode == "delete" && int.TryParse(Id, System.Globalization.NumberStyles.None, invariant, out var deleteId))
        {
            (outcome, success) = (await Administration.DeleteRuleAsync(deleteId, actor, CancellationToken.None), "The rule was deleted.");
        }
        else if (Mode is "create" or "edit")
        {
            var target = Target?.Split(':', 2) ?? [];
            if (!int.TryParse(Priority, System.Globalization.NumberStyles.None, invariant, out var priority)
                || target is not [("ring" or "group"), var targetText]
                || !int.TryParse(targetText, System.Globalization.NumberStyles.None, invariant, out var targetId))
            {
                (outcome, success) = (new Outcome("Invalid priority or target."), string.Empty);
            }
            else
            {
                var assignmentTarget = target[0] == "ring" ? AssignmentTarget.Ring : AssignmentTarget.Group;
                var roles = string.Join(',', Roles ?? []);
                if (Mode == "create")
                {
                    (outcome, success) = (await Administration.CreateRuleAsync(priority, assignmentTarget, targetId, roles, Domain, HostNamePattern, actor, CancellationToken.None), "The rule was created.");
                }
                else
                {
                    (outcome, success) = int.TryParse(Id, System.Globalization.NumberStyles.None, invariant, out var ruleId)
                        ? (await Administration.UpdateRuleAsync(ruleId, priority, assignmentTarget, targetId, roles, Domain, HostNamePattern, actor, CancellationToken.None), "The rule was saved.")
                        : (new Outcome("Invalid request."), string.Empty);
                }
            }
        }
        else
        {
            (outcome, success) = (new Outcome("Invalid request."), string.Empty);
        }

        ShowResult(outcome.Error, success);
        _dialog = outcome.Succeeded ? null : DialogName;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _rules = await Db.AssignmentRules.AsNoTracking().OrderBy(r => r.Priority).ThenBy(r => r.Id).ToListAsync();
        _nextPriority = SUSyphos.Server.Administration.RulePriority.NextFree([.. _rules.Select(r => r.Priority)]);
        _rings = await Db.Rings.AsNoTracking().OrderBy(r => r.Order).ToListAsync();
        _groups = await Db.Groups.AsNoTracking().OrderBy(g => g.Name).ToListAsync();
        var approved = await Db.Clients.AsNoTracking().Where(c => c.State == SUSyphos.Contracts.Agents.RegistrationState.Approved).ToListAsync();
        _matches = _rules.ToDictionary(r => r.Id, r => approved.Count(c => SUSyphos.Server.Assignment.AssignmentService.Matches(r, c)));
        _approved = approved;
        _memberships = (await Db.ClientGroups.AsNoTracking().ToListAsync()).Select(m => (m.ClientId, m.GroupId)).ToHashSet();
        _table = TableQuery.From(Navigation, "priority");
        _page = TablePaging.Apply(_rules, _table, Columns, r => $"{r.Domain} {r.HostNamePattern} {r.Role}");
        var inventoryRoles = (await Db.Clients.AsNoTracking().Select(c => c.Roles).ToListAsync()).SelectMany(r => r);
        _knownRoles = [.. BuiltInRoles
            .Concat(inventoryRoles)
            .Concat(_rules.SelectMany(r => AssignmentAdministration.RuleRoles(r.Role)))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Order(StringComparer.OrdinalIgnoreCase)];
    }

    private const string Unchanged = "no change";

    private List<ClientEntity> _approved = [];
    private HashSet<(Guid ClientId, int GroupId)> _memberships = [];

    private sealed record ServerChange(ClientEntity Client, string Change, string Class, RingEntity? From = null, RingEntity? To = null);

    /// <summary>
    /// What the rule as typed would change if saved: for a ring rule each server whose ring moves (or that the rule matches
    /// but a manual ring or a rule with a lower number keeps), for a group rule who joins or leaves. Changes first.
    /// </summary>
    private List<ServerChange> PreviewChanges(AssignmentRuleEntity? editing, string? target)
    {
        var parts = target?.Split(':', 2) ?? [];
        if (parts is not [("ring" or "group"), var idText] || !int.TryParse(idText, System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out var targetId) || _rings.Count == 0)
        {
            return [];
        }

        var candidate = new AssignmentRuleEntity
        {
            Id = editing?.Id ?? int.MaxValue,
            Priority = int.TryParse(Priority, System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out var priority) ? priority : editing?.Priority ?? _nextPriority,
            Target = parts[0] == "ring" ? AssignmentTarget.Ring : AssignmentTarget.Group,
            TargetId = targetId,
            Role = Mode is null ? editing?.Role : string.Join(',', Roles ?? []) is { Length: > 0 } roles ? roles : null,
            Domain = string.IsNullOrWhiteSpace(Domain) ? (Mode is null ? editing?.Domain : null) : Domain.Trim(),
            HostNamePattern = string.IsNullOrWhiteSpace(HostNamePattern) ? (Mode is null ? editing?.HostNamePattern : null) : HostNamePattern.Trim(),
        };
        var rules = _rules.Where(r => r.Id != candidate.Id).Append(candidate).OrderBy(r => r.Priority).ThenBy(r => r.Id).ToList();
        var fallback = _rings[^1].Id;
        var changes = new List<ServerChange>();
        foreach (var client in _approved)
        {
            var matches = AssignmentService.Matches(candidate, client);
            var before = editing is not null && AssignmentService.Matches(editing, client);
            if (!matches && !before)
            {
                continue;
            }

            if (candidate.Target == AssignmentTarget.Ring || editing?.Target == AssignmentTarget.Ring)
            {
                var to = AssignmentService.RingFor(client, rules, fallback);
                var from = _rings.FirstOrDefault(r => r.Id == client.RingId);
                var toRing = _rings.FirstOrDefault(r => r.Id == to);
                changes.Add(to != client.RingId
                    ? new ServerChange(client, "moves", "pend", from, toRing)
                    : new ServerChange(client, client.ManualRingId is not null ? "ring set by hand stays" : matches && to != targetId ? "a rule with a lower number decides" : Unchanged, "neutral", from, toRing));
            }
            else
            {
                var member = _memberships.Contains((client.Id, targetId));
                changes.Add(matches && !member ? new ServerChange(client, "joins the group", "pend")
                    : !matches && before ? new ServerChange(client, "leaves the group unless added by hand", "queue")
                    : new ServerChange(client, Unchanged, "neutral"));
            }
        }

        return [.. changes.OrderBy(c => c.Class == "neutral").ThenBy(c => c.Client.HostName, StringComparer.OrdinalIgnoreCase)];
    }

    private string TargetLink(AssignmentRuleEntity rule) => rule.Target == AssignmentTarget.Ring
        ? Servers.Link("ring", _rings.FirstOrDefault(r => r.Id == rule.TargetId)?.Name ?? string.Empty)
        : Servers.Link("group", _groups.FirstOrDefault(g => g.Id == rule.TargetId)?.Name ?? string.Empty);

    private string TargetName(AssignmentRuleEntity rule) => rule.Target == AssignmentTarget.Ring
        ? $"Ring {_rings.FirstOrDefault(r => r.Id == rule.TargetId)?.Name}"
        : $"Group {_groups.FirstOrDefault(g => g.Id == rule.TargetId)?.Name}";
}
