@page "/help"
@page "/help/{Topic}"
@using SUSyphos.Server.Help
@inject HelpCatalog Catalog
@inject NavigationManager Navigation

@* Open to everyone, also before sign-in: the help describes the product and contains no data of this installation. *@
@if (_topic is null && Topic is null)
{
    <PageTitle>Help</PageTitle>
    <PageHeader Title="Help" Icon="@PageIcons.Help" Subtitle="Every page of the dashboard explained: what each box shows and what each field and button does." />
    <Box Flush="true">
        <ul class="help-index">
            @foreach (var topic in Catalog.Topics)
            {
                <li><a href="@($"help/{topic.Slug}")">@topic.Title</a><span class="sub">@topic.Summary</span></li>
            }
        </ul>
    </Box>
}
else if (_topic is not null)
{
    <PageTitle>Help: @_topic.Title</PageTitle>
    <nav class="crumbs" aria-label="Breadcrumb"><a href="help">Help</a><span aria-hidden="true">/</span><span>@_topic.Title</span></nav>
    <article class="box help-article">
        <div class="box-body">@((MarkupString)_topic.Html)</div>
    </article>
}

@code {
    private HelpTopic? _topic;

    [Parameter]
    public string? Topic { get; set; }

    protected override void OnParametersSet()
    {
        _topic = Catalog.Find(Topic);
        if (_topic is null && Topic is not null)
        {
            Navigation.NotFound();
        }
    }
}
