@page "/administration/audit"
@attribute [Authorize(Policy = AdminRoles.Policies.Administer)]
@inject ServerDbContext Db
@inject AuditLog Audit
@inject NavigationManager Navigation

<PageTitle>Audit log</PageTitle>

<PageHeader Title="Audit log" Icon="@PageIcons.AuditLog" Subtitle="Every change in the administration and every decision, protected by a hash chain" Help="audit-log" Crumbs="@([("Administration", null), ("Audit log", null)])" />

@if (_broken is null)
{
    <p class="notice" role="status">Integrity check passed: the hash chain is intact.</p>
}
else
{
    <p class="error" role="alert">Integrity check failed at entry @_broken. The audit log was modified outside the application.</p>
}

<Box Title="Entries" Help="audit-log#entries" Flush="true">
    <TableTools Table="_table" Placeholder="Search target or details" Labels="Labels" View="_view" Options="_options" />
    <div class="scroll">
        <table>
            <thead>
                <tr>
                    <th>Time</th>
                    <SortHeader Table="_table" Column="actor" Label="Actor" Sortable="false" Options="_actors" />
                    <SortHeader Table="_table" Column="action" Label="Action" Sortable="false" Options="_actions" />
                    <SortHeader Table="_table" Column="target" Label="Target" Sortable="false" Options="_targets" />
                    <th>Details</th>
                </tr>
            </thead>
            <tbody>
                @if (_entries.Count == 0)
                {
                    <tr><td colspan="5" class="note">No entry matches.</td></tr>
                }
                @foreach (var entry in _entries)
                {
                    <tr>
                        <td class="nowrap">@DisplayTime.FormatSeconds(entry.AtUtc)</td>
                        <td>@entry.Actor</td>
                        <td class="nowrap">@entry.Action</td>
                        <td>@entry.Target</td>
                        <td>@entry.Details</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <Pager Table="_table" Page="_pageInfo" Noun="entries" />
</Box>

@code {
    private static readonly IReadOnlyDictionary<string, string> Labels = new Dictionary<string, string> { ["actor"] = "Actor", ["action"] = "Action", ["target"] = "Target" };

    private TableQuery _table = default!;
    private List<AuditEntryEntity> _entries = [];
    private IReadOnlyList<FilterOption> _actors = [];
    private IReadOnlyList<FilterOption> _actions = [];
    private IReadOnlyList<FilterOption> _targets = [];
    private TableViewState? _view;
    private Dictionary<string, IReadOnlyList<FilterOption>> _options = [];
    private PageInfo _pageInfo = new(1, 1, 0, 0);
    private long? _broken;

    protected override async Task OnInitializedAsync()
    {
        // The audit log grows without limit, so filtering and paging run in the database; values are parameters.
        var all = Db.AuditEntries.AsNoTracking();
        _actions = await all.GroupBy(e => e.Action).OrderBy(g => g.Key).Select(g => new FilterOption(g.Key, g.Count())).ToListAsync();
        _table = TableQuery.From(Navigation, "time", defaultDescending: true, defaultPageSize: 50, views: Views([.. _actions.Select(a => a.Value)]));
        var query = Filtered(all, _table.EffectiveFilters);

        if (_table.Search is { } search)
        {
            var pattern = "%" + search.Replace(@"\", @"\\", StringComparison.Ordinal).Replace("%", @"\%", StringComparison.Ordinal).Replace("_", @"\_", StringComparison.Ordinal) + "%";
            query = query.Where(e => (e.Target != null && EF.Functions.Like(e.Target, pattern, @"\")) || (e.Details != null && EF.Functions.Like(e.Details, pattern, @"\")));
        }

        var total = await all.CountAsync();
        var matching = await query.CountAsync();
        var pageSize = _table.PageSize;
        var pages = Math.Max(1, (matching + pageSize - 1) / pageSize);
        var page = Math.Min(_table.Page, pages);
        _entries = await query.OrderByDescending(e => e.Id).Skip((page - 1) * pageSize).Take(pageSize).ToListAsync();
        _pageInfo = new PageInfo(page, pages, matching, total, pageSize);
        _actors = await all.GroupBy(e => e.Actor).OrderBy(g => g.Key).Select(g => new FilterOption(g.Key, g.Count())).Take(200).ToListAsync();
        // The most frequent targets; others are found with the search.
        _targets = await all.Where(e => e.Target != null).GroupBy(e => e.Target!).OrderByDescending(g => g.Count()).Select(g => new FilterOption(g.Key, g.Count())).Take(200).ToListAsync();
        _targets = [.. _targets.OrderBy(t => t.Value, StringComparer.OrdinalIgnoreCase)];
        _options = new Dictionary<string, IReadOnlyList<FilterOption>>(StringComparer.Ordinal) { ["actor"] = _actors, ["action"] = _actions, ["target"] = _targets };
        var counts = new Dictionary<string, int>(StringComparer.Ordinal);
        foreach (var view in _table.Views)
        {
            counts[view.Key] = await Filtered(all, view.Filters).CountAsync();
        }

        _view = TableViewState.Of(_table, _options.ToDictionary(o => o.Key, o => (IReadOnlyList<string>)[.. o.Value.Select(v => v.Value)], StringComparer.Ordinal), v => counts[v.Key]);
        _broken = await Audit.FindFirstBrokenEntryAsync();
    }

    /// <summary>The views of the audit log; the areas take the actions that occur (AuditAreas), so new actions need no list.</summary>
    private static IReadOnlyList<TableView> Views(IReadOnlyList<string> actions)
    {
        TableFilter Area(string area) => TableFilter.In([.. actions.Where(a => AuditAreas.Of(a) == area)]);
        return
        [
            new("all", "All entries", "No filter"),
            new("sign-ins", AuditAreas.SignIns, "Sign-ins, sign-outs, refused sign-ins and the first setup", ("action", Area(AuditAreas.SignIns))),
            new("rollouts", AuditAreas.Rollouts, "Rollouts, ring approvals, held and blocked updates, approved servers, released agent versions", ("action", Area(AuditAreas.Rollouts))),
            new("settings", AuditAreas.Settings, "Rings, rules, groups, maintenance windows, notifications, accounts and other settings", ("action", Area(AuditAreas.Settings))),
        ];
    }

    /// <summary>Applies column filters in the database; the values are parameters, an exclusion keeps entries without a value.</summary>
    private static IQueryable<AuditEntryEntity> Filtered(IQueryable<AuditEntryEntity> query, IReadOnlyDictionary<string, TableFilter> filters)
    {
        if (filters.GetValueOrDefault("actor") is { } actor)
        {
            var values = actor.Values.ToList();
            query = actor.Exclude ? query.Where(e => !values.Contains(e.Actor)) : query.Where(e => values.Contains(e.Actor));
        }

        if (filters.GetValueOrDefault("action") is { } action)
        {
            var values = action.Values.ToList();
            query = action.Exclude ? query.Where(e => !values.Contains(e.Action)) : query.Where(e => values.Contains(e.Action));
        }

        if (filters.GetValueOrDefault("target") is { } target)
        {
            var values = target.Values.ToList();
            query = target.Exclude ? query.Where(e => e.Target == null || !values.Contains(e.Target)) : query.Where(e => e.Target != null && values.Contains(e.Target));
        }

        return query;
    }
}
