@page "/servers"
@attribute [Authorize(Policy = AdminRoles.Policies.Read)]
@inherits DashboardPageBase
@using SUSyphos.Contracts.Agents
@using SUSyphos.Server.Agents
@inject ServerDbContext Db
@inject DeploymentStatus Deployment
@inject AgentActionService Actions
@inject SUSyphos.Server.Assignment.AssignmentAdministration Administration
@inject NavigationManager Navigation
@inject TimeProvider Time
@inject SUSyphos.Server.AgentPackages.AgentUpdateService AgentUpdates
@inject SUSyphos.Server.Lifecycle.SupportLifecycle Lifecycle
@inject SUSyphos.Server.Security.SecurityBaseline Baseline
@inject SUSyphos.Server.Software.SoftwareAssignments SoftwareAssignments

<PageTitle>Servers</PageTitle>

<PageHeader Title="Servers" Icon="@PageIcons.Servers" Subtitle="@($"{_page.Total} registered servers")" Help="servers" />
<StatusMessage Text="@Message" IsError="@MessageIsError" />

<form id="bulk" method="post" @formname="servers-bulk" @onsubmit="BulkAsync" class="detached"><AntiforgeryToken /></form>
<AuthorizeView Policy="@AdminRoles.Policies.Operate">
    <ActionBand>
        <ActionMenu Label="Updates" Icon="scan-search" Kind="primary">
            <MenuItem Form="bulk" Name="Bulk" Value="search" Icon="search">Search for updates</MenuItem>
            <MenuItem Form="bulk" Name="Bulk" Value="resync" Icon="refresh-cw" Reason="Collect the inventory and the Windows Update history again and search">Sync inventory and history</MenuItem>
        </ActionMenu>
        <ActionMenu Label="Assign" Icon="git-branch">
            @foreach (var ring in _rings)
            {
                <MenuItem Form="bulk" Name="Bulk" Value="@($"ring:{ring.Id}")" Icon="target" Disabled="@(!_canAdminister)" Reason="@(_canAdminister ? "Assign the selected servers to this ring by hand" : "Only administrators can do this")">Move to ring @ring.Order @ring.Name</MenuItem>
            }
            @if (_groups.Count > 0)
            {
                <MenuSeparator />
                @foreach (var group in _groups.Take(MultiSelect.MaxOptions))
                {
                    <MenuItem Form="bulk" Name="Bulk" Value="@($"group:{group.Key}")" Icon="boxes" Disabled="@(!_canAdminister)" Reason="@(_canAdminister ? null : "Only administrators can do this")">Add to group @group.Value</MenuItem>
                }
            }
        </ActionMenu>
        @if (_packages.Count > 0)
        {
            <ActionMenu Label="Software" Icon="@PageIcons.Software">
                @foreach (var package in _packages.Take(MultiSelect.MaxOptions))
                {
                    <MenuItem Form="bulk" Name="Bulk" Value="@($"software:{package.Key}")" Icon="download" Disabled="@(!_canAdminister)" Reason="@(_canAdminister ? "Assign the package to the selected servers; they install its newest released version when it is released for their ring" : "Only administrators can do this")">Install @package.Value</MenuItem>
                }
            </ActionMenu>
        }
        <a class="btn" href="@Navigation.Uri" title="Load the list again with the latest state"><Icon Name="refresh-cw" Size="16" />Refresh</a>
        <div class="spacer"></div>
        <span class="note">Applies to the servers selected in the list</span>
    </ActionBand>
</AuthorizeView>

<Box Flush="true">
    <RingStrip Rings="@_ringCounts" Transitions="@_transitions" Table="_table" />
    <TableTools Table="_table" Placeholder="Search name or domain" GroupOptions="GroupOptions" Labels="Labels" View="_page.View">
        @if (_rule is not null)
        {
            <span class="chip" data-help="servers#rule">Assignment rule @_rule.Priority<a href="@Navigation.GetUriWithQueryParameter("rule", (string?)null)" aria-label="Remove the rule filter">×</a></span>
        }
    </TableTools>
    <div class="scroll">
        <table class="dense">
            <thead>
                <tr>
                    <th class="select"><input type="checkbox" data-select-all="Selected" data-help="tables#select" data-help-term="Select all" aria-label="Select all servers shown" hidden /></th>
                    <SortHeader Table="_table" Column="name" Label="Server" FilterColumn="domain" FilterLabel="Domain" Options="@Options("domain")" />
                    <SortHeader Table="_table" Column="os" Label="Operating system" Options="@Options("os")" />
                    <SortHeader Table="_table" Column="ring" Label="Ring and groups" Class="wrap-head" Options="@Options("ring")" />
                    <SortHeader Table="_table" Column="security" Label="Security" Options="@Options("security")" />
                    <SortHeader Table="_table" Column="agent" Label="Agent" Options="@Options("agent")" />
                    <SortHeader Table="_table" Column="status" Label="Status" Options="@Options("status")" />
                    <SortHeader Table="_table" Column="pending" Label="Updates" Options="@Options("pending")" />
                    <SortHeader Table="_table" Column="seen" Label="Last seen" />
                </tr>
            </thead>
            <tbody>
                @if (_page.Rows.Count == 0)
                {
                    <tr><td colspan="9" class="note">No server matches the search and filters.</td></tr>
                }
                @foreach (var (group, rows) in TablePaging.Groups(_page, _table, Columns))
                {
                    <GroupRow Name="@group" Count="@rows.Count" Columns="9" />
                    @foreach (var row in rows)
                    {
                        <tr>
                            <td class="select"><input type="checkbox" data-help-term="Select" form="bulk" name="Selected" value="@row.Id" aria-label="Select @row.HostName" /></td>
                            <td class="nowrap"><a href="/servers/@row.Id">@row.HostName</a>@if (row.Domain.Length > 0) { <div class="note break">@row.Domain</div> }</td>
                            <td>@row.Os<div class="note mono">@row.Build</div>@if (row.Support.State is not (SUSyphos.Server.Lifecycle.SupportState.Mainstream or SUSyphos.Server.Lifecycle.SupportState.Extended or SUSyphos.Server.Lifecycle.SupportState.Unknown)) { <div title="@SUSyphos.Server.Lifecycle.SupportLifecycle.Describe(row.Support)"><StatusTag Text="@SUSyphos.Server.Lifecycle.SupportLifecycle.Label(row.Support.State)" Kind="@SUSyphos.Server.Lifecycle.SupportLifecycle.Class(row.Support.State)" /></div> }</td>
                            <td><RingTag Name="@row.Ring" Order="@row.RingOrder" />@if (row.Groups.Count > 0) { <div class="tag-list" title="Server groups">@foreach (var groupName in row.Groups) { <span class="tag">@groupName</span> }</div> }</td>
                            <td class="nowrap" title="@SecurityTitle(row.Security)"><StatusTag Text="@SUSyphos.Server.Security.SecuritySnapshot.Label(row.Security.State)" Kind="@SUSyphos.Server.Security.SecuritySnapshot.Class(row.Security.State)" />@if (row.Security.Exploited > 0) { <div><span class="pill fail">Exploited</span></div> }</td>
                            <td class="mono nowrap" title="@row.AgentVersion"><span class="mark @ServerIndicators.Class(row.Agent)" title="@AgentTitle(row)">@ServerIndicators.Symbol(row.Agent)</span> @AgentVersion.ShortForm(row.AgentVersion)</td>
                            <td><span class="pill @ServerHealth.PillClass(row.Health)">@ServerHealth.Label(row.Health)</span>@if (row.RestartAt is { } restartAt) { <div class="note nowrap">restart @DisplayTime.Format(restartAt)</div> }</td>
                            <td class="nowrap" title="@UpdatesTitle(row)">@if (row.Counts.Failed == 0 && row.Counts.Pending == 0 && row.Counts.Queued == 0) { <span class="pill ok">up to date</span> } else { <span class="pill-list">@if (row.Counts.Failed > 0) { <span class="pill fail">@DisplayNumber.Format(row.Counts.Failed) failed</span> }@if (row.Counts.Pending > 0) { <span class="pill pend" title="Ready to install">@DisplayNumber.Format(row.Counts.Pending) ready</span> }@if (row.Counts.Queued > 0) { <span class="pill wait" title="Waiting for release">@DisplayNumber.Format(row.Counts.Queued) waiting</span> }</span> }</td>
                            <td class="nowrap"><span class="dot @ServerIndicators.Class(row.Freshness)" title="@ServerIndicators.Label(row.Freshness)"></span><span class="stamp">@(row.LastHeartbeat is { } seen ? DisplayTime.FormatDate(seen) : "–")@if (row.LastHeartbeat is { } seenAt) { <span class="note">@DisplayTime.ToLocal(seenAt).ToString("HH:mm", System.Globalization.CultureInfo.InvariantCulture)</span> }</span></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    <Pager Table="_table" Page="PageInfo.Of(_page)" Noun="servers" />
</Box>

@if (_updating)
{
    @* A server installs right now: the list follows it (the pill "Updating"). *@
    <LiveRefresh Seconds="15" />
}

@code {
    private bool _updating;

    private static readonly IReadOnlyList<(string Key, string Label)> GroupOptions = [("os", "Operating system"), ("ring", "Ring"), ("group", "Group"), ("agent", "Agent version"), ("status", "Status"), ("security", "Security baseline"), ("domain", "Domain")];
    private static readonly IReadOnlyDictionary<string, string> Labels = new Dictionary<string, string> { ["domain"] = "Domain", ["os"] = "Operating system", ["ring"] = "Ring", ["group"] = "Group", ["agent"] = "Agent", ["status"] = "Status", ["pending"] = "Updates", ["support"] = "Support", ["security"] = "Security" };

    /// <summary>Filter values of the pending column; the overview links to them.</summary>

    /// <summary>The open states of a server as filter values of the Updates column (Marc, 2026-11-20).</summary>
    private static IEnumerable<string> UpdateStates(Row row)
    {
        if (row.Counts.Failed > 0)
        {
            yield return DeploymentStates.Failed;
        }

        if (row.Counts.Pending > 0)
        {
            yield return DeploymentStates.ReadyToInstall;
        }

        if (row.Counts.Queued > 0)
        {
            yield return DeploymentStates.WaitingForRelease;
        }
    }

    /// <summary>Tooltip of the Updates column: the open states and what is installed already.</summary>
    private static string UpdatesTitle(Row row) =>
        $"{row.Counts.Failed} failed, {row.Counts.Pending} ready to install, {row.Counts.Queued} waiting for release; {row.Counts.Successful} installed; {row.Missing} missing in all, released or not";
    public const string PendingYes = "Updates pending";
    public const string PendingNo = "Up to date";

    /// <summary>The update search still reports a missing update, released or not (the "fully patched" share of the overview).</summary>
    public const string NotFullyPatched = "Not fully patched";

    public const string FullyPatched = "Fully patched";

    /// <summary>Address of the view with the servers that are not fully patched.</summary>
    public const string NotFullyPatchedLink = "/servers?view=unpatched";

    /// <summary>Address of the server list filtered to the given values of one column.</summary>
    public static string Link(string column, params string[] values) =>
        "/servers?" + string.Join("&", values.Select(v => $"{Uri.EscapeDataString("f." + column)}={Uri.EscapeDataString(v)}"));

    private sealed record Row(Guid Id, string HostName, string Domain, string Os, string Build, int BuildNumber, string Ring, int RingOrder, bool ManualRing, IReadOnlyList<string> Groups, string AgentVersion, ServerHealthState Health, int Pending, DateTime? LastHeartbeat, AgentState Agent, string? AgentTarget, string? AgentError, DeploymentCounts Counts, Freshness Freshness, DateTime? RestartAt, SUSyphos.Server.Lifecycle.SupportInfo Support, SUSyphos.Server.Security.ServerSecurity Security, int Missing = 0);

    /// <summary>Build against baseline and open vulnerabilities, as tooltip of the security cell.</summary>
    private static string SecurityTitle(SUSyphos.Server.Security.ServerSecurity security) => security.Target is { } target
        ? $"Build {security.Build}.{security.Revision}, baseline {target.Build}.{target.Revision} ({target.Month}); {security.Open.Count} open vulnerabilities, {security.Critical} critical, {security.Exploited} exploited"
        : "No security baseline: no MSRC data or a Windows version without one";

    private static string AgentTitle(Row row) => row.Agent switch
    {
        AgentState.UpdateAvailable => $"Update to {row.AgentTarget} available",
        AgentState.Failed => $"Agent update failed: {row.AgentError}",
        AgentState.Current => "Current: no newer version released for its ring",
        _ => "Version unknown, or too old to update itself",
    };

    private static readonly IReadOnlyList<TableColumn<Row>> Columns =
    [
        new("name", "Server", r => r.HostName),
        new("domain", "Domain", r => r.Domain, r => [r.Domain]),
        new("os", "Operating system", r => r.BuildNumber, r => [r.Os]),
        new("build", "Build", r => r.Build),
        new("support", "Support", r => r.Support.DaysLeft ?? int.MaxValue, r => [SUSyphos.Server.Lifecycle.SupportLifecycle.Label(r.Support.State)]),
        new("ring", "Ring", r => r.RingOrder, r => [r.Ring]),
        new("group", "Groups", r => r.Groups.FirstOrDefault(), r => r.Groups.Count == 0 ? [string.Empty] : r.Groups),
        new("agent", "Agent", r => AgentVersion.SortKey(r.AgentVersion), r => [AgentVersion.ShortForm(r.AgentVersion), ServerIndicators.Label(r.Agent)]),
        new("status", "Status", r => (int)r.Health, r => [ServerHealth.Label(r.Health)]),
        new("security", "Security baseline", r => (int)r.Security.State, r => r.Security.Exploited > 0 ? [SUSyphos.Server.Security.SecuritySnapshot.Label(r.Security.State), "Exploited"] : [SUSyphos.Server.Security.SecuritySnapshot.Label(r.Security.State)]),
        new("pending", "Updates", r => (r.Counts.Failed * 1_000_000) + (r.Counts.Pending * 1_000) + r.Counts.Queued, r => [r.Pending > 0 ? PendingYes : PendingNo, r.Missing > 0 ? NotFullyPatched : FullyPatched, .. UpdateStates(r)]),
        new("seen", "Last heartbeat", r => r.LastHeartbeat, r => [ServerIndicators.Label(r.Freshness)]),
    ];

    /// <summary>The views of the server list (docs/06-dashboard.md, section 8 "Table tools"), default first.</summary>
    private static readonly IReadOnlyList<TableView> Views =
    [
        new("all", "All servers", "No filter"),
        new("attention", "Needs attention", "Failed, offline, warning or waiting for a restart", ("status", TableFilter.In(ServerHealth.Label(ServerHealthState.Failed), ServerHealth.Label(ServerHealthState.Offline), ServerHealth.Label(ServerHealthState.Warning), ServerHealth.Label(ServerHealthState.RebootPending)))),
        new("pending", "Updates pending", "Approved servers that still miss released updates", ("pending", TableFilter.In(PendingYes)), ("status", TableFilter.Not(ServerHealth.Label(ServerHealthState.NotApproved)))),
        new("unpatched", NotFullyPatched, "Approved servers whose update search still reports a missing update, released or not", ("pending", TableFilter.In(NotFullyPatched)), ("status", TableFilter.Not(ServerHealth.Label(ServerHealthState.NotApproved)))),
        new("behind", "Behind security baseline", "Build older than the current security baseline of Microsoft", ("security", TableFilter.In(SUSyphos.Server.Security.SecuritySnapshot.Label(SUSyphos.Server.Security.BaselineState.OneBehind), SUSyphos.Server.Security.SecuritySnapshot.Label(SUSyphos.Server.Security.BaselineState.TwoBehind)))),
        new("agent", "Outdated agent", "A newer agent version is released for the ring of the server", ("agent", TableFilter.In(ServerIndicators.Label(AgentState.UpdateAvailable), ServerIndicators.Label(AgentState.Failed)))),
        new("unapproved", "Waiting for approval", "Registered, not approved yet", ("status", TableFilter.In(ServerHealth.Label(ServerHealthState.NotApproved)))),
    ];

    /// <summary>Shows only the approved servers an assignment rule matches (link from the assignment rules).</summary>
    [SupplyParameterFromQuery(Name = "rule")]
    private int? Rule { get; set; }

    private AssignmentRuleEntity? _rule;

    [SupplyParameterFromForm(FormName = "servers-bulk")]
    private string? Bulk { get; set; }

    [SupplyParameterFromForm(FormName = "servers-bulk")]
    private Guid[]? Selected { get; set; }

    private bool _canAdminister;
    private List<RingEntity> _rings = [];
    private IReadOnlyList<(int Id, int Order, string Name, int Servers)> _ringCounts = [];
    private IReadOnlyDictionary<int, (TimeSpan MinimumWait, TimeSpan MaximumWait, bool ManualGate)> _transitions = new Dictionary<int, (TimeSpan, TimeSpan, bool)>();

    private IReadOnlyDictionary<int, string> _groups = new Dictionary<int, string>();
    private IReadOnlyDictionary<string, string> _packages = new Dictionary<string, string>();

    private TableQuery _table = default!;
    private TablePage<Row> _page = new([], 0, 0, 1, 1, new Dictionary<string, IReadOnlyList<FilterOption>>());

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private IReadOnlyList<FilterOption>? Options(string column) => _page.Options.GetValueOrDefault(column);

    private async Task BulkAsync()
    {
        if (!await IsAuthorizedAsync(AdminRoles.Policies.Operate))
        {
            ShowResult("Only operators and administrators can send actions to servers.", string.Empty);
            return;
        }

        if (Bulk?.Split(':', 2) is ["software", var packageId] && SUSyphos.Server.Software.SoftwarePackages.IsValidId(packageId))
        {
            await AssignSoftwareAsync(packageId);
            return;
        }

        if (Bulk?.Split(':', 2) is [var target and ("ring" or "group"), var idText] && int.TryParse(idText, System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out var targetId))
        {
            await AssignAsync(target, targetId);
            return;
        }

        var kind = Bulk switch { "search" => AgentActionKind.SearchNow, "resync" => AgentActionKind.FullResync, _ => (AgentActionKind?)null };
        var selected = (Selected ?? []).Distinct().Take(500).ToList();
        if (kind is null || selected.Count == 0)
        {
            ShowResult("Select at least one server in the list first.", string.Empty);
            await LoadAsync();
            return;
        }

        var actor = await GetActorAsync();
        var queued = 0;
        var errors = new List<string>();
        foreach (var id in selected)
        {
            var outcome = await Actions.QueueAsync(id, kind.Value, actor, CancellationToken.None);
            if (outcome.Succeeded)
            {
                queued++;
            }
            else if (!errors.Contains(outcome.Error!))
            {
                errors.Add(outcome.Error!);
            }
        }

        ShowResult(queued == 0 ? string.Join(" ", errors) : null, $"Queued for {queued} servers; each runs it with its next heartbeat.{(errors.Count > 0 ? " Not queued for the others: " + string.Join(" ", errors) : string.Empty)}");
        await LoadAsync();
    }

    /// <summary>Assigns a package of the catalog to each selected server (administrators; Marc, 2026-11-21).</summary>
    private async Task AssignSoftwareAsync(string packageId)
    {
        var selected = (Selected ?? []).Distinct().Take(1000).ToList();
        if (!await IsAuthorizedAsync(AdminRoles.Policies.Administer))
        {
            ShowResult("Only administrators assign software.", string.Empty);
        }
        else if (selected.Count == 0)
        {
            ShowResult("Select at least one server in the list first.", string.Empty);
        }
        else
        {
            var actor = await GetActorAsync();
            var assigned = 0;
            var errors = new List<string>();
            foreach (var id in selected)
            {
                var outcome = await SoftwareAssignments.AddAsync(packageId, null, id, null, false, actor, CancellationToken.None);
                if (outcome.Succeeded)
                {
                    assigned++;
                }
                else if (!errors.Contains(outcome.Error!))
                {
                    errors.Add(outcome.Error!);
                }
            }

            ShowResult(assigned == 0 ? string.Join(" ", errors) : null, $"{_packages.GetValueOrDefault(packageId) ?? packageId} was assigned to {DisplayNumber.Count(assigned, "server", "servers")}; they install it when its newest version is released for their ring.{(errors.Count > 0 ? " Not for the others: " + string.Join(" ", errors) : string.Empty)}");
        }

        await LoadAsync();
    }

    /// <summary>Moves the selected servers to a ring by hand, or adds them to a group (administrators).</summary>
    private async Task AssignAsync(string target, int id)
    {
        var selected = (Selected ?? []).Distinct().Take(1000).ToList();
        if (!await IsAuthorizedAsync(AdminRoles.Policies.Administer))
        {
            ShowResult(target == "ring" ? "Only administrators can move servers between rings." : "Only administrators can change group memberships.", string.Empty);
        }
        else if (selected.Count == 0)
        {
            ShowResult("Select at least one server in the list first.", string.Empty);
        }
        else if (target == "ring")
        {
            var outcome = await Administration.MoveClientsToRingAsync(selected, id, await GetActorAsync(), CancellationToken.None);
            ShowResult(outcome.Error, $"Moved {selected.Count} servers to ring {_rings.FirstOrDefault(r => r.Id == id)?.Name}; assignment rules no longer move them.");
        }
        else
        {
            var (outcome, added) = await Administration.AddClientsToGroupAsync(selected, id, await GetActorAsync(), CancellationToken.None);
            ShowResult(outcome.Error, $"Added {added} servers to the group; the others were members already.");
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _table = TableQuery.From(Navigation, "name", views: Views);
        var rings = await Db.Rings.AsNoTracking().ToDictionaryAsync(r => r.Id);
        _canAdminister = await IsAuthorizedAsync(AdminRoles.Policies.Administer);
        _rings = [.. rings.Values.OrderBy(r => r.Order)];
        _transitions = (await Db.RingTransitions.AsNoTracking().ToListAsync()).ToDictionary(t => t.FromRingId, t => (t.MinimumWait, t.MaximumWait, t.ManualGate));
        var groups = await Db.Groups.AsNoTracking().ToDictionaryAsync(g => g.Id, g => g.Name);
        _groups = groups.OrderBy(g => g.Value, StringComparer.CurrentCulture).ToDictionary(g => g.Key, g => g.Value);
        _packages = await SUSyphos.Server.Software.SoftwareFeature.IsEnabledAsync(Db, CancellationToken.None)
            ? (await Db.Packages.AsNoTracking().Select(p => new { p.PackageId, p.Name }).ToListAsync()).OrderBy(p => p.Name, StringComparer.CurrentCulture).ToDictionary(p => p.PackageId, p => p.Name, StringComparer.OrdinalIgnoreCase)
            : new Dictionary<string, string>();
        var memberships = (await Db.ClientGroups.AsNoTracking().ToListAsync()).ToLookup(m => m.ClientId, m => m.GroupId);
        var clients = await Db.Clients.AsNoTracking().Where(c => c.State != RegistrationState.Deleted).ToListAsync();
        _rule = Rule is { } ruleId ? await Db.AssignmentRules.AsNoTracking().SingleOrDefaultAsync(r => r.Id == ruleId) : null;
        if (_rule is not null)
        {
            clients = [.. clients.Where(c => c.State == RegistrationState.Approved && SUSyphos.Server.Assignment.AssignmentService.Matches(_rule, c))];
        }
        var entries = await Deployment.GetAsync(null, null, null, CancellationToken.None);
        var failed = entries.Where(e => e.State == DeploymentState.Failed).Select(e => e.ClientId).ToHashSet();
        var pending = entries.Where(e => e.EarliestInstallAtUtc is not null && e.State != DeploymentState.Successful).GroupBy(e => e.ClientId).ToDictionary(g => g.Key, g => g.Count());
        var now = Time.GetUtcNow().UtcDateTime;
        var security = await Baseline.LoadAsync(CancellationToken.None);
        var agents = await AgentUpdates.StatesAsync(clients, rings.ToDictionary(r => r.Key, r => r.Value.Order), CancellationToken.None);
        var counts = entries.ToLookup(e => e.ClientId);
        var missing = await Db.ClientAvailableUpdates.AsNoTracking().GroupBy(a => a.ClientId).Select(g => new { g.Key, Count = g.Count() }).ToDictionaryAsync(g => g.Key, g => g.Count);

        List<Row> rows = [.. clients.Select(c =>
        {
            var ring = c.RingId is { } id && rings.TryGetValue(id, out var r) ? r : null;
            var (agent, target) = agents[c.Id];
            return new Row(
                c.Id,
                c.HostName,
                c.DomainName ?? string.Empty,
                OperatingSystems.Name(c.OsProductName, c.OsVersion, c.OsEditionId),
                OperatingSystems.Build(c.OsVersion),
                OperatingSystems.BuildNumber(c.OsVersion) ?? 0,
                ring?.Name ?? "–",
                ring?.Order ?? int.MaxValue,
                c.ManualRingId is not null,
                [.. memberships[c.Id].Where(groups.ContainsKey).Select(g => groups[g]).Order(StringComparer.CurrentCulture)],
                c.AgentVersion,
                ServerHealth.Evaluate(c, failed.Contains(c.Id), now),
                pending.GetValueOrDefault(c.Id),
                c.LastHeartbeatAtUtc,
                agent,
                target,
                c.AgentUpdateError,
                DeploymentCounts.Of(counts[c.Id]),
                ServerIndicators.Heartbeat(c.LastHeartbeatAtUtc, now),
                c.RestartAnnouncedAtUtc ?? (c.RestartRequested ? c.PlannedRestartAtUtc : null),
                Lifecycle.Of(c, security.Of(c)),
                security.Of(c),
                missing.GetValueOrDefault(c.Id));
        })];

        _updating = rows.Any(r => r.Health == ServerHealthState.Updating);
        _ringCounts = [.. _rings.Select(r => (r.Id, r.Order, r.Name, clients.Count(c => c.State == RegistrationState.Approved && c.RingId == r.Id)))];
        _page = TablePaging.Apply(rows, _table, Columns, r => $"{r.HostName} {r.Domain}");
    }
}
