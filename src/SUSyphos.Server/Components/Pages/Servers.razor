@page "/servers"
@attribute [Authorize(Policy = AdminRoles.Policies.Read)]
@inherits DashboardPageBase
@using SUSyphos.Contracts.Agents
@using SUSyphos.Server.Agents
@inject ServerDbContext Db
@inject DeploymentStatus Deployment
@inject AgentActionService Actions
@inject SUSyphos.Server.Assignment.AssignmentAdministration Administration
@inject NavigationManager Navigation
@inject TimeProvider Time
@inject SUSyphos.Server.AgentPackages.AgentUpdateService AgentUpdates

<PageTitle>Servers</PageTitle>

<PageHeader Title="Servers" Icon="@PageIcons.Servers" Subtitle="@($"{_page.Total} registered servers")" Help="servers" />
<StatusMessage Text="@Message" IsError="@MessageIsError" />

<AuthorizeView Policy="@AdminRoles.Policies.Operate">
    <ActionBand>
        <form id="bulk" method="post" @formname="servers-bulk" @onsubmit="BulkAsync">
            <AntiforgeryToken />
            <button type="submit" name="Bulk" value="search" class="primary">Search for updates now</button>
            <button type="submit" name="Bulk" value="resync">Sync inventory</button>
            <AuthorizeView Policy="@AdminRoles.Policies.Administer" Context="admin">
                @if (_groups.Count > 0)
                {
                    <span class="add-to-group">
                        <label class="visually-hidden" for="bulk-group">Group</label>
                        <select id="bulk-group" name="BulkGroup" data-help-term="Add to group">
                            @foreach (var group in _groups)
                            {
                                <option value="@group.Key">@group.Value</option>
                            }
                        </select>
                        <button type="submit" name="Bulk" value="group">Add to group</button>
                    </span>
                }
            </AuthorizeView>
        </form>
        <div class="spacer"></div>
        <span class="note">Applies to the servers selected in the list</span>
    </ActionBand>
</AuthorizeView>

<Box Flush="true">
    <TableTools Table="_table" Placeholder="Search name or domain" GroupOptions="GroupOptions" Labels="Labels">
        @if (_rule is not null)
        {
            <span class="chip" data-help="servers#rule">Assignment rule @_rule.Priority<a href="@Navigation.GetUriWithQueryParameter("rule", (string?)null)" aria-label="Remove the rule filter">×</a></span>
        }
    </TableTools>
    <div class="scroll">
        <table>
            <thead>
                <tr>
                    <th class="select"><input type="checkbox" data-select-all="Selected" data-help="tables#select" data-help-term="Select all" aria-label="Select all servers shown" hidden /></th>
                    <SortHeader Table="_table" Column="name" Label="Server" FilterColumn="domain" FilterLabel="Domain" Options="@Options("domain")" />
                    <SortHeader Table="_table" Column="os" Label="Operating system" Options="@Options("os")" />
                    <SortHeader Table="_table" Column="ring" Label="Ring" Options="@Options("ring")" />
                    <SortHeader Table="_table" Column="group" Label="Groups" Options="@Options("group")" />
                    <SortHeader Table="_table" Column="agent" Label="Agent" Options="@Options("agent")" />
                    <SortHeader Table="_table" Column="status" Label="Status" Options="@Options("status")" />
                    <SortHeader Table="_table" Column="pending" Label="Updates" Options="@Options("pending")" />
                    <SortHeader Table="_table" Column="seen" Label="Last seen" />
                </tr>
            </thead>
            <tbody>
                @if (_page.Rows.Count == 0)
                {
                    <tr><td colspan="9" class="note">No server matches the search and filters.</td></tr>
                }
                @foreach (var (group, rows) in Groups())
                {
                    @if (group is not null)
                    {
                        <tr class="group-row"><td colspan="9">@(group.Length == 0 ? "(none)" : group) · @rows.Count</td></tr>
                    }
                    @foreach (var row in rows)
                    {
                        <tr>
                            <td class="select"><input type="checkbox" data-help-term="Select" form="bulk" name="Selected" value="@row.Id" aria-label="Select @row.HostName" /></td>
                            <td class="nowrap"><a href="/servers/@row.Id">@row.HostName</a>@if (row.Domain.Length > 0) { <div class="note break">@row.Domain</div> }</td>
                            <td>@row.Os<div class="note mono">@row.Build</div></td>
                            <td class="nowrap">@row.Ring@if (row.ManualRing) { <div class="note">manual</div> }</td>
                            <td>@string.Join(", ", row.Groups)</td>
                            <td class="mono nowrap" title="@row.AgentVersion"><span class="mark @ServerIndicators.Class(row.Agent)" title="@AgentTitle(row)">@ServerIndicators.Symbol(row.Agent)</span> @AgentVersion.ShortForm(row.AgentVersion)</td>
                            <td><span class="pill @ServerHealth.PillClass(row.Health)">@ServerHealth.Label(row.Health)</span>@if (row.RestartAt is { } restartAt) { <div class="note nowrap">restart @DisplayTime.Format(restartAt)</div> }</td>
                            <td class="nowrap"><span class="donut-cell" title="@($"{row.Pending} pending, {row.Counts.Failed} failed, {row.Counts.Successful} installed")"><Donut Counts="@row.Counts" Small="true" /><span class="note num">@row.Pending</span></span></td>
                            <td class="nowrap"><span class="dot @ServerIndicators.Class(row.Freshness)" title="@ServerIndicators.Label(row.Freshness)"></span>@DisplayTime.Format(row.LastHeartbeat)</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    <Pager Table="_table" Page="PageInfo.Of(_page)" Noun="servers" />
</Box>

@code {
    private static readonly IReadOnlyList<(string Key, string Label)> GroupOptions = [("os", "Operating system"), ("ring", "Ring"), ("group", "Group"), ("agent", "Agent version"), ("status", "Status"), ("domain", "Domain")];
    private static readonly IReadOnlyDictionary<string, string> Labels = new Dictionary<string, string> { ["domain"] = "Domain", ["os"] = "Operating system", ["ring"] = "Ring", ["group"] = "Group", ["agent"] = "Agent", ["status"] = "Status", ["pending"] = "Updates" };

    /// <summary>Filter values of the pending column; the overview links to them.</summary>
    public const string PendingYes = "Updates pending";
    public const string PendingNo = "Up to date";

    /// <summary>Address of the server list filtered to the given values of one column.</summary>
    public static string Link(string column, params string[] values) =>
        "/servers?" + string.Join("&", values.Select(v => $"{Uri.EscapeDataString("f." + column)}={Uri.EscapeDataString(v)}"));

    private sealed record Row(Guid Id, string HostName, string Domain, string Os, string Build, int BuildNumber, string Ring, int RingOrder, bool ManualRing, IReadOnlyList<string> Groups, string AgentVersion, ServerHealthState Health, int Pending, DateTime? LastHeartbeat, AgentState Agent, string? AgentTarget, string? AgentError, DeploymentCounts Counts, Freshness Freshness, DateTime? RestartAt);

    private static string AgentTitle(Row row) => row.Agent switch
    {
        AgentState.UpdateAvailable => $"Update to {row.AgentTarget} available",
        AgentState.Failed => $"Agent update failed: {row.AgentError}",
        AgentState.Current => "Current: no newer version released for its ring",
        _ => "Version unknown, or too old to update itself",
    };

    private static readonly IReadOnlyList<TableColumn<Row>> Columns =
    [
        new("name", "Server", r => r.HostName),
        new("domain", "Domain", r => r.Domain, r => [r.Domain]),
        new("os", "Operating system", r => r.BuildNumber, r => [r.Os]),
        new("build", "Build", r => r.Build),
        new("ring", "Ring", r => r.RingOrder, r => [r.Ring]),
        new("group", "Groups", r => r.Groups.FirstOrDefault(), r => r.Groups.Count == 0 ? [string.Empty] : r.Groups),
        new("agent", "Agent", r => AgentVersion.SortKey(r.AgentVersion), r => [AgentVersion.ShortForm(r.AgentVersion), ServerIndicators.Label(r.Agent)]),
        new("status", "Status", r => (int)r.Health, r => [ServerHealth.Label(r.Health)]),
        new("pending", "Pending updates", r => r.Pending, r => [r.Pending > 0 ? PendingYes : PendingNo]),
        new("seen", "Last heartbeat", r => r.LastHeartbeat, r => [ServerIndicators.Label(r.Freshness)]),
    ];

    /// <summary>Shows only the approved servers an assignment rule matches (link from the assignment rules).</summary>
    [SupplyParameterFromQuery(Name = "rule")]
    private int? Rule { get; set; }

    private AssignmentRuleEntity? _rule;

    [SupplyParameterFromForm(FormName = "servers-bulk")]
    private string? Bulk { get; set; }

    [SupplyParameterFromForm(FormName = "servers-bulk")]
    private Guid[]? Selected { get; set; }

    [SupplyParameterFromForm(FormName = "servers-bulk")]
    private int? BulkGroup { get; set; }

    private IReadOnlyDictionary<int, string> _groups = new Dictionary<int, string>();

    private TableQuery _table = default!;
    private TablePage<Row> _page = new([], 0, 0, 1, 1, new Dictionary<string, IReadOnlyList<FilterOption>>());

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private IReadOnlyList<FilterOption>? Options(string column) => _page.Options.GetValueOrDefault(column);

    /// <summary>Rows of the current page, grouped when the address asks for it.</summary>
    private IEnumerable<(string? Group, List<Row> Rows)> Groups()
    {
        var column = Columns.FirstOrDefault(c => c.Key == _table.Group && c.FilterValues is not null);
        if (column is null)
        {
            yield return (null, [.. _page.Rows]);
            yield break;
        }

        foreach (var group in _page.Rows.GroupBy(column.GroupKey))
        {
            yield return (group.Key, [.. group]);
        }
    }

    private async Task BulkAsync()
    {
        if (!await IsAuthorizedAsync(AdminRoles.Policies.Operate))
        {
            ShowResult("Only operators and administrators can send actions to servers.", string.Empty);
            return;
        }

        if (Bulk == "group")
        {
            await AddToGroupAsync();
            return;
        }

        var kind = Bulk switch { "search" => AgentActionKind.SearchNow, "resync" => AgentActionKind.FullResync, _ => (AgentActionKind?)null };
        var selected = (Selected ?? []).Distinct().Take(500).ToList();
        if (kind is null || selected.Count == 0)
        {
            ShowResult("Select at least one server in the list first.", string.Empty);
            await LoadAsync();
            return;
        }

        var actor = await GetActorAsync();
        var queued = 0;
        var errors = new List<string>();
        foreach (var id in selected)
        {
            var outcome = await Actions.QueueAsync(id, kind.Value, actor, CancellationToken.None);
            if (outcome.Succeeded)
            {
                queued++;
            }
            else if (!errors.Contains(outcome.Error!))
            {
                errors.Add(outcome.Error!);
            }
        }

        ShowResult(queued == 0 ? string.Join(" ", errors) : null, $"Queued for {queued} servers; each runs it with its next heartbeat.{(errors.Count > 0 ? " Not queued for the others: " + string.Join(" ", errors) : string.Empty)}");
        await LoadAsync();
    }

    private async Task AddToGroupAsync()
    {
        if (!await IsAuthorizedAsync(AdminRoles.Policies.Administer))
        {
            ShowResult("Only administrators can change group memberships.", string.Empty);
        }
        else if (BulkGroup is not { } groupId)
        {
            ShowResult("Choose a group.", string.Empty);
        }
        else
        {
            var (outcome, added) = await Administration.AddClientsToGroupAsync(Selected ?? [], groupId, await GetActorAsync(), CancellationToken.None);
            ShowResult(outcome.Error, $"Added {added} servers to the group; the others were members already.");
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _table = TableQuery.From(Navigation, "name");
        var rings = await Db.Rings.AsNoTracking().ToDictionaryAsync(r => r.Id);
        var groups = await Db.Groups.AsNoTracking().ToDictionaryAsync(g => g.Id, g => g.Name);
        _groups = groups.OrderBy(g => g.Value, StringComparer.CurrentCulture).ToDictionary(g => g.Key, g => g.Value);
        var memberships = (await Db.ClientGroups.AsNoTracking().ToListAsync()).ToLookup(m => m.ClientId, m => m.GroupId);
        var clients = await Db.Clients.AsNoTracking().Where(c => c.State != RegistrationState.Deleted).ToListAsync();
        _rule = Rule is { } ruleId ? await Db.AssignmentRules.AsNoTracking().SingleOrDefaultAsync(r => r.Id == ruleId) : null;
        if (_rule is not null)
        {
            clients = [.. clients.Where(c => c.State == RegistrationState.Approved && SUSyphos.Server.Assignment.AssignmentService.Matches(_rule, c))];
        }
        var entries = await Deployment.GetAsync(null, null, null, CancellationToken.None);
        var failed = entries.Where(e => e.State == DeploymentState.Failed).Select(e => e.ClientId).ToHashSet();
        var pending = entries.Where(e => e.EarliestInstallAtUtc is not null && e.State != DeploymentState.Successful).GroupBy(e => e.ClientId).ToDictionary(g => g.Key, g => g.Count());
        var now = Time.GetUtcNow().UtcDateTime;
        var packages = await AgentUpdates.GetOfferablePackagesAsync(CancellationToken.None);
        var counts = entries.ToLookup(e => e.ClientId);

        List<Row> rows = [.. clients.Select(c =>
        {
            var ring = c.RingId is { } id && rings.TryGetValue(id, out var r) ? r : null;
            var known = AgentVersion.TryParse(c.AgentVersion, out var version);
            var target = known && packages.Count > 0 ? SUSyphos.Server.AgentPackages.AgentUpdateService.TargetFor(packages, ring?.Order ?? SUSyphos.Server.AgentPackages.AgentPackageEntity.AllRings, version!, AgentUpdates.Minimum)?.Version : null;
            return new Row(
                c.Id,
                c.HostName,
                c.DomainName ?? string.Empty,
                OperatingSystems.Name(c.OsProductName, c.OsVersion),
                OperatingSystems.Build(c.OsVersion),
                OperatingSystems.BuildNumber(c.OsVersion) ?? 0,
                ring?.Name ?? "–",
                ring?.Order ?? int.MaxValue,
                c.ManualRingId is not null,
                [.. memberships[c.Id].Where(groups.ContainsKey).Select(g => groups[g]).Order(StringComparer.CurrentCulture)],
                c.AgentVersion,
                ServerHealth.Evaluate(c, failed.Contains(c.Id), now),
                pending.GetValueOrDefault(c.Id),
                c.LastHeartbeatAtUtc,
                ServerIndicators.Agent(c.AgentUpdateError, known, target),
                target,
                c.AgentUpdateError,
                DeploymentCounts.Of(counts[c.Id]),
                ServerIndicators.Heartbeat(c.LastHeartbeatAtUtc, now),
                c.RestartAnnouncedAtUtc ?? (c.RestartRequested ? c.PlannedRestartAtUtc : null));
        })];

        _page = TablePaging.Apply(rows, _table, Columns, r => $"{r.HostName} {r.Domain}");
    }
}
