    /// <summary>
    /// Assigns the chosen packages to this server (Marc, 2026-11-21: installing software from the server page instead of
    /// the package page), optionally releasing the newest version for this server alone right away.
    /// </summary>
    private async Task InstallSoftwareAsync()
    {
        if (!await IsAuthorizedAsync(AdminRoles.Policies.Administer))
        {
            ShowResult("Only administrators install software.", string.Empty);
            return;
        }

        var chosen = (InstallPackage ?? []).Where(SUSyphos.Server.Software.SoftwarePackages.IsValidId).Distinct(StringComparer.OrdinalIgnoreCase).Take(MaxCatalogChoices).ToList();
        if (chosen.Count == 0)
        {
            ShowResult("Choose at least one package.", string.Empty);
            Dialog = "install-software";
            await LoadAsync();
            return;
        }

        var actor = await GetActorAsync();
        var errors = new List<string>();
        var assigned = new List<string>();
        foreach (var packageId in chosen)
        {
            var outcome = await Assignments.AddAsync(packageId, null, Id, null, InstallUninstallOnRemoval == "true", actor, CancellationToken.None);
            if (outcome.Succeeded)
            {
                assigned.Add(packageId);
            }
            else
            {
                errors.Add($"{packageId}: {outcome.Error}");
            }
        }

        var installed = string.Empty;
        if (InstallRightAway == "true" && assigned.Count > 0)
        {
            var newest = (await Db.PackageVersions.AsNoTracking().Where(v => assigned.Contains(v.PackageId)).Select(v => new { v.PackageId, v.Version, v.UpdateId }).ToListAsync())
                .GroupBy(v => v.PackageId, StringComparer.OrdinalIgnoreCase)
                .Select(g => g.MaxBy(v => v.Version, SUSyphos.WinGet.Catalog.RestSource.VersionComparer.Instance)!.UpdateId)
                .ToList();
            var result = await Selection.InstallAsync(Id, newest, SUSyphos.Contracts.Agents.AgentActionKind.InstallNowRestartInWindow, actor, CancellationToken.None);
            installed = result.Error is { } error ? $" Install now: {error}" : $" {DisplayNumber.Count(result.Done, "installs", "install")} now{(result.Skipped.Count > 0 ? $"; skipped: {string.Join("; ", result.Skipped.Select(s => $"{s.Title} ({s.Reason})"))}" : string.Empty)}.";
        }

        ShowResultAndReload(errors.Count > 0 && assigned.Count == 0 ? string.Join(" ", errors) : null, $"{DisplayNumber.Count(assigned.Count, "package was", "packages were")} assigned to {_client?.HostName}.{installed}{(errors.Count > 0 ? $" Not assigned: {string.Join("; ", errors)}" : string.Empty)}");
        Dialog = null;
        await LoadAsync();
    }

    /// <summary>Catalog packages for the install dialog and the assignments of this server that wait for their installation.</summary>
    private async Task LoadSoftwareChoicesAsync(List<ClientSoftwareEntity> programs)
    {
        var installedIds = programs.Where(p => p.PackageId is not null).Select(p => p.PackageId!).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var groupIds = _memberships.Select(m => m.GroupId).ToList();
        var assignments = await Db.PackageAssignments.AsNoTracking()
            .Where(a => a.Mode == PackageAssignmentMode.Install && (a.ClientId == Id || (a.GroupId != null && groupIds.Contains(a.GroupId.Value)) || a.TargetKind == PackageAssignmentTarget.AllServers))
            .ToListAsync();
        var packages = await Db.Packages.AsNoTracking().Select(p => new { p.PackageId, p.Name }).ToListAsync();
        var names = packages.ToDictionary(p => p.PackageId, p => p.Name, StringComparer.OrdinalIgnoreCase);
        var newest = (await Db.PackageVersions.AsNoTracking().Select(v => new { v.PackageId, v.Version }).ToListAsync())
            .GroupBy(v => v.PackageId, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(g => g.Key, g => g.Select(v => v.Version).Max(SUSyphos.WinGet.Catalog.RestSource.VersionComparer.Instance), StringComparer.OrdinalIgnoreCase);
        var unsupported = await SUSyphos.Server.Software.SoftwareNeeds.UnsupportedAsync(Db, [Id], CancellationToken.None);
        var unsupportedIds = unsupported.Select(u => u.Need.UpdateId).ToList();
        var reasons = unsupported
            .Join(await Db.PackageVersions.AsNoTracking().Where(v => unsupportedIds.Contains(v.UpdateId)).Select(v => new { v.UpdateId, v.PackageId }).ToListAsync(), u => u.Need.UpdateId, v => v.UpdateId, (u, v) => (v.PackageId, u.Reason))
            .GroupBy(r => r.PackageId, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(g => g.Key, g => g.First().Reason, StringComparer.OrdinalIgnoreCase);

        _assignedWaiting = [.. assignments
            .Where(a => !installedIds.Contains(a.PackageId))
            .GroupBy(a => a.PackageId, StringComparer.OrdinalIgnoreCase)
            .Select(g =>
            {
                var a = g.OrderBy(x => x.TargetKind == PackageAssignmentTarget.Server ? 0 : x.TargetKind == PackageAssignmentTarget.Group ? 1 : 2).First();
                var via = a.TargetKind == PackageAssignmentTarget.AllServers ? "all servers" : a.GroupId is { } group ? $"group {_groups.FirstOrDefault(x => x.Id == group)?.Name}" : "this server";
                return new AssignedWaiting(a.PackageId, names.GetValueOrDefault(a.PackageId) ?? a.PackageId, a.FixedVersion, via, reasons.GetValueOrDefault(a.PackageId));
            })
            .OrderBy(w => w.Name, StringComparer.OrdinalIgnoreCase)];

        if (Dialog != "install-software")
        {
            return;
        }

        var taken = installedIds.Concat(assignments.Select(a => a.PackageId)).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var query = SoftwareQuery?.Trim();
        var matches = packages
            .Where(p => !taken.Contains(p.PackageId) && (string.IsNullOrEmpty(query) || p.PackageId.Contains(query, StringComparison.OrdinalIgnoreCase) || p.Name.Contains(query, StringComparison.OrdinalIgnoreCase)))
            .OrderBy(p => p.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();
        _catalogMore = Math.Max(0, matches.Count - MaxCatalogChoices);
        _catalogChoices = [.. matches.Take(MaxCatalogChoices).Select(p => new CatalogChoice(p.PackageId, p.Name, newest.GetValueOrDefault(p.PackageId), reasons.GetValueOrDefault(p.PackageId)))];
    }

