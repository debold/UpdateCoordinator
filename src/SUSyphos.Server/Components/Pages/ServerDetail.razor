    /// <summary>Next opening of the effective windows in the server's time zone, with the time of the central server for comparison.</summary>
    private string NextWindowText
    {
        get
        {
            if (_client?.TimeZoneId is not { } zoneId || !TimeZoneInfo.TryFindSystemTimeZoneById(zoneId, out var zone))
            {
                return "unknown until the server reports its time zone";
            }

            var windows = MaintenanceWindowFormat.FromJson(_client.EffectiveWindowsJson) ?? [];
            var localNow = TimeZoneInfo.ConvertTimeFromUtc(Time.GetUtcNow().UtcDateTime, zone);
            if (SUSyphos.Contracts.Agents.MaintenanceSchedule.NextOpening(windows, localNow) is not { } next)
            {
                return "no window";
            }

            if (next == localNow)
            {
                return "open now";
            }

            var utc = TimeZoneInfo.ConvertTimeToUtc(DateTime.SpecifyKind(next, DateTimeKind.Unspecified), zone);
            return zone.Id == DisplayTime.Zone.Id
                ? Format(utc)
                : $"{next.ToString("ddd yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture)} server time ({Format(utc)} central server time)";
        }
    }

    /// <summary>Reboot state for the filter, without the time of the restart.</summary>
    private string RebootKind(InstallationEntity installation) => RebootTag(installation).Text;

    /// <summary>Restart after an installation as a tag: not needed (green), restarted (green, with the time) or still pending (yellow).</summary>
    private (string Text, string Kind, string? Detail) RebootTag(InstallationEntity installation) => !installation.RebootRequired
        ? ("No restart", "ok", null)
        : _client?.LastBootAtUtc is { } boot && boot > installation.FinishedAtUtc ? ("Restarted", "ok", Format(boot)) : ("Restart pending", "queue", null);

    private static string Format(DateTime? value) => DisplayTime.Format(value);

    /// <summary>What the agent reports: WSUS, Microsoft Update (registered) or Windows Update.</summary>
    private string UpdateSourceText =>
        _client?.WsusServer is { } wsus ? $"WSUS {wsus}"
        : _client?.MicrosoftUpdateRegistered == true ? "Microsoft Update (Windows and other Microsoft products)"
        : _client?.MicrosoftUpdateRegistered == false ? "Windows Update"
        : "Windows Update (agents from 0.7.6 also report Microsoft Update)";

    private string RingName(int? id) => _rings.FirstOrDefault(r => r.Id == id)?.Name ?? "–";

    private string GroupName(int id) => _groups.FirstOrDefault(g => g.Id == id)?.Name ?? "?";

    private WindowPickerState? _windowDraft;

    /// <summary>What applies to software without windows of the server: its groups, the system default or the maintenance windows.</summary>
    private IReadOnlyList<SUSyphos.Contracts.Agents.MaintenanceWindow> SoftwareWindowsInherited =>
        _client is null ? [] : _client.SoftwareWindowsJson is null
            ? MaintenanceWindowFormat.FromJson(_client.EffectiveSoftwareWindowsJson) ?? _effectiveWindows
            : _effectiveWindows;

    private async Task SaveSoftwareWindowsAsync(string? windowsText)
    {
        var outcome = await Administration.SetSoftwareWindowsAsync(null, Id, windowsText, await GetActorAsync(), CancellationToken.None);
        ShowResult(outcome.Error, "The software windows were saved.");
        await LoadAsync();
    }
}
