@page "/servers/{Id:guid}"
@attribute [Authorize(Policy = AdminRoles.Policies.Read)]
@inherits DashboardPageBase
@using SUSyphos.Server.Assignment
@using SUSyphos.Server.Agents
@using SUSyphos.Server.Components.Shared
@inject ServerDbContext Db
@inject AssignmentAdministration Administration
@inject DeploymentStatus Deployment
@inject SUSyphos.Server.Agents.AgentActionService Actions
@inject SUSyphos.Server.Approval.ClientLifecycle Lifecycle
@inject TimeProvider Time
@inject SUSyphos.Server.Agents.GlobalPause Pause
@inject SUSyphos.Server.AgentPackages.AgentUpdateService AgentUpdates
@inject SUSyphos.Server.Lifecycle.SupportLifecycle Support
@inject SUSyphos.Server.Security.SecurityBaseline Baseline

<PageTitle>@(_client?.HostName ?? "Server")</PageTitle>

@if (_client is null)
{
    <PageHeader Title="Server not found" Crumbs="@([("Servers", "/servers"), ("Not found", null)])" />
    <Box><p>The server does not exist or was deleted with its history. <a href="/servers">Back to the server list</a></p></Box>
}
else
{
    <PageHeader Title="@_client.HostName" Icon="@PageIcons.Servers" Subtitle="@Subtitle" Help="server-detail" Crumbs="@([("Servers", "/servers"), (_client.HostName, null)])" />
    <StatusMessage Text="@Message" IsError="@MessageIsError" />

    <form id="actions" method="post" @formname="action" @onsubmit="HandleActionAsync" class="detached"><AntiforgeryToken /></form>
    <form id="cancel-restart" method="post" @formname="cancel-restart" @onsubmit="CancelRestartAsync" class="detached"><AntiforgeryToken /></form>
    @if (RestartQueuedText is { } restartText)
    {
        <Banner Label="@(_client.RestartAnnouncedAtUtc is null ? "Restart queued" : "Restart announced")" Severity="fail" Help="server-detail#restart-queued">
            <ChildContent>@restartText</ChildContent>
            <Action>
                <AuthorizeView Policy="@AdminRoles.Policies.Administer" Context="cancelRestart">
                    <button type="submit" form="cancel-restart" class="danger">Cancel restart</button>
                </AuthorizeView>
            </Action>
        </Banner>
    }

    <ActionBand>
        @if (_canOperate)
        {
            <ActionMenu Label="Updates" Icon="scan-search" Kind="primary">
                <MenuItem Form="actions" Name="RemoteAction" Value="queue:SearchNow" Icon="search">Search for updates</MenuItem>
                <MenuItem Form="actions" Name="RemoteAction" Value="queue:FullResync" Icon="refresh-cw" Reason="Collect the inventory and the Windows Update history again and search">Sync inventory and history</MenuItem>
                <MenuSeparator />
                <MenuItem Href="@DialogLink("install")" Icon="download" Disabled="@(!_canAdminister || ReleasedPending.Count == 0)" Reason="@(!_canAdminister ? AdministratorsOnly : ReleasedPending.Count == 0 ? "No released update is missing on this server" : null)">Install updates now…</MenuItem>
                <MenuItem Href="@DialogLink("uninstall")" Icon="undo-2" Disabled="@(!_canAdminister)" Reason="@(_canAdminister ? null : AdministratorsOnly)">Uninstall update…</MenuItem>
            </ActionMenu>
            <ActionMenu Label="Server" Icon="server">
                <MenuItem Href="@DialogLink("restart")" Icon="power" Disabled="@(!_canAdminister)" Reason="@(_canAdminister ? null : AdministratorsOnly)">Restart server…</MenuItem>
                <MenuSeparator />
                <MenuItem Form="actions" Name="RemoteAction" Value="queue:RestartService" Icon="rotate-cw">Restart agent service</MenuItem>
                <MenuItem Form="actions" Name="RemoteAction" Value="queue:UploadLogs" Icon="file-down">Request logs</MenuItem>
            </ActionMenu>
        }
        <a class="btn" href="@AddressWithoutMessage" title="Load the page again with the latest state"><Icon Name="refresh-cw" Size="16" />Refresh</a>
        @if (_canOperate)
        {
            <div class="spacer"></div>
            <ActionMenu Label="Remove" Icon="trash-2" Kind="danger" Align="right">
                <MenuItem Href="@DialogLink("remove")" Icon="ban" Danger="true" Disabled="@(!_canAdminister)" Reason="@(_canAdminister ? "Remove the server; it can register again" : AdministratorsOnly)">Remove server…</MenuItem>
                <MenuItem Href="@DialogLink("purge")" Icon="trash-2" Danger="true" Disabled="@(!_canAdminister)" Reason="@(_canAdminister ? "Delete the server with its whole history" : AdministratorsOnly)">Delete with history…</MenuItem>
            </ActionMenu>
        }
    </ActionBand>

    <section class="tiles" aria-label="Status">
        <Tile Title="Status" Href="@ServerPage.Link(Id, "checks")" Edge="@ServerHealth.Edge(_health)" Footer="@($"agent {DisplayNumber.Version(AgentVersion.ShortForm(_client.AgentVersion))}")">
            <TileValue><StatusTag Text="@ServerHealth.Label(_health)" Kind="@ServerHealth.PillClass(_health)" /></TileValue>
        </Tile>
        <Tile Title="Updates" Href="@ServerPage.Link(Id, "missing")" Edge="@(_open.Any(o => o.Entry.State == DeploymentState.Failed) ? "fail" : null)" Footer="released for this server and not installed yet, and all it misses">
            <TileValue Value="@DisplayNumber.Format(ReleasedPending.Count)" Caption="released" />
            <TileValue Value="@DisplayNumber.Format(_open.Count)" Caption="missing" />
        </Tile>
        <Tile Title="Next maintenance window" Href="@ServerPage.Link(Id, "tasks")" Footer="@NextWindowFooter">
            @if (_window is { } window && window.Start <= _now)
            {
                <TileValue Caption="@($"until {DisplayTime.ToLocal(window.End):HH:mm}")"><StatusTag Text="Open" Kind="ok" /></TileValue>
            }
            else if (_window is { } next)
            {
                <TileValue Value="@DisplayTime.ToLocal(next.Start).ToString("HH:mm", System.Globalization.CultureInfo.InvariantCulture)" Caption="@DisplayTime.ToLocal(next.Start).ToString("ddd yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)" />
            }
            else
            {
                <TileValue Value="–" Caption="@NextWindowText" />
            }
        </Tile>
        <Tile Title="Last heartbeat" Edge="@(_health == ServerHealthState.Offline ? "fail" : null)" Footer="@($"last boot {Format(_client.LastBootAtUtc)}")">
            @if (_client.LastHeartbeatAtUtc is { } heartbeat)
            {
                <TileValue Value="@DisplayTime.ToLocal(heartbeat).ToString("HH:mm", System.Globalization.CultureInfo.InvariantCulture)" Caption="@DisplayTime.ToLocal(heartbeat).ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)" />
            }
            else
            {
                <TileValue Value="–" Caption="none yet" />
            }
        </Tile>
    </section>

    <TabBar Tabs="@TabItems" Current="@_tab" Link="@(tab => "/" + ServerPage.TabPath(Id, tab))" />

    @if (IsBusy && Dialog is null && _tab is ServerPage.Overview or ServerPage.Activity && HttpMethods.IsGet(HttpContext?.Request.Method ?? string.Empty))
    {
        @* Reload while the agent works or an action waits for it, only on the tabs with live state; not after a form post,
           so unsaved input is never lost. *@
        <LiveRefresh Seconds="LiveRefreshSeconds" Url="@AddressWithoutMessage" />
    }
    @if (_tab == ServerPage.Overview)
    {
    <Box Title="Tasks" Anchor="tasks" Help="server-detail#tasks" Hint="@(IsBusy ? $"the page updates every {LiveRefreshSeconds} seconds while the agent works or an action waits" : "what the agent does next, in order; heartbeats are not listed")" Flush="true">
        @if (_livePhase is { } livePhase)
        {
            <div class="box-body">
                <p class="live-line">
                    <span class="pill pend">Running</span>
                    <b>@LiveStatus.PhaseLabel(livePhase)</b>
                    @if (_client.ActivityPercent is { } percent)
                    {
                        <progress max="100" value="@percent" aria-label="Progress">@percent %</progress>
                        <span>@percent %</span>
                    }
                    <span class="note">since @Format(_client.ActivityStartedAtUtc)</span>
                </p>
                @if (_liveUpdates.Count > 0)
                {
                    <ul class="plain">
                        @foreach (var (updateId, revision, title) in _liveUpdates)
                        {
                            <li>@if (revision > 0) { <a href="/updates/@updateId/@revision">@title</a> } else { <span>@title</span> }</li>
                        }
                    </ul>
                }
            </div>
        }
        <div class="scroll">
            <table>
                <thead><tr><th>When</th><th>Task</th><th>Details</th></tr></thead>
                <tbody>
                    @if (_tasks.Count == 0)
                    {
                        <tr><td colspan="3" class="note">Nothing planned: no remote action waits, no update is due and no restart is pending.</td></tr>
                    }
                    @foreach (var task in _tasks)
                    {
                        <tr>
                            <td class="nowrap">@task.When</td>
                            <td class="nowrap"><span class="pill @task.Class">@task.Kind</span></td>
                            <td class="wrap">
                                @task.Detail
                                @if (task.Updates.Count > 0)
                                {
                                    <ul class="plain task-updates">
                                        @foreach (var (entry, title) in task.Updates)
                                        {
                                            <li><a href="/updates/@entry.UpdateId/@entry.Revision">@title</a>@if (entry.State == DeploymentState.Failed) { <span class="pill fail">tried again</span> }</li>
                                        }
                                    </ul>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </Box>

    <Box Title="Pre-flight checks" Anchor="checks" Help="server-detail#checks" Hint="@(_client.LastSearchAtUtc is { } searched ? $"{Format(searched)}" : null)" Flush="true">
        @if (_client.HealthChecks.Count == 0)
        {
            <div class="empty-state">No update run reported yet.</div>
        }
        else
        {
            <div class="scroll">
                <table>
                    <thead><tr><th>Check</th><th>Result</th><th>Details</th></tr></thead>
                    <tbody>
                        @foreach (var check in _client.HealthChecks.OrderByDescending(c => c.Status))
                        {
                            <tr>
                                <td class="nowrap">@CheckName(check.Name)</td>
                                <td><span class="pill @CheckClass(check.Status)">@((SUSyphos.Contracts.Agents.HealthStatus)check.Status)</span></td>
                                <td class="wrap">@check.Detail</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        @if (_client.LastSearchSucceeded == false)
        {
            <div class="box-body"><p class="error">Last update search failed: @string.Create(System.Globalization.CultureInfo.InvariantCulture, $"0x{_client.LastSearchHResult ?? 0:X8}") @SUSyphos.Server.Agents.HResultCatalog.Describe(_client.LastSearchHResult ?? 0)</p></div>
        }
    </Box>
    }
    else if (_tab == ServerPage.Updates)
    {
    <Box Title="Missing updates" Anchor="missing" Help="server-detail#missing" Flush="true">
        <ListTable Table="_openTable" Page="_openPage" Columns="OpenColumns" Search="Search update" Noun="updates" Empty="The last search reported no missing update.">
            <Row Context="row">
                <tr>
                    <td class="wrap"><a href="/updates/@row.Entry.UpdateId/@row.Entry.Revision">@row.Title</a> <KbLinks Kb="@UpdateText.KbIn(row.Title)" /></td>
                    <td><span class="pill @DeploymentText.PillClass(row.Entry.State)">@OpenStatus(row.Entry)</span></td>
                    <td class="nowrap">@Format(row.Entry.EarliestInstallAtUtc)</td>
                    <td>@(row.Entry.HResult is { } hresult ? string.Create(System.Globalization.CultureInfo.InvariantCulture, $"0x{hresult:X8}: {SUSyphos.Server.Agents.HResultCatalog.Describe(hresult)}") : null)</td>
                </tr>
            </Row>
        </ListTable>
    </Box>
    }
    else if (_tab == ServerPage.Security)
    {
    <Box Title="Security baseline" Anchor="security" Help="server-detail#security" Hint="the build of the server against the newest security build of its Windows version (MSRC)">
        <dl class="facts">
            <dt>State</dt><dd><StatusTag Text="@SUSyphos.Server.Security.SecuritySnapshot.Label(_serverSecurity.State)" Kind="@SUSyphos.Server.Security.SecuritySnapshot.Class(_serverSecurity.State)" />@if (_serverSecurity.State == SUSyphos.Server.Security.BaselineState.Unknown) { <span class="note">@(_securityHasData ? "Microsoft publishes no security builds for this Windows version" : "no security data from Microsoft (MSRC) yet")</span> }</dd>
            <dt>Build of the server</dt><dd class="mono">@OperatingSystems.Build(_client.OsVersion)</dd>
            <dt>Baseline</dt><dd>@if (_serverSecurity.Target is { } target) { <span class="mono">@target.Build.@target.Revision</span> <span>from @target.Month, released @Format(target.ReleasedAtUtc)</span> <KbLinks Kb="@target.Kb" /> } else { <span>–</span> }</dd>
            @if (_serverSecurity.Missing is { } missing)
            {
                <dt>Behind since</dt><dd>@Format(missing.ReleasedAtUtc) (@DisplayNumber.Format((int)(_now - missing.ReleasedAtUtc).TotalDays) days): the baseline of @missing.Month is missing; <KbLinks Kb="@missing.Kb" /> closes it</dd>
            }
            <dt>Support</dt><dd>@{ var supportInfo = Support.Of(_client, _serverSecurity); }<StatusTag Text="@supportInfo.Label" Kind="@SUSyphos.Server.Lifecycle.SupportLifecycle.Class(supportInfo.State)" /> <span>@SUSyphos.Server.Lifecycle.SupportLifecycle.Describe(supportInfo)</span></dd>
            <dt>Extended Security Updates</dt><dd>@EsuText</dd>
        </dl>
    </Box>

    <Box Title="Open vulnerabilities" Anchor="vulnerabilities" Help="server-detail#vulnerabilities" Hint="fixed in a later build than the server runs; exploited first" Flush="true">
        <ListTable Table="_cveTable" Page="_cvePage" Columns="VulnerabilityTable" Search="Search CVE or title" Noun="vulnerabilities" Empty="@(_serverSecurity.State == SUSyphos.Server.Security.BaselineState.Unknown ? "Unknown without security data for this Windows version." : "No vulnerability is open on this server.")">
            <Row Context="vulnerability">
                <tr><VulnerabilityCells Vulnerability="@vulnerability" /><td class="nowrap"><KbLinks Kb="@_securityFixes.GetValueOrDefault(vulnerability.Cve)" /></td></tr>
            </Row>
        </ListTable>
    </Box>
    }
    else if (_tab == ServerPage.History)
    {
    <Box Title="Installed by SUSyphos" Anchor="history" Help="server-detail#history" Hint="installations the agent ran, with result and restart" Flush="true">
        <ListTable Table="_historyTable" Page="_historyPage" Columns="HistoryColumns" Search="Search update" Noun="installations" Empty="No installation reported yet.">
            <Row Context="row">
                <tr>
                    <td class="nowrap">@Format(row.Installation.FinishedAtUtc)</td>
                    <td class="wrap"><a href="/updates/@row.Installation.UpdateId/@row.Installation.Revision">@row.Title</a> <KbLinks Kb="@UpdateText.KbIn(row.Title)" /></td>
                    <td><StatusTag Text="SUSyphos" Kind="ok" /></td>
                    <td class="wrap"><StatusTag Text="@UpdateHistoryText.ResultLabel((SUSyphos.Contracts.Agents.InstallResultCode)row.Installation.ResultCode, row.Installation.HResult)" Kind="@UpdateHistoryText.ResultClass((SUSyphos.Contracts.Agents.InstallResultCode)row.Installation.ResultCode, row.Installation.HResult)" Detail="@UpdateHistoryText.ResultDetail((SUSyphos.Contracts.Agents.InstallResultCode)row.Installation.ResultCode, row.Installation.HResult)" /></td>
                    <td>@{ var reboot = RebootTag(row.Installation); }<StatusTag Text="@reboot.Text" Kind="@reboot.Kind" Detail="@reboot.Detail" /></td>
                </tr>
            </Row>
        </ListTable>
    </Box>

    <Box Title="All installations on the server" Anchor="windows-history" Help="server-detail#windows-history" Hint="@($"Windows Update history of the last {SUSyphos.Contracts.Agents.UpdateHistoryEntry.HistoryDays} days, from any source: SUSyphos, Windows, Defender, administrators; updated with the inventory")" Flush="true">
        <ListTable Table="_windowsTable" Page="_windowsPage" Columns="WindowsColumns" Search="Search update" Noun="entries" Empty="Nothing reported yet; agents from version 0.7 send the history with their inventory.">
            <Row Context="entry">
                        <tr>
                            <td class="nowrap">@Format(entry.DateUtc)</td>
                            <td class="wrap">@entry.Title <KbLinks Kb="@UpdateText.KbIn(entry.Title)" /></td>
                            <td><StatusTag Text="@entry.Operation.ToString()" /></td>
                            <td class="wrap"><StatusTag Text="@UpdateHistoryText.ResultLabel(entry.ResultCode, entry.HResult)" Kind="@UpdateHistoryText.ResultClass(entry.ResultCode, entry.HResult)" Detail="@UpdateHistoryText.ResultDetail(entry.ResultCode, entry.HResult)" /></td>
                            <td>@{ var started = StartedBy(entry); }<StatusTag Text="@started.Text" Kind="@started.Kind" Detail="@started.Detail" /></td>
                        </tr>
            </Row>
        </ListTable>
    </Box>
    }
    else if (_tab == ServerPage.Configuration)
    {
    <AuthorizeView Policy="@AdminRoles.Policies.Administer" Context="assign">
        <Authorized>
            <form method="post" @formname="assignment" @onsubmit="SaveAsync" class="box" id="assignment">
                <AntiforgeryToken />
                <header class="box-head"><h2>Assignment<HelpLink To="server-detail#assignment" Label="Assignment" /></h2><span class="hint">Saved configuration of this server; empty values inherit</span></header>
                <div class="box-body form">
                    <div class="form-row">
                        <label class="field"><span>Ring</span>
                            <select name="Ring">
                                <option value="" selected="@(_client.ManualRingId is null)">Automatic: assignment rules, else @_fallbackRing (now @RingName(_client.RingId))</option>
                                @foreach (var ring in _rings)
                                {
                                    <option value="@ring.Id" selected="@(_client.ManualRingId == ring.Id)">@ring.Name</option>
                                }
                            </select>
                        </label>
                        <label class="field"><span>Reboots</span>
                            <select name="Reboot">
                                <option value="" selected="@(_client.RebootPolicy is null)">Inherit from groups or system (now @RebootPolicyText.Label(_client.EffectiveRebootPolicy))</option>
                                @foreach (var policy in Enum.GetValues<SUSyphos.Contracts.Agents.RebootPolicy>())
                                {
                                    <option value="@policy" selected="@(_client.RebootPolicy == policy)">@RebootPolicyText.Label(policy)</option>
                                }
                            </select>
                        </label>
                    </div>
                    <div class="form-row">
                        <label class="field"><span>Windows Automatic Updates</span>
                            <select name="AutomaticUpdates">
                                <option value="" selected="@(_client.ManageAutomaticUpdates is null)">Inherit from groups or system (now @(_client.EffectiveManageAutomaticUpdates ? "keep Windows from installing" : "leave unchanged"))</option>
                                <option value="leave" selected="@(_client.ManageAutomaticUpdates == false)">Leave unchanged, only warn</option>
                                <option value="prevent" selected="@(_client.ManageAutomaticUpdates == true)">Keep Windows from installing on its own</option>
                            </select>
                        </label>
                        <label class="field"><span>Other Microsoft products</span>
                            <select name="MicrosoftUpdate">
                                <option value="" selected="@(_client.UseMicrosoftUpdate is null)">Inherit from groups or system (now @(_client.EffectiveUseMicrosoftUpdate ? "Microsoft Update" : "Windows Update only"))</option>
                                <option value="windows" selected="@(_client.UseMicrosoftUpdate == false)">Windows Update only</option>
                                <option value="microsoft" selected="@(_client.UseMicrosoftUpdate == true)">Microsoft Update</option>
                            </select>
                        </label>
                    </div>
                    <div class="field">
                        <span class="field-label">Groups</span>
                        <MultiSelect Name="Groups" Placeholder="No group"
                                     Options="@([.. _groups.Take(MultiSelect.MaxOptions).Select(g => (g.Id.ToString(System.Globalization.CultureInfo.InvariantCulture), g.Name))])"
                                     Selected="@([.. _memberships.Where(m => m.Manual).Select(m => m.GroupId.ToString(System.Globalization.CultureInfo.InvariantCulture))])"
                                     Fixed="@([.. _memberships.Where(m => !m.Manual).Select(m => (m.GroupId.ToString(System.Globalization.CultureInfo.InvariantCulture), $"{GroupName(m.GroupId)} (rule)"))])">
                            <Empty><span class="note">No group exists yet. <a href="/administration/groups">Create groups</a></span></Empty>
                        </MultiSelect>
                        <span class="help">Groups from assignment rules are added automatically.</span>
                    </div>
                    <div class="field">
                        <span class="field-label">Maintenance windows</span>
                        <WindowPicker Prefix="Windows" Windows="@_ownWindows" Draft="@_windowDraft" InheritedWindows="@_effectiveWindows" AllowInherit="true" Inherited="@(_ownWindows.Count == 0)" InheritLabel="Inherit from groups or the system default" />
                    </div>
                    <AgentSettingOverrides Explained="@_agentSettings" Own="@_ownAgentSettings" Applied="@_appliedSettings" EditHref="@(key => SettingHref(key))" Help="server-detail#agent-settings" />
                </div>
                <footer class="box-foot">
                    <span class="note">Applies with the server's next heartbeat.</span>
                    <span class="actions"><a class="btn" href="@ServerPage.Link(Id, "assignment")">Discard changes</a><button type="submit" class="primary">Save assignment</button></span>
                </footer>
            </form>
        </Authorized>
        <NotAuthorized>
            <Box Title="Assignment" Help="server-detail#assignment">
                <dl class="facts">
                    <dt>Ring</dt><dd>@RingName(_client.RingId) @(_client.ManualRingId is null ? "(automatic)" : "(manual)")</dd>
                    <dt>Groups</dt><dd>@(_memberships.Count > 0 ? string.Join(", ", _memberships.Select(m => GroupName(m.GroupId))) : "–")</dd>
                    <dt>Maintenance windows</dt><dd>@(_effectiveWindows.Count > 0 ? WindowPickerForm.Describe(_effectiveWindows) : "none")</dd>
                    <dt>Reboots</dt><dd>@RebootPolicyText.Label(_client.EffectiveRebootPolicy)</dd>
                    <dt>Update source</dt><dd>@(_client.EffectiveUseMicrosoftUpdate ? "Microsoft Update" : "Windows Update only")</dd>
                </dl>
            </Box>
        </NotAuthorized>
    </AuthorizeView>
    }
    else if (_tab == ServerPage.System)
    {
    <Box Title="System" Help="server-detail#system" Anchor="system">
        <dl class="facts">
            <dt>Operating system</dt><dd>@OperatingSystems.Name(_client.OsProductName, _client.OsVersion, _client.OsEditionId)@(_client.OsEditionId is { Length: > 0 } edition ? $" ({edition})" : string.Empty)</dd>
            <dt>Build</dt><dd class="mono">@OperatingSystems.Build(_client.OsVersion)</dd>
            <dt>Support</dt><dd>@{ var support = Support.Of(_client); }@if (support.State == SUSyphos.Server.Lifecycle.SupportState.Unknown) { <span class="note">unknown for this Windows version</span> } else { <StatusTag Text="@SUSyphos.Server.Lifecycle.SupportLifecycle.Label(support.State)" Kind="@SUSyphos.Server.Lifecycle.SupportLifecycle.Class(support.State)" /> <span>@SUSyphos.Server.Lifecycle.SupportLifecycle.Describe(support)@(support.MainstreamEnd is { } mainstream ? $"; mainstream support {(support.DaysLeft - (support.End!.Value.DayNumber - mainstream.DayNumber) >= 0 ? "until" : "ended")} {mainstream:yyyy-MM-dd}" : null)</span> }</dd>
            <dt>Domain</dt><dd>@(_client.DomainName ?? "–")</dd>
            <dt>Roles</dt><dd>@(_client.Roles.Count > 0 ? string.Join(", ", _client.Roles) : "–")</dd>
            <dt>Update source</dt><dd>@UpdateSourceText@if (_client.MicrosoftUpdateRegistered is { } registered && registered != _client.EffectiveUseMicrosoftUpdate) { <span class="pill queue" title="The agent applies the setting with its next heartbeat and reports it with the next inventory">@(_client.EffectiveUseMicrosoftUpdate ? "set: Microsoft Update" : "set: Windows Update only")</span> }</dd>
            <dt>Agent update</dt><dd>@if (_client.AgentUpdateError is { } agentError) { <span class="pill fail">failed</span> <span>@agentError</span> } else { <a href="@Servers.Link("agent", AgentVersion.ShortForm(_client.AgentVersion))" title="@_client.AgentVersion: show all servers with this agent version" class="mono">@AgentVersion.ShortForm(_client.AgentVersion)</a> }@if (AgentUpdates.IsBelowMinimum(_client.AgentVersion)) { <span class="pill fail">below minimum @AgentUpdates.Minimum</span> }</dd>
            <dt>Agent settings</dt><dd>@{ var applied = AppliedSummary; }<StatusTag Text="@applied.Text" Kind="@applied.Kind" /> <a href="@ServerPage.Link(Id, "assignment")" data-help-term="Show agent settings">Show</a></dd>
            @if (_client.ServerMoveError is { } moveError)
            {
                <dt>Move</dt><dd><span class="pill fail">not moved</span> <span>@moveError</span> <a href="/administration/backup#move" title="The announced move to a new central server">Move to a new server</a></dd>
            }
            <dt>Automatic updates</dt><dd>@if (_client.AutoUpdateMode is null) { <span class="note">reported by agents from version 0.3</span> } else if (_client.AutomaticUpdatesBypass) { <span class="pill fail">problem</span> <span>Windows may install or restart on its own, outside rings and windows (<a href="@ServerPage.Link(Id, "checks")">details</a>); setting: @AutomaticUpdatesText.Describe(_client.AutoUpdateMode, _client.AutomaticUpdatesByPolicy, _client.AutomaticUpdatesManagedByAgent)</span> } else { <span class="pill ok">OK</span> <span>Windows does not install on its own; setting: @AutomaticUpdatesText.Describe(_client.AutoUpdateMode, _client.AutomaticUpdatesByPolicy, _client.AutomaticUpdatesManagedByAgent)</span> }</dd>
            <dt>Restart</dt><dd>@if (_client.RestartAnnouncedAtUtc is { } restartAt) { <span class="pill pend">restarting</span> <span>at @Format(restartAt), announced to Windows by the agent</span> } else if (!_client.RebootPending) { <span class="pill ok">not pending</span> } else if (_client.RebootWait is { } wait) { <span class="pill queue">pending</span> <span>@LiveStatus.RebootWaitText(wait) (policy: @RebootPolicyText.Label(_client.EffectiveRebootPolicy))</span> } else { <span class="pill queue">pending</span> <span>the agent reports why it waits from version 0.7 (policy: @RebootPolicyText.Label(_client.EffectiveRebootPolicy))</span> }</dd>
            <dt>Outside SUSyphos</dt><dd>@if (_externalInstalls > 0) { <span class="pill queue">@_externalInstalls</span> <span>installations in the last @SUSyphos.Contracts.Agents.UpdateHistoryEntry.HistoryDays days were started by Windows or an administrator, not by SUSyphos (<a href="@ServerPage.Link(Id, "windows-history")">history</a>)</span> } else { <span>none in the reported history</span> }</dd>
            <dt>Time zone</dt><dd>@(_client.TimeZoneId ?? "reported with the next inventory")</dd>
            <dt>Uptime</dt><dd>@UptimeText</dd>
            <dt>Last update search</dt><dd>@if (_client.LastSearchAtUtc is null) { <span>none reported yet</span> } else if (_client.LastSearchSucceeded == true) { <span class="pill ok">OK</span> <span>@Format(_client.LastSearchAtUtc)</span> } else { <span class="pill fail">failed</span> <span>@Format(_client.LastSearchAtUtc) (<a href="@ServerPage.Link(Id, "missing")">details</a>)</span> }</dd>
            <dt>Registered</dt><dd>@Format(_client.RegisteredAtUtc)</dd>
        </dl>
    </Box>
    }
    else if (_tab == ServerPage.Activity)
    {
    <Box Title="Recent activity" Anchor="activity" Help="server-detail#activity" Hint="@($"what the agent did and reported, newest first; kept for {ClientActivityLog.Retention.TotalDays:0} days, heartbeats are not listed")" Flush="true">
        <ListTable Table="_activityTable" Page="_activityPage" Columns="ActivityColumns" Search="Search activity or detail" Noun="entries" Empty="No activity recorded yet.">
            <Row Context="entry">
                <tr>
                    <td class="nowrap">@Format(entry.AtUtc)</td>
                    <td class="nowrap">@ClientActivityLog.Label(entry.Kind)</td>
                    <td class="wrap">@entry.Detail</td>
                </tr>
            </Row>
        </ListTable>
    </Box>

    <Box Title="Remote actions" Anchor="remote-actions" Help="server-detail#remote-actions" Hint="The agent picks actions up with its next heartbeat; the central server never connects to the agent." Flush="true">
        <ListTable Table="_actionTable" Page="_actionPage" Columns="ActionColumns" Search="Search action, user or detail" Noun="actions" Empty="No action requested yet." ExtraColumns="1">
            <ExtraHeader><th></th></ExtraHeader>
            <Row Context="action">
                        <tr>
                            <td class="nowrap">@Format(action.RequestedAtUtc)</td>
                            <td>@ActionLabel(action.Kind)</td>
                            <td>@action.RequestedBy</td>
                            <td><span class="pill @ActionClass(action.State)">@ActionStateLabel(action)</span></td>
                            <td>
                                @action.Detail
                                @if (action.LogFileSize is { } size && _canOperate)
                                {
                                    <a href="@AgentLogEndpoints.DownloadPath(action.Id)">Download (@(size / 1024) KB)</a>
                                }
                            </td>
                            <td class="n">
                                @if (action.State == AgentActionState.Queued && _canOperate)
                                {
                                    <span class="row-actions"><button type="submit" form="actions" name="RemoteAction" value="cancel:@action.Id">Cancel</button></span>
                                }
                            </td>
                        </tr>
            </Row>
        </ListTable>
    </Box>
    }

    @if (Dialog == "uninstall")
    {
        <Dialog Title="@($"Uninstall an update on {_client.HostName}?")" CloseHref="@Here" Help="server-detail#uninstall" Wide="true">
            <form method="post" @formname="uninstall" @onsubmit="UninstallAsync">
                <AntiforgeryToken />
                <div class="dialog-body">
                    @if (_installed.Count == 0)
                    {
                        <p>The inventory of this server lists no installed update that can be uninstalled (Defender signatures and its platform and the Malicious Software Removal Tool are not offered).</p>
                    }
                    else
                    {
                        <div class="scroll radio-list">
                            <table class="compact">
                                <thead><tr><th><span class="visually-hidden">Choose</span></th><th>Update</th><th>Installed</th></tr></thead>
                                <tbody>
                                    @foreach (var candidate in _installed)
                                    {
                                        <tr>
                                            <td><input type="radio" id="@($"uninstall-{candidate.UpdateId:N}")" name="UninstallUpdate" value="@candidate.UpdateId" required data-help-term="Update" /></td>
                                            <td class="wrap"><label for="@($"uninstall-{candidate.UpdateId:N}")">@candidate.Title</label>@if (candidate.Kb is not null) { <div class="note">KB@candidate.Kb</div> }@if (candidate.Uninstallable == false) { <div><span title="Windows Update cannot remove it; the agent tries DISM by the KB number, which some packages refuse"><StatusTag Text="only through DISM, may fail" Kind="queue" /></span></div> }</td>
                                            <td class="nowrap">@(candidate.InstalledAtUtc is { } at ? DisplayTime.FormatDate(at) : "–")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    <UninstallTiming />
                    <p class="note">Next maintenance window: @NextWindowText. The agent uninstalls through Windows Update, or with DISM by the KB number where Windows Update cannot; some packages cannot be removed, the remote action then reports why. To keep the update away from all servers, block it on its update page.</p>
                </div>
                <div class="dialog-foot"><a class="btn" href="@Here">Cancel</a><button type="submit" class="danger" disabled="@(_installed.Count == 0)">Uninstall update</button></div>
            </form>
        </Dialog>
    }
    else if (Dialog == "install")
    {
        var released = ReleasedPending;
        <Dialog Title="@($"Install the released updates on {_client.HostName} now?")" CloseHref="@Here" Help="server-detail#install-now">
            <form method="post" @formname="install" @onsubmit="InstallNowAsync">
                <AntiforgeryToken />
                <div class="dialog-body">
                    @if (released.Count == 0)
                    {
                        <p>No update is released for this server and still missing; there is nothing to install.</p>
                    }
                    else
                    {
                        <p>The agent installs @(released.Count == 1 ? "this update" : $"these {released.Count} updates") with its next heartbeat, also outside the maintenance window and before their planned time:</p>
                        <ul class="plain">
                            @foreach (var (entry, title) in released.Take(10))
                            {
                                <li>@title</li>
                            }
                        </ul>
                        @if (released.Count > 10)
                        {
                            <p class="help">and @(released.Count - 10) more.</p>
                        }
                    }
                    <p>Only updates released for the ring of the server are installed. If Windows then needs a restart, the server restarts <b>right after</b> (five minute warning) or in the <b>next maintenance window</b> (next window: @NextWindowText).</p>
                    <p class="note">A global pause holds the installation until it ends; in a coordinated group the agent waits for a free slot. A local veto (registry value AllowReboot) prevents the restart.</p>
                </div>
                <div class="dialog-foot"><a class="btn" href="@Here">Cancel</a><button type="submit" name="InstallRestart" value="window" disabled="@(released.Count == 0)">Install, restart in the next window</button><button type="submit" name="InstallRestart" value="now" class="danger" disabled="@(released.Count == 0)">Install and restart right after</button></div>
            </form>
        </Dialog>
    }
    else if (Dialog == "restart")
    {
        <Dialog Title="@($"Restart {_client.HostName}?")" CloseHref="@Here" Help="server-detail#restart">
            <form method="post" @formname="restart" @onsubmit="RestartAsync">
                <AntiforgeryToken />
                <div class="dialog-body">
                    <p><b>Now:</b> the agent restarts the server with its next heartbeat, also outside the maintenance window, after a five minute warning.</p>
                    <p><b>In the next maintenance window:</b> the agent restarts the server once a window is open for at least 30 more minutes (next window: @NextWindowText), also if its reboot policy is "Never"; in a coordinated group it waits for a free slot. It reports the planned time.</p>
                    <p class="note">A local veto on the server (registry value AllowReboot) applies to both. A queued restart can be cancelled until it happens.</p>
                </div>
                <div class="dialog-foot"><a class="btn" href="@Here">Cancel</a><button type="submit" name="When" value="window">Restart in the next maintenance window</button><button type="submit" name="When" value="now" class="danger">Restart now</button></div>
            </form>
        </Dialog>
    }
    else if (Dialog == "agent-setting" && SUSyphos.Contracts.Agents.AgentSettings.Find(SettingKey) is { } settingDefinition)
    {
        var inherited = SUSyphos.Server.Assignment.AgentSettingValues.Explain(_systemAgentSettings, _memberGroupSettings, new Dictionary<string, string>(), "this server").First(e => e.Definition.Key == settingDefinition.Key);
        <AgentSettingDialog Definition="settingDefinition" Scope="@($"server {_client.HostName}")" Own="@_ownAgentSettings.GetValueOrDefault(settingDefinition.Key)"
                            InheritedValue="@inherited.Value" InheritedSource="@inherited.Source" CancelHref="@(ServerPage.Link(Id, "assignment"))" Error="@_settingError" Help="server-detail#agent-settings" OnSave="SaveSettingAsync" />
    }
    else if (Dialog is "remove" or "purge")
    {
        <Dialog Title="@(Dialog == "purge" ? $"Delete {_client.HostName} with its history?" : $"Remove {_client.HostName}?")" CloseHref="@Here" Help="server-detail#remove">
            <form method="post" @formname="remove" @onsubmit="RemoveAsync">
                <AntiforgeryToken />
                <input type="hidden" name="ConfirmRemove" value="yes" />
                <div class="dialog-body">
                    @if (Dialog == "purge")
                    {
                        <p>The server and all its data (history, installations, actions) are deleted for good. This cannot be undone.</p>
                    }
                    else
                    {
                        <p>The history is kept, open releases, actions and leases are cancelled and the credentials end. If the agent still runs, it registers again as a new pending server.</p>
                    }
                </div>
                <div class="dialog-foot"><a class="btn" href="@Here">Cancel</a><button type="submit" name="Remove" value="@(Dialog == "purge" ? "hard" : "soft")" class="danger">@(Dialog == "purge" ? "Delete with history" : "Remove server")</button></div>
            </form>
        </Dialog>
    }
}

@* Resets one agent setting of this server; its buttons sit in the assignment form but belong to this form. *@
<form id="agent-setting-reset" method="post" @formname="agent-setting-reset" @onsubmit="ResetSettingAsync" class="detached">
    <AntiforgeryToken />
</form>

@code {
    [Parameter]
    public Guid Id { get; set; }

    [SupplyParameterFromForm(FormName = "assignment")]
    private string? Ring { get; set; }

    [SupplyParameterFromForm(FormName = "assignment")]
    private string[]? Groups { get; set; }

    [SupplyParameterFromForm(FormName = "assignment")]
    private string? Reboot { get; set; }

    /// <summary>Confirmation dialog the address asks for: restart, remove or purge.</summary>
    [SupplyParameterFromQuery(Name = "dialog")]
    private string? Dialog { get; set; }

    [CascadingParameter]
    private Microsoft.AspNetCore.Http.HttpContext? HttpContext { get; set; }

    private IReadOnlyList<SUSyphos.Contracts.Agents.MaintenanceWindow> _ownWindows = [];
    private Dictionary<string, string> _ownAgentSettings = [];
    private IReadOnlyList<(SUSyphos.Contracts.Agents.AgentSettingDefinition Definition, string Value, string Source)> _agentSettings = [];
    private Dictionary<string, string> _systemAgentSettings = [];
    private List<(string Name, IReadOnlyDictionary<string, string> Values)> _memberGroupSettings = [];
    private Dictionary<string, SUSyphos.Contracts.Agents.AppliedAgentSetting> _appliedSettings = [];
    private string? _settingError;

    [SupplyParameterFromQuery(Name = "key")]
    private string? SettingKey { get; set; }

    private string SettingHref(string key) => $"/servers/{Id}?tab={ServerPage.Configuration}&dialog=agent-setting&key={Uri.EscapeDataString(key)}";
    private IReadOnlyList<SUSyphos.Contracts.Agents.MaintenanceWindow> _effectiveWindows = [];
    private string _fallbackRing = "Production";

    private string DialogLink(string dialog) => $"/servers/{Id}?{(_tab == ServerPage.Overview ? string.Empty : $"tab={_tab}&")}dialog={dialog}";

    /// <summary>The current tab of this server, where dialogs return to.</summary>
    private string Here => "/" + ServerPage.TabPath(Id, _tab);

    [SupplyParameterFromQuery(Name = "tab")]
    private string? Tab { get; set; }

    private string _tab = ServerPage.Overview;
    private bool _canAdminister;
    private SUSyphos.Server.Security.ServerSecurity _serverSecurity = SUSyphos.Server.Security.ServerSecurity.Unknown;
    private Dictionary<string, string?> _securityFixes = [];
    private TableQuery _cveTable = default!;
    private TablePage<SUSyphos.Server.Data.SecurityVulnerabilityEntity> _cvePage = new([], 0, 0, 1, 1, new Dictionary<string, IReadOnlyList<FilterOption>>());
    private static readonly IReadOnlyList<TableColumn<SUSyphos.Server.Data.SecurityVulnerabilityEntity>> VulnerabilityTable =
        [.. SUSyphos.Server.Security.VulnerabilityColumns.Of<SUSyphos.Server.Data.SecurityVulnerabilityEntity>(v => v), new("kb", "Fixed by", v => v.Cve, Sortable: false)];
    private bool _securityHasData;

    /// <summary>What the agent found about Extended Security Updates.</summary>
    private string EsuText => _client is null || (_client.EsuKey is null && _client.AzureArc is null && _client.Azure is null)
        ? "reported by agents from version 0.7.10"
        : string.Join("; ", new[] { _client.EsuKey == true ? "ESU key licensed" : null, _client.AzureArc == true ? "Azure Arc agent running (no proof of ESU)" : null, _client.Azure == true ? "runs in Azure" : null }.Where(s => s is not null)) is { Length: > 0 } found ? found : "nothing found (no ESU key, no Azure Arc agent, not in Azure)";
    private DateTime _now;
    private const string AdministratorsOnly = "Only administrators can do this";

    /// <summary>The tabs with a badge where something waits: missing updates, a failed check, open remote actions.</summary>
    private IReadOnlyList<TabItem> TabItems => [.. ServerPage.Tabs.Select(t => t.Key switch
    {
        ServerPage.Overview when _client?.HealthChecks.Any(c => c.Status == (int)SUSyphos.Contracts.Agents.HealthStatus.Failed) == true => new TabItem(t.Key, t.Label, "!", "fail"),
        ServerPage.Updates when _open.Count > 0 => new TabItem(t.Key, t.Label, DisplayNumber.Format(_open.Count), _open.Any(o => o.Entry.State == DeploymentState.Failed) ? "fail" : "neutral"),
        ServerPage.Security when _serverSecurity.Open.Count > 0 => new TabItem(t.Key, t.Label, DisplayNumber.Format(_serverSecurity.Open.Count), _serverSecurity.Exploited > 0 ? "fail" : "queue"),
        ServerPage.System when _client is { } c && (c.AutomaticUpdatesBypass || c.AgentUpdateError is not null || c.ServerMoveError is not null) => new TabItem(t.Key, t.Label, "!", "queue"),
        ServerPage.Activity when _actions.Count(a => a.State is AgentActionState.Queued or AgentActionState.Delivered) is > 0 and var open => new TabItem(t.Key, t.Label, DisplayNumber.Format(open), "neutral"),
        _ => new TabItem(t.Key, t.Label),
    })];

    /// <summary>Below the next window: how many updates it installs.</summary>
    private string NextWindowFooter => _window is null ? "no installation planned" : _planned.Count == 0 ? "nothing to install" : $"{DisplayNumber.Format(_planned.Count)} {(_planned.Count == 1 ? "update" : "updates")} to install";

    private string Subtitle => _client is null
        ? string.Empty
        : $"{(_client.DomainName is { Length: > 0 } domain ? $"{_client.HostName.ToLowerInvariant()}.{domain}" : _client.HostName)} · {OperatingSystems.Name(_client.OsProductName, _client.OsVersion, _client.OsEditionId)}, build {OperatingSystems.Build(_client.OsVersion)} · ring {RingName(_client.RingId)}";

    [SupplyParameterFromForm(FormName = "restart")]
    private string? When { get; set; }

    [SupplyParameterFromForm(FormName = "assignment")]
    private string? AutomaticUpdates { get; set; }

    [SupplyParameterFromForm(FormName = "assignment")]
    private string? MicrosoftUpdate { get; set; }

    [SupplyParameterFromForm(FormName = "install")]
    private string? InstallRestart { get; set; }

    [SupplyParameterFromForm(FormName = "uninstall")]
    private string? UninstallWhen { get; set; }

    [SupplyParameterFromForm(FormName = "uninstall")]
    private Guid? UninstallUpdate { get; set; }

    /// <summary>Updates the inventory lists as installed, for the uninstall dialog.</summary>
    private List<UninstallCandidate> _installed = [];

    private async Task UninstallAsync()
    {
        var kind = SUSyphos.Server.Agents.AgentActionService.UninstallKind(UninstallWhen);
        var outcome = !await IsAuthorizedAsync(AdminRoles.Policies.Administer)
            ? new Outcome("Only administrators can uninstall updates.")
            : kind is null || UninstallUpdate is not { } updateId
                ? new Outcome("Choose the update and when the server uninstalls it.")
                : await Actions.QueueUninstallAsync(Id, updateId, kind.Value, await GetActorAsync(), CancellationToken.None);
        ShowResultAndReload(outcome.Error, kind == SUSyphos.Contracts.Agents.AgentActionKind.UninstallInWindow
            ? "The uninstallation was queued; the agent removes the update in the next maintenance window."
            : "The uninstallation was queued; the agent removes the update after its next heartbeat (in a coordinated group once it has the lease).");
        await LoadAsync();
    }

    /// <summary>Released for this server and not installed yet: what "Install updates now" installs.</summary>
    private List<(DeploymentEntry Entry, string Title)> ReleasedPending =>
        [.. _open.Where(o => o.Entry.EarliestInstallAtUtc is not null && o.Entry.State is DeploymentState.Pending or DeploymentState.Failed)];

    private async Task InstallNowAsync()
    {
        var kind = InstallRestart switch
        {
            "now" => SUSyphos.Contracts.Agents.AgentActionKind.InstallNow,
            "window" => SUSyphos.Contracts.Agents.AgentActionKind.InstallNowRestartInWindow,
            _ => (SUSyphos.Contracts.Agents.AgentActionKind?)null,
        };
        var outcome = !await IsAuthorizedAsync(AdminRoles.Policies.Administer)
            ? new Outcome("Only administrators can install updates outside the maintenance window.")
            : kind is null
                ? new Outcome("Choose when the server restarts.")
                : await Actions.QueueAsync(Id, kind.Value, await GetActorAsync(), CancellationToken.None);
        ShowResultAndReload(outcome.Error, kind == SUSyphos.Contracts.Agents.AgentActionKind.InstallNow
            ? "The installation was queued; the agent installs the released updates after its next heartbeat and restarts right after if needed."
            : "The installation was queued; the agent installs the released updates after its next heartbeat, and a needed restart waits for the next maintenance window.");
        Dialog = null;
        await LoadAsync();
    }

    private async Task RestartAsync()
    {
        var kind = When switch
        {
            "now" => SUSyphos.Contracts.Agents.AgentActionKind.RestartServer,
            "window" => SUSyphos.Contracts.Agents.AgentActionKind.RestartServerInWindow,
            _ => (SUSyphos.Contracts.Agents.AgentActionKind?)null,
        };
        var outcome = !await IsAuthorizedAsync(AdminRoles.Policies.Administer)
            ? new Outcome("Only administrators can restart a server.")
            : kind is null
                ? new Outcome("Choose when the server restarts.")
                : await Actions.QueueAsync(Id, kind.Value, await GetActorAsync(), CancellationToken.None);
        ShowResultAndReload(outcome.Error, kind == SUSyphos.Contracts.Agents.AgentActionKind.RestartServer
            ? "The restart was queued; the agent restarts the server after its next heartbeat and a five minute warning."
            : "The restart was queued for the next maintenance window; the agent reports the planned time with its next heartbeat.");
        Dialog = null;
        await LoadAsync();
    }

    /// <summary>Cancels a queued restart action, or asks the agent to drop a restart it holds or has announced.</summary>
    private async Task CancelRestartAsync()
    {
        Outcome outcome;
        string success;
        if (!await IsAuthorizedAsync(AdminRoles.Policies.Administer))
        {
            (outcome, success) = (new Outcome("Only administrators can cancel a restart."), string.Empty);
        }
        else if (await Db.AgentActions.AsNoTracking().Where(a => a.ClientId == Id && a.State == AgentActionState.Queued && RestartKinds.Contains(a.Kind)).Select(a => (Guid?)a.Id).FirstOrDefaultAsync() is { } queued)
        {
            (outcome, success) = (await Actions.CancelAsync(Id, queued, await GetActorAsync(), CancellationToken.None), "The restart was cancelled before the agent picked it up.");
        }
        else
        {
            (outcome, success) = (await Actions.QueueAsync(Id, SUSyphos.Contracts.Agents.AgentActionKind.CancelRestart, await GetActorAsync(), CancellationToken.None), "The cancellation was queued; the agent drops the restart with its next heartbeat.");
        }

        ShowResultAndReload(outcome.Error, success);
        await LoadAsync();
    }

    private static readonly SUSyphos.Contracts.Agents.AgentActionKind[] RestartKinds = [SUSyphos.Contracts.Agents.AgentActionKind.RestartServer, SUSyphos.Contracts.Agents.AgentActionKind.RestartServerInWindow];

    /// <summary>What is known about a queued restart: requested by whom, and when the agent will restart; null if none is queued.</summary>
    private string? RestartQueuedText
    {
        get
        {
            if (_client is null)
            {
                return null;
            }

            var cancelling = _actions.Any(a => a.Kind == SUSyphos.Contracts.Agents.AgentActionKind.CancelRestart && a.State is AgentActionState.Queued or AgentActionState.Delivered);
            var pending = _actions.FirstOrDefault(a => RestartKinds.Contains(a.Kind) && a.State is AgentActionState.Queued or AgentActionState.Delivered);
            if (cancelling)
            {
                return "Cancellation requested; the agent drops the restart with its next heartbeat.";
            }

            if (_client.RestartAnnouncedAtUtc is { } announced)
            {
                return $"The agent announced the restart to Windows: the server restarts at {Format(announced)}; signed-in users see the warning.";
            }

            if (pending is not null)
            {
                return pending.Kind == SUSyphos.Contracts.Agents.AgentActionKind.RestartServer
                    ? $"Requested by {pending.RequestedBy} at {Format(pending.RequestedAtUtc)}: restart now, after a five minute warning. Waiting for the agent to pick it up."
                    : $"Requested by {pending.RequestedBy} at {Format(pending.RequestedAtUtc)}: restart in the next maintenance window. Waiting for the agent to pick it up.";
            }

            if (_client.RestartRequested)
            {
                var requested = _actions.FirstOrDefault(a => a.Kind == SUSyphos.Contracts.Agents.AgentActionKind.RestartServerInWindow && a.State == AgentActionState.Succeeded);
                var by = requested is null ? string.Empty : $"Requested by {requested.RequestedBy} at {Format(requested.RequestedAtUtc)}. ";
                var when = _client.RebootWait == SUSyphos.Contracts.Agents.RebootWait.Restarting
                    ? "The agent is restarting the server now."
                    : _client.PlannedRestartAtUtc is { } planned ? $"The agent plans the restart for {Format(planned)}" + (_client.RebootWait is { } wait ? $"; {LiveStatus.RebootWaitText(wait)}." : ".") : "The agent has not reported a planned time (no maintenance window?).";
                return by + when;
            }

            return null;
        }
    }

    private static string ActionLabel(SUSyphos.Contracts.Agents.AgentActionKind kind) => kind switch
    {
        SUSyphos.Contracts.Agents.AgentActionKind.SearchNow => "Search for updates",
        SUSyphos.Contracts.Agents.AgentActionKind.FullResync => "Sync inventory",
        SUSyphos.Contracts.Agents.AgentActionKind.RestartService => "Restart agent service",
        SUSyphos.Contracts.Agents.AgentActionKind.RestartServer => "Restart server now",
        SUSyphos.Contracts.Agents.AgentActionKind.UploadLogs => "Request logs",
        SUSyphos.Contracts.Agents.AgentActionKind.RestartServerInWindow => "Restart server in maintenance window",
        SUSyphos.Contracts.Agents.AgentActionKind.CancelRestart => "Cancel restart",
        SUSyphos.Contracts.Agents.AgentActionKind.InstallNow => "Install now, restart right after",
        SUSyphos.Contracts.Agents.AgentActionKind.InstallNowRestartInWindow => "Install now, restart in maintenance window",
        SUSyphos.Contracts.Agents.AgentActionKind.Uninstall => "Uninstall, restart right after",
        SUSyphos.Contracts.Agents.AgentActionKind.UninstallRestartInWindow => "Uninstall, restart in maintenance window",
        SUSyphos.Contracts.Agents.AgentActionKind.UninstallInWindow => "Uninstall in maintenance window",
        _ => kind.ToString(),
    };

    private ClientEntity? _client;
    private List<RingEntity> _rings = [];
    private List<GroupEntity> _groups = [];
    private List<ClientGroupEntity> _memberships = [];

    protected override async Task OnInitializedAsync()
    {
        _canOperate = await IsAuthorizedAsync(AdminRoles.Policies.Operate);
