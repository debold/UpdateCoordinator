    /// <summary>Time since the last boot the agent reported, e.g. "3 days 4 h (since 2026-10-17 08:12)".</summary>
    private string UptimeText
    {
        get
        {
            if (_client?.LastBootAtUtc is not { } boot)
            {
                return "unknown";
            }

            var up = Time.GetUtcNow().UtcDateTime - boot;
            if (up < TimeSpan.Zero)
            {
                up = TimeSpan.Zero;
            }

            var text = up.TotalDays >= 1
                ? string.Create(System.Globalization.CultureInfo.InvariantCulture, $"{(int)up.TotalDays} {((int)up.TotalDays == 1 ? "day" : "days")} {up.Hours} h")
                : string.Create(System.Globalization.CultureInfo.InvariantCulture, $"{up.Hours} h {up.Minutes} min");
            return $"{text} (since {Format(boot)})";
        }
    }
