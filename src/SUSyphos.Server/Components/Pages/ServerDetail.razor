    {
        SUSyphos.Contracts.Agents.AgentActionKind.SearchNow => "Search for updates",
        SUSyphos.Contracts.Agents.AgentActionKind.FullResync => "Sync inventory",
        SUSyphos.Contracts.Agents.AgentActionKind.RestartService => "Restart agent service",
        SUSyphos.Contracts.Agents.AgentActionKind.RestartServer => "Restart server now",
        SUSyphos.Contracts.Agents.AgentActionKind.UploadLogs => "Request logs",
        SUSyphos.Contracts.Agents.AgentActionKind.RestartServerInWindow => "Restart server in maintenance window",
        SUSyphos.Contracts.Agents.AgentActionKind.CancelRestart => "Cancel restart",
        _ => kind.ToString(),
    };

