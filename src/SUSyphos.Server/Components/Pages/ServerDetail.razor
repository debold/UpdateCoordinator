@page "/servers/{Id:guid}"
@attribute [Authorize(Policy = AdminRoles.Policies.Read)]
@inherits DashboardPageBase
@using SUSyphos.Server.Assignment
@using SUSyphos.Server.Agents
@using SUSyphos.Server.Components.Shared
@inject SUSyphos.Server.Software.SoftwareTrust Trust
@inject ServerDbContext Db
@inject AssignmentAdministration Administration
@inject DeploymentStatus Deployment
@inject SUSyphos.Server.Agents.AgentActionService Actions
@inject SUSyphos.Server.Rollouts.ServerUpdateSelection Selection
@inject SUSyphos.Server.Approval.ServerRemoval Removal
@inject TimeProvider Time
@inject SUSyphos.Server.Agents.GlobalPause Pause
@inject SUSyphos.Server.AgentPackages.AgentUpdateService AgentUpdates
@inject SUSyphos.Server.Lifecycle.SupportLifecycle Support
@inject SUSyphos.Server.Security.SecurityBaseline Baseline
@inject SUSyphos.Server.Assignment.SchedulePreview Preview
@inject SUSyphos.Server.Administration.DebugMode Debug
@inject SUSyphos.Server.Software.SoftwareAssignments Assignments

<PageTitle>@(_client?.HostName ?? "Server")</PageTitle>

@if (_client is null)
{
    <PageHeader Title="Server not found" Crumbs="@([("Servers", "/servers"), ("Not found", null)])" />
    <Box><p>The server does not exist or was deleted with its history. <a href="/servers">Back to the server list</a></p></Box>
}
else
{
    <PageHeader Title="@_client.HostName" Icon="@PageIcons.Servers" Subtitle="@Subtitle" Help="server-detail" Crumbs="@([("Servers", "/servers"), (_client.HostName, null)])">
        <Below>@if (_memberships.Count > 0) { <span>groups </span>@for (var g = 0; g < _memberships.Count; g++) { var groupId = _memberships[g].GroupId; if (g > 0) { <span>, </span> } <a href="@GroupPage.Link(groupId)">@GroupName(groupId)</a>@if (_groups.FirstOrDefault(x => x.Id == groupId) is { Coordinated: true } coordinated) { <span class="note"> (coordinated@(coordinated.LeasesHalted ? ", stopped" : null))</span> } } }</Below>
    </PageHeader>
    <StatusMessage Text="@Message" IsError="@MessageIsError" />
    @foreach (var stopped in StoppedGroups)
    {
        <p class="warning" role="alert">The coordinated group <a href="@GroupPage.Link(stopped.Id)">@stopped.Name</a> is stopped after failed leases: this server installs no Windows update until the group is resumed (group page or Approvals).</p>
    }

    <form id="actions" method="post" @formname="action" @onsubmit="HandleActionAsync" class="detached"><AntiforgeryToken /></form>
    <form id="cancel-restart" method="post" @formname="cancel-restart" @onsubmit="CancelRestartAsync" class="detached"><AntiforgeryToken /></form>
    @if (_trust.FailingServers.Count > 0)
    {
        <SoftwareTrustBanner State="@_trust" />
    }
    @if (_pendingRemoval is { } removal)
    {
        <Banner Label="Removal requested" Severity="fail" Help="server-detail#remove">
            <ChildContent>@removal.Actor asked on @Format(removal.RequestedAtUtc) to remove the server@(removal.KeepHistory ? " (history kept)" : " with its history"). It waits for the agent to uninstall itself and is removed once the agent confirms, or when the agent does not answer in time.</ChildContent>
            <Action>
                <AuthorizeView Policy="@AdminRoles.Policies.Administer" Context="cancelRemoval">
                    <button type="submit" form="actions" name="RemoteAction" value="@($"cancel:{removal.ActionId}")" class="danger">Cancel removal</button>
                </AuthorizeView>
            </Action>
        </Banner>
    }
    @if (_debug is { } debug)
    {
        <Banner Label="Debug mode" Severity="queue" Help="server-detail#debug">
            <ChildContent>On until @Format(debug.UntilUtc) (@DebugLeft(debug.UntilUtc) left), switched on by @debug.By: the agent logs at Debug, WinGet writes its verbose log, and a log collection adds the Windows Update, CBS and DISM logs.</ChildContent>
            <Action>
                <AuthorizeView Policy="@AdminRoles.Policies.Administer" Context="debugActions">
                    <a class="btn" href="@DialogLink("debug")">Extend…</a>
                    <button type="submit" form="debug-off">Turn off</button>
                </AuthorizeView>
            </Action>
        </Banner>
        <form id="debug-off" method="post" @formname="debug-off" @onsubmit="DebugOffAsync" class="detached"><AntiforgeryToken /></form>
    }
    @if (RestartQueuedText is { } restartText)
    {
        <Banner Label="@(_client.RestartAnnouncedAtUtc is null ? "Restart queued" : "Restart announced")" Severity="fail" Help="server-detail#restart-queued">
            <ChildContent>@restartText</ChildContent>
            <Action>
                <AuthorizeView Policy="@AdminRoles.Policies.Administer" Context="cancelRestart">
                    <button type="submit" form="cancel-restart" class="danger">Cancel restart</button>
                </AuthorizeView>
            </Action>
        </Banner>
    }
    else if (_client is { RebootPending: true } && RestartPendingText is { } pendingText)
    {
        @* As present as "Restart announced", in amber (Marc, 2026-11-22): why, when, and the restart now. *@
        <Banner Label="Restart pending" Severity="queue" Help="server-detail#restart-pending">
            <ChildContent>@pendingText</ChildContent>
            <Action>
                <AuthorizeView Policy="@AdminRoles.Policies.Administer" Context="restartPending">
                    <a class="btn" href="@DialogLink("restart")" data-help-term="Restart now">Restart now…</a>
                </AuthorizeView>
            </Action>
        </Banner>
    }

    <ActionBand>
        @if (_canOperate)
        {
            <ActionMenu Label="Updates" Icon="scan-search" Kind="primary">
                <MenuItem Form="actions" Name="RemoteAction" Value="queue:SearchNow" Icon="search">Search for updates</MenuItem>
                <MenuItem Form="actions" Name="RemoteAction" Value="queue:FullResync" Icon="refresh-cw" Reason="Collect the inventory and the Windows Update history again and search">Sync inventory and history</MenuItem>
                <MenuSeparator />
                <MenuItem Href="@DialogLink("install")" Icon="download" Disabled="@(!_canAdminister || ReleasedPending.Count == 0)" Reason="@(!_canAdminister ? AdministratorsOnly : ReleasedPending.Count == 0 ? "No released update is missing on this server" : "Install every released update now; to choose updates, select them on the Updates tab")">Install all released now…</MenuItem>
            </ActionMenu>
            <ActionMenu Label="Server" Icon="server">
                <MenuItem Href="@DialogLink("restart")" Icon="power" Disabled="@(!_canAdminister)" Reason="@(_canAdminister ? null : AdministratorsOnly)">Restart server…</MenuItem>
                <MenuSeparator />
                <MenuItem Form="actions" Name="RemoteAction" Value="queue:RestartService" Icon="rotate-cw">Restart agent service</MenuItem>
                <MenuItem Form="actions" Name="RemoteAction" Value="queue:UploadLogs" Icon="file-down">Request logs</MenuItem>
                <MenuItem Href="@DialogLink("debug")" Icon="scroll-text" Disabled="@(!_canAdminister)" Reason="@(_canAdminister ? "More detailed logs from this server for a while" : AdministratorsOnly)">Debug mode…</MenuItem>
            </ActionMenu>
        }
        <a class="btn" href="@AddressWithoutMessage" title="Load the page again with the latest state"><Icon Name="refresh-cw" Size="16" />Refresh</a>
        @if (_canOperate && LatestLogs is { } logs)
        {
            @* Marc, 2026-11-22: the button tells new logs (blue) from logs you downloaded already (green with a check);
               the times are in the tooltip, a dot shows that newer logs are requested. *@
            var downloaded = _logsDownloadedAt is not null;
            var newer = _actions.FirstOrDefault(a => a.Kind == SUSyphos.Contracts.Agents.AgentActionKind.UploadLogs && a.State is AgentActionState.Queued or AgentActionState.Delivered && a.RequestedAtUtc > (logs.CompletedAtUtc ?? DateTime.MinValue));
            var tooltip = $"Logs the agent uploaded on {Format(logs.CompletedAtUtc)}" + (_logsDownloadedAt is { } at ? $"; you downloaded them on {Format(at)}" : "; not downloaded by you yet") + (newer is null ? string.Empty : $"; new logs requested {Format(newer.RequestedAtUtc)}");
            <a class="btn @(downloaded ? "done" : "primary")" href="@AgentLogEndpoints.DownloadPath(logs.Id)" title="@tooltip" data-help-term="Download logs"><Icon Name="@(downloaded ? "check" : "download")" Size="16" /><span>Download logs</span>@if (newer is not null) { <span class="pend-dot" aria-label="New logs requested"></span> }</a>
        }
        @if (_canOperate)
        {
            <div class="spacer"></div>
            <ActionMenu Label="Remove" Icon="trash-2" Kind="danger" Align="right">
                <MenuItem Href="@DialogLink("remove")" Icon="trash-2" Danger="true" Disabled="@(!_canAdminister || _pendingRemoval is not null)" Reason="@(!_canAdminister ? AdministratorsOnly : _pendingRemoval is not null ? "The removal waits for the agent to uninstall itself" : "Remove the server from SUSyphos, with or without its history, and uninstall its agent")">Remove server…</MenuItem>
            </ActionMenu>
        }
    </ActionBand>

    <section class="tiles" aria-label="Status">
        <Tile Title="Status" Href="@ServerPage.Link(Id, "checks")" Edge="@ServerHealth.Edge(_health)" Footer="@($"agent {DisplayNumber.Version(AgentVersion.ShortForm(_client.AgentVersion))}")">
            <TileValue><StatusTag Text="@ServerHealth.Label(_health)" Kind="@ServerHealth.PillClass(_health)" /></TileValue>
        </Tile>
        <Tile Title="Updates" Href="@ServerPage.Link(Id, "missing")" Edge="@(_open.Any(o => o.Entry.State == DeploymentState.Failed) ? "fail" : null)" Footer="released for this server and not installed yet, and all it misses">
            <TileValue Value="@DisplayNumber.Format(ReleasedPending.Count)" Caption="released" />
            <TileValue Value="@DisplayNumber.Format(_open.Count)" Caption="missing" />
        </Tile>
        <Tile Title="Next maintenance window" Href="@ServerPage.Link(Id, "tasks")" Footer="@NextWindowFooter">
            @if (_window is { } window && window.Start <= _now)
            {
                <TileValue Caption="@($"until {DisplayTime.ToLocal(window.End):HH:mm}")"><StatusTag Text="Open" Kind="ok" /></TileValue>
            }
            else if (_window is { } next)
            {
                <TileValue Value="@DisplayTime.ToLocal(next.Start).ToString("HH:mm", System.Globalization.CultureInfo.InvariantCulture)" Caption="@DisplayTime.ToLocal(next.Start).ToString("ddd yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)" />
            }
            else
            {
                <TileValue Value="–" Caption="@NextWindowText" />
            }
        </Tile>
        <Tile Title="Last heartbeat" Edge="@(_health == ServerHealthState.Offline ? "fail" : null)" Footer="@($"last boot {Format(_client.LastBootAtUtc)}")">
            @if (_client.LastHeartbeatAtUtc is { } heartbeat)
            {
                <TileValue Value="@DisplayTime.ToLocal(heartbeat).ToString("HH:mm", System.Globalization.CultureInfo.InvariantCulture)" Caption="@DisplayTime.ToLocal(heartbeat).ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)" />
            }
            else
            {
                <TileValue Value="–" Caption="none yet" />
            }
        </Tile>
    </section>

    <TabBar Tabs="@TabItems" Current="@_tab" Link="@(tab => "/" + ServerPage.TabPath(Id, tab))">

    @if (IsBusy && Dialog is null && _tab is ServerPage.Overview or ServerPage.Activity or ServerPage.History && HttpMethods.IsGet(HttpContext?.Request.Method ?? string.Empty))
    {
        @* Reload while the agent works or an action waits for it, only on the tabs with live state; not after a form post,
           so unsaved input is never lost. *@
        <LiveRefresh Seconds="LiveRefreshSeconds" Url="@AddressWithoutMessage" />
    }
    @if (_tab == ServerPage.Overview)
    {
    <Box Title="Tasks" Anchor="tasks" Help="server-detail#tasks" Hint="@(IsBusy ? $"the page updates every {LiveRefreshSeconds} seconds while the agent works or an action waits" : "what the agent does next, in order; heartbeats are not listed")" Flush="true">
        @if (_livePhase is { } livePhase)
        {
            <div class="box-body">
                <p class="live-line">
                    <span class="pill pend">Running</span>
                    <b>@LiveStatus.PhaseLabel(livePhase)</b>
                    @if (_client.ActivityPercent is { } percent)
                    {
                        <progress max="100" value="@percent" aria-label="Progress">@percent %</progress>
                        <span>@percent %</span>
                    }
                    <span class="note">since @Format(_client.ActivityStartedAtUtc)</span>
                </p>
                @if (_liveUpdates.Count > 0)
                {
                    <ul class="plain">
                        @foreach (var (updateId, revision, title) in _liveUpdates)
                        {
                            <li>@if (revision > 0) { <a href="/updates/@updateId/@revision">@title</a> } else { <span>@title</span> }</li>
                        }
                    </ul>
                }
            </div>
        }
        <div class="scroll">
            <table>
                <thead><tr><th>When</th><th>Task</th><th>Details</th></tr></thead>
                <tbody>
                    @if (_tasks.Count == 0)
                    {
                        <tr><td colspan="3" class="note">Nothing planned: no remote action waits, no update is due and no restart is pending.</td></tr>
                    }
                    @foreach (var task in _tasks)
                    {
                        <tr>
                            <td class="nowrap">@task.When</td>
                            <td class="nowrap"><span class="pill @task.Class">@task.Kind</span></td>
                            <td class="wrap">
                                @task.Detail
                                @if (task.Updates.Count > 0)
                                {
                                    <ul class="plain task-updates">
                                        @foreach (var (entry, title) in task.Updates)
                                        {
                                            <li><a href="/updates/@entry.UpdateId/@entry.Revision">@title</a>@if (entry.State == DeploymentState.Failed) { <span class="pill fail">tried again</span> }</li>
                                        }
                                    </ul>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </Box>

    <Box Title="Pre-flight checks" Anchor="checks" Help="server-detail#checks" Hint="@(_client.LastSearchAtUtc is { } searched ? $"{Format(searched)}" : null)" Flush="true">
        @if (_client.HealthChecks.Count == 0)
        {
            <div class="empty-state">No update run reported yet.</div>
        }
        else
        {
            <div class="scroll">
                <table>
                    <thead><tr><th>Check</th><th>Result</th><th>Details</th></tr></thead>
                    <tbody>
                        @foreach (var check in _client.HealthChecks.OrderByDescending(c => c.Status))
                        {
                            <tr>
                                <td class="nowrap">@CheckName(check.Name)</td>
                                <td><span class="pill @CheckClass(check.Status)">@CheckLabel(check.Status)</span></td>
                                <td class="wrap">@check.Detail@if (check.Name == AutomaticUpdatesCheck && check.Status != (int)SUSyphos.Contracts.Agents.HealthStatus.Ok) { <AutomaticUpdatesFix Bypass="@_client.AutomaticUpdatesBypass" ByPolicy="@_client.AutomaticUpdatesByPolicy" UpdateForBusiness="@(check.Detail?.Contains(AutomaticUpdatesFix.UpdateForBusinessMarker, StringComparison.Ordinal) == true)" /> }</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        @if (_client.LastSearchSucceeded == false)
        {
            <div class="box-body"><p class="error">Last update search failed: @string.Create(System.Globalization.CultureInfo.InvariantCulture, $"0x{_client.LastSearchHResult ?? 0:X8}") @SUSyphos.Server.Agents.HResultCatalog.Describe(_client.LastSearchHResult ?? 0)</p></div>
        }
    </Box>
    }
    else if (_tab == ServerPage.Updates)
    {
    @* The selection of the lists (Marc, 2026-11-16): checkboxes and buttons belong to these forms by form="…", which open
       the confirmation of the action with the selection in the address (sel, isel); without script they work the same. *@
    <form id="missing-select" method="get" action="/servers/@Id" class="detached"><input type="hidden" name="tab" value="updates" /></form>
    <form id="installed-select" method="get" action="/servers/@Id" class="detached"><input type="hidden" name="tab" value="updates" /></form>
    <Box Title="Missing updates" Anchor="missing" Help="server-detail#missing" Flush="true">
        @if (_canOperate && _open.Count > 0)
        {
            <div class="selection-bar" data-selection="sel">
                <span class="note" data-selection-count>Select updates, then</span>
                <button type="submit" form="missing-select" name="dialog" value="install-selection" class="primary" disabled="@(!_canAdminister)" title="@(_canAdminister ? "Install the selected updates now, also outside the maintenance window" : AdministratorsOnly)" data-help-term="Install now"><Icon Name="download" Size="16" />Install now…</button>
                <button type="submit" form="missing-select" name="dialog" value="hold-selection" title="Hold the selected updates for this server" data-help-term="Hold"><Icon Name="pause" Size="16" />Hold…</button>
                <button type="submit" form="missing-select" name="dialog" value="end-hold-selection" title="End the holds of this server for the selected updates" data-help-term="End hold"><Icon Name="play" Size="16" />End hold…</button>
            </div>
        }
        <ListTable Table="_openTable" Page="_openPage" Columns="OpenColumns" Search="Search update" Noun="updates" Empty="The last search reported no missing update." ExtraColumns="@(_canOperate ? 1 : 0)">
            <Leading>@if (_canOperate) { <th class="select"><input type="checkbox" data-select-all="sel" data-help="tables#select" data-help-term="Select all" aria-label="Select all updates shown" hidden /></th> }</Leading>
            <Row Context="row">
                <tr>
                    @if (_canOperate)
                    {
                        <td><input type="checkbox" form="missing-select" name="sel" value="@row.Entry.UpdateId" aria-label="@($"Select {row.Title}")" data-help-term="Select" /></td>
                    }
                    <td class="wrap"><a href="/updates/@row.Entry.UpdateId/@row.Entry.Revision">@row.Title</a> <KbLinks Kb="@UpdateText.KbIn(row.Title)" />@if (_softwareIds.Contains(row.Entry.UpdateId)) { <text> </text><ClassificationTag Text="@SUSyphos.Server.Software.SoftwarePackages.Classification" /> }</td>
                    <td><span class="pill @DeploymentText.PillClass(row.Entry)">@OpenStatus(row.Entry)</span>@if (_missingRows.GetValueOrDefault(row.Entry.UpdateId)?.Hold is { } hold) { <div class="note">on hold for @hold.Target</div> }</td>
                    <td class="nowrap">@Format(row.Entry.EarliestInstallAtUtc)</td>
                    <td>@(row.Entry.HResult is { } hresult ? UpdateHistoryText.Failure(hresult, row.Entry.InstallerExitCode) : null)</td>
                </tr>
            </Row>
        </ListTable>
    </Box>

    <Box Title="Installed updates" Anchor="installed" Help="server-detail#installed" Flush="true" Hint="Updates the server can uninstall and programs WinGet knows">
        @if (_canAdminister && _installedRows.Count > 0)
        {
            <div class="selection-bar" data-selection="isel">
                <span class="note" data-selection-count>Select updates or programs, then</span>
                <button type="submit" form="installed-select" name="dialog" value="hold-selection" title="Hold the selected updates for this server, so they are not installed again" data-help-term="Hold"><Icon Name="pause" Size="16" />Hold…</button>
                <div class="spacer"></div>
                <button type="submit" form="installed-select" name="dialog" value="uninstall" class="danger" title="Uninstall the selected updates and programs from this server" data-help-term="Uninstall"><Icon Name="undo-2" Size="16" />Uninstall…</button>
            </div>
        }
        <ListTable Table="_installedTable" Page="_installedPage" Columns="InstalledColumns" Search="Search update or program" Noun="updates" Empty="The inventory lists no update this server can uninstall and no program WinGet knows." ExtraColumns="@(_canAdminister ? 1 : 0)">
            <Leading>@if (_canAdminister) { <th class="select"><input type="checkbox" data-select-all="isel" data-help="tables#select" data-help-term="Select all" aria-label="Select all updates shown" hidden /></th> }</Leading>
            <Row Context="row">
                <tr>
                    @if (_canAdminister)
                    {
                        <td><input type="checkbox" form="installed-select" name="isel" value="@row.Key" aria-label="@($"Select {row.Title}")" data-help-term="Select" /></td>
                    }
                    <td class="wrap">@if (row.UpdateId is { } updateId) { <a href="/updates/@updateId/@row.Revision">@row.Title</a> <KbLinks Kb="@UpdateText.KbIn(row.Title)" /> } else { <a href="@PackagePage.Link(row.PackageId!)">@row.Title</a> <text> </text><ClassificationTag Text="@SUSyphos.Server.Software.SoftwarePackages.Classification" /> }</td>
                    <td class="nowrap">@(row.InstalledAtUtc is { } at ? DisplayTime.FormatDate(at) : "–")</td>
                    <td>@if (row.UninstallBlocker is { } blocker) { <span class="note">@blocker</span> } else if (row.Uninstallable == false) { <span title="Windows Update cannot remove it; the agent tries DISM by the KB number, which some packages refuse"><StatusTag Text="only through DISM, may fail" Kind="queue" /></span> } else { <StatusTag Text="yes" Kind="ok" /> }@if (row.Hold is { } hold) { <div class="note">on hold for @hold.Target</div> }</td>
                </tr>
            </Row>
        </ListTable>
    </Box>
    }
    else if (_tab == ServerPage.Software)
    {
    <FeatureOff Off="@(!_softwareEnabled)" Title="Software management is switched off" Help="software#switch" Text="An administrator switched off software with WinGet on the Software page. The data stays, but nothing is updated or installed until it is switched on again.">
    <form id="software-select" method="get" action="/servers/@Id" class="detached"><input type="hidden" name="tab" value="software" /></form>
    @if (_assignedWaiting.Count > 0)
    {
        <Box Title="Assigned, not installed yet" Anchor="assigned" Help="server-detail#assigned" Flush="true" Hint="Packages assigned to this server, one of its groups or all servers; installed when the version is released for its ring">
            <div class="scroll">
                <table>
                    <thead><tr><th>Package</th><th>Version</th><th>Assigned to</th><th>State</th></tr></thead>
                    <tbody>
                        @foreach (var waiting in _assignedWaiting)
                        {
                            <tr>
                                <td class="wrap"><a href="@PackagePage.Link(waiting.PackageId)">@waiting.Name</a><div class="note mono">@waiting.PackageId</div></td>
                                <td class="nowrap">@(waiting.Version ?? "newest released")</td>
                                <td>@waiting.Via</td>
                                <td><span class="pill @(waiting.Reason is null ? "wait" : "neutral")" title="@waiting.Reason">@(waiting.Reason is null ? "Assigned, waiting" : "Not supported here")</span>@if (waiting.Reason is { } reason) { <div class="note">@reason</div> }</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </Box>
    }
    <Box Title="Installed software" Anchor="software" Help="server-detail#software" Flush="true" Hint="@SoftwareHint">
        @if (_canAdminister)
        {
            <div class="selection-bar" data-selection="isel">
                <a class="btn primary" href="@DialogLink("install-software")" title="Assign packages of the catalog to this server" data-help-term="Install software"><Icon Name="plus" Size="16" />Install software…</a>
                <span class="note" data-selection-count>Select programs, then</span>
                <div class="spacer"></div>
                <button type="submit" form="software-select" name="dialog" value="uninstall" class="danger" title="Uninstall the selected programs from this server with WinGet" data-help-term="Uninstall"><Icon Name="undo-2" Size="16" />Uninstall…</button>
            </div>
        }
        <ListTable Table="_softwareTable" Page="_softwarePage" Columns="SoftwareColumns" Search="Search program or package" Noun="programs" Empty="The agent has reported no installed programs yet (from version 0.9)." ExtraColumns="@(_canAdminister ? 1 : 0)">
            <Leading>@if (_canAdminister) { <th class="select"><input type="checkbox" data-select-all="isel" data-help="tables#select" data-help-term="Select all" aria-label="Select all programs shown" hidden /></th> }</Leading>
            <Row Context="row">
                <tr>
                    @if (_canAdminister)
                    {
                        var blocked = SoftwareUninstallBlocker(row);
                        <td>@if (row.Program.PackageId is { } selectable && blocked is null) { <input type="checkbox" form="software-select" name="isel" value="@($"p:{selectable}")" aria-label="@($"Select {row.Program.DisplayName}")" data-help-term="Select" /> } else { <input type="checkbox" disabled title="@(blocked ?? "Not known to WinGet")" aria-label="@($"{row.Program.DisplayName} cannot be selected")" /> }</td>
                    }
                    <td class="wrap">@row.Program.DisplayName@if (row.Program.Publisher is not null) { <div class="note">@row.Program.Publisher</div> }</td>
                    <td class="nowrap">@(row.Program.InstalledVersion ?? row.Program.DisplayVersion ?? "–")</td>
                    <td class="wrap">@if (row.Program.PackageId is { } packageId) { <a href="@PackagePage.Link(packageId)" class="mono">@packageId</a> } else { <span class="note">not known to WinGet</span> }</td>
                    <td class="nowrap">@(row.Newest ?? "–")</td>
                    <td><span class="pill @row.State.Class" title="@row.Reason">@row.State.Label</span>@if (row.Reason is { } why) { <div class="note">@why</div> }</td>
                </tr>
            </Row>
        </ListTable>
    </Box>
    </FeatureOff>
    }
    else if (_tab == ServerPage.Security)
    {
    <Box Title="Security baseline" Anchor="security" Help="server-detail#security" Hint="the build of the server against the newest security build of its Windows version (MSRC)" Flush="true">
        @if (BaselineSegments is { Count: > 0 } segments)
        {
            <div class="baseline-track" aria-label="Monthly security baselines">
                <div class="baseline-row">
                    @foreach (var segment in segments)
                    {
                        <div class="baseline-seg @(segment.Installed ? "have" : "miss") @(segment.ServerBuild ? "here" : null)"><span class="m">@segment.Baseline.Month</span><span class="b">@segment.Baseline.Build.@segment.Baseline.Revision</span><span class="s">@segment.State</span></div>
                    }
                </div>
                <div class="baseline-legend"><span>@BaselineSentence</span>@if (_serverSecurity.Missing is not null && _serverSecurity.Target is { } target) { <KbLinks Kb="@target.Kb" /> }</div>
            </div>
        }
        <StatusList Rows="@SecurityRows" />
        <FactGrid ShowLabel="true">
            <Fact Label="Server build" Mono="true">@OperatingSystems.Build(_client.OsVersion)</Fact>
            <Fact Label="Current baseline" Note="@(_serverSecurity.Target is { } current ? $"{current.Month}, released {Format(current.ReleasedAtUtc)}" : null)">@if (_serverSecurity.Target is { } baseline) { <span class="mono">@baseline.Build.@baseline.Revision</span> } else { <span>–</span> }</Fact>
            <Fact Label="Windows version">@OperatingSystems.Name(_client.OsProductName, _client.OsVersion, _client.OsEditionId)</Fact>
        </FactGrid>
    </Box>

    <Box Title="Open vulnerabilities" Anchor="vulnerabilities" Help="server-detail#vulnerabilities" Hint="fixed in a later build than the server runs; exploited first" Flush="true">
        <ListTable Table="_cveTable" Page="_cvePage" Columns="VulnerabilityTable" Search="Search CVE or title" Noun="vulnerabilities" Empty="@(_serverSecurity.State == SUSyphos.Server.Security.BaselineState.Unknown ? "Unknown without security data for this Windows version." : "No vulnerability is open on this server.")">
            <Row Context="vulnerability">
                <tr><VulnerabilityCells Vulnerability="@vulnerability" /><td class="nowrap"><KbLinks Kb="@_securityFixes.GetValueOrDefault(vulnerability.Cve)" /></td></tr>
            </Row>
        </ListTable>
    </Box>
    }
    else if (_tab == ServerPage.History)
    {
    <Box Title="Installed by SUSyphos" Anchor="history" Help="server-detail#history" Hint="installations the agent ran, with result and restart" Flush="true">
        <ListTable Table="_historyTable" Page="_historyPage" Columns="HistoryColumns" Search="Search update" Noun="installations" Empty="No installation reported yet.">
            <ExtraHeader><th class="n"><span class="visually-hidden">Actions</span></th></ExtraHeader>
            <Row Context="row">
                <tr>
                    <td class="nowrap">@Format(row.Installation.FinishedAtUtc)</td>
                    <td class="wrap">@if (row.PackageId is { } historyPackage) { <a href="@PackagePage.Link(historyPackage)">@row.Title</a> } else { <a href="/updates/@row.Installation.UpdateId/@row.Installation.Revision">@row.Title</a> <KbLinks Kb="@UpdateText.KbIn(row.Title)" /> }</td>
                    <td><ClassificationTag Text="@row.Category" /></td>
                    <td><OperationTag Text="@row.Operation" /></td>
                    <td><StatusTag Text="SUSyphos" Kind="ok" /></td>
                    <td class="wrap"><StatusTag Text="@UpdateHistoryText.ResultLabel((SUSyphos.Contracts.Agents.InstallResultCode)row.Installation.ResultCode, row.Installation.HResult)" Kind="@UpdateHistoryText.ResultClass((SUSyphos.Contracts.Agents.InstallResultCode)row.Installation.ResultCode, row.Installation.HResult)" Detail="@UpdateHistoryText.ResultDetail((SUSyphos.Contracts.Agents.InstallResultCode)row.Installation.ResultCode, row.Installation.HResult, row.Installation.InstallerExitCode)" />@foreach (var run in ScriptRunsOf(row)) { <div class="note"><a href="@ScriptText.RunLink(Id, run.Id)" data-help-term="Script output">@ScriptText.Phase(run.Phase) output</a></div> }</td>
                    <td>@{ var reboot = RebootTag(row.Installation); }<StatusTag Text="@reboot.Text" Kind="@reboot.Kind" Detail="@reboot.Detail" /></td>
                    <td class="n"><UninstallRowMenu Show="@(row.PackageId is null && IsUninstallable(row.Installation.UpdateId))" Allowed="@_canAdminister" Href="@UninstallLink(row.Installation.UpdateId)" Title="@row.Title" /></td>
                </tr>
            </Row>
        </ListTable>
    </Box>

    @if (_scriptRuns.Count > 0)
    {
    <Box Title="Script runs" Anchor="script-runs" Help="server-detail#script-runs" Hint="scripts of WinGet packages around installations and uninstallations, with their complete output" Flush="true">
        <div class="scroll">
            <table>
                <thead><tr><th>Finished</th><th>Package</th><th>Phase</th><th>Result</th><th class="n">Output</th></tr></thead>
                <tbody>
                    @foreach (var run in _scriptRuns)
                    {
                        var (runLabel, runKind) = ScriptText.Result(run.Result);
                        <tr>
                            <td class="nowrap">@Format(run.FinishedAtUtc)</td>
                            <td><a href="@PackagePage.Link(run.PackageId)" class="mono">@run.PackageId</a></td>
                            <td>@ScriptText.Phase(run.Phase) <span class="note">(@run.Action)</span></td>
                            <td><StatusTag Text="@runLabel" Kind="@runKind" Detail="@(run.Detail ?? (run.ExitCode is { } code ? $"exit code {code}" : null))" /></td>
                            <td class="n"><a href="@ScriptText.RunLink(Id, run.Id)" data-help-term="Show output">Show output</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </Box>
    }

    <Box Title="All installations on the server" Anchor="windows-history" Help="server-detail#windows-history" Hint="@($"Windows Update history of the last {SUSyphos.Contracts.Agents.UpdateHistoryEntry.HistoryDays} days, from any source: SUSyphos, Windows, Defender, administrators; updated with the inventory")" Flush="true">
        <ListTable Table="_windowsTable" Page="_windowsPage" Columns="WindowsColumns" Search="Search update" Noun="entries" Empty="Nothing reported yet; agents from version 0.7 send the history with their inventory.">
            <ExtraHeader><th class="n"><span class="visually-hidden">Actions</span></th></ExtraHeader>
            <Row Context="entry">
                        <tr>
                            <td class="nowrap">@Format(entry.DateUtc)</td>
                            <td class="wrap">@entry.Title <KbLinks Kb="@UpdateText.KbIn(entry.Title)" /></td>
                            <td><ClassificationTag Text="@Category(entry)" /></td>
                            <td><OperationTag Text="@entry.Operation.ToString()" /></td>
                            <td class="wrap"><StatusTag Text="@UpdateHistoryText.ResultLabel(entry.ResultCode, entry.HResult)" Kind="@UpdateHistoryText.ResultClass(entry.ResultCode, entry.HResult)" Detail="@UpdateHistoryText.ResultDetail(entry.ResultCode, entry.HResult)" /></td>
                            <td>@{ var started = StartedBy(entry); }<StatusTag Text="@started.Text" Kind="@started.Kind" Detail="@started.Detail" /></td>
                            <td class="n"><UninstallRowMenu Show="@(entry.Operation == SUSyphos.Contracts.Agents.UpdateOperation.Installation && IsUninstallable(entry.UpdateId))" Allowed="@_canAdminister" Href="@UninstallLink(entry.UpdateId)" Title="@entry.Title" /></td>
                        </tr>
            </Row>
        </ListTable>
    </Box>
    }
    else if (_tab == ServerPage.Configuration)
    {
    <AuthorizeView Policy="@AdminRoles.Policies.Administer" Context="assign">
        <Authorized>
            <form method="post" @formname="assignment" @onsubmit="SaveAsync" class="box" id="assignment">
                <AntiforgeryToken />
                <header class="box-head"><h2>Assignment<HelpLink To="server-detail#assignment" Label="Assignment" /></h2><span class="hint">Saved configuration of this server; empty values inherit</span></header>
                <div class="box-body form">
                    <div class="form-row">
                        <label class="field"><span>Ring</span>
                            <select name="Ring">
                                <option value="" selected="@(_client.ManualRingId is null)">Automatic: assignment rules, else @_fallbackRing (now @RingName(_client.RingId))</option>
                                @foreach (var ring in _rings)
                                {
                                    <option value="@ring.Id" selected="@(_client.ManualRingId == ring.Id)">@ring.Name</option>
                                }
                            </select>
                        </label>
                        <label class="field"><span>Reboots</span>
                            <select name="Reboot">
                                <option value="" selected="@(_client.RebootPolicy is null)">Inherit from groups or system (now @RebootPolicyText.Label(_client.EffectiveRebootPolicy))</option>
                                @foreach (var policy in Enum.GetValues<SUSyphos.Contracts.Agents.RebootPolicy>())
                                {
                                    <option value="@policy" selected="@(_client.RebootPolicy == policy)">@RebootPolicyText.Label(policy)</option>
                                }
                            </select>
                        </label>
                    </div>
                    <div class="form-row">
                        <label class="field"><span>Windows Automatic Updates</span>
                            <select name="AutomaticUpdates">
                                <option value="" selected="@(_client.ManageAutomaticUpdates is null)">Inherit from groups or system (now @(_client.EffectiveManageAutomaticUpdates ? "keep Windows from installing" : "leave unchanged"))</option>
                                <option value="leave" selected="@(_client.ManageAutomaticUpdates == false)">Leave unchanged, only warn</option>
                                <option value="prevent" selected="@(_client.ManageAutomaticUpdates == true)">Keep Windows from installing on its own</option>
                            </select>
                        </label>
                        <label class="field"><span>Other Microsoft products</span>
                            <select name="MicrosoftUpdate">
                                <option value="" selected="@(_client.UseMicrosoftUpdate is null)">Inherit from groups or system (now @(_client.EffectiveUseMicrosoftUpdate ? "Microsoft Update" : "Windows Update only"))</option>
                                <option value="windows" selected="@(_client.UseMicrosoftUpdate == false)">Windows Update only</option>
                                <option value="microsoft" selected="@(_client.UseMicrosoftUpdate == true)">Microsoft Update</option>
                            </select>
                        </label>
                    </div>
                    <div class="field">
                        <span class="field-label">Groups</span>
                        <MultiSelect Name="Groups" Placeholder="No group"
                                     Options="@([.. _groups.Take(MultiSelect.MaxOptions).Select(g => (g.Id.ToString(System.Globalization.CultureInfo.InvariantCulture), g.Name))])"
                                     Selected="@([.. _memberships.Where(m => m.Manual).Select(m => m.GroupId.ToString(System.Globalization.CultureInfo.InvariantCulture))])"
                                     Fixed="@([.. _memberships.Where(m => !m.Manual).Select(m => (m.GroupId.ToString(System.Globalization.CultureInfo.InvariantCulture), $"{GroupName(m.GroupId)} (rule)"))])">
                            <Empty><span class="note">No group exists yet. <a href="/administration/groups">Create groups</a></span></Empty>
                        </MultiSelect>
                        <span class="help">Groups from assignment rules are added automatically.</span>
                    </div>
                    <div class="field">
                        <span class="field-label">Maintenance windows</span>
                        <WindowPicker Prefix="Windows" Windows="@_ownWindows" Draft="@_windowDraft" InheritedWindows="@_effectiveWindows" AllowInherit="true" Inherited="@(_ownWindows.Count == 0)" InheritLabel="Inherit from groups or the system default" CompareWindows="@MaintenanceWindowFormat.FromJson(_client.EffectiveSoftwareWindowsJson)" CompareSoftware="true" />
                        <p class="note"><a href="@($"/servers/{Id}?tab=configuration&dialog=preview")" data-help-term="Next 30 days">Next @SUSyphos.Server.Assignment.SchedulePreview.Days days</a>: weekly and one-time windows and blackouts of this server together.</p>
                    </div>
                    <AgentSettingOverrides Explained="@_agentSettings" Own="@_ownAgentSettings" Applied="@_appliedSettings" EditHref="@(key => SettingHref(key))" Help="server-detail#agent-settings" />
                </div>
                <footer class="box-foot">
                    <span class="note">Applies with the server's next heartbeat.</span>
                    <span class="actions"><a class="btn" href="@ServerPage.Link(Id, "assignment")">Discard changes</a><button type="submit" class="primary">Save assignment</button></span>
                </footer>
            </form>
            <SoftwareWindowsBox Title="Software windows" Help="server-detail#software-windows" FormName="server-software-windows" Own="@MaintenanceWindowFormat.FromJson(_client.SoftwareWindowsJson)" Inherited="@SoftwareWindowsInherited" InheritLabel="Inherit from groups or the system default" Compare="@_effectiveWindows" OnSave="SaveSoftwareWindowsAsync" />
        </Authorized>
        <NotAuthorized>
            <Box Title="Assignment" Help="server-detail#assignment" Flush="true">
                <FactGrid>
                    <Fact Label="Ring" Note="@(_client.ManualRingId is null ? "automatic" : "manual")">@RingName(_client.RingId)</Fact>
                    <Fact Label="Groups">@if (_memberships.Count > 0) { @foreach (var membership in _memberships) { <span class="tag">@GroupName(membership.GroupId)</span> } } else { <span>–</span> }</Fact>
                    <Fact Label="Maintenance windows" Wide="true"><ChildContent>@(_effectiveWindows.Count > 0 ? WindowPickerForm.Describe(_effectiveWindows) : "none")</ChildContent><NoteContent><small><a href="@($"/servers/{Id}?tab=configuration&dialog=preview")" data-help-term="Next 30 days">Next @SUSyphos.Server.Assignment.SchedulePreview.Days days →</a></small></NoteContent></Fact>
                    <Fact Label="Software windows" Wide="true">@(MaintenanceWindowFormat.FromJson(_client.EffectiveSoftwareWindowsJson) is { Count: > 0 } software ? WindowPickerForm.Describe(software) : "the maintenance windows")</Fact>
                    <Fact Label="Reboots">@RebootPolicyText.Label(_client.EffectiveRebootPolicy)</Fact>
                    <Fact Label="Update source">@(_client.EffectiveUseMicrosoftUpdate ? "Microsoft Update" : "Windows Update only")</Fact>
                </FactGrid>
            </Box>
        </NotAuthorized>
    </AuthorizeView>
    }
    else if (_tab == ServerPage.System)
    {
    <Box Title="System" Help="server-detail#system" Anchor="system" Flush="true">
        <StatusList Rows="@SystemRows" />
        <FactGrid ShowLabel="true">
            <Fact Label="Operating system" Note="@(_client.OsEditionId is { Length: > 0 } edition ? $"edition {edition}" : null)">@OperatingSystems.Name(_client.OsProductName, _client.OsVersion, _client.OsEditionId)</Fact>
            <Fact Label="Build" Mono="true">@OperatingSystems.Build(_client.OsVersion)</Fact>
            <Fact Label="Agent"><a href="@Servers.Link("agent", AgentVersion.ShortForm(_client.AgentVersion))" title="@_client.AgentVersion: show all servers with this agent version" class="mono">@AgentVersion.ShortForm(_client.AgentVersion)</a></Fact>
            <Fact Label="PowerShell 7" Note="@(SUSyphos.Server.Scripts.PowerShell7Coverage.Reports(_client.AgentVersion) ? "for scripts of software packages" : "reported by agents from 0.9.0-rc.8")">@(_client.PowerShell7Version ?? (SUSyphos.Server.Scripts.PowerShell7Coverage.Reports(_client.AgentVersion) ? "not installed" : "unknown"))</Fact>
            <Fact Label="Domain">@(_client.DomainName ?? "–")</Fact>
            <Fact Label="Roles">@if (_client.Roles.Count > 0) { @foreach (var role in _client.Roles) { <span class="tag">@role</span> } } else { <span>–</span> }</Fact>
            <Fact Label="Update source">@UpdateSourceText</Fact>
            <Fact Label="Time zone">@(_client.TimeZoneId ?? "reported with the next inventory")</Fact>
            <Fact Label="Uptime">@UptimeText</Fact>
            <Fact Label="Registered">@Format(_client.RegisteredAtUtc)</Fact>
        </FactGrid>
    </Box>
    }
    else if (_tab == ServerPage.Activity)
    {
    <Box Title="Recent activity" Anchor="activity" Help="server-detail#activity" Hint="@($"what the agent did and reported, newest first; kept for {ClientActivityLog.Retention.TotalDays:0} days, heartbeats are not listed")" Flush="true">
        <ListTable Table="_activityTable" Page="_activityPage" Columns="ActivityColumns" Search="Search activity or detail" Noun="entries" Empty="No activity recorded yet.">
            <Row Context="entry">
                <tr>
                    <td class="nowrap">@Format(entry.AtUtc)</td>
                    <td class="nowrap"><StatusTag Text="@ClientActivityLog.Label(entry.Kind)" Kind="@ClientActivityLog.Class(entry.Kind)" /></td>
                    <td class="wrap">@entry.Detail</td>
                </tr>
            </Row>
        </ListTable>
    </Box>

    <Box Title="Remote actions" Anchor="remote-actions" Help="server-detail#remote-actions" Hint="The agent picks actions up with its next heartbeat; the central server never connects to the agent." Flush="true">
        @if (_canOperate && _actions.Any(a => a.State == AgentActionState.Queued))
        {
            <div class="selection-bar" data-selection="CancelIds">
                <span class="note" data-selection-count>Select queued actions, then</span>
                <div class="spacer"></div>
                <button type="submit" form="actions" name="RemoteAction" value="cancel-selected" class="danger" data-help-term="Cancel"><Icon Name="x" Size="16" />Cancel</button>
            </div>
        }
        <ListTable Table="_actionTable" Page="_actionPage" Columns="ActionColumns" Search="Search action, user or detail" Noun="actions" Empty="No action requested yet." ExtraColumns="1">
            <Leading><th class="select"><span class="visually-hidden">Select</span></th></Leading>
            <Row Context="action">
                        <tr>
                            <td class="select">@if (action.State == AgentActionState.Queued && _canOperate) { <input type="checkbox" form="actions" name="CancelIds" value="@action.Id" aria-label="@($"Select {SUSyphos.Server.Agents.AgentActionText.Label(action.Kind, action.Scope)}")" data-help-term="Select" /> }</td>
                            <td class="nowrap">@Format(action.RequestedAtUtc)</td>
                            <td>@SUSyphos.Server.Agents.AgentActionText.Label(action.Kind, action.Scope)</td>
                            <td>@action.RequestedBy</td>
                            <td><span class="pill @SUSyphos.Server.Agents.AgentActionText.StateClass(action.State)">@ActionStateLabel(action)</span></td>
                            <td>
                                @action.Detail
                                @if (action.LogFileSize is { } size && _canOperate)
                                {
                                    <text> </text><a href="@AgentLogEndpoints.DownloadPath(action.Id)">Download (@(size / 1024) KB)</a>
                                }
                            </td>
                        </tr>
            </Row>
        </ListTable>
    </Box>
    }
    </TabBar>

    @if (Dialog is "uninstall" or "uninstall-software")
    {
        var chosen = _installedRows.Where(r => SelectedInstalled.Contains(r.Key)).ToList();
        var applies = chosen.Where(r => r.UninstallBlocker is null).ToList();
        var anyUpdate = applies.Any(r => !r.Software);
        var anySoftware = applies.Any(r => r.Software);
        <Dialog Title="@(applies.Count == 1 ? $"Uninstall {applies[0].Title} from {_client.HostName}?" : $"Uninstall {applies.Count} updates and programs from {_client.HostName}?")" CloseHref="@SelectionCloseHref" Help="server-detail#uninstall" Wide="true">
            <form method="post" @formname="uninstall" @onsubmit="UninstallSelectionAsync">
                <AntiforgeryToken />
                <div class="dialog-body">
                    <SelectionSummary Applies="@applies.Select(r => (r.Title, r.Software ? "Software" : r.Uninstallable == false ? "only through DISM, may fail" : null)).ToList()" Skipped="@chosen.Where(r => r.UninstallBlocker is not null).Select(r => (r.Title, r.UninstallBlocker!)).ToList()" Missing="@(SelectedInstalled.Count - chosen.Count)" Verb="uninstall" />
                    @foreach (var row in applies)
                    {
                        <input type="hidden" name="Selected" value="@row.Key" />
                    }
                    @if (applies.Any(r => r.PackageId is { } package && SUSyphos.Server.Software.SoftwareUninstall.IsRuntime(package)))
                    {
                        <p class="warning">The selection holds a runtime that other programs may need (Visual C++ Redistributable, .NET, Java, WebView2 and the like). Make sure nothing on the server depends on it.</p>
                    }
                    <UninstallTiming Name="UninstallWhen" Software="@(anySoftware && !anyUpdate)" />
                    @if (anyUpdate)
                    {
                        <label class="check"><input type="checkbox" name="UninstallHold" value="yes" checked data-help-term="Hold the updates for this server" /> Hold the updates for this server, so they are not installed again</label>
                    }
                    <p class="note">Next maintenance window: @NextWindowText. Windows updates are removed through Windows Update, or with DISM by the KB number where Windows Update cannot; programs with WinGet, silently as SYSTEM, "in the next window" meaning their software window. Each becomes a remote action of its own.@if (anySoftware) { <text> Assignments of a package that cover this server install it again: end them on the package page.</text> }</p>
                </div>
                <div class="dialog-foot"><a class="btn" href="@SelectionCloseHref">Cancel</a><button type="submit" class="danger" disabled="@(applies.Count == 0)">Uninstall</button></div>
            </form>
        </Dialog>
    }
    else if (Dialog == "install-selection")
    {
        var chosen = _missingRows.Values.Where(r => SelectedMissing.Contains(r.UpdateId)).ToList();
        var applies = chosen.Where(r => r.InstallBlocker is null).ToList();
        var supported = SUSyphos.Server.Agents.AgentActionService.SupportsSelection(_client.AgentVersion);
        <Dialog Title="@(applies.Count == 1 ? $"Install {applies[0].Title} on {_client.HostName} now?" : $"Install {applies.Count} updates on {_client.HostName} now?")" CloseHref="@SelectionCloseHref" Help="server-detail#install-selection" Wide="true">
            <form method="post" @formname="install-selection" @onsubmit="InstallSelectionAsync">
                <AntiforgeryToken />
                <div class="dialog-body">
                    @if (!supported)
                    {
                        <p class="error" role="alert">The agent of this server (@DisplayNumber.Version(AgentVersion.ShortForm(_client.AgentVersion))) installs a selection from version @SUSyphos.Contracts.Agents.AgentAction.SelectionSinceVersion on. Update the agent, or use "Install all released now" in the Updates menu.</p>
                    }
                    <SelectionSummary Applies="@applies.Select(r => (r.Title, r.Released ? (r.Software ? "Software" : null) : "not released for its ring yet: released for this server only")).ToList()" Skipped="@chosen.Where(r => r.InstallBlocker is not null).Select(r => (r.Title, r.InstallBlocker!)).ToList()" Missing="@(SelectedMissing.Count - chosen.Count)" Verb="install" />
                    @foreach (var row in applies)
                    {
                        <input type="hidden" name="Selected" value="@row.UpdateId" />
                    }
                    @if (applies.Any(r => !r.Released))
                    {
                        <p>Updates not released for the ring yet are released for this server alone (recorded in the audit log); the ring keeps its own date.</p>
                    }
                    <p>The agent installs them with its next heartbeat, also outside the maintenance window. If Windows then needs a restart, the server restarts <b>right after</b> (five minute warning) or in the <b>next maintenance window</b> (next window: @NextWindowText).</p>
                    <p class="note">A global pause holds the installation until it ends; in a coordinated group the agent waits for a free slot for Windows updates (software takes no lease). A local veto (registry value AllowReboot) prevents the restart.</p>
                </div>
                <div class="dialog-foot"><a class="btn" href="@SelectionCloseHref">Cancel</a><button type="submit" name="SelectionRestart" value="window" disabled="@(applies.Count == 0 || !supported)">Install, restart in the next window</button><button type="submit" name="SelectionRestart" value="now" class="danger" disabled="@(applies.Count == 0 || !supported)">Install and restart right after</button></div>
            </form>
        </Dialog>
    }
    else if (Dialog == "hold-selection")
    {
        var chosenMissing = _missingRows.Values.Where(r => SelectedMissing.Contains(r.UpdateId)).ToList();
        var chosenInstalled = _installedRows.Where(r => SelectedInstalled.Contains(r.Key)).ToList();
        var applies = chosenMissing.Where(r => r.HoldBlocker is null).Select(r => r.Title).Concat(chosenInstalled.Where(r => r.HoldBlocker is null).Select(r => r.Title)).ToList();
        <Dialog Title="@(applies.Count == 1 ? $"Hold {applies[0]} for {_client.HostName}?" : $"Hold {applies.Count} updates for {_client.HostName}?")" CloseHref="@SelectionCloseHref" Help="server-detail#hold-selection" Wide="true">
            <form method="post" @formname="hold-selection" @onsubmit="HoldSelectionAsync">
                <AntiforgeryToken />
                <div class="dialog-body">
                    <SelectionSummary Applies="@applies.Select(t => (t, (string?)null)).ToList()" Skipped="@chosenMissing.Where(r => r.HoldBlocker is not null).Select(r => (r.Title, r.HoldBlocker!)).Concat(chosenInstalled.Where(r => r.HoldBlocker is not null).Select(r => (r.Title, r.HoldBlocker!))).ToList()" Missing="@(SelectedMissing.Count + SelectedInstalled.Count - chosenMissing.Count - chosenInstalled.Count)" Verb="hold" />
                    @foreach (var row in chosenMissing.Where(r => r.HoldBlocker is null))
                    {
                        <input type="hidden" name="Selected" value="@row.UpdateId" />
                    }
                    @foreach (var row in chosenInstalled.Where(r => r.HoldBlocker is null))
                    {
                        <input type="hidden" name="SelectedInstalled" value="@row.Key" />
                    }
                    <label class="field"><span>Reason <span class="note">optional</span></span><input name="HoldReason" maxlength="@UpdateHoldEntity.MaxReasonLength" autocomplete="off" placeholder="e.g. ticket number" data-help-term="Reason" /></label>
                    <DateTimeField Label="Hold until" DateName="HoldUntilDate" TimeName="HoldUntilTime" Optional="true" />
                    <p class="help">Time of the central server. Without a date the hold lasts until someone ends it.</p>
                    <p class="note">A held update is not released to this server, also not by "Install now"; it stays missing. Holds of the ring or a group stay as they are and are ended on the update page.</p>
                </div>
                <div class="dialog-foot"><a class="btn" href="@SelectionCloseHref">Cancel</a><button type="submit" class="primary" disabled="@(applies.Count == 0)">Hold</button></div>
            </form>
        </Dialog>
    }
    else if (Dialog == "end-hold-selection")
    {
        var chosen = _missingRows.Values.Where(r => SelectedMissing.Contains(r.UpdateId)).ToList();
        var applies = chosen.Where(r => r.EndHoldBlocker is null).ToList();
        <Dialog Title="@(applies.Count == 1 ? $"End the hold of {applies[0].Title}?" : $"End the holds of {applies.Count} updates?")" CloseHref="@SelectionCloseHref" Help="server-detail#hold-selection" Wide="true">
            <form method="post" @formname="end-hold-selection" @onsubmit="EndHoldSelectionAsync">
                <AntiforgeryToken />
                <div class="dialog-body">
                    <SelectionSummary Applies="@applies.Select(r => (r.Title, (string?)null)).ToList()" Skipped="@chosen.Where(r => r.EndHoldBlocker is not null).Select(r => (r.Title, r.EndHoldBlocker!)).ToList()" Missing="@(SelectedMissing.Count - chosen.Count)" Verb="release from the hold" />
                    @foreach (var row in applies)
                    {
                        <input type="hidden" name="Selected" value="@row.UpdateId" />
                    }
                    <p class="note">The updates are released to this server again as their ring allows; they install in the next maintenance window.</p>
                </div>
                <div class="dialog-foot"><a class="btn" href="@SelectionCloseHref">Cancel</a><button type="submit" class="primary" disabled="@(applies.Count == 0)">End hold</button></div>
            </form>
        </Dialog>
    }
    else if (Dialog == "preview" && _schedulePreview is not null)
    {
        <SchedulePreviewDialog Preview="@_schedulePreview" CloseHref="@($"/servers/{Id}?tab=configuration")" />
    }
    else if (Dialog == "install")
    {
        var released = ReleasedPending;
        <Dialog Title="@($"Install the released updates on {_client.HostName} now?")" CloseHref="@Here" Help="server-detail#install-now">
            <form method="post" @formname="install" @onsubmit="InstallNowAsync">
                <AntiforgeryToken />
                <div class="dialog-body">
                    @if (released.Count == 0)
                    {
                        <p>No update is released for this server and still missing; there is nothing to install.</p>
                    }
                    else
                    {
                        var softwareCount = released.Count(r => _softwareIds.Contains(r.Entry.UpdateId));
                        <p>The agent installs @(released.Count == 1 ? "this update" : $"these {released.Count} updates") with its next heartbeat, also outside the maintenance window and before their planned time:</p>
                        <ul class="plain">
                            @foreach (var (entry, title) in released.Take(10))
                            {
                                <li>@title @if (_softwareIds.Contains(entry.UpdateId)) { <ClassificationTag Text="@SUSyphos.Server.Software.SoftwarePackages.Classification" /> }</li>
                            }
                        </ul>
                        @if (released.Count > 10)
                        {
                            <p class="help">and @(released.Count - 10) more.</p>
                        }
                        @if (softwareCount > 0 && softwareCount < released.Count)
                        {
                            <fieldset class="choices">
                                <legend>What to install</legend>
                                <div class="choice"><input type="radio" id="install-all" name="InstallWhat" value="all" checked data-help-term="Windows updates and software" /> <span><label for="install-all"><b>Windows updates and software</b></label><span class="note">Everything listed above.</span></span></div>
                                <div class="choice"><input type="radio" id="install-updates" name="InstallWhat" value="updates" data-help-term="Windows updates only" /> <span><label for="install-updates"><b>Windows updates only</b></label><span class="note">@DisplayNumber.Format(released.Count - softwareCount) Windows @(released.Count - softwareCount == 1 ? "update" : "updates"); the software waits for the maintenance window.</span></span></div>
                                <div class="choice"><input type="radio" id="install-software" name="InstallWhat" value="software" data-help-term="Software only" /> <span><label for="install-software"><b>Software only</b></label><span class="note">@DisplayNumber.Format(softwareCount) @(softwareCount == 1 ? "program" : "programs"); the Windows updates wait for the maintenance window.</span></span></div>
                            </fieldset>
                        }
                        else
                        {
                            <input type="hidden" name="InstallWhat" value="all" />
                        }
                    }
                    <p>Only updates released for the ring of the server are installed. If Windows then needs a restart, the server restarts <b>right after</b> (five minute warning) or in the <b>next maintenance window</b> (next window: @NextWindowText).</p>
                    <p class="note">A global pause holds the installation until it ends; in a coordinated group the agent waits for a free slot. A local veto (registry value AllowReboot) prevents the restart.</p>
                </div>
                <div class="dialog-foot"><a class="btn" href="@Here">Cancel</a><button type="submit" name="InstallRestart" value="window" disabled="@(released.Count == 0)">Install, restart in the next window</button><button type="submit" name="InstallRestart" value="now" class="danger" disabled="@(released.Count == 0)">Install and restart right after</button></div>
            </form>
        </Dialog>
    }
    else if (Dialog == "install-software" && _canAdminister)
    {
        <Dialog Title="@($"Install software on {_client.HostName}")" CloseHref="@ServerPage.Link(Id, "software")" Wide="true" Help="server-detail#install-software">
            <form method="get" action="/servers/@Id" class="dialog-search">
                <input type="hidden" name="tab" value="software" />
                <input type="hidden" name="dialog" value="install-software" />
                <label class="field"><span>Search the catalog</span><input name="swq" maxlength="100" value="@SoftwareQuery" placeholder="Name or ID, e.g. 7zip" /></label>
                <button type="submit">Search</button>
            </form>
            <form method="post" @formname="install-software" @onsubmit="InstallSoftwareAsync">
                <AntiforgeryToken />
                <div class="dialog-body">
                    @if (_catalogChoices.Count == 0)
                    {
                        <p class="note">@(string.IsNullOrWhiteSpace(SoftwareQuery) ? "Every package of the catalog is installed or assigned already." : "No package of the catalog matches.") Packages that are not in the catalog yet are added on the <a href="/software?dialog=add">Software page</a>.</p>
                    }
                    else
                    {
                        <div class="scroll">
                            <table>
                                <thead><tr><th class="select"><span class="visually-hidden">Choose</span></th><th>Package</th><th>Newest version</th></tr></thead>
                                <tbody>
                                    @foreach (var choice in _catalogChoices)
                                    {
                                        <tr>
                                            <td><input type="checkbox" name="InstallPackage" value="@choice.PackageId" aria-label="@($"Choose {choice.Name}")" data-help-term="Choose" /></td>
                                            <td class="wrap">@choice.Name<div class="note mono">@choice.PackageId</div>@if (choice.Reason is { } reason) { <div class="note">Not supported here: @reason</div> }</td>
                                            <td class="nowrap">@(choice.Newest ?? "–")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        @if (_catalogMore > 0)
                        {
                            <p class="note">@DisplayNumber.Count(_catalogMore, "more package matches", "more packages match"); search to narrow the list.</p>
                        }
                    }
                    <label class="check"><input type="checkbox" name="InstallUninstallOnRemoval" value="true" data-help-term="Uninstall when the assignment is removed" /> Uninstall when the assignment is removed</label>
                    <label class="check"><input type="checkbox" name="InstallRightAway" value="true" data-help-term="Install now" /> Install now: release the newest version for this server alone and install it at once (restart in the maintenance window)</label>
                    <p class="help">Each chosen package is assigned to this server with its newest released version. Without "Install now" it installs when the version is released for the ring of the server.</p>
                </div>
                <div class="dialog-foot"><a class="btn" href="@ServerPage.Link(Id, "software")">Close</a><button type="submit" class="primary" disabled="@(_catalogChoices.Count == 0)" data-help-term="Assign to">Assign to @_client.HostName</button></div>
            </form>
        </Dialog>
    }
    else if (Dialog == "debug")
    {
        <Dialog Title="@($"Debug mode for {_client.HostName}")" CloseHref="@Here" Help="server-detail#debug">
            <form method="post" @formname="debug" @onsubmit="DebugOnAsync">
                <AntiforgeryToken />
                <div class="dialog-body">
                    <p>For a while the agent collects what its normal logs leave out: it logs at Debug, WinGet writes its verbose log (why an installer does not fit), and <b>Request logs</b> adds WindowsUpdate.log, CBS.log and the DISM log. It ends by itself; the agent takes it with its next heartbeat.</p>
                    <fieldset class="choices">
                        <legend>Duration</legend>
                        @foreach (var hours in SUSyphos.Server.Administration.DebugMode.Durations)
                        {
                            <div class="choice"><input type="radio" id="@($"debug-{hours}")" name="DebugHours" value="@hours" checked="@(hours == SUSyphos.Server.Administration.DebugMode.DefaultHours)" data-help-term="Duration" /> <label for="@($"debug-{hours}")">@DisplayNumber.Count(hours, "hour", "hours")</label></div>
                        }
                    </fieldset>
                    @if (_debug is { } running)
                    {
                        <p class="note">It is on until @Format(running.UntilUtc); a new duration starts now.</p>
                    }
                </div>
                <div class="dialog-foot"><a class="btn" href="@Here">Cancel</a><button type="submit" class="primary">@(_debug is null ? "Turn on" : "Extend")</button></div>
            </form>
        </Dialog>
    }
    else if (Dialog == "restart")
    {
        <Dialog Title="@($"Restart {_client.HostName}?")" CloseHref="@Here" Help="server-detail#restart">
            <form method="post" @formname="restart" @onsubmit="RestartAsync">
                <AntiforgeryToken />
                <div class="dialog-body">
                    <p><b>Now:</b> the agent restarts the server with its next heartbeat, also outside the maintenance window, after a five minute warning.</p>
                    <p><b>In the next maintenance window:</b> the agent restarts the server once a window is open for at least 30 more minutes (next window: @NextWindowText), also if its reboot policy is "Never"; in a coordinated group it waits for a free slot. It reports the planned time.</p>
                    <p class="note">A local veto on the server (registry value AllowReboot) applies to both. A queued restart can be cancelled until it happens.</p>
                </div>
                <div class="dialog-foot"><a class="btn" href="@Here">Cancel</a><button type="submit" name="When" value="window">Restart in the next maintenance window</button><button type="submit" name="When" value="now" class="danger">Restart now</button></div>
            </form>
        </Dialog>
    }
    else if (Dialog == "agent-setting" && SUSyphos.Contracts.Agents.AgentSettings.Find(SettingKey) is { } settingDefinition)
    {
        var inherited = SUSyphos.Server.Assignment.AgentSettingValues.Explain(_systemAgentSettings, _memberGroupSettings, new Dictionary<string, string>(), "this server").First(e => e.Definition.Key == settingDefinition.Key);
        <AgentSettingDialog Definition="settingDefinition" Scope="@($"server {_client.HostName}")" Own="@_ownAgentSettings.GetValueOrDefault(settingDefinition.Key)"
                            InheritedValue="@inherited.Value" InheritedSource="@inherited.Source" CancelHref="@(ServerPage.Link(Id, "assignment"))" Error="@_settingError" Help="server-detail#agent-settings" OnSave="SaveSettingAsync" />
    }
    else if (Dialog is "remove" or "purge" && _pendingRemoval is null)
    {
        var canUninstall = _client.State == SUSyphos.Contracts.Agents.RegistrationState.Approved;
        <Dialog Title="@($"Remove {_client.HostName}?")" CloseHref="@Here" Help="server-detail#remove">
            <form method="post" @formname="remove" @onsubmit="RemoveAsync">
                <AntiforgeryToken />
                <input type="hidden" name="ConfirmRemove" value="yes" />
                <div class="dialog-body">
                    <fieldset class="choices">
                        <legend>History</legend>
                        <div class="choice"><input type="radio" id="remove-keep" name="Remove" value="soft" checked="@(Dialog != "purge")" data-help-term="Keep the history" /> <span><label for="remove-keep"><b>Keep the history</b></label><span class="note">Releases, actions and leases end; installations and activity stay in the reports.</span></span></div>
                        <div class="choice"><input type="radio" id="remove-delete" name="Remove" value="hard" checked="@(Dialog == "purge")" data-help-term="Delete with the history" /> <span><label for="remove-delete"><b>Delete with the history</b></label><span class="note">The server and all its data are deleted for good. This cannot be undone.</span></span></div>
                    </fieldset>
                    <label class="check"><input type="checkbox" name="UninstallAgent" value="yes" checked="@canUninstall" disabled="@(!canUninstall)" data-help-term="Uninstall the agent" /> Uninstall the agent</label>
                    <p class="help">@(canUninstall
                        ? "The agent uninstalls itself with its next heartbeat and the server is removed once it confirms; if it does not answer within a day, the server is removed anyway. Without this, a running agent registers again."
                        : "Only an approved server can uninstall its agent; uninstall it by hand if it still runs.") A removed server that registers again is never approved by a rule; approve it by hand under Approvals.</p>
                </div>
                <div class="dialog-foot"><a class="btn" href="@Here">Cancel</a><button type="submit" class="danger">Remove server</button></div>
            </form>
        </Dialog>
    }
}

@* Resets one agent setting of this server; its buttons sit in the assignment form but belong to this form. *@
<form id="agent-setting-reset" method="post" @formname="agent-setting-reset" @onsubmit="ResetSettingAsync" class="detached">
    <AntiforgeryToken />
</form>

@code {
    [Parameter]
    public Guid Id { get; set; }

    [SupplyParameterFromForm(FormName = "assignment")]
    private string? Ring { get; set; }

    [SupplyParameterFromForm(FormName = "assignment")]
    private string[]? Groups { get; set; }

    [SupplyParameterFromForm(FormName = "assignment")]
    private string? Reboot { get; set; }

    /// <summary>Confirmation dialog the address asks for: restart, remove or purge.</summary>
    [SupplyParameterFromQuery(Name = "dialog")]
    private string? Dialog { get; set; }

    [CascadingParameter]
    private Microsoft.AspNetCore.Http.HttpContext? HttpContext { get; set; }

    private IReadOnlyList<SUSyphos.Contracts.Agents.MaintenanceWindow> _ownWindows = [];
    private Dictionary<string, string> _ownAgentSettings = [];
    private IReadOnlyList<(SUSyphos.Contracts.Agents.AgentSettingDefinition Definition, string Value, string Source)> _agentSettings = [];
    private Dictionary<string, string> _systemAgentSettings = [];
    private List<(string Name, IReadOnlyDictionary<string, string> Values)> _memberGroupSettings = [];
    private Dictionary<string, SUSyphos.Contracts.Agents.AppliedAgentSetting> _appliedSettings = [];
    private string? _settingError;

    [SupplyParameterFromQuery(Name = "key")]
    private string? SettingKey { get; set; }

    /// <summary>The update the uninstall dialog preselects, when opened from a history row.</summary>
    [SupplyParameterFromQuery(Name = "update")]
    private string? PreselectedUpdateParam { get; set; }

    private Guid? PreselectedUpdate => Guid.TryParse(PreselectedUpdateParam, out var id) ? id : null;

    private const string FailedResult = "Failed";
    private const string ErrorsResult = "Succeeded with errors";

    /// <summary>
    /// Views of the SUSyphos installations, default first: antivirus definition updates arrive several times a day and
    /// would bury the rest, so the default view hides them (Marc, 2026-10-27).
    /// </summary>
    private static readonly IReadOnlyList<TableView> HistoryViews =
    [
        new("updates", "Without definition updates", "Antivirus definitions arrive several times a day and are hidden", ("category", TableFilter.Not(DefinitionUpdates.Classification))),
        new("problems", "Failed or with errors", "Installations that did not fully succeed", ("result", TableFilter.In(FailedResult, ErrorsResult))),
        new("software", "Software only", "Programs installed or updated with WinGet", ("category", TableFilter.In(SUSyphos.Server.Software.SoftwarePackages.Classification))),
        new("all", "All installations", "No filter, definition updates included"),
    ];

    /// <summary>Views of the Windows Update history, default first; definition updates are hidden as in the installations.</summary>
    private static readonly IReadOnlyList<TableView> WindowsViews =
    [
        new("updates", "Without definition updates", "Antivirus definitions arrive several times a day and are hidden", ("category", TableFilter.Not(DefinitionUpdates.Classification))),
        new("problems", "Failed or with errors", "Entries that did not fully succeed", ("result", TableFilter.In(FailedResult, ErrorsResult))),
        new("outside", "Started outside SUSyphos", "Installed by Windows Update, an administrator or another tool; definition updates are expected and not counted", ("started", TableFilter.In("outside SUSyphos"))),
        new("definitions", "Definition updates only", "Antivirus signatures and the Defender platform", ("category", TableFilter.In(DefinitionUpdates.Classification))),
        new("all", "All entries", "No filter"),
    ];

    /// <summary>Views of the remote actions, default first.</summary>
    private static readonly IReadOnlyList<TableView> ActionViews =
    [
        new("all", "All actions", "No filter"),
        new("open", "Open", "Queued or delivered, no result yet", ("state", TableFilter.In(nameof(AgentActionState.Queued), nameof(AgentActionState.Delivered)))),
        new("failed", "Failed", "Failed, refused by the agent or expired", ("state", TableFilter.In(nameof(AgentActionState.Failed), nameof(AgentActionState.Rejected), nameof(AgentActionState.Expired)))),
    ];

    private string UninstallLink(Guid updateId) => $"{DialogLink("uninstall")}&isel=u:{updateId:D}";

    private bool IsUninstallable(Guid updateId) => _installedRows.Any(r => r.UpdateId == updateId);


    private Dictionary<Guid, string> _categories = [];

    private string Category(ClientUpdateHistoryEntity entry) =>
        _categories.GetValueOrDefault(entry.UpdateId) ?? (DefinitionUpdates.IsTitle(entry.Title) ? DefinitionUpdates.Classification : "Unknown");

    private string SettingHref(string key) => $"/servers/{Id}?tab={ServerPage.Configuration}&dialog=agent-setting&key={Uri.EscapeDataString(key)}";
    private IReadOnlyList<SUSyphos.Contracts.Agents.MaintenanceWindow> _effectiveWindows = [];
    private string _fallbackRing = "Production";

    private string DialogLink(string dialog) => $"/servers/{Id}?{(_tab == ServerPage.Overview ? string.Empty : $"tab={_tab}&")}dialog={dialog}";

    /// <summary>The current tab of this server, where dialogs return to.</summary>
    private string Here => "/" + ServerPage.TabPath(Id, _tab);

    [SupplyParameterFromQuery(Name = "tab")]
    private string? Tab { get; set; }

    private string _tab = ServerPage.Overview;
    private bool _canAdminister;
    private SUSyphos.Server.Security.ServerSecurity _serverSecurity = SUSyphos.Server.Security.ServerSecurity.Unknown;
    private Dictionary<string, string?> _securityFixes = [];
    private TableQuery _cveTable = default!;
    private TablePage<SUSyphos.Server.Data.SecurityVulnerabilityEntity> _cvePage = new([], 0, 0, 1, 1, new Dictionary<string, IReadOnlyList<FilterOption>>());
    private static readonly IReadOnlyList<TableColumn<SUSyphos.Server.Data.SecurityVulnerabilityEntity>> VulnerabilityTable =
        [.. SUSyphos.Server.Security.VulnerabilityColumns.Of<SUSyphos.Server.Data.SecurityVulnerabilityEntity>(v => v), new("kb", "Fixed by", v => v.Cve, Sortable: false)];
    private bool _securityHasData;

    /// <summary>What the agent found about Extended Security Updates.</summary>
    /// <summary>The monthly baselines of the server's Windows build, oldest first (the last four), for the baseline track.</summary>
    private sealed record BaselineSegment(SecurityBaselineEntity Baseline, bool Installed, bool ServerBuild, string State);

    private SUSyphos.Server.Security.SecuritySnapshot _securitySnapshot = SUSyphos.Server.Security.SecuritySnapshot.Empty;

    private IReadOnlyList<BaselineSegment> BaselineSegments
    {
        get
        {
            if (_serverSecurity.Build is not { } build || _serverSecurity.Revision is not { } revision)
            {
                return [];
            }

            var baselines = _securitySnapshot.Baselines(build).OrderBy(b => b.Revision).TakeLast(4).ToList();
            var newestInstalled = baselines.LastOrDefault(b => b.Revision <= revision);
            return [.. baselines.Select(b => new BaselineSegment(
                b,
                b.Revision <= revision,
                ReferenceEquals(b, newestInstalled),
                b.Revision <= revision
                    ? ReferenceEquals(b, newestInstalled) ? "installed · server build" : "installed"
                    : ReferenceEquals(b, baselines[^1]) ? "missing · current baseline" : $"missing since {b.ReleasedAtUtc.ToLocalTime():yyyy-MM-dd}"))];
        }
    }

    /// <summary>One sentence under the baseline track: how far behind, since when, which KB closes the gap.</summary>
    private string BaselineSentence
    {
        get
        {
            var behind = BaselineSegments.Count(s => !s.Installed);
            if (behind == 0 || _serverSecurity.Missing is not { } missing)
            {
                return "The server runs the current security baseline.";
            }

            var days = DisplayNumber.Format((int)(_now - missing.ReleasedAtUtc).TotalDays);
            return $"{behind} {(behind == 1 ? "baseline" : "baselines")} behind, for {days} days.{(_serverSecurity.Target?.Kb is { } kb ? $" KB{kb} brings the server to the current baseline." : string.Empty)}";
        }
    }

    private IReadOnlyList<StatusRow> SecurityRows
    {
        get
        {
            if (_client is null)
            {
                return [];
            }

            var rows = new List<StatusRow>();
            var state = _serverSecurity.State;
            var label = SUSyphos.Server.Security.SecuritySnapshot.Label(state);
            var kind = SUSyphos.Server.Security.SecuritySnapshot.Class(state);
            RenderFragment? cves = _serverSecurity.Open.Count > 0 ? @<a href="@($"{ServerPage.Link(Id, ServerPage.Security)}#vulnerabilities")">@DisplayNumber.Format(_serverSecurity.Open.Count) open @(_serverSecurity.Open.Count == 1 ? "CVE" : "CVEs") →</a> : null;
            rows.Add(state switch
            {
                SUSyphos.Server.Security.BaselineState.Unknown => new StatusRow(kind, label, "Security baseline", "unknown", _securityHasData ? "Microsoft publishes no security builds for this Windows version" : "no security data from Microsoft (MSRC) yet"),
                SUSyphos.Server.Security.BaselineState.Current => new StatusRow(kind, label, "Security baseline", "current", _serverSecurity.Target is { } target ? $"{target.Month}, released {Format(target.ReleasedAtUtc)}" : null, cves),
                _ when _serverSecurity.Missing is { } missing => new StatusRow(kind, label, "Security baseline", $"{DisplayNumber.Format((int)(_now - missing.ReleasedAtUtc).TotalDays)} days behind", $"since {Format(missing.ReleasedAtUtc)}", cves),
                _ => new StatusRow(kind, label, "Security baseline", "behind", null, cves),
            });
            var support = Support.Of(_client, _serverSecurity);
            rows.Add(SupportRow(support, null));
            rows.Add(new StatusRow(_client.EsuKey == true || _client.Azure == true ? "ok" : "neutral", _client.EsuKey == true || _client.Azure == true ? "found" : "none", "Extended Security Updates", EsuText.Split(" (", 2)[0], EsuText.Contains(" (", StringComparison.Ordinal) ? EsuText.Split(" (", 2)[1].TrimEnd(')') : null));
            return rows;
        }
    }

    private StatusRow SupportRow(SUSyphos.Server.Lifecycle.SupportInfo support, RenderFragment? action)
    {
        if (support.State == SUSyphos.Server.Lifecycle.SupportState.Unknown)
        {
            return new StatusRow("neutral", "Unknown", "Support", "unknown for this Windows version", null, action);
        }

        var mainstream = support.MainstreamEnd is { } end && support.End is { } final && support.DaysLeft is { } days
            ? $"mainstream support {(days - (final.DayNumber - end.DayNumber) >= 0 ? "until" : "ended")} {end:yyyy-MM-dd}"
            : null;
        return new StatusRow(SUSyphos.Server.Lifecycle.SupportLifecycle.Class(support.State), support.Label, "Support", SUSyphos.Server.Lifecycle.SupportLifecycle.Describe(support), mainstream, action);
    }

    private IReadOnlyList<StatusRow> SystemRows
    {
        get
        {
            if (_client is null)
            {
                return [];
            }

            var policy = $"policy: {RebootPolicyText.Label(_client.EffectiveRebootPolicy)}";
            var rows = new List<StatusRow>
            {
                _client.RestartAnnouncedAtUtc is { } restartAt ? new StatusRow("pend", "restarting", "Restart", $"at {Format(restartAt)}", "announced to Windows by the agent")
                : !_client.RebootPending ? new StatusRow("ok", "not pending", "Restart", "no restart pending", policy)
                : _client.RebootWait == SUSyphos.Contracts.Agents.RebootWait.RestartRefused ? new StatusRow("fail", "refused", "Restart", LiveStatus.RebootWaitText(_client.RebootWait.Value, _client.RestartRefusedCode), policy)
                : new StatusRow("queue", "pending", "Restart", _client.RebootWait is { } wait ? LiveStatus.RebootWaitText(wait, _client.RestartRefusedCode) : "the agent reports why it waits from version 0.7", policy),

                _externalInstalls > 0
                    ? new StatusRow("queue", DisplayNumber.Format(_externalInstalls), "Outside SUSyphos", $"installations in the last {SUSyphos.Contracts.Agents.UpdateHistoryEntry.HistoryDays} days", "started by Windows or an administrator, not by SUSyphos", @<a href="@ServerPage.Link(Id, "windows-history")">History →</a>)
                    : new StatusRow("ok", "none", "Outside SUSyphos", "none in the reported history"),

                _client.AutoUpdateMode is null ? new StatusRow("neutral", "unknown", "Automatic updates", "reported by agents from version 0.3")
                : _client.AutomaticUpdatesBypass ? new StatusRow("queue", "Warning", "Automatic updates", "Windows installs updates on its own", $"outside rings and maintenance windows; setting: {AutomaticUpdatesText.Describe(_client.AutoUpdateMode, _client.AutomaticUpdatesByPolicy, _client.AutomaticUpdatesManagedByAgent)}", @<a href="@($"/servers/{Id}?tab={ServerPage.Overview}#checks")">Pre-flight check →</a>, @<AutomaticUpdatesFix Bypass="true" ByPolicy="@_client.AutomaticUpdatesByPolicy" />)
                : new StatusRow("ok", "OK", "Automatic updates", "Windows does not install on its own", $"setting: {AutomaticUpdatesText.Describe(_client.AutoUpdateMode, _client.AutomaticUpdatesByPolicy, _client.AutomaticUpdatesManagedByAgent)}"),

                _client.LastSearchAtUtc is null ? new StatusRow("neutral", "none", "Last update search", "none reported yet")
                : _client.LastSearchSucceeded == true ? new StatusRow("ok", "OK", "Last update search", Format(_client.LastSearchAtUtc))
                : new StatusRow("fail", "failed", "Last update search", Format(_client.LastSearchAtUtc), null, @<a href="@ServerPage.Link(Id, "missing")">Details →</a>),
            };

            var applied = AppliedSummary;
            rows.Add(new StatusRow(applied.Kind, applied.Text, "Agent settings", $"agent {AgentVersion.ShortForm(_client.AgentVersion)}", null, @<a href="@ServerPage.Link(Id, "assignment")" data-help-term="Show agent settings">Settings →</a>));
            if (_client.AgentUpdateError is { } agentError)
            {
                rows.Add(new StatusRow("fail", "failed", "Agent update", agentError));
            }

            if (AgentUpdates.IsBelowMinimum(_client.AgentVersion))
            {
                rows.Add(new StatusRow("fail", "too old", "Agent version", $"below minimum {AgentUpdates.Minimum}", "update the agent on the SUSyphos page"));
            }

            if (_client.MicrosoftUpdateRegistered is { } registered && registered != _client.EffectiveUseMicrosoftUpdate)
            {
                rows.Add(new StatusRow("queue", "changing", "Update source", _client.EffectiveUseMicrosoftUpdate ? "set: Microsoft Update" : "set: Windows Update only", "the agent applies the setting with its next heartbeat and reports it with the next inventory"));
            }

            if (_client.ServerMoveError is { } moveError)
            {
                rows.Add(new StatusRow("fail", "not moved", "Move", moveError, null, @<a href="/administration/backup#move">Move to a new server →</a>));
            }

            rows.Add(SupportRow(Support.Of(_client), @<a href="@ServerPage.Link(Id, ServerPage.Security)">Security →</a>));
            return rows;
        }
    }
    private string EsuText => _client is null || (_client.EsuKey is null && _client.AzureArc is null && _client.Azure is null)
