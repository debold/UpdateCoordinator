    /// <summary>Coordinated groups of this server that are stopped after failed leases (Marc, 2026-11-13).</summary>
    private IEnumerable<GroupEntity> StoppedGroups => _memberships.Select(m => _groups.FirstOrDefault(g => g.Id == m.GroupId)).OfType<GroupEntity>().Where(g => g.Coordinated && g.LeasesHalted);

    private Dictionary<int, List<SUSyphos.Server.Assignment.LeaseHolder>> _leaseHolders = [];

    /// <summary>Why an installation waits in a coordinated group: stopped, held by another server, or simply needs a lease.</summary>
    private string LeaseNote()
    {
        if (StoppedGroups.FirstOrDefault() is { } stopped)
        {
            return $"coordinated group {stopped.Name} is stopped: nothing installs until it is resumed";
        }

        foreach (var membership in _memberships)
        {
            if (_leaseHolders.GetValueOrDefault(membership.GroupId) is { Count: > 0 } holders && holders.All(h => h.ClientId != Id)
                && _groups.FirstOrDefault(g => g.Id == membership.GroupId) is { Coordinated: true } group
                && holders.Count >= SUSyphos.Server.Assignment.LeaseService.Capacity(_groupSizes.GetValueOrDefault(group.Id), group.LeasePercent, group.LeaseMaximum))
            {
                return $"coordinated group {group.Name}: waits for the lease, held by {holders[0].HostName} until {DisplayTime.Format(holders[0].ExpiresAtUtc)}";
            }
        }

        return _leaseHolders.Values.Any(h => h.Any(l => l.ClientId == Id)) ? "coordinated group: this server holds the lease" : "coordinated group: installs only with a lease";
    }

