    private async Task LoadAsync()
    {
        _client = await Db.Clients.AsNoTracking().SingleOrDefaultAsync(c => c.Id == Id);
        _rings = await Db.Rings.AsNoTracking().OrderBy(r => r.Order).ToListAsync();
        _groups = await Db.Groups.AsNoTracking().OrderBy(g => g.Name).ToListAsync();
        _memberships = await Db.ClientGroups.AsNoTracking().Where(m => m.ClientId == Id).ToListAsync();
        var memberGroupIds = _memberships.Select(m => m.GroupId).ToList();
        _leaseHolders = await SUSyphos.Server.Assignment.GroupLeaseStatus.HoldersAsync(Db, memberGroupIds, CancellationToken.None);
        _groupSizes = await Db.ClientGroups.AsNoTracking().Where(m => memberGroupIds.Contains(m.GroupId)).GroupBy(m => m.GroupId).Select(g => new { g.Key, Count = g.Count() }).ToDictionaryAsync(g => g.Key, g => g.Count);
        _pendingRemoval = await Removal.PendingAsync(Id, CancellationToken.None);
        _debug = await Debug.ServerAsync(Id, CancellationToken.None);
        await LoadSoftwareAsync();
        _actions = await Db.AgentActions.AsNoTracking().Where(a => a.ClientId == Id).OrderByDescending(a => a.RequestedAtUtc).Take(MaxHistory).ToListAsync();
        var me = await GetActorAsync();
        var latestLogs = LatestLogs?.Id.ToString("D");
        _logsDownloadedAt = latestLogs is null ? null : await Db.AuditEntries.AsNoTracking().Where(a => a.Action == "Action.LogsDownloaded" && a.Actor == me && a.Details == latestLogs).MaxAsync(a => (DateTime?)a.AtUtc);
        _actionTable = TableQuery.From(Navigation, "requested", defaultDescending: true, prefix: "ra.", defaultPageSize: 10, views: ActionViews);
        _actionPage = TablePaging.Apply(_actions, _actionTable, ActionColumns, a => $"{SUSyphos.Server.Agents.AgentActionText.Label(a.Kind, a.Scope)} {a.RequestedBy} {a.Detail}");
        if (_client is null)
        {
            return;
        }

        _ownWindows = MaintenanceWindowFormat.FromJson(_client.MaintenanceWindowsJson) ?? [];
        _ownAgentSettings = SUSyphos.Server.Assignment.AgentSettingValues.Parse(_client.AgentSettingsJson);
        _systemAgentSettings = await Administration.GetSystemAgentSettingsAsync(CancellationToken.None);
        _memberGroupSettings = _memberships.Select(m => _groups.FirstOrDefault(g => g.Id == m.GroupId)).OfType<GroupEntity>()
            .Select(g => (g.Name, (IReadOnlyDictionary<string, string>)SUSyphos.Server.Assignment.AgentSettingValues.Parse(g.AgentSettingsJson))).ToList();
        _agentSettings = SUSyphos.Server.Assignment.AgentSettingValues.Explain(_systemAgentSettings, _memberGroupSettings, _ownAgentSettings, "this server");
        _appliedSettings = SUSyphos.Server.Assignment.AppliedAgentSettings.Parse(_client.AppliedAgentSettingsJson);
        _schedulePreview = Dialog == "preview" ? await Preview.ForClientAsync(Id, CancellationToken.None) : null;
        // The selection lists of the Updates tab, also for the confirmation dialogs and the ⋯ of the history rows.
        if (_tab is ServerPage.Updates or ServerPage.History || Dialog is "uninstall" or "uninstall-software" or "install-selection" or "hold-selection" or "end-hold-selection")
        {
            _missingRows = (await Selection.MissingAsync(Id, CancellationToken.None)).ToDictionary(r => r.UpdateId);
            _installedRows = await Selection.InstalledAsync(Id, CancellationToken.None);
        }

        _installedTable = TableQuery.From(Navigation, "installed", defaultDescending: true, prefix: "iu.", defaultPageSize: 10);
        _installedPage = TablePaging.Apply(_installedRows, _installedTable, InstalledColumns, r => r.Title);
        _effectiveWindows = MaintenanceWindowFormat.FromJson(_client.EffectiveWindowsJson) ?? [];
        _fallbackRing = _rings.Count > 0 ? _rings[^1].Name : "the final ring";

        var entries = await Deployment.GetAsync(null, Id, null, CancellationToken.None);
        _health = ServerHealth.Evaluate(_client, entries.Any(e => e.State == DeploymentState.Failed), Time.GetUtcNow().UtcDateTime);

        _scriptRuns = await Db.ScriptRuns.AsNoTracking().Where(r => r.ClientId == Id).OrderByDescending(r => r.FinishedAtUtc).Take(50)
            .Select(r => new ScriptRunEntity { Id = r.Id, ClientId = r.ClientId, PackageId = r.PackageId, Phase = r.Phase, Action = r.Action, Result = r.Result, ExitCode = r.ExitCode, Detail = r.Detail, FinishedAtUtc = r.FinishedAtUtc, StartedAtUtc = r.StartedAtUtc })
            .ToListAsync();
        var installations = await Db.Installations.AsNoTracking()
            .Where(i => i.ClientId == Id)
            .OrderByDescending(i => i.FinishedAtUtc).ThenByDescending(i => i.Id)
            .Take(MaxHistory)
            .ToListAsync();
        _definitionIds = await DefinitionUpdates.CatalogIdsAsync(Db, _windowsHistory.Select(h => h.UpdateId), CancellationToken.None);
        var available = await Db.ClientAvailableUpdates.AsNoTracking().Where(a => a.ClientId == Id).Select(a => new { a.UpdateId, a.Revision }).ToListAsync();
        var now = Time.GetUtcNow().UtcDateTime;
        _livePhase = LiveStatus.CurrentPhase(_client, now);
        var liveIds = _livePhase is null ? [] : _client.ActivityUpdateIds;
        var ids = entries.Select(e => e.UpdateId).Concat(installations.Select(i => i.UpdateId)).Concat(liveIds).Distinct().ToList();
        var updates = await Db.Updates.AsNoTracking().Where(u => ids.Contains(u.UpdateId)).ToListAsync();
        string Title(Guid updateId, int revision) => UpdateText.Title(updates.FirstOrDefault(u => u.UpdateId == updateId && u.Revision == revision), updateId);
        string ClassificationOf(Guid updateId, int revision) => updates.FirstOrDefault(u => u.UpdateId == updateId && u.Revision == revision) is { } update
            ? update.Kind == UpdateKind.Software ? SUSyphos.Server.Software.SoftwarePackages.Classification : update.Classification ?? "Unknown"
            : "Unknown";

        // Missing = reported by the last search, or released and not installed yet.
        _open = [.. entries
            .Where(e => available.Any(a => a.UpdateId == e.UpdateId && a.Revision == e.Revision) || (e.EarliestInstallAtUtc is not null && e.State != DeploymentState.Successful))
            .OrderByDescending(e => e.State).ThenBy(e => e.EarliestInstallAtUtc)
            .Select(e => (e, Title(e.UpdateId, e.Revision)))];
        _softwareIds = [.. updates.Where(u => u.Kind == UpdateKind.Software).Select(u => u.UpdateId)];
        _packageOfUpdate = updates.Where(u => u.Kind == UpdateKind.Software && u.PackageId != null).GroupBy(u => u.UpdateId).ToDictionary(g => g.Key, g => g.First().PackageId!);
        _history = [.. installations.Select(i => (Installation: i, Title: Title(i.UpdateId, i.Revision), Category: ClassificationOf(i.UpdateId, i.Revision), Operation: "Installation", PackageId: (string?)null))];
        // What asked for the pending restart: installations by SUSyphos since the last start that reported one (Marc, 2026-11-22).
        _restartReasons = [.. _history.Where(h => h.Installation.RebootRequired && (_client?.LastBootAtUtc is not { } boot || h.Installation.FinishedAtUtc > boot)).Select(h => h.Title).Distinct().Take(5)];

        // Uninstallations of software (Marc, 2026-11-14) come from their remote actions: operation Uninstallation,
        // category Software, the result as the agent reported it.
        var uninstalls = await Db.AgentActions.AsNoTracking()
            .Where(a => a.ClientId == Id && a.PackageId != null && a.CompletedAtUtc != null
                && (a.Kind == SUSyphos.Contracts.Agents.AgentActionKind.Uninstall || a.Kind == SUSyphos.Contracts.Agents.AgentActionKind.UninstallRestartInWindow || a.Kind == SUSyphos.Contracts.Agents.AgentActionKind.UninstallInWindow)
                && (a.State == AgentActionState.Succeeded || a.State == AgentActionState.Failed || a.State == AgentActionState.Rejected))
            .OrderByDescending(a => a.CompletedAtUtc)
            .Take(MaxHistory)
            .ToListAsync();
        var packageNames = await Db.Packages.AsNoTracking().Where(p => uninstalls.Select(u => u.PackageId).Contains(p.PackageId)).ToDictionaryAsync(p => p.PackageId, p => p.Name, StringComparer.OrdinalIgnoreCase);
        _history = [.. _history.Concat(uninstalls.Select(a => (
            Installation: new InstallationEntity
            {
                ClientId = a.ClientId,
                RunId = a.Id,
                UpdateId = a.UpdateId ?? Guid.Empty,
                Revision = a.Revision ?? 0,
                ResultCode = (int)(a.State == AgentActionState.Succeeded ? SUSyphos.Contracts.Agents.InstallResultCode.Succeeded : SUSyphos.Contracts.Agents.InstallResultCode.Failed),
                HResult = a.State == AgentActionState.Succeeded ? 0 : unchecked((int)0x80004005),
                RebootRequired = a.State == AgentActionState.Succeeded && a.Detail?.Contains("restart", StringComparison.OrdinalIgnoreCase) == true,
                StartedAtUtc = a.CompletedAtUtc!.Value,
                FinishedAtUtc = a.CompletedAtUtc!.Value,
                Source = "SUSyphos",
            },
            Title: packageNames.GetValueOrDefault(a.PackageId!) ?? a.PackageId!,
            Category: SUSyphos.Server.Software.SoftwarePackages.Classification,
            Operation: "Uninstallation",
            PackageId: a.PackageId)))
            .OrderByDescending(h => h.Installation.FinishedAtUtc)
            .Take(MaxHistory)];
        _openTable = TableQuery.From(Navigation, "status", defaultDescending: true, prefix: "mu.", defaultPageSize: 10);
        _openPage = TablePaging.Apply(_open, _openTable, OpenColumns, o => o.Title);
        _historyTable = TableQuery.From(Navigation, "finished", defaultDescending: true, prefix: "hist.", defaultPageSize: 10, views: HistoryViews);
        _historyPage = TablePaging.Apply(_history, _historyTable, HistoryColumns, h => h.Title);
        _liveUpdates = [.. liveIds.Select(id => updates.Where(u => u.UpdateId == id).MaxBy(u => u.Revision) is { } update ? (id, update.Revision, UpdateText.Title(update, id)) : (id, 0, UpdateText.Title(null, id)))];

        // Preview: what the agent installs in the next window (released, not installed, due before the window closes).
        _now = Time.GetUtcNow().UtcDateTime;
        var securitySnapshot = await Baseline.LoadAsync(CancellationToken.None);
        _securitySnapshot = securitySnapshot;
        _securityHasData = securitySnapshot.HasData;
        _serverSecurity = securitySnapshot.Of(_client);
        _securityFixes = _serverSecurity.Build is { } securityBuild ? _serverSecurity.Open.ToDictionary(v => v.Cve, v => securitySnapshot.FixesOf(v.Cve).Where(f => f.Build == securityBuild).OrderByDescending(f => f.Revision).Select(f => f.Kb).FirstOrDefault()) : [];
        _cveTable = TableQuery.From(Navigation, SUSyphos.Server.Security.VulnerabilityColumns.DefaultSort, defaultDescending: true, prefix: "cve.", defaultPageSize: 10, views: SUSyphos.Server.Security.VulnerabilityColumns.Views);
        _cvePage = TablePaging.Apply([.. _serverSecurity.Open], _cveTable, VulnerabilityTable, SUSyphos.Server.Security.VulnerabilityColumns.SearchText);
        _window = NextWindowUtc();
        _planned = _window is { } window
            ? [.. _open.Where(o => o.Entry.EarliestInstallAtUtc is { } earliest && earliest <= window.End && o.Entry.State is DeploymentState.Pending or DeploymentState.Failed)]
            : [];
        _paused = await Pause.IsActiveAsync(CancellationToken.None);
        _tasks = BuildTasks(now);

        _windowsHistory = await Db.ClientUpdateHistory.AsNoTracking()
            .Where(h => h.ClientId == Id)
            .OrderByDescending(h => h.DateUtc).ThenBy(h => h.Id)
            .Take(MaxHistory)
            .ToListAsync();
        _activities = await Db.ClientActivities.AsNoTracking()
            .Where(a => a.ClientId == Id)
            .OrderByDescending(a => a.AtUtc).ThenByDescending(a => a.Id)
            .Take(MaxActivities)
            .ToListAsync();
        var historyIds = _windowsHistory.Select(h => h.UpdateId).Distinct().ToList();
        _categories = (await Db.Updates.AsNoTracking().Where(u => historyIds.Contains(u.UpdateId) && u.Classification != null).Select(u => new { u.UpdateId, u.Revision, u.Classification }).ToListAsync())
            .GroupBy(u => u.UpdateId).ToDictionary(g => g.Key, g => g.MaxBy(u => u.Revision)!.Classification!);
        _windowsTable = TableQuery.From(Navigation, "date", defaultDescending: true, prefix: "wu.", defaultPageSize: 10, views: WindowsViews);
        _windowsPage = TablePaging.Apply(_windowsHistory, _windowsTable, WindowsColumns, h => h.Title);
        _activityTable = TableQuery.From(Navigation, "time", defaultDescending: true, prefix: "act.", defaultPageSize: 10);
        _activityPage = TablePaging.Apply(_activities, _activityTable, ActivityColumns, a => $"{ClientActivityLog.Label(a.Kind)} {a.Detail}");
        _externalInstalls = _windowsHistory.Count(h => h.Operation == SUSyphos.Contracts.Agents.UpdateOperation.Installation && StartedBy(h).Kind == "queue");
    }

