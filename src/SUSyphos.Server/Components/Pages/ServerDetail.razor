        await LoadAsync();
    }

    /// <summary>One line for the System box: whether the agent applies the central values.</summary>
    private (string Text, string Kind) AppliedSummary
    {
        get
        {
            if (_appliedSettings.Count == 0)
            {
                return ("not reported", "neutral");
            }

            var marks = _agentSettings.Select(e => SUSyphos.Server.Assignment.AppliedAgentSettings.Compare(e.Definition, e.Value, _appliedSettings.GetValueOrDefault(e.Definition.Key))).OfType<(string Text, string Kind, string Title)>().ToList();
            var local = marks.Count(m => m.Kind == "queue");
            return local > 0 ? ($"{local} set differently on the server", "queue")
                : marks.Count > 0 ? ($"{marks.Count} not applied yet", "neutral")
                : ("applied as set", "ok");
        }
    }

    private async Task SaveSettingAsync()
    {
        var form = HttpContext?.Request.HasFormContentType == true ? HttpContext.Request.Form : null;
        var key = form?["SettingKey"].ToString();
        if (!await IsAuthorizedAsync(AdminRoles.Policies.Administer) || form is null || string.IsNullOrEmpty(key))
        {
            ShowResult("Only administrators can change agent settings.", string.Empty);
            await LoadAsync();
            return;
        }

        var value = form["Inherit"] == "yes" ? null : form["Value"].ToString();
        var outcome = await Administration.SetClientAgentSettingAsync(Id, key, value, await GetActorAsync(), CancellationToken.None);
        if (outcome.Succeeded)
        {
            Navigation.NavigateTo(ServerPage.Link(Id, "assignment"));
            return;
        }

        _settingError = outcome.Error;
        await LoadAsync();
    }

    private async Task ResetSettingAsync()
    {
        var form = HttpContext?.Request.HasFormContentType == true ? HttpContext.Request.Form : null;
        var key = form?["ResetKey"].ToString();
        if (!await IsAuthorizedAsync(AdminRoles.Policies.Administer) || string.IsNullOrEmpty(key))
        {
            ShowResult("Only administrators can change agent settings.", string.Empty);
            await LoadAsync();
            return;
        }

        var outcome = await Administration.SetClientAgentSettingAsync(Id, key, null, await GetActorAsync(), CancellationToken.None);
        ShowResultAndReload(outcome.Error, "The setting takes the inherited value again; the agent applies it with its next heartbeat.");
        await LoadAsync();
    }

    private async Task SaveAsync()
    {
        if (!await IsAuthorizedAsync(AdminRoles.Policies.Administer))
        {
            ShowResult("Only administrators can change the assignment.", string.Empty);
            await LoadAsync();
            return;
        }

        int? ring = null;
        if (!string.IsNullOrEmpty(Ring))
        {
            if (!int.TryParse(Ring, System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out var parsed))
            {
                ShowResult("Invalid ring.", string.Empty);
                await LoadAsync();
                return;
            }

            ring = parsed;
        }

        var groups = new List<int>();
        foreach (var value in Groups ?? [])
        {
            if (!int.TryParse(value, System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out var group))
            {
                ShowResult("Invalid group.", string.Empty);
                await LoadAsync();
                return;
            }

            groups.Add(group);
        }

        // Add, remove and preview of the picker show the rows again without saving.
        if (HttpContext?.Request.HasFormContentType == true && WindowPickerForm.ReadEdit(HttpContext.Request.Form, "Windows") is { } draft)
        {
            _windowDraft = draft;
            return;
        }

        var actor = await GetActorAsync();
        var windows = HttpContext?.Request.HasFormContentType == true ? WindowPickerForm.Read(HttpContext.Request.Form, "Windows", out _) : string.Empty;
        var outcome = !RebootPolicyText.TryParse(Reboot, out var reboot) ? new Outcome("The reboot policy is invalid.")
            : AutomaticUpdates is not (null or "" or "leave" or "prevent") ? new Outcome("The Automatic Updates setting is invalid.")
            : MicrosoftUpdate is not (null or "" or "windows" or "microsoft") ? new Outcome("The Microsoft Update setting is invalid.")
            : await Administration.SetClientAssignmentAsync(Id, ring, groups, windows, actor, CancellationToken.None);
        if (outcome.Succeeded)
        {
            outcome = await Administration.SetClientRebootPolicyAsync(Id, reboot, actor, CancellationToken.None);
        }

        if (outcome.Succeeded)
        {
            bool? manage = AutomaticUpdates switch { "prevent" => true, "leave" => false, _ => null };
            bool? microsoft = MicrosoftUpdate switch { "microsoft" => true, "windows" => false, _ => null };
            outcome = await Administration.SetClientUpdateSourceAsync(Id, manage, microsoft, actor, CancellationToken.None);
        }

        ShowResultAndReload(outcome.Error, "The assignment was saved.");
        await LoadAsync();
    }

    /// <summary>Value of the pressed action button: "queue:{kind}" or "cancel:{action id}".</summary>
    [SupplyParameterFromForm(FormName = "action")]
    private string? RemoteAction { get; set; }

    [SupplyParameterFromForm(FormName = "action")]
    private string? ConfirmRestart { get; set; }

    private bool _canOperate;
    private List<AgentActionEntity> _actions = [];

    private async Task HandleActionAsync()
    {
        Outcome outcome;
        string success;
        if (!await IsAuthorizedAsync(AdminRoles.Policies.Operate))
        {
            (outcome, success) = (new Outcome("Only operators and administrators can request remote actions."), string.Empty);
        }
        else if (RemoteAction?.Split(':', 2) is ["queue", var kindText]
            && Enum.TryParse<SUSyphos.Contracts.Agents.AgentActionKind>(kindText, ignoreCase: false, out var kind)
            && Enum.IsDefined(kind)
            && !int.TryParse(kindText, out _))
        {
            if (kind is SUSyphos.Contracts.Agents.AgentActionKind.RestartServer or SUSyphos.Contracts.Agents.AgentActionKind.InstallNow or SUSyphos.Contracts.Agents.AgentActionKind.InstallNowRestartInWindow
                && !await IsAuthorizedAsync(AdminRoles.Policies.Administer))
            {
                (outcome, success) = (new Outcome("Only administrators can restart a server or install outside the maintenance window."), string.Empty);
            }
            else if (kind == SUSyphos.Contracts.Agents.AgentActionKind.RestartServer && ConfirmRestart != "yes")
            {
                (outcome, success) = (new Outcome("Confirm the restart with the checkbox first."), string.Empty);
            }
            else
            {
                (outcome, success) = (await Actions.QueueAsync(Id, kind, await GetActorAsync(), CancellationToken.None), "The action was queued; the agent picks it up with its next heartbeat.");
            }
        }
        else if (RemoteAction?.Split(':', 2) is ["cancel", var idText] && Guid.TryParse(idText, out var actionId))
        {
            (outcome, success) = (await Actions.CancelAsync(Id, actionId, await GetActorAsync(), CancellationToken.None), "The action was cancelled.");
        }
        else
        {
            (outcome, success) = (new Outcome("Invalid request."), string.Empty);
        }

        ShowResultAndReload(outcome.Error, success);
        await LoadAsync();
    }

    /// <summary>The state of a remote action; an uninstallation the agent fetched waits for its window or the lease of its group.</summary>
    private static string ActionStateLabel(AgentActionEntity action) =>
        action.State == AgentActionState.Delivered && SUSyphos.Server.Agents.AgentActionService.IsHeld(action.Kind) ? "Waiting (window or lease)" : action.State.ToString();

    private static string ActionClass(AgentActionState state) => state switch
    {
        AgentActionState.Succeeded => "ok",
        AgentActionState.Queued or AgentActionState.Delivered => "pend",
        AgentActionState.Failed or AgentActionState.Rejected or AgentActionState.Expired => "fail",
        _ => "neutral",
    };

