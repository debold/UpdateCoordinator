@page "/servers/{Id:guid}"
@attribute [Authorize(Policy = AdminRoles.Policies.Read)]
@inherits DashboardPageBase
@using SUSyphos.Server.Assignment
@using SUSyphos.Server.Agents
@using SUSyphos.Server.Components.Shared
@inject ServerDbContext Db
@inject AssignmentAdministration Administration
@inject DeploymentStatus Deployment
@inject SUSyphos.Server.Agents.AgentActionService Actions
@inject SUSyphos.Server.Approval.ClientLifecycle Lifecycle
@inject TimeProvider Time
@inject SUSyphos.Server.Agents.GlobalPause Pause
@inject SUSyphos.Server.AgentPackages.AgentUpdateService AgentUpdates

<PageTitle>@(_client?.HostName ?? "Server")</PageTitle>

@if (_client is null)
{
    <PageHeader Title="Server not found" Crumbs="@([("Servers", "/servers"), ("Not found", null)])" />
    <Box><p>The server does not exist or was deleted with its history. <a href="/servers">Back to the server list</a></p></Box>
}
else
{
    <PageHeader Title="@_client.HostName" Icon="@PageIcons.Servers" Subtitle="@Subtitle" Help="server-detail" Crumbs="@([("Servers", "/servers"), (_client.HostName, null)])" />
    <StatusMessage Text="@Message" IsError="@MessageIsError" />

    @if (RestartQueuedText is { } restartText)
    {
        <form method="post" @formname="cancel-restart" @onsubmit="CancelRestartAsync" class="restart-banner help-scope" role="status">
            <AntiforgeryToken />
            <span class="pill fail">Restart queued</span>
            <span>@restartText</span><HelpLink To="server-detail#restart-queued" Label="Queued restart" />
            <AuthorizeView Policy="@AdminRoles.Policies.Administer" Context="cancelRestart">
                <button type="submit" class="danger">Cancel restart</button>
            </AuthorizeView>
        </form>
    }

    <ActionBand>
        <AuthorizeView Policy="@AdminRoles.Policies.Operate" Context="operate">
            <form id="actions" method="post" @formname="action" @onsubmit="HandleActionAsync">
                <AntiforgeryToken />
                <button type="submit" name="RemoteAction" value="queue:SearchNow" class="primary">Search for updates</button>
                <button type="submit" name="RemoteAction" value="queue:FullResync">Sync inventory</button>
                <button type="submit" name="RemoteAction" value="queue:UploadLogs">Request logs</button>
                <button type="submit" name="RemoteAction" value="queue:RestartService">Restart agent service</button>
            </form>
        </AuthorizeView>
        <a class="btn" href="@AddressWithoutMessage" title="Load the page again with the latest state">Refresh</a>
        @if (IsBusy)
        {
            <span class="note">updates every @LiveRefreshSeconds seconds while the agent works or an action waits</span>
        }
        <AuthorizeView Policy="@AdminRoles.Policies.Administer" Context="administer">
            <a class="btn" href="@DialogLink("restart")">Restart server…</a>
            <div class="spacer"></div>
            <a class="btn danger" href="@DialogLink("remove")">Remove server…</a>
            <a class="btn danger" href="@DialogLink("purge")">Delete with history…</a>
        </AuthorizeView>
    </ActionBand>

    <section class="figures" aria-label="Status">
        <a class="tile @(_health == ServerHealthState.Failed ? "attention-tile" : null)" href="/servers/@Id#checks">
            <span class="go">Show ›</span>
            <div class="label">Status</div>
            <div class="value"><span class="pill @ServerHealth.PillClass(_health)">@ServerHealth.Label(_health)</span></div>
            <div class="detail" title="agent @_client.AgentVersion">@_client.State · agent @AgentVersion.ShortForm(_client.AgentVersion)</div>
        </a>
        <a class="tile" href="/servers/@Id#missing">
            <span class="go">Show ›</span>
            <div class="label">Pending updates</div>
            <div class="value">@_open.Count(o => o.Entry.EarliestInstallAtUtc is not null && o.Entry.State != DeploymentState.Successful)</div>
            <div class="detail">released for this server, not installed yet</div>
        </a>
        <div class="tile">
            <div class="label">Next maintenance window</div>
            <div class="value small-value">@NextWindowText</div>
        </div>
        <div class="tile">
            <div class="label">Last heartbeat</div>
            <div class="value small-value">@Format(_client.LastHeartbeatAtUtc)</div>
            <div class="detail">last boot @Format(_client.LastBootAtUtc)@(_client.RebootPending ? " · reboot pending" : string.Empty)</div>
        </div>
    </section>

    @if (IsBusy && Dialog is null && HttpMethods.IsGet(HttpContext?.Request.Method ?? string.Empty))
    {
        @* Reload while the agent works or an action waits for it; not after a form post, so unsaved input is never lost. *@
        <HeadContent><meta http-equiv="refresh" content="@($"{LiveRefreshSeconds}; url={AddressWithoutMessage}")" /></HeadContent>
    }
    <Box Title="Tasks" Anchor="tasks" Help="server-detail#tasks" Hint="@(_livePhase is null ? "what the agent does next, in order; heartbeats are not listed" : $"running now; the page updates every {LiveRefreshSeconds} seconds while the agent works")" Flush="true">
        @if (_livePhase is { } livePhase)
        {
            <div class="box-body">
                <p class="live-line">
                    <span class="pill pend">Running</span>
                    <b>@LiveStatus.PhaseLabel(livePhase)</b>
                    @if (_client.ActivityPercent is { } percent)
                    {
                        <progress max="100" value="@percent" aria-label="Progress">@percent %</progress>
                        <span>@percent %</span>
                    }
                    <span class="note">since @Format(_client.ActivityStartedAtUtc)</span>
                </p>
                @if (_liveUpdates.Count > 0)
                {
                    <ul class="plain">
                        @foreach (var (updateId, revision, title) in _liveUpdates)
                        {
                            <li>@if (revision > 0) { <a href="/updates/@updateId/@revision">@title</a> } else { <span>@title</span> }</li>
                        }
                    </ul>
                }
            </div>
        }
        <div class="scroll">
            <table>
                <thead><tr><th>When</th><th>Task</th><th>Details</th></tr></thead>
                <tbody>
                    @if (_tasks.Count == 0)
                    {
                        <tr><td colspan="3" class="note">Nothing planned yet; agents from version 0.7.1 report when they search and collect the inventory next.</td></tr>
                    }
                    @foreach (var task in _tasks)
                    {
                        <tr>
                            <td class="nowrap">@task.When</td>
                            <td class="nowrap"><span class="pill @task.Class">@task.Kind</span></td>
                            <td class="wrap">
                                @task.Detail
                                @if (task.Updates.Count > 0)
                                {
                                    <ul class="plain task-updates">
                                        @foreach (var (entry, title) in task.Updates)
                                        {
                                            <li><a href="/updates/@entry.UpdateId/@entry.Revision">@title</a>@if (entry.State == DeploymentState.Failed) { <span class="pill fail">tried again</span> }</li>
                                        }
                                    </ul>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </Box>
    <div class="grid-side">
        <AuthorizeView Policy="@AdminRoles.Policies.Administer" Context="assign">
            <Authorized>
                <form method="post" @formname="assignment" @onsubmit="SaveAsync" class="box">
                    <AntiforgeryToken />
                    <header class="box-head"><h2>Assignment<HelpLink To="server-detail#assignment" Label="Assignment" /></h2><span class="hint">Saved configuration of this server; empty values inherit</span></header>
                    <div class="box-body form">
                        <div class="form-row">
                            <label class="field"><span>Ring</span>
                                <select name="Ring">
                                    <option value="" selected="@(_client.ManualRingId is null)">Automatic: assignment rules, else @_fallbackRing (now @RingName(_client.RingId))</option>
                                    @foreach (var ring in _rings)
                                    {
                                        <option value="@ring.Id" selected="@(_client.ManualRingId == ring.Id)">@ring.Name</option>
                                    }
                                </select>
                            </label>
                            <label class="field"><span>Reboots</span>
                                <select name="Reboot">
                                    <option value="" selected="@(_client.RebootPolicy is null)">Inherit from groups or system (now @RebootPolicyText.Label(_client.EffectiveRebootPolicy))</option>
                                    @foreach (var policy in Enum.GetValues<SUSyphos.Contracts.Agents.RebootPolicy>())
                                    {
                                        <option value="@policy" selected="@(_client.RebootPolicy == policy)">@RebootPolicyText.Label(policy)</option>
                                    }
                                </select>
                            </label>
                        </div>
                        <div class="field">
                            <span class="field-label">Groups</span>
                            <MultiSelect Name="Groups" Placeholder="No group"
                                         Options="@([.. _groups.Take(MultiSelect.MaxOptions).Select(g => (g.Id.ToString(System.Globalization.CultureInfo.InvariantCulture), g.Name))])"
                                         Selected="@([.. _memberships.Where(m => m.Manual).Select(m => m.GroupId.ToString(System.Globalization.CultureInfo.InvariantCulture))])"
                                         Fixed="@([.. _memberships.Where(m => !m.Manual).Select(m => $"{GroupName(m.GroupId)} (rule)")])">
                                <Empty><span class="note">No group exists yet. <a href="/administration/groups">Create groups</a></span></Empty>
                            </MultiSelect>
                            <span class="help">Groups from assignment rules are added automatically.</span>
                        </div>
                        <div class="field">
                            <span class="field-label">Maintenance windows</span>
                            <WindowPicker Prefix="Windows" Windows="@_ownWindows" Draft="@_windowDraft" InheritedWindows="@_effectiveWindows" AllowInherit="true" Inherited="@(_ownWindows.Count == 0)" InheritLabel="Inherit from groups or the system default" />
                        </div>
                    </div>
                    <footer class="box-foot">
                        <span class="note">Applies with the server's next heartbeat.</span>
                        <span class="actions"><a class="btn" href="/servers/@Id">Discard changes</a><button type="submit" class="primary">Save assignment</button></span>
                    </footer>
                </form>
            </Authorized>
            <NotAuthorized>
                <Box Title="Assignment" Help="server-detail#assignment">
                    <dl class="facts">
                        <dt>Ring</dt><dd>@RingName(_client.RingId) @(_client.ManualRingId is null ? "(automatic)" : "(manual)")</dd>
                        <dt>Groups</dt><dd>@(_memberships.Count > 0 ? string.Join(", ", _memberships.Select(m => GroupName(m.GroupId))) : "–")</dd>
                        <dt>Maintenance windows</dt><dd>@(_effectiveWindows.Count > 0 ? WindowPickerForm.Describe(_effectiveWindows) : "none")</dd>
                        <dt>Reboots</dt><dd>@RebootPolicyText.Label(_client.EffectiveRebootPolicy)</dd>
                    </dl>
                </Box>
            </NotAuthorized>
        </AuthorizeView>

        <Box Title="System" Help="server-detail#system">
            <dl class="facts">
                <dt>Operating system</dt><dd>@OperatingSystems.Name(_client.OsProductName, _client.OsVersion)@(_client.OsEditionId is { Length: > 0 } edition ? $" ({edition})" : string.Empty)</dd>
                <dt>Build</dt><dd class="mono">@OperatingSystems.Build(_client.OsVersion)</dd>
                <dt>Domain</dt><dd>@(_client.DomainName ?? "–")</dd>
                <dt>Roles</dt><dd>@(_client.Roles.Count > 0 ? string.Join(", ", _client.Roles) : "–")</dd>
                <dt>Update source</dt><dd>@(_client.WsusServer is { } wsus ? $"WSUS {wsus}" : "Windows Update")</dd>
                <dt>Agent update</dt><dd>@if (_client.AgentUpdateError is { } agentError) { <span class="pill fail">failed</span> <span>@agentError</span> } else { <a href="@Servers.Link("agent", AgentVersion.ShortForm(_client.AgentVersion))" title="@_client.AgentVersion: show all servers with this agent version" class="mono">@AgentVersion.ShortForm(_client.AgentVersion)</a> }@if (AgentUpdates.IsBelowMinimum(_client.AgentVersion)) { <span class="pill fail">below minimum @AgentUpdates.Minimum</span> }</dd>
                <dt>Automatic updates</dt><dd>@if (_client.AutoUpdateMode is null) { <span class="note">reported by agents from version 0.3</span> } else if (_client.AutomaticUpdatesBypass) { <span class="pill fail">problem</span> <span>Windows may install or restart on its own, outside rings and windows (<a href="/servers/@Id#checks">details</a>); setting: @AutomaticUpdatesText.Describe(_client.AutoUpdateMode, _client.AutomaticUpdatesByPolicy, _client.AutomaticUpdatesManagedByAgent)</span> } else { <span class="pill ok">OK</span> <span>Windows does not install on its own; setting: @AutomaticUpdatesText.Describe(_client.AutoUpdateMode, _client.AutomaticUpdatesByPolicy, _client.AutomaticUpdatesManagedByAgent)</span> }</dd>
                <dt>Restart</dt><dd>@if (!_client.RebootPending) { <span>not pending</span> } else if (_client.RebootWait is { } wait) { <span class="pill queue">pending</span> <span>@LiveStatus.RebootWaitText(wait) (policy: @RebootPolicyText.Label(_client.EffectiveRebootPolicy))</span> } else { <span class="pill queue">pending</span> <span>the agent reports why it waits from version 0.7 (policy: @RebootPolicyText.Label(_client.EffectiveRebootPolicy))</span> }</dd>
                <dt>Outside SUSyphos</dt><dd>@if (_externalInstalls > 0) { <span class="pill queue">@_externalInstalls</span> <span>installations in the last @SUSyphos.Contracts.Agents.UpdateHistoryEntry.HistoryDays days were started by Windows or an administrator, not by SUSyphos (<a href="/servers/@Id#windows-history">history</a>)</span> } else { <span>none in the reported history</span> }</dd>
                <dt>Time zone</dt><dd>@(_client.TimeZoneId ?? "reported with the next inventory")</dd>
                <dt>Uptime</dt><dd>@UptimeText</dd>
                <dt>Last update search</dt><dd>@if (_client.LastSearchAtUtc is null) { <span>none reported yet</span> } else if (_client.LastSearchSucceeded == true) { <span class="pill ok">OK</span> <span>@Format(_client.LastSearchAtUtc)</span> } else { <span class="pill fail">failed</span> <span>@Format(_client.LastSearchAtUtc) (<a href="/servers/@Id#missing">details</a>)</span> }</dd>
                <dt>Registered</dt><dd>@Format(_client.RegisteredAtUtc)</dd>
            </dl>
        </Box>
    </div>

    <Box Title="Missing updates" Anchor="missing" Help="server-detail#missing" Flush="true">
        <ListTable Table="_openTable" Page="_openPage" Columns="OpenColumns" Search="Search update" Noun="updates" Empty="The last search reported no missing update.">
            <Row Context="row">
                <tr>
                    <td class="wrap"><a href="/updates/@row.Entry.UpdateId/@row.Entry.Revision">@row.Title</a></td>
                    <td><span class="pill @DeploymentText.PillClass(row.Entry.State)">@OpenStatus(row.Entry)</span></td>
                    <td class="nowrap">@Format(row.Entry.EarliestInstallAtUtc)</td>
                    <td>@(row.Entry.HResult is { } hresult ? string.Create(System.Globalization.CultureInfo.InvariantCulture, $"0x{hresult:X8}: {SUSyphos.Server.Agents.HResultCatalog.Describe(hresult)}") : null)</td>
                </tr>
            </Row>
        </ListTable>
    </Box>

    <Box Title="Pre-flight checks" Anchor="checks" Help="server-detail#checks" Hint="@(_client.LastSearchAtUtc is { } searched ? $"{Format(searched)}" : null)" Flush="true">
        @if (_client.HealthChecks.Count == 0)
        {
            <div class="empty-state">No update run reported yet.</div>
        }
        else
        {
            <div class="scroll">
                <table>
                    <thead><tr><th>Check</th><th>Result</th><th>Details</th></tr></thead>
                    <tbody>
                        @foreach (var check in _client.HealthChecks.OrderByDescending(c => c.Status))
                        {
                            <tr>
                                <td class="nowrap">@CheckName(check.Name)</td>
                                <td><span class="pill @CheckClass(check.Status)">@((SUSyphos.Contracts.Agents.HealthStatus)check.Status)</span></td>
                                <td class="wrap">@check.Detail</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        @if (_client.LastSearchSucceeded == false)
        {
            <div class="box-body"><p class="error">Last update search failed: @string.Create(System.Globalization.CultureInfo.InvariantCulture, $"0x{_client.LastSearchHResult ?? 0:X8}") @SUSyphos.Server.Agents.HResultCatalog.Describe(_client.LastSearchHResult ?? 0)</p></div>
        }
    </Box>

    <Box Title="Update history" Anchor="history" Help="server-detail#history" Flush="true">
        <ListTable Table="_historyTable" Page="_historyPage" Columns="HistoryColumns" Search="Search update" Noun="installations" Empty="No installation reported yet.">
            <Row Context="row">
                <tr>
                    <td class="nowrap">@Format(row.Installation.FinishedAtUtc)</td>
                    <td class="wrap"><a href="/updates/@row.Installation.UpdateId/@row.Installation.Revision">@row.Title</a></td>
                    <td>@row.Installation.Source</td>
                    <td>@ResultText(row.Installation)</td>
                    <td>@RebootText(row.Installation)</td>
                </tr>
            </Row>
        </ListTable>
    </Box>

    <Box Title="Windows Update history" Anchor="windows-history" Help="server-detail#windows-history" Hint="@($"last {SUSyphos.Contracts.Agents.UpdateHistoryEntry.HistoryDays} days as recorded by Windows, including installations outside SUSyphos; updated with the inventory")" Flush="true">
        <ListTable Table="_windowsTable" Page="_windowsPage" Columns="WindowsColumns" Search="Search update" Noun="entries" Empty="Nothing reported yet; agents from version 0.7 send the history with their inventory.">
            <Row Context="entry">
                        <tr>
                            <td class="nowrap">@Format(entry.DateUtc)</td>
                            <td class="wrap">@entry.Title</td>
                            <td>@entry.Operation</td>
                            <td>@UpdateHistoryText.Result(entry.ResultCode, entry.HResult)</td>
                            <td>@if (UpdateHistoryText.IsAgent(entry.ClientApplicationId)) { <span class="pill ok">SUSyphos</span> } else { <span class="pill queue">outside SUSyphos</span> <span>@UpdateHistoryText.Source(entry.ClientApplicationId)</span> }</td>
                        </tr>
            </Row>
        </ListTable>
    </Box>

    <Box Title="Recent activity" Anchor="activity" Help="server-detail#activity" Hint="@($"what the agent did and reported, newest first; kept for {ClientActivityLog.Retention.TotalDays:0} days, heartbeats are not listed")" Flush="true">
        <ListTable Table="_activityTable" Page="_activityPage" Columns="ActivityColumns" Search="Search activity or detail" Noun="entries" Empty="No activity recorded yet.">
            <Row Context="entry">
                <tr>
                    <td class="nowrap">@Format(entry.AtUtc)</td>
                    <td class="nowrap">@ClientActivityLog.Label(entry.Kind)</td>
                    <td class="wrap">@entry.Detail</td>
                </tr>
            </Row>
        </ListTable>
    </Box>

    <Box Title="Remote actions" Help="server-detail#remote-actions" Hint="The agent picks actions up with its next heartbeat; the central server never connects to the agent." Flush="true">
        <ListTable Table="_actionTable" Page="_actionPage" Columns="ActionColumns" Search="Search action, user or detail" Noun="actions" Empty="No action requested yet." ExtraColumns="1">
            <ExtraHeader><th></th></ExtraHeader>
            <Row Context="action">
                        <tr>
                            <td class="nowrap">@Format(action.RequestedAtUtc)</td>
                            <td>@ActionLabel(action.Kind)</td>
                            <td>@action.RequestedBy</td>
                            <td><span class="pill @ActionClass(action.State)">@action.State</span></td>
                            <td>
                                @action.Detail
                                @if (action.LogFileSize is { } size && _canOperate)
                                {
                                    <a href="@AgentLogEndpoints.DownloadPath(action.Id)">Download (@(size / 1024) KB)</a>
                                }
                            </td>
                            <td class="n">
                                @if (action.State == AgentActionState.Queued && _canOperate)
                                {
                                    <span class="row-actions"><button type="submit" form="actions" name="RemoteAction" value="cancel:@action.Id">Cancel</button></span>
                                }
                            </td>
                        </tr>
            </Row>
        </ListTable>
    </Box>

    @if (Dialog == "restart")
    {
        <Dialog Title="@($"Restart {_client.HostName}?")" CloseHref="@($"/servers/{Id}")" Help="server-detail#restart">
            <form method="post" @formname="restart" @onsubmit="RestartAsync">
                <AntiforgeryToken />
                <div class="dialog-body">
                    <p><b>Now:</b> the agent restarts the server with its next heartbeat, also outside the maintenance window, after a five minute warning.</p>
                    <p><b>In the next maintenance window:</b> the agent restarts the server once a window is open for at least 30 more minutes (next window: @NextWindowText), also if its reboot policy is "Never"; in a coordinated group it waits for a free slot. It reports the planned time.</p>
                    <p class="note">A local veto on the server (registry value AllowReboot) applies to both. A queued restart can be cancelled until it happens.</p>
                </div>
                <div class="dialog-foot"><a class="btn" href="/servers/@Id">Cancel</a><button type="submit" name="When" value="window">Restart in the next maintenance window</button><button type="submit" name="When" value="now" class="danger">Restart now</button></div>
            </form>
        </Dialog>
    }
    else if (Dialog is "remove" or "purge")
    {
        <Dialog Title="@(Dialog == "purge" ? $"Delete {_client.HostName} with its history?" : $"Remove {_client.HostName}?")" CloseHref="@($"/servers/{Id}")" Help="server-detail#remove">
            <form method="post" @formname="remove" @onsubmit="RemoveAsync">
                <AntiforgeryToken />
                <input type="hidden" name="ConfirmRemove" value="yes" />
                <div class="dialog-body">
                    @if (Dialog == "purge")
                    {
                        <p>The server and all its data (history, installations, actions) are deleted for good. This cannot be undone.</p>
                    }
                    else
                    {
                        <p>The history is kept, open releases, actions and leases are cancelled and the credentials end. If the agent still runs, it registers again as a new pending server.</p>
                    }
                </div>
                <div class="dialog-foot"><a class="btn" href="/servers/@Id">Cancel</a><button type="submit" name="Remove" value="@(Dialog == "purge" ? "hard" : "soft")" class="danger">@(Dialog == "purge" ? "Delete with history" : "Remove server")</button></div>
            </form>
        </Dialog>
    }
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    [SupplyParameterFromForm(FormName = "assignment")]
    private string? Ring { get; set; }

    [SupplyParameterFromForm(FormName = "assignment")]
    private string[]? Groups { get; set; }

    [SupplyParameterFromForm(FormName = "assignment")]
    private string? Reboot { get; set; }

    /// <summary>Confirmation dialog the address asks for: restart, remove or purge.</summary>
    [SupplyParameterFromQuery(Name = "dialog")]
    private string? Dialog { get; set; }

    [CascadingParameter]
    private Microsoft.AspNetCore.Http.HttpContext? HttpContext { get; set; }

    private IReadOnlyList<SUSyphos.Contracts.Agents.MaintenanceWindow> _ownWindows = [];
    private IReadOnlyList<SUSyphos.Contracts.Agents.MaintenanceWindow> _effectiveWindows = [];
    private string _fallbackRing = "Production";

    private string DialogLink(string dialog) => $"/servers/{Id}?dialog={dialog}";

    private string Subtitle => _client is null
        ? string.Empty
        : $"{(_client.DomainName is { Length: > 0 } domain ? $"{_client.HostName.ToLowerInvariant()}.{domain}" : _client.HostName)} · {OperatingSystems.Name(_client.OsProductName, _client.OsVersion)}, build {OperatingSystems.Build(_client.OsVersion)} · ring {RingName(_client.RingId)}";

    [SupplyParameterFromForm(FormName = "restart")]
    private string? When { get; set; }

    private async Task RestartAsync()
    {
        var kind = When switch
        {
            "now" => SUSyphos.Contracts.Agents.AgentActionKind.RestartServer,
            "window" => SUSyphos.Contracts.Agents.AgentActionKind.RestartServerInWindow,
            _ => (SUSyphos.Contracts.Agents.AgentActionKind?)null,
        };
        var outcome = !await IsAuthorizedAsync(AdminRoles.Policies.Administer)
            ? new Outcome("Only administrators can restart a server.")
            : kind is null
                ? new Outcome("Choose when the server restarts.")
                : await Actions.QueueAsync(Id, kind.Value, await GetActorAsync(), CancellationToken.None);
        ShowResultAndReload(outcome.Error, kind == SUSyphos.Contracts.Agents.AgentActionKind.RestartServer
            ? "The restart was queued; the agent restarts the server after its next heartbeat and a five minute warning."
            : "The restart was queued for the next maintenance window; the agent reports the planned time with its next heartbeat.");
        Dialog = null;
        await LoadAsync();
    }

    /// <summary>Cancels a queued restart action, or asks the agent to drop a restart it holds or has announced.</summary>
    private async Task CancelRestartAsync()
    {
        Outcome outcome;
        string success;
        if (!await IsAuthorizedAsync(AdminRoles.Policies.Administer))
        {
            (outcome, success) = (new Outcome("Only administrators can cancel a restart."), string.Empty);
        }
        else if (await Db.AgentActions.AsNoTracking().Where(a => a.ClientId == Id && a.State == AgentActionState.Queued && RestartKinds.Contains(a.Kind)).Select(a => (Guid?)a.Id).FirstOrDefaultAsync() is { } queued)
        {
            (outcome, success) = (await Actions.CancelAsync(Id, queued, await GetActorAsync(), CancellationToken.None), "The restart was cancelled before the agent picked it up.");
        }
        else
        {
            (outcome, success) = (await Actions.QueueAsync(Id, SUSyphos.Contracts.Agents.AgentActionKind.CancelRestart, await GetActorAsync(), CancellationToken.None), "The cancellation was queued; the agent drops the restart with its next heartbeat.");
        }

        ShowResultAndReload(outcome.Error, success);
        await LoadAsync();
    }

    private static readonly SUSyphos.Contracts.Agents.AgentActionKind[] RestartKinds = [SUSyphos.Contracts.Agents.AgentActionKind.RestartServer, SUSyphos.Contracts.Agents.AgentActionKind.RestartServerInWindow];

    /// <summary>What is known about a queued restart: requested by whom, and when the agent will restart; null if none is queued.</summary>
    private string? RestartQueuedText
    {
        get
        {
            if (_client is null)
            {
                return null;
            }

            var cancelling = _actions.Any(a => a.Kind == SUSyphos.Contracts.Agents.AgentActionKind.CancelRestart && a.State is AgentActionState.Queued or AgentActionState.Delivered);
            var pending = _actions.FirstOrDefault(a => RestartKinds.Contains(a.Kind) && a.State is AgentActionState.Queued or AgentActionState.Delivered);
            if (cancelling)
            {
                return "Cancellation requested; the agent drops the restart with its next heartbeat.";
            }

            if (pending is not null)
            {
                return pending.Kind == SUSyphos.Contracts.Agents.AgentActionKind.RestartServer
                    ? $"Requested by {pending.RequestedBy} at {Format(pending.RequestedAtUtc)}: restart now, after a five minute warning. Waiting for the agent to pick it up."
                    : $"Requested by {pending.RequestedBy} at {Format(pending.RequestedAtUtc)}: restart in the next maintenance window. Waiting for the agent to pick it up.";
            }

            if (_client.RestartRequested)
            {
                var requested = _actions.FirstOrDefault(a => a.Kind == SUSyphos.Contracts.Agents.AgentActionKind.RestartServerInWindow && a.State == AgentActionState.Succeeded);
                var by = requested is null ? string.Empty : $"Requested by {requested.RequestedBy} at {Format(requested.RequestedAtUtc)}. ";
                var when = _client.RebootWait == SUSyphos.Contracts.Agents.RebootWait.Restarting
                    ? "The agent is restarting the server now."
                    : _client.PlannedRestartAtUtc is { } planned ? $"The agent plans the restart for {Format(planned)}" + (_client.RebootWait is { } wait ? $"; {LiveStatus.RebootWaitText(wait)}." : ".") : "The agent has not reported a planned time (no maintenance window?).";
                return by + when;
            }

            return null;
        }
    }

