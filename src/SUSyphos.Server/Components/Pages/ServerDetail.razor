    /// <summary>One planned task of the agent; Sort orders by time, unknown times ("next heartbeat") first.</summary>
    private sealed record PlannedTask(DateTime Sort, string When, string Kind, string Class, string Detail, IReadOnlyList<(DeploymentEntry Entry, string Title)> Updates);

    private List<PlannedTask> _tasks = [];

    /// <summary>
    /// What the agent does next: queued remote actions, the next update search and inventory (reported by the agent),
    /// installations and a restart in the next maintenance window. Heartbeats are not listed.
    /// </summary>
    private List<PlannedTask> BuildTasks(DateTime now)
    {
        if (_client is null)
        {
            return [];
        }

        var tasks = new List<PlannedTask>();
        foreach (var action in _actions.Where(a => a.State is AgentActionState.Queued or AgentActionState.Delivered))
        {
            tasks.Add(new(now, action.State == AgentActionState.Queued ? "next heartbeat" : SUSyphos.Server.Agents.AgentActionService.IsHeld(action.Kind) ? "when it may run" : "now", "Remote action", "queue", $"{ActionLabel(action.Kind)}, requested by {action.RequestedBy}", []));
        }

        // While the agent searches or after a search was requested it reports no next time: the search runs now.
        var searchDetail = _client.LastSearchAtUtc is { } lastSearch ? $"Last search {Format(lastSearch)}{(_client.LastSearchSucceeded == false ? " (failed)" : string.Empty)}" : "First search";
        if (_livePhase == SUSyphos.Contracts.Agents.AgentPhase.Searching)
        {
            tasks.Add(new(now, "now", "Update search", "pend", $"Running; {searchDetail.ToLowerInvariant()}", []));
        }
        else if (_client.NextSearchAtUtc is { } search)
        {
            tasks.Add(new(search, Format(search), "Update search", "pend", searchDetail, []));
        }
        else if (_client.LastSearchAtUtc is not null)
        {
            tasks.Add(new(now, "next cycle", "Update search", "pend", searchDetail, []));
        }

        var inventoryDetail = _client.InventoryAtUtc is { } lastInventory ? $"Last inventory {Format(lastInventory)}" : "First inventory";
        if (_livePhase == SUSyphos.Contracts.Agents.AgentPhase.Inventory)
        {
            tasks.Add(new(now, "now", "Inventory", "neutral", $"Running; {inventoryDetail.ToLowerInvariant()}", []));
        }
        else if (_client.NextInventoryAtUtc is { } inventory)
        {
            tasks.Add(new(inventory, Format(inventory), "Inventory", "neutral", inventoryDetail, []));
        }
        else if (_client.InventoryAtUtc is not null)
        {
            tasks.Add(new(now, "next cycle", "Inventory", "neutral", inventoryDetail, []));
        }

        // An installation that runs now (also "install updates now") is not planned for the window any more.
        var installingNow = _livePhase is SUSyphos.Contracts.Agents.AgentPhase.Downloading or SUSyphos.Contracts.Agents.AgentPhase.Installing;
        var installNowQueued = _actions.Any(a => a.Kind is SUSyphos.Contracts.Agents.AgentActionKind.InstallNow or SUSyphos.Contracts.Agents.AgentActionKind.InstallNowRestartInWindow && a.State is AgentActionState.Queued or AgentActionState.Delivered);
        var planned = installingNow || installNowQueued
            ? [.. _planned.Where(p => !_client.ActivityUpdateIds.Contains(p.Entry.UpdateId) && !installNowQueued)]
            : _planned;

        if (_window is { } window)
        {
            var notes = new List<string> { $"Maintenance window {Format(window.Start)} to {Format(window.End)}" };
            if (_paused)
            {
                notes.Add("global pause: nothing starts while it is on");
            }

            if (_client.RequiresLease)
            {
                notes.Add("coordinated group: installs only with a lease");
            }

            if (planned.Count > 0)
            {
                var start = planned.Select(p => p.Entry.EarliestInstallAtUtc ?? window.Start).Append(window.Start).Max();
                tasks.Add(new(start > window.Start ? start : window.Start, Format(start > window.Start ? start : window.Start), "Installation", "ok", $"{planned.Count} {(planned.Count == 1 ? "update" : "updates")}; {string.Join("; ", notes)}", planned));
            }

            var restartPlanned = _client.RebootPending && _client.EffectiveRebootPolicy == SUSyphos.Contracts.Agents.RebootPolicy.InsideMaintenanceWindow;
            if (!_client.RestartRequested && _client.RestartAnnouncedAtUtc is null && (restartPlanned || (planned.Count > 0 && _client.EffectiveRebootPolicy == SUSyphos.Contracts.Agents.RebootPolicy.InsideMaintenanceWindow)))
            {
                tasks.Add(new(window.Start.AddSeconds(1), Format(window.Start), "Restart", "fail", restartPlanned
                    ? $"A restart is pending; allowed in the window if it stays open at least 30 more minutes{(_client.RebootWait is { } wait ? $" ({LiveStatus.RebootWaitText(wait)})" : string.Empty)}"
                    : "If the installation needs one; allowed in the window if it stays open at least 30 more minutes", []));
            }
        }
        else
        {
            tasks.Add(new(DateTime.MaxValue, "–", "Installation", "neutral", _client.TimeZoneId is null
                ? "The server has not reported its time zone yet, so the next window cannot be calculated."
                : "No maintenance window, so nothing is installed.", []));
        }

        if (_client.RestartAnnouncedAtUtc is { } announcedAt)
        {
            tasks.Add(new(announcedAt, Format(announcedAt), "Restart", "fail", "Announced to Windows by the agent; signed-in users see the warning", []));
        }
        else if (_client.RestartRequested)
        {
            tasks.Add(new(_client.PlannedRestartAtUtc ?? DateTime.MaxValue, _client.PlannedRestartAtUtc is { } plannedRestart ? Format(plannedRestart) : "unknown", "Restart", "fail", $"Requested by an administrator{(_client.RebootWait is { } wait ? $"; {LiveStatus.RebootWaitText(wait)}" : string.Empty)}", []));
        }

        return [.. tasks.OrderBy(t => t.Sort)];
    }

    /// <summary>Reload interval of the page while the agent reports an activity.</summary>
    private const int LiveRefreshSeconds = 10;

    /// <summary>The agent works, or a remote action waits to be picked up or for its result.</summary>
    private bool IsBusy => _livePhase is not null || _actions.Any(a => a.State is AgentActionState.Queued or AgentActionState.Delivered);

    private const int MaxActivities = 100;

    private List<ClientUpdateHistoryEntity> _windowsHistory = [];
    private List<ClientActivityEntity> _activities = [];

    /// <summary>Time since the last boot the agent reported, e.g. "3 days 4 h (since 2026-10-17 08:12)".</summary>
    private string UptimeText
    {
        get
        {
            if (_client?.LastBootAtUtc is not { } boot)
            {
                return "unknown";
            }

            var up = Time.GetUtcNow().UtcDateTime - boot;
            if (up < TimeSpan.Zero)
            {
                up = TimeSpan.Zero;
            }

            var text = up.TotalDays >= 1
                ? string.Create(System.Globalization.CultureInfo.InvariantCulture, $"{(int)up.TotalDays} {((int)up.TotalDays == 1 ? "day" : "days")} {up.Hours} h")
                : string.Create(System.Globalization.CultureInfo.InvariantCulture, $"{up.Hours} h {up.Minutes} min");
            return $"{text} (since {Format(boot)})";
        }
    }
