@page "/coverage"
@attribute [Authorize(Policy = AdminRoles.Policies.Read)]
@using SUSyphos.Server.Approval
@inject DirectoryCoverage Coverage
@inject NavigationManager Navigation

<PageTitle>AD coverage</PageTitle>

<PageHeader Title="AD coverage" Icon="@PageIcons.Coverage" Subtitle="@CoverageSubtitle" Help="coverage" Crumbs="@([("Overview", "/"), ("AD coverage", null)])" />

<section class="tiles" aria-label="Coverage">
    <Tile Title="Supported servers with an agent" Edge="@(_report.Missing.Count > 0 ? "queue" : null)" Footer="enabled server accounts with Windows Server 2016 or newer">
        <TileValue>@DisplayNumber.Format(_report.Covered) <small>/ @DisplayNumber.Format(_report.Supported)</small></TileValue>
        <TileValue Value="@DisplayNumber.Percent(_report.Percent)" Caption="covered" />
    </Tile>
    <Tile Title="Server accounts" Footer="@(_report.ReadAtUtc is { } read ? $"read from Active Directory at {DisplayTime.Format(read)}" : "not read yet")">
        <TileDonut Parts="@Parts" />
    </Tile>
</section>

<Box Title="Supported servers without agent" Anchor="missing" Help="coverage#missing" Hint="enabled server accounts no registered agent reports for" Flush="true">
    <ListTable Table="_missingTable" Page="_missingPage" Columns="Columns" Search="Search account or DNS name" Noun="accounts" Empty="Every supported server account has an agent.">
        <Row Context="computer">
            <tr><td>@computer.Name</td><td>@computer.DnsHostName</td><td>@computer.OperatingSystem</td><td>@computer.Build</td></tr>
        </Row>
    </ListTable>
</Box>

<Box Title="Not supported" Anchor="unsupported" Help="coverage#unsupported" Hint="older than Windows Server 2016, not counted" Flush="true">
    <ListTable Table="_unsupportedTable" Page="_unsupportedPage" Columns="Columns" Search="Search account or DNS name" Noun="accounts" Empty="None.">
        <Row Context="computer">
            <tr><td>@computer.Name</td><td>@computer.DnsHostName</td><td>@computer.OperatingSystem</td><td>@(computer.Build?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "unknown")</td></tr>
        </Row>
    </ListTable>
</Box>

@code {
    private static readonly IReadOnlyList<TableColumn<DirectoryComputerEntity>> Columns =
    [
        new("account", "Account", c => c.Name),
        new("dns", "DNS name", c => c.DnsHostName),
        new("os", "Operating system", c => c.OperatingSystem, c => [c.OperatingSystem ?? string.Empty]),
        new("build", "Build", c => c.Build),
    ];

    private CoverageReport _report = new(null, 0, 0, [], []);

    private IReadOnlyList<SUSyphos.Server.Rollouts.DonutPart> Parts =>
    [
        new("ok", "With agent", _report.Covered),
        new("queue", "Without agent", _report.Missing.Count, "#missing"),
        new("neutral", "Not supported", _report.Unsupported.Count, "#unsupported"),
    ];
    private TableQuery _missingTable = default!;
    private TablePage<DirectoryComputerEntity> _missingPage = default!;
    private TableQuery _unsupportedTable = default!;
    private TablePage<DirectoryComputerEntity> _unsupportedPage = default!;

    private string CoverageSubtitle => _report.ReadAtUtc is { } read
        ? $"Server accounts read from Active Directory at {DisplayTime.Format(read)}"
        : "Active Directory has not been read yet. The central server must be a domain member, or a domain must be configured under Coverage:Domain.";

    protected override async Task OnInitializedAsync()
    {
        _report = await Coverage.GetReportAsync(CancellationToken.None);
        _missingTable = TableQuery.From(Navigation, "account", prefix: "miss.");
        _missingPage = TablePaging.Apply(_report.Missing, _missingTable, Columns, c => $"{c.Name} {c.DnsHostName}");
        _unsupportedTable = TableQuery.From(Navigation, "account", prefix: "old.");
        _unsupportedPage = TablePaging.Apply(_report.Unsupported, _unsupportedTable, Columns, c => $"{c.Name} {c.DnsHostName}");
    }
}
