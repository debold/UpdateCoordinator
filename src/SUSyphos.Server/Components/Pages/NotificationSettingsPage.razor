@page "/administration/notifications"
@attribute [Authorize(Policy = AdminRoles.Policies.Administer)]
@inherits DashboardPageBase
@using System.ComponentModel.DataAnnotations
@using SUSyphos.Server.Notifications
@inject NotificationSettingsStore Store
@inject NotificationService Notifications
@inject AuditLog Audit

<PageTitle>Notifications</PageTitle>

<PageHeader Title="Notifications" Icon="@PageIcons.Notifications" Subtitle="Every minute the central server sends each new event once, collected in one message; the event table below decides which events go to which channel. Passwords and secrets are stored encrypted on this server and are not part of the backup." Help="notifications" Crumbs="@([("Administration", null), ("Notifications", null)])" />
<StatusMessage Text="@Message" IsError="@MessageIsError" />

<form method="post" @formname="notifications" @onsubmit="HandleAsync" class="stack">
    <AntiforgeryToken />
    <ActionBand>
        <button type="submit" name="Action" value="save" class="primary"><Icon Name="check" Size="16" />Save</button>
        <button type="submit" name="Action" value="test"><Icon Name="send" Size="16" />Send a test notification</button>
        <div class="spacer"></div>
        <span class="note">The test uses the saved settings.</span>
    </ActionBand>

    <TabBar Tabs="@TabItems" Current="@_tab" Link="@(tab => tab == "events" ? "/administration/notifications?tab=events" : "/administration/notifications")" />

    @* One form for both tabs: the other tab stays in the page, hidden, so saving keeps its values. *@
    <div class="stack" hidden="@(_tab != "channels")">
    <div class="grid-2">
        <Box Title="E-mail" Help="notifications#email">
            <Header><span class="pill @(_settings.EmailEnabled ? "ok" : "neutral")">@(_settings.EmailEnabled ? "on" : "off")</span></Header>
            <ChildContent>
                <div class="form gated">
                    <label class="check gate"><input type="checkbox" name="EmailEnabled" value="yes" checked="@_settings.EmailEnabled" /> Send e-mails</label>
                    <div class="gated-body form">
                    <div class="form-row">
                        <label class="field"><span>SMTP server</span><input name="SmtpHost" value="@_settings.SmtpHost" maxlength="253" autocomplete="off" /></label>
                        <label class="field"><span>Port</span><input name="SmtpPort" type="number" min="1" max="65535" value="@_settings.SmtpPort" /></label>
                    </div>
                    <label class="field">
                        <span>Encryption</span>
                        <select name="SecurityMode">
                            <option value="StartTls" selected="@(_settings.SmtpSecurity == SmtpSecurity.StartTls)">STARTTLS (port 587)</option>
                            <option value="SslOnConnect" selected="@(_settings.SmtpSecurity == SmtpSecurity.SslOnConnect)">TLS (port 465)</option>
                            <option value="None" selected="@(_settings.SmtpSecurity == SmtpSecurity.None)">None (internal relay only)</option>
                        </select>
                    </label>
                    <div class="form-row">
                        <label class="field"><span>User name</span><input name="SmtpUser" value="@_settings.SmtpUser" maxlength="256" autocomplete="off" /><span class="help">Empty: no authentication</span></label>
                        <label class="field"><span>Password</span><input name="SmtpPassword" type="password" maxlength="@NotificationSettingsStore.MaxSecretLength" autocomplete="new-password" /><span class="help">Empty: keep the stored one</span></label>
                    </div>
                    <label class="check"><input type="checkbox" name="ClearSmtpPassword" value="yes" /> Remove the stored password</label>
                    <label class="field"><span>Sender address</span><input name="From" type="email" value="@_settings.From" maxlength="254" autocomplete="off" /></label>
                    <label class="field"><span>Recipients</span><textarea name="Recipients" rows="3" maxlength="4000">@_settings.Recipients</textarea><span class="help">Comma, semicolon or one per line</span></label>
                    </div>
                </div>
            </ChildContent>
            <Footer><button type="submit" name="Action" value="test:E-mail" data-help-term="Send test e-mail"><Icon Name="send" Size="16" />Send test e-mail</button><span class="note">uses the saved settings, also while e-mail is off</span></Footer>
        </Box>

        <div class="stack">
            <Box Title="Webhook" Help="notifications#webhook">
                <Header><span class="pill @(_settings.WebhookEnabled ? "ok" : "neutral")">@(_settings.WebhookEnabled ? "on" : "off")</span></Header>
                <ChildContent>
                    <div class="form gated">
                        <label class="check gate"><input type="checkbox" name="WebhookEnabled" value="yes" checked="@_settings.WebhookEnabled" /> Call a webhook</label>
                        <div class="gated-body form">
                        <label class="field"><span>Address (https://)</span><input name="WebhookUrl" type="url" value="@_settings.WebhookUrl" maxlength="2000" autocomplete="off" /></label>
                        <label class="field"><span>Signature secret</span><input name="WebhookSecret" type="password" maxlength="@NotificationSettingsStore.MaxSecretLength" autocomplete="new-password" /><span class="help">Empty: keep the stored one</span></label>
                        <label class="check"><input type="checkbox" name="ClearWebhookSecret" value="yes" /> Remove the stored secret</label>
                        </div>
                        <p class="note">
                            The webhook receives a JSON document with subject, time, severity and the events (kind, category, severity, title, text, affected, impact, link). With a secret, the header
                            <code>@WebhookChannel.SignatureHeader</code> carries <code>sha256=</code> and the HMAC-SHA256 of the body.
                        </p>
                    </div>
                </ChildContent>
                <Footer><button type="submit" name="Action" value="test:Webhook" data-help-term="Send test webhook"><Icon Name="send" Size="16" />Send test webhook</button><span class="note">uses the saved settings, also while the webhook is off; <a href="help/notifications#webhook-example" target="_blank" rel="noopener">example and Teams</a></span></Footer>
            </Box>
            <Box Title="Messages and links" Help="notifications#links">
                <div class="form">
                    <label class="field"><span>Subject prefix</span><input name="SubjectPrefix" value="@_settings.SubjectPrefix" maxlength="@NotificationSettings.MaxPrefixLength" autocomplete="off" /><span class="help">Before every e-mail subject, e.g. for mail filters; empty for none</span></label>
                    <label class="field"><span>Dashboard address for links (optional)</span><input name="DashboardUrl" type="url" value="@_settings.DashboardUrl" maxlength="2000" placeholder="@_defaultAddress" autocomplete="off" /><span class="help">Empty: this server's own name and port (@_defaultAddress); set it when recipients reach the dashboard under another name</span></label>
                    <div class="form-row">
                        <label class="field"><span>Offline after (hours)</span><input name="OfflineHours" type="number" min="1" max="168" value="@_settings.OfflineHours" /><span class="help">For "Server offline"</span></label>
                        <label class="field"><span>Restart pending for (days)</span><input name="RebootPendingDays" type="number" min="1" max="60" value="@_settings.RebootPendingDays" /><span class="help">For "Restart pending for long"</span></label>
                    </div>
                </div>
            </Box>
        </div>
    </div>

    </div>

    <div class="stack" hidden="@(_tab != "events")">
    <Box Title="Events" Anchor="events" Help="notifications#events" Hint="Which events go to which channel; critical and recommended events are on by default" Flush="true">
        <input type="hidden" name="EventsShown" value="yes" />
        <div class="scroll">
            <table>
                <thead><tr><th>Event</th><th>When it is sent</th><th class="n">E-mail</th><th class="n">Webhook</th></tr></thead>
                <tbody>
                    @foreach (var category in Enum.GetValues<NotificationCategory>())
                    {
                        <tr class="group-row"><td colspan="4">@category <span class="note">· @CategoryNote(category)</span></td></tr>
                        @foreach (var info in NotificationCatalog.All.Where(k => k.Category == category))
                        {
                            <tr>
                                <td class="nowrap">@info.Label</td>
                                <td class="wrap note">@info.Description</td>
                                <td class="n"><input type="checkbox" name="EmailEvent" value="@info.Kind" checked="@_settings.EmailKinds.Contains(info.Kind)" aria-label="@($"Send {info.Label} by e-mail")" data-help-term="E-mail" /></td>
                                <td class="n"><input type="checkbox" name="WebhookEvent" value="@info.Kind" checked="@_settings.WebhookKinds.Contains(info.Kind)" aria-label="@($"Send {info.Label} to the webhook")" data-help-term="Webhook" /></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </Box>
    </div>
</form>

@code {
    [SupplyParameterFromQuery(Name = "tab")] private string? Tab { get; set; }

    private string _tab => Tab == "events" ? "events" : "channels";

    /// <summary>Channels with how many are on; events with how many are sent at all.</summary>
    private IReadOnlyList<TabItem> TabItems =>
    [
        new("channels", "Channels", $"{(_settings.EmailEnabled ? 1 : 0) + (_settings.WebhookEnabled ? 1 : 0)} on", _settings.EmailEnabled || _settings.WebhookEnabled ? "neutral" : "queue"),
        new("events", "Events", DisplayNumber.Format(NotificationCatalog.All.Count(k => _settings.EmailKinds.Contains(k.Kind) || _settings.WebhookKinds.Contains(k.Kind)))),
    ];

    [SupplyParameterFromForm(FormName = "notifications")] private string? Action { get; set; }
    [SupplyParameterFromForm(FormName = "notifications")] private string? EmailEnabled { get; set; }
    [SupplyParameterFromForm(FormName = "notifications")] private string? SmtpHost { get; set; }
    [SupplyParameterFromForm(FormName = "notifications")] private string? SmtpPort { get; set; }
    [SupplyParameterFromForm(FormName = "notifications")] private string? SecurityMode { get; set; }
    [SupplyParameterFromForm(FormName = "notifications")] private string? SmtpUser { get; set; }
    [SupplyParameterFromForm(FormName = "notifications")] private string? SmtpPassword { get; set; }
    [SupplyParameterFromForm(FormName = "notifications")] private string? ClearSmtpPassword { get; set; }
    [SupplyParameterFromForm(FormName = "notifications")] private string? From { get; set; }
    [SupplyParameterFromForm(FormName = "notifications")] private string? Recipients { get; set; }
    [SupplyParameterFromForm(FormName = "notifications")] private string? WebhookEnabled { get; set; }
    [SupplyParameterFromForm(FormName = "notifications")] private string? WebhookUrl { get; set; }
    [SupplyParameterFromForm(FormName = "notifications")] private string? WebhookSecret { get; set; }
    [SupplyParameterFromForm(FormName = "notifications")] private string? ClearWebhookSecret { get; set; }
    [SupplyParameterFromForm(FormName = "notifications")] private string? DashboardUrl { get; set; }
    [SupplyParameterFromForm(FormName = "notifications")] private string? SubjectPrefix { get; set; }
    [SupplyParameterFromForm(FormName = "notifications")] private string? OfflineHours { get; set; }
    [SupplyParameterFromForm(FormName = "notifications")] private string? RebootPendingDays { get; set; }
    [SupplyParameterFromForm(FormName = "notifications")] private string? EventsShown { get; set; }
    [SupplyParameterFromForm(FormName = "notifications")] private string[]? EmailEvent { get; set; }
    [SupplyParameterFromForm(FormName = "notifications")] private string[]? WebhookEvent { get; set; }

    [Inject]
    private IConfiguration Configuration { get; set; } = default!;

    private string _defaultAddress = string.Empty;

    private NotificationSettings _settings = new();

    protected override async Task OnInitializedAsync()
    {
        _defaultAddress = ServerIdentity.DefaultAddress(Configuration);
        _settings = await Store.LoadAsync(CancellationToken.None);
    }

    private static string CategoryNote(NotificationCategory category) => category switch
    {
        NotificationCategory.Critical => "operation or security at risk",
        NotificationCategory.Recommended => "needs an action, not urgently",
        _ => "for information, off by default",
    };

    /// <summary>The ticked kinds; unknown values are dropped. Without the table in the form the stored choice stays.</summary>
    private List<NotificationKind>? Kinds(string[]? ticked, List<NotificationKind>? stored) =>
        EventsShown != "yes" ? stored : [.. (ticked ?? []).Select(t => Enum.TryParse<NotificationKind>(t, out var kind) && Enum.IsDefined(kind) ? kind : (NotificationKind?)null).OfType<NotificationKind>().Distinct()];

    private async Task HandleAsync()
    {
        // The page is Admin-only; the handler checks again, since hiding a form is no protection.
        if (!await IsAuthorizedAsync(AdminRoles.Policies.Administer))
        {
            ShowResult("Only administrators can change notifications.", string.Empty);
            return;
        }

        var actor = await GetActorAsync();
        if (Action is not null && (Action == "test" || Action.StartsWith("test:", StringComparison.Ordinal)))
        {
            var channel = Action == "test" ? null : Action[5..];
            var (outcome, delivered) = await Notifications.SendTestAsync(actor, channel, CancellationToken.None);
            ShowResult(outcome.Error, $"Test notification sent. {delivered}.");
            return;
        }

        var settings = new NotificationSettings
        {
            EmailEnabled = EmailEnabled == "yes",
            SmtpHost = Clean(SmtpHost),
            SmtpPort = int.TryParse(SmtpPort, System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out var port) ? port : 0,
            SmtpSecurity = Enum.TryParse<SmtpSecurity>(SecurityMode, out var security) && Enum.IsDefined(security) ? security : (SmtpSecurity)(-1),
            SmtpUser = Clean(SmtpUser),
            From = Clean(From),
            Recipients = Clean(Recipients),
            WebhookEnabled = WebhookEnabled == "yes",
            WebhookUrl = Clean(WebhookUrl),
            DashboardUrl = Clean(DashboardUrl),
            SubjectPrefix = string.IsNullOrEmpty(SubjectPrefix) ? null : SubjectPrefix,
            OfflineHours = int.TryParse(OfflineHours, System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out var hours) ? hours : string.IsNullOrEmpty(OfflineHours) ? _settings.OfflineHours : 0,
            RebootPendingDays = int.TryParse(RebootPendingDays, System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out var days) ? days : string.IsNullOrEmpty(RebootPendingDays) ? _settings.RebootPendingDays : 0,
            EmailEvents = Kinds(EmailEvent, _settings.EmailEvents),
            WebhookEvents = Kinds(WebhookEvent, _settings.WebhookEvents),
        };

        // Shown again on error, so nothing typed is lost.
        _settings = settings;
        var errors = new List<ValidationResult>();
        if (!Validator.TryValidateObject(settings, new ValidationContext(settings), errors, validateAllProperties: true))
        {
            ShowResult(string.Join(" ", errors.Select(e => e.ErrorMessage)), string.Empty);
            return;
        }

        // A user name without password would make every e-mail fail at the SMTP server.
        if (settings.EmailEnabled && settings.SmtpUser is not null && string.IsNullOrEmpty(SmtpPassword)
            && (ClearSmtpPassword == "yes" || string.IsNullOrEmpty(Store.LoadSecrets().SmtpPassword)))
        {
            ShowResult($"Enter the password for the SMTP user {settings.SmtpUser}, or leave the user name empty for a relay without authentication.", string.Empty);
            return;
        }

        if (SmtpPassword?.Length > NotificationSettingsStore.MaxSecretLength || WebhookSecret?.Length > NotificationSettingsStore.MaxSecretLength)
        {
            ShowResult($"Passwords and secrets may have at most {NotificationSettingsStore.MaxSecretLength} characters.", string.Empty);
            return;
        }

        var password = ClearSmtpPassword == "yes" ? string.Empty : string.IsNullOrEmpty(SmtpPassword) ? null : SmtpPassword;
        var secret = ClearWebhookSecret == "yes" ? string.Empty : string.IsNullOrEmpty(WebhookSecret) ? null : WebhookSecret;
        await Store.SaveAsync(settings, password, secret, CancellationToken.None);
        await Audit.WriteAsync(actor, "Notifications.Changed", null, $"e-mail {(settings.EmailEnabled ? "on" : "off")}, webhook {(settings.WebhookEnabled ? "on" : "off")}", CancellationToken.None);
        ShowResult(null, "Notification settings saved.");
    }

    private static string? Clean(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
}
