@page "/software/{PackageId}/scripts/{PhaseSlug}"
@attribute [Authorize(Policy = AdminRoles.Policies.Read)]
@attribute [Microsoft.AspNetCore.Mvc.RequestSizeLimit(ScriptPageLimits.RequestBytes)]
@attribute [Microsoft.AspNetCore.Mvc.RequestFormLimits(MultipartBodyLengthLimit = ScriptPageLimits.RequestBytes)]
@inherits DashboardPageBase
@using SUSyphos.Contracts.Scripts
@using SUSyphos.Server.Scripts
@inject ServerDbContext Db
@inject ScriptAdministration Scripts
@inject NavigationManager Navigation
@inject IScriptParser Parser

@* The script of one phase of a WinGet package (Marc, 2026-11-13, detail view C of the concept): status, details,
   content and parameters; administrators save drafts and approve them, which signs a new revision. Everybody who may
   read the dashboard reads the script; values of parameters are set per assignment on the package page. *@
@if (_package is null || _phase is null)
{
    <PageTitle>Script</PageTitle>
    <PageHeader Icon="@PageIcons.Software" Title="Script not found" Help="script" Crumbs="@([("Software", "/software"), ("Script", null)])" />
    <p class="note">The catalog has no package @PackageId, or the phase is unknown.</p>
}
else
{
    var phase = _phase.Value;
    <PageTitle>@ScriptText.Phase(phase): @_package.Name</PageTitle>
    <HeadContent><script src="@Assets["lib/prism/prism-powershell.js"]" defer></script></HeadContent>
    <PageHeader Icon="@PageIcons.Software" Title="@($"{ScriptText.Phase(phase)}: {_package.Name}")" Subtitle="@($"Runs as SYSTEM · {_package.PackageId}")" Help="script" Crumbs="@([("Software", "/software"), (_package.Name, PackagePage.Link(_package.PackageId)), (ScriptText.Phase(phase), null)])" />
    <StatusMessage Text="@Message" IsError="@MessageIsError" />
    @if (!_enabled)
    {
        <p class="warning">Scripts are switched off: agents run none until an administrator switches them on under <a href="/administration/agent-settings#scripts">Agent settings</a>. You can still write and approve scripts.</p>
    }

    <AuthorizeView Policy="@AdminRoles.Policies.Administer">
        <ActionBand>
            @if (_view?.HasDraft == true)
            {
                <a class="btn primary" href="@($"{Here}?dialog=approve")" data-help-term="Approve and sign"><Icon Name="shield-check" Size="16" />Approve and sign…</a>
            }
            else
            {
                <button type="button" class="primary" disabled title="Save a draft first"><Icon Name="shield-check" Size="16" />Approve and sign…</button>
            }
            <button type="submit" form="script-edit" data-help-term="Save draft"><Icon Name="check" Size="16" />Save draft</button>
            @if (_view?.HasDraft == true)
            {
                <form method="post" @formname="script-discard" @onsubmit="DiscardAsync"><AntiforgeryToken /><button type="submit" data-help-term="Discard draft"><Icon Name="undo-2" Size="16" />Discard draft</button></form>
            }
            <div class="spacer"></div>
            @if (_view is not null)
            {
                <a class="btn danger" href="@($"{Here}?dialog=delete")" data-help-term="Delete script"><Icon Name="trash-2" Size="16" />Delete script…</a>
            }
        </ActionBand>
    </AuthorizeView>

    <Box Title="Status" Help="script#status" Flush="true">
        <StatusList Rows="@StatusRows" ShowLabel="false" />
    </Box>

    @if (_view?.Approved is { } approved)
    {
        <Box Title="Details" Help="script#details" Flush="true" Hint="of the approved revision, as signed">
            <FactGrid>
                <Fact Label="Runs on">@ScriptText.RunOn(approved.RunOn)</Fact>
                <Fact Label="On failure">@ScriptText.OnFailure(phase, approved.OnFailure)</Fact>
                <Fact Label="Timeout">@(approved.TimeoutSeconds / 60) minutes</Fact>
                <Fact Label="PowerShell">@(approved.PowerShell == ScriptPowerShell.PowerShell7 ? "PowerShell 7, else Windows PowerShell 5.1" : "Windows PowerShell 5.1")</Fact>
                <Fact Label="SHA-256" Mono="true" Wide="true"><HexValue Value="@approved.ContentSha256" /></Fact>
                <Fact Label="Signing key" Mono="true">@approved.KeyId</Fact>
                <Fact Label="Approved" Note="@($"by {approved.ApprovedBy}")">@DisplayTime.Format(approved.SignedAtUtc)</Fact>
            </FactGrid>
        </Box>
    }

    <form method="post" id="script-edit" @formname="script-edit" @onsubmit="SaveAsync">
        <AntiforgeryToken />
        <Box Title="Content" Help="script#content" Hint="@(_view?.HasDraft == true ? "draft, not yet approved: agents run the approved revision" : "the approved revision; changes become a draft")">
            <div class="box-body form">
                <label class="field"><span>Script</span>
                    <textarea name="Content" class="mono script-editor" rows="22" spellcheck="false" readonly="@(!_canAdminister)" maxlength="200000" data-parse="@(_canAdminister ? ScriptEndpoints.ParsePath : null)" data-help-term="Syntax check">@(_view?.Text ?? Template(phase))</textarea>
                    <span class="help">Exit code 0 is success, 3010 asks for a restart in the maintenance window, anything else is a failure. Read values with Get-SUSyphosParameter Name; never put secrets into the script itself. Do not restart the server from the script.</span>
                </label>
                    <div class="parse-result" data-parse-result aria-live="polite">@if (_parse is { } parse) { @if (!parse.Checked) { <span class="note">Syntax not checked: @parse.Problem</span> } else if (parse.Ok) { <span class="pill ok">no syntax errors</span> <span class="note">checked with @parse.Parser</span> } else { <span class="pill fail">@DisplayNumber.Count(parse.Errors.Count, "syntax error", "syntax errors")</span> <span class="note">@parse.Parser; approving is blocked until they are fixed</span><ul>@foreach (var error in parse.Errors) { <li><b>Line @error.Line, column @error.Column:</b> @error.Message</li> }</ul> } }</div>
                <div class="field-row">
                    @if (phase is ScriptPhase.BeforeInstall or ScriptPhase.AfterInstall)
                    {
                        <label class="field"><span>Runs on</span>
                            <select name="RunOn" disabled="@(!_canAdminister)">
                                @foreach (var option in Enum.GetValues<ScriptRunOn>())
                                {
                                    <option value="@option" selected="@(option == (_view?.Script.DraftRunOn ?? ScriptRunOn.Both))">@ScriptText.RunOn(option)</option>
                                }
                            </select>
                        </label>
                    }
                    <label class="field"><span>On failure</span>
                        <select name="OnFailure" disabled="@(!_canAdminister || phase != ScriptPhase.BeforeInstall)">
                            <option value="@ScriptOnFailure.Stop" selected="@((_view?.Script.DraftOnFailure ?? ScriptOnFailure.Stop) == ScriptOnFailure.Stop)">@ScriptText.OnFailure(phase, ScriptOnFailure.Stop)</option>
                            @if (phase == ScriptPhase.BeforeInstall)
                            {
                                <option value="@ScriptOnFailure.Continue" selected="@(_view?.Script.DraftOnFailure == ScriptOnFailure.Continue)">@ScriptText.OnFailure(phase, ScriptOnFailure.Continue)</option>
                            }
                        </select>
                    </label>
                    <label class="field"><span>PowerShell</span>
                        <select name="PowerShell" disabled="@(!_canAdminister)">
                            <option value="@ScriptPowerShell.WindowsPowerShell" selected="@(_view?.Script.DraftPowerShell == ScriptPowerShell.WindowsPowerShell)">Windows PowerShell 5.1</option>
                            <option value="@ScriptPowerShell.PowerShell7" selected="@((_view?.Script.DraftPowerShell ?? ScriptPowerShell.PowerShell7) == ScriptPowerShell.PowerShell7)">PowerShell 7, else 5.1</option>
                        </select>
                        <span class="help">PowerShell 7 is the default for new scripts (Microsoft deprecated Windows PowerShell 5.1 in November 2026). It runs where pwsh.exe is installed (for example with the WinGet package Microsoft.PowerShell, assigned through SUSyphos); elsewhere the script runs in 5.1 and its log says so.</span>
                    </label>
                    <label class="field"><span>Timeout</span><input name="TimeoutMinutes" type="number" min="1" max="30" value="@((_view?.Script.DraftTimeoutSeconds ?? ScriptLimits.DefaultTimeoutSeconds) / 60)" readonly="@(!_canAdminister)" /><span class="help">minutes, 1 to 30</span></label>
                </div>
            </div>
        </Box>

        <Box Title="Parameters" Help="script#parameters" Flush="true" Hint="values are set per assignment on the package page; secrets are stored encrypted and never shown again">
            <div class="scroll">
                <table>
                    <thead><tr><th>Name</th><th>Type</th><th>Required</th><th>Default</th><th>Description</th></tr></thead>
                    <tbody>
                        @{ var rows = (_view?.Parameters ?? []).Append(new ScriptParameter(string.Empty, false, false, null, null)).ToList(); }
                        @for (var i = 0; i < rows.Count && i < ScriptLimits.MaxParameters; i++)
                        {
                            var row = rows[i];
                            <tr>
                                <td><input name="@($"Param{i}Name")" value="@row.Name" maxlength="64" placeholder="@(row.Name.Length == 0 ? "new parameter" : null)" aria-label="Name" readonly="@(!_canAdminister)" data-help-term="Name" /></td>
                                <td><select name="@($"Param{i}Type")" aria-label="Type" disabled="@(!_canAdminister)" data-help-term="Type"><option value="text" selected="@(!row.Secret)">Text</option><option value="secret" selected="@row.Secret">Secret</option></select></td>
                                <td><input type="checkbox" name="@($"Param{i}Required")" value="true" checked="@row.Required" aria-label="Required" disabled="@(!_canAdminister)" data-help-term="Required" /></td>
                                <td><input name="@($"Param{i}Default")" value="@row.Default" maxlength="@ScriptLimits.MaxValueLength" aria-label="Default" readonly="@(!_canAdminister)" data-help-term="Default" /></td>
                                <td><input name="@($"Param{i}Description")" value="@row.Description" maxlength="256" aria-label="Description" readonly="@(!_canAdminister)" data-help-term="Description" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </Box>
    </form>

    @* Files the script brings along as one ZIP (Marc, 2026-11-22), part of the signed revision. *@
    <Box Title="Files" Anchor="files" Help="script#files" Flush="true" Hint="@(_draftFiles is null ? "none: the script brings no files along" : "unpacked for every run into the folder in $env:SUSYPHOS_FILES")">
        @if (_draftFiles is { } files)
        {
            <div class="box-body">
                <p><b>@files.FileName</b> · @DisplayNumber.Count(files.Files.Count, "file", "files"), @ByteSize(files.UnpackedBytes) unpacked · <StatusTag Text="@($"scan {files.ScanState}")" Kind="@(files.ScanState == InstallerScanState.Clean ? "ok" : files.ScanState == InstallerScanState.NotScanned ? "neutral" : "fail")" Detail="@files.ScanDetail" /> <span class="note">uploaded by @files.UploadedBy on @DisplayTime.Format(files.UploadedAtUtc)</span> · <a href="@ScriptEndpoints.FilesDownloadPath(files.Sha256)" download data-help-term="Download ZIP">Download ZIP</a></p>
                @if (_view?.Approved?.FilesSha256 != files.Sha256)
                {
                    <p class="note">In the draft only: agents get these files with the next approval@(_view?.Approved?.FilesSha256 is null ? "." : "; until then they unpack the files of the approved revision.")</p>
                }
            </div>
            <div class="scroll">
                <table>
                    <thead><tr><th>File</th><th class="n">Size</th><th>SHA-256</th></tr></thead>
                    <tbody>
                        @foreach (var entry in files.Files.Take(200))
                        {
                            <tr><td class="mono">@entry.Path</td><td class="n nowrap">@ByteSize(entry.Size)</td><td><HexValue Value="@entry.Sha256" /></td></tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        <AuthorizeView Policy="@AdminRoles.Policies.Administer" Context="filesAdmin">
            @if (_view is not null)
            {
                <form method="post" enctype="multipart/form-data" @formname="script-files" @onsubmit="UploadFilesAsync" class="box-body form">
                    <AntiforgeryToken />
                    <label class="field"><span>@(_draftFiles is null ? "Add files" : "Replace the files")</span>
                        <input type="file" name="FilesZip" accept=".zip,application/zip" required data-help-term="ZIP file" />
                        <span class="help">One ZIP of at most @(ScriptLimits.MaxFilesZipBytes / (1024 * 1024)) MB, @(ScriptLimits.MaxFilesUnpackedBytes / (1024 * 1024)) MB and @ScriptLimits.MaxFiles files unpacked, relative paths only. No secrets: those belong into secret parameters. Save changes to the script first: uploading keeps the saved draft, not unsaved text.</span>
                    </label>
                    <div class="actions"><button type="submit" data-help-term="Upload"><Icon Name="upload" Size="16" />Upload</button></div>
                </form>
                @if (_draftFiles is not null)
                {
                    <form method="post" @formname="script-files-remove" @onsubmit="RemoveFilesAsync" class="box-body"><AntiforgeryToken /><button type="submit" class="danger" data-help-term="Remove files"><Icon Name="trash-2" Size="16" />Remove files</button></form>
                }
            }
            else
            {
                <p class="box-body note">Save a draft of the script first; then you can add files.</p>
            }
        </AuthorizeView>
    </Box>

    @if (_view is { Revisions.Count: > 0 } withRevisions)
    {
        <Box Title="Revisions" Help="script#revisions" Flush="true" Hint="every approved revision stays; agents run the newest">
            <div class="scroll">
                <table>
                    <thead><tr><th>Revision</th><th>Approved</th><th>Virus scan</th><th>SHA-256</th><th class="n">Download</th></tr></thead>
                    <tbody>
                        @foreach (var revision in withRevisions.Revisions)
                        {
                            <tr>
                                <td>@revision.Revision @if (revision.Revision == withRevisions.Script.ApprovedRevision) { <StatusTag Text="runs" Kind="ok" /> }</td>
                                <td class="nowrap">@DisplayTime.Format(revision.SignedAtUtc) <span class="note">by @revision.ApprovedBy</span></td>
                                <td><StatusTag Text="@revision.ScanState.ToString()" Kind="@(revision.ScanState == InstallerScanState.Clean ? "ok" : revision.ScanState == InstallerScanState.NotScanned ? "neutral" : "fail")" Detail="@revision.ScanDetail" /></td>
                                <td class="mono note">@revision.ContentSha256[..16]…</td>
                                <td class="n"><a href="@ScriptEndpoints.DownloadPath(_package.PackageId, phase, revision.Revision)" download data-help-term="Download">.ps1</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </Box>
    }

    @if (Dialog == "approve" && _view?.HasDraft == true && _canAdminister)
    {
        <Dialog Title="@($"Approve and sign the script {ScriptText.Phase(phase).ToLowerInvariant()}?")" CloseHref="@Here" Help="script#approve">
            <form method="post" @formname="script-approve" @onsubmit="ApproveAsync">
                <AntiforgeryToken />
                <div class="dialog-body">
                    <p>@(_view.Approved is { } current ? $"Replaces revision {current.Revision}." : "The first revision of this script.") It runs as SYSTEM on @DisplayNumber.Count(_servers, "server", "servers") that have or get @_package.Name, from their next release list.</p>
                    <p class="note">Change: @ScriptAdministration.DiffSummary(_view.Approved is { } before ? SUSyphos.Contracts.Scripts.ScriptSigningFormat.ContentText(before.Content) : string.Empty, _view.Text). The script is scanned for malware before it is signed.</p>
                    @if (_draftFiles is { } signedFiles) { <p class="note">The revision brings @DisplayNumber.Count(signedFiles.Files.Count, "file", "files") along (@signedFiles.FileName, SHA-256 <HexValue Value="@signedFiles.Sha256" />); their hash is signed with the script, see the box Files.</p> }
                    <label class="check"><input type="checkbox" name="ReadWholeScript" value="true" required data-help-term="I have read the whole script" /> I have read the whole script</label>
                </div>
                <div class="dialog-foot"><a class="btn" href="@Here">Cancel</a><button type="submit" class="primary">Approve and sign</button></div>
            </form>
        </Dialog>
    }
    else if (Dialog == "delete" && _view is not null && _canAdminister)
    {
        <Dialog Title="Delete the script?" CloseHref="@Here" Help="script#delete">
            <form method="post" @formname="script-delete" @onsubmit="DeleteAsync">
                <AntiforgeryToken />
                <div class="dialog-body"><p>The script, all its revisions and the values of its parameters go. From their next release list no server runs it any more. The deletion is recorded in the audit log.</p></div>
                <div class="dialog-foot"><a class="btn" href="@Here">Cancel</a><button type="submit" class="danger">Delete script</button></div>
            </form>
        </Dialog>
    }
}

@code {
    [Parameter] public string PackageId { get; set; } = string.Empty;

    [Parameter] public string PhaseSlug { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "dialog")] private string? Dialog { get; set; }

    [SupplyParameterFromForm(FormName = "script-edit")] private string? Content { get; set; }

    [SupplyParameterFromForm(FormName = "script-edit")] private string? RunOn { get; set; }

    [SupplyParameterFromForm(FormName = "script-edit")] private string? OnFailure { get; set; }

    [SupplyParameterFromForm(FormName = "script-edit")] private int? TimeoutMinutes { get; set; }

    [SupplyParameterFromForm(FormName = "script-edit")] private string? PowerShell { get; set; }

    [SupplyParameterFromForm(FormName = "script-approve")] private string? ReadWholeScript { get; set; }

    [CascadingParameter] private Microsoft.AspNetCore.Http.HttpContext? HttpContext { get; set; }

    private PackageEntity? _package;
    private ScriptPhase? _phase;
    private PackageScriptView? _view;
    private bool _enabled;
    private bool _canAdminister;
    private int _servers;

    private string Here => _package is null || _phase is null ? "/software" : ScriptText.Link(_package.PackageId, _phase.Value);

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _phase = ScriptText.FromSlug(PhaseSlug);
        _package = await Db.Packages.AsNoTracking().SingleOrDefaultAsync(p => p.PackageId == PackageId);
        if (_package is null || _phase is null)
        {
            return;
        }

        _view = await Scripts.GetAsync(_package.PackageId, _phase.Value, CancellationToken.None);
        _enabled = await Scripts.IsEnabledAsync(CancellationToken.None);
        _canAdminister = await IsAuthorizedAsync(AdminRoles.Policies.Administer);
        _servers = await Db.ClientSoftware.AsNoTracking().Where(s => s.PackageId == _package.PackageId).Select(s => s.ClientId).Distinct().CountAsync();
        _draftFiles = await Scripts.FilesAsync(_view?.Script.DraftFilesSha256, CancellationToken.None);
        // The syntax of a draft is checked on the server too, so the result shows without the dashboard script.
        _parse = _view is { HasDraft: true } draft && _canAdminister ? await Parser.ParseAsync(draft.Text, draft.Script.DraftPowerShell, CancellationToken.None) : null;
        _withoutPowerShell7 = _view?.Approved?.PowerShell == ScriptPowerShell.PowerShell7 ? await PowerShell7Coverage.MissingAsync(Db, _package.PackageId, CancellationToken.None) : [];
    }

    private IReadOnlyList<StatusRow> StatusRows
    {
        get
        {
            if (_view is null)
            {
                return [new StatusRow("neutral", "none", "Script", "no script yet", "write it below and save a draft; it runs only after an administrator approved and signed it")];
            }

            var rows = new List<StatusRow>
            {
                _view.Approved is { } approved
                    ? new StatusRow("ok", $"revision {approved.Revision}", "Approved", $"approved by {approved.ApprovedBy} on {DisplayTime.Format(approved.SignedAtUtc)}", "agents run this revision")
                    : new StatusRow("queue", "not approved", "Approved", "no revision approved yet", "agents run nothing until the draft is approved"),
                _view.HasDraft
                    ? new StatusRow("pend", "draft", "Draft", $"changed by {_view.Script.DraftChangedBy} on {DisplayTime.Format(_view.Script.DraftChangedAtUtc)}", "approve it to make it the next revision")
                    : new StatusRow("neutral", "none", "Draft", "the content is the approved revision"),
            };
            if (_view.Approved is { } scanned)
            {
                rows.Add(new StatusRow(scanned.ScanState == InstallerScanState.Clean ? "ok" : scanned.ScanState == InstallerScanState.NotScanned ? "queue" : "fail", scanned.ScanState.ToString(), "Virus scan", scanned.ScanState == InstallerScanState.NotScanned ? "not scanned: no antivirus product answered (AMSI)" : "scanned with AMSI before signing", scanned.ScanDetail));
            }

            if (_withoutPowerShell7.Count > 0)
            {
                rows.Add(new StatusRow("queue", "missing", "PowerShell 7", $"{DisplayNumber.Count(_withoutPowerShell7.Count, "server has", "servers have")} no PowerShell 7: {string.Join(", ", _withoutPowerShell7.Take(5).Select(s => s.HostName))}{(_withoutPowerShell7.Count > 5 ? $" and {_withoutPowerShell7.Count - 5} more" : string.Empty)}", "there the script runs in Windows PowerShell 5.1; install PowerShell 7 with Recommended on the Software page"));
            }

            rows.Add(new StatusRow("neutral", "per server", "Local veto", "a server with AllowScripts = 0 in HKLM\\SOFTWARE\\Policies\\SUSyphos\\Agent runs no script", "such servers report \"Blocked locally\" and do not install the package"));
            return rows;
        }
    }

    /// <summary>
    /// The text of a new script: what it is for and, as before, the values SUSyphos hands over, now with the folder of its
    /// files (Marc, 2026-11-22: the variables stay explained as a comment at the top of new scripts).
    /// </summary>
    internal static string Template(ScriptPhase phase) => phase switch
    {
        ScriptPhase.BeforeInstall => "# Runs before WinGet installs or upgrades the package, as SYSTEM.\r\n" + Variables + "# Exit 0 to go on; any other exit code stops the installation.\r\n\r\nexit 0\r\n",
        ScriptPhase.AfterInstall => "# Runs after WinGet installed or upgraded the package, as SYSTEM.\r\n" + Variables + "# Exit 0 for success, 3010 when a restart is needed.\r\n\r\nexit 0\r\n",
        ScriptPhase.BeforeUninstall => "# Runs before WinGet uninstalls the package, as SYSTEM.\r\n" + Variables + "# Exit 0 to go on; any other exit code keeps the package installed.\r\n\r\nexit 0\r\n",
        _ => "# Runs after WinGet uninstalled the package, as SYSTEM, for example to remove what the uninstaller left.\r\n" + Variables + "\r\nexit 0\r\n",
    };

    private const string Variables =
        "# $env:SUSYPHOS_ACTION (Install, Upgrade or Uninstall), $env:SUSYPHOS_PACKAGE_ID, $env:SUSYPHOS_VERSION and\r\n"
        + "# $env:SUSYPHOS_PREVIOUS_VERSION tell what happens; $env:SUSYPHOS_ARCHITECTURE is x64 or x86, and after the\r\n"
        + "# installation $env:SUSYPHOS_INSTALLER_EXIT_CODE holds the exit code of the installer.\r\n"
        + "# $env:SUSYPHOS_FILES is the folder with the unpacked files of this script (box Files), deleted after the run.\r\n"
        + "# Parameters: Get-SUSyphosParameter Name.\r\n";

    private ScriptFilesView? _draftFiles;

    private ScriptParseResult? _parse;

    private IReadOnlyList<(Guid ClientId, string HostName)> _withoutPowerShell7 = [];

    [SupplyParameterFromForm(FormName = "script-files")] private IFormFile? FilesZip { get; set; }

    private static string ByteSize(long bytes) => bytes < 1024 ? $"{bytes} B" : bytes < 1024 * 1024 ? $"{bytes / 1024.0:0.#} KB" : $"{bytes / (1024.0 * 1024):0.#} MB";

    private async Task UploadFilesAsync()
    {
        Outcome outcome;
        if (!await IsAuthorizedAsync(AdminRoles.Policies.Administer) || _phase is not { } phase)
        {
            outcome = new Outcome("Only administrators change scripts.");
        }
        else if (FilesZip is not { Length: > 0 } upload)
        {
            outcome = new Outcome("Choose a ZIP file.");
        }
        else if (upload.Length > ScriptLimits.MaxFilesZipBytes)
        {
            outcome = new Outcome($"Choose a ZIP file of at most {ScriptLimits.MaxFilesZipBytes / (1024 * 1024)} MB.");
        }
        else
        {
            await using var stream = upload.OpenReadStream();
            outcome = await Scripts.SetDraftFilesAsync(PackageId, phase, stream, upload.FileName, await GetActorAsync(), CancellationToken.None);
        }

        ShowResult(outcome.Error, "The files were added to the draft; approve it to hand them to the agents.");
        await LoadAsync();
    }

    private async Task RemoveFilesAsync()
    {
        var outcome = !await IsAuthorizedAsync(AdminRoles.Policies.Administer) || _phase is not { } phase ? new Outcome("Only administrators change scripts.")
            : await Scripts.RemoveDraftFilesAsync(PackageId, phase, await GetActorAsync(), CancellationToken.None);
        ShowResult(outcome.Error, "The files were removed from the draft; approve it to take them from the agents.");
        await LoadAsync();
    }

    /// <summary>The parameter rows of the form; rows without a name are left out.</summary>
    private List<ScriptParameter> FormParameters()
    {
        var form = HttpContext?.Request.HasFormContentType == true ? HttpContext.Request.Form : null;
        var list = new List<ScriptParameter>();
        for (var i = 0; form is not null && i <= ScriptLimits.MaxParameters; i++)
        {
            var name = form[$"Param{i}Name"].ToString().Trim();
            if (name.Length == 0)
            {
                continue;
            }

            var secret = form[$"Param{i}Type"] == "secret";
            var defaultValue = form[$"Param{i}Default"].ToString();
            var description = form[$"Param{i}Description"].ToString().Trim();
            list.Add(new ScriptParameter(name, secret, form[$"Param{i}Required"] == "true", secret || defaultValue.Length == 0 ? null : defaultValue, description.Length == 0 ? null : description));
        }

        return list;
    }

    private async Task SaveAsync()
    {
        var outcome = !await IsAuthorizedAsync(AdminRoles.Policies.Administer) ? new Outcome("Only administrators change scripts.")
            : _phase is not { } phase ? new Outcome("The phase is unknown.")
            : await Scripts.SaveDraftAsync(PackageId, phase, Content, FormParameters(),
                Enum.TryParse<ScriptRunOn>(RunOn, out var runOn) ? runOn : ScriptRunOn.Both,
                Enum.TryParse<ScriptOnFailure>(OnFailure, out var onFailure) ? onFailure : ScriptOnFailure.Stop,
                (TimeoutMinutes ?? 0) * 60, await GetActorAsync(), CancellationToken.None,
                Enum.TryParse<ScriptPowerShell>(PowerShell, out var powerShell) && Enum.IsDefined(powerShell) ? powerShell : ScriptPowerShell.PowerShell7);
        ShowResult(outcome.Error, "The draft was saved; approve it to make agents run it.");
        await LoadAsync();
    }

    private async Task ApproveAsync()
    {
        var outcome = !await IsAuthorizedAsync(AdminRoles.Policies.Administer) || _view is null ? new Outcome("Only administrators approve scripts.")
            : await Scripts.ApproveAsync(_view.Script.Id, ReadWholeScript == "true", await GetActorAsync(), CancellationToken.None);
        ShowResult(outcome.Error, "The script was approved and signed; agents run the new revision from their next release list.");
        Dialog = outcome.Succeeded ? null : Dialog;
        await LoadAsync();
    }

    private async Task DiscardAsync()
    {
        var outcome = !await IsAuthorizedAsync(AdminRoles.Policies.Administer) || _view is null ? new Outcome("Only administrators change scripts.")
            : await Scripts.DiscardDraftAsync(_view.Script.Id, await GetActorAsync(), CancellationToken.None);
        ShowResult(outcome.Error, "The draft was discarded.");
        await LoadAsync();
    }

    private async Task DeleteAsync()
    {
        var outcome = !await IsAuthorizedAsync(AdminRoles.Policies.Administer) || _view is null ? new Outcome("Only administrators delete scripts.")
            : await Scripts.DeleteAsync(_view.Script.Id, await GetActorAsync(), CancellationToken.None);
        if (outcome.Succeeded)
        {
            Navigation.NavigateTo(PackagePage.Link(PackageId) + "#scripts");
            return;
        }

        ShowResult(outcome.Error, string.Empty);
        await LoadAsync();
    }
}
