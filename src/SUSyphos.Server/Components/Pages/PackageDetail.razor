@page "/software/{PackageId}"
@attribute [Authorize(Policy = AdminRoles.Policies.Read)]
@inherits DashboardPageBase
@using Microsoft.EntityFrameworkCore
@using SUSyphos.Server.Software
@using SUSyphos.WinGet.Catalog.RestSource
@inject ServerDbContext Db
@inject SoftwareCatalog Catalog
@inject SoftwareFeature Feature
@inject SoftwareTrust Trust
@inject SoftwareAssignments Assignments

@if (_package is null)
{
    <PageTitle>Package</PageTitle>
    <PageHeader Icon="@PageIcons.Software" Title="Package not found" Help="package-detail" Crumbs="@([("Software", "/software"), ("Package", null)])" />
    <p class="note">The catalog has no package @PackageId.</p>
}
else
{
    <PageTitle>@_package.Name</PageTitle>
    <PageHeader Icon="@PageIcons.Software" Title="@_package.Name" Subtitle="@($"{_package.Publisher ?? "Unknown publisher"} · {_package.PackageId}")" Help="package-detail" Crumbs="@([("Software", "/software"), (_package.Name, null)])" />
    <SoftwareTrustBanner State="@_trust" />
    <StatusMessage Text="@Message" IsError="@MessageIsError" />

    <FeatureOff Off="@(!_enabled)" Title="Software management is switched off" Help="software#switch" Text="An administrator switched off software with WinGet on the Software page. The data stays, but nothing is updated or installed until it is switched on again.">
    <Box Title="About this package" Help="package-detail#about" Flush="true">
        <div class="box-body">
            <div class="pkg-name"><PackageLogo Name="@_package.Name" LogoFile="@_package.LogoFile" Large="true" /><p>@(_package.ShortDescription ?? _package.Name)</p></div>
        </div>
        <StatusList Rows="@AgreementRows" ShowLabel="false" />
        <FactGrid>
            <Fact Label="Publisher">@(_package.Publisher ?? "–")</Fact>
            <Fact Label="License">@(_package.License ?? "–")</Fact>
            <Fact Label="In the catalog" Note="@(_package.CheckedAtUtc is { } checkedAt ? $"checked for new versions {DisplayTime.Format(checkedAt)}" : null)">@(_package.AddedBy == SoftwareCatalog.InventoryActor ? "from the software inventory of the servers" : $"added by {_package.AddedBy}") on @DisplayTime.Format(_package.AddedAtUtc)</Fact>
            @if (Links.Count > 0)
            {
                <Fact Label="Links" Wide="true">@for (var i = 0; i < Links.Count; i++) { if (i > 0) { <span class="note"> · </span> } <a href="@Links[i].Url" target="_blank" rel="noopener noreferrer">@Links[i].Label</a> }</Fact>
            }
            @if (_package.Tags is { Length: > 0 } tags)
            {
                <Fact Label="Tags" Wide="true">@foreach (var tag in tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)) { <span class="tag">@tag</span> }</Fact>
            }
        </FactGrid>
    </Box>
    <Box Title="Versions" Help="package-detail#versions" Flush="true" Hint="Each version is an update of its own: open it to start, follow or stop its rollout">
        <div class="scroll">
            <table>
                <thead><tr><th>Version</th><th>Released</th><th>Rollout</th><th>Virus scan</th><th>In the source</th></tr></thead>
                <tbody>
                    @if (_versions.Count == 0)
                    {
                        <tr><td colspan="5" class="note">No version known yet.</td></tr>
                    }
                    @foreach (var version in _versions)
                    {
                        var rollout = SoftwareOverview.RolloutState(_package, version, _rollouts.TryGetValue(version.UpdateId, out var state) ? state : null);
                        var scan = SoftwareOverview.ScanLabel(version.ScanState);
                        <tr>
                            <td class="nowrap"><a href="/updates/@version.UpdateId/@SoftwarePackages.SoftwareRevision">@version.Version</a></td>
                            <td class="nowrap">@(version.ReleaseDate?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture) ?? "–")</td>
                            <td><span class="pill @rollout.Class">@rollout.Label</span></td>
                            <td><span class="pill @scan.Class" title="@version.ScanDetail">@scan.Label</span></td>
                            <td class="nowrap">@(version.CachedAtUtc is { } cached ? $"since {DisplayTime.Format(cached)}" : "no")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </Box>

    <Box Title="Assignments" Help="package-detail#assignments" Flush="true" Hint="New installations: the package is installed on these servers when its version is released for their ring">
        <AuthorizeView Policy="@AdminRoles.Policies.Administer">
            <div class="box-body"><a class="btn" href="@($"{PackagePage.Link(PackageId)}?dialog=assign")"><Icon Name="plus" Size="16" />Assign package…</a></div>
        </AuthorizeView>
        <div class="scroll">
            <table>
                <thead><tr><th>Target</th><th>Version</th><th>On removal</th><th>Assigned</th><th class="n">Actions</th></tr></thead>
                <tbody>
                    @if (_assignments.Count == 0)
                    {
                        <tr><td colspan="5" class="note">Not assigned: only servers that have the package installed get its new versions.</td></tr>
                    }
                    @foreach (var assignment in _assignments)
                    {
                        <tr>
                            <td>@TargetName(assignment)</td>
                            <td class="nowrap">@(assignment.FixedVersion ?? "newest released")</td>
                            <td>@(assignment.UninstallOnRemoval ? "uninstall" : "keep installed")</td>
                            <td class="nowrap">@assignment.CreatedBy, @DisplayTime.Format(assignment.CreatedAtUtc)</td>
                            <td class="n"><span class="row-actions">
                                <AuthorizeView Policy="@AdminRoles.Policies.Administer">
                                    <ActionMenu Label="More" Icon="ellipsis" Compact="true" Align="right" Title="@($"More for {TargetName(assignment)}")">
                                        <MenuItem Href="@($"{PackagePage.Link(PackageId)}?dialog=unassign&id={assignment.Id}")" Icon="trash-2" Danger="true">Remove assignment…</MenuItem>
                                    </ActionMenu>
                                </AuthorizeView>
                            </span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </Box>

    <Box Title="Installed on" Help="package-detail#installed" Flush="true" Hint="Approved servers that report the package installed">
        <div class="scroll">
            <table>
                <thead><tr><th>Server</th><th>Installed version</th><th>Matched by</th></tr></thead>
                <tbody>
                    @if (_installed.Count == 0)
                    {
                        <tr><td colspan="3" class="note">No server reports the package installed.</td></tr>
                    }
                    @foreach (var item in _installed)
                    {
                        <tr>
                            <td><a href="@ServerPage.Link(item.ClientId, "software")">@item.HostName</a></td>
                            <td class="nowrap">@(item.Version ?? "–")</td>
                            <td>@(item.Match == SoftwareMatch.WinGet ? "WinGet" : "product code")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </Box>
    </FeatureOff>
}

@if (_package is not null && _enabled && Dialog == "assign")
{
    <Dialog Title="@($"Assign {_package.Name}")" CloseHref="@PackagePage.Link(PackageId)" Help="package-detail#assign">
        <form method="post" @formname="package-assign" @onsubmit="AssignAsync">
            <AntiforgeryToken />
            <div class="dialog-body">
                <label class="field"><span>Group or server</span>
                    <select name="Target" required>
                        <option value="">Choose…</option>
                        <optgroup label="Groups">@foreach (var group in _groups) { <option value="@($"g:{group.Id}")">@group.Name</option> }</optgroup>
                        <optgroup label="Servers">@foreach (var server in _servers) { <option value="@($"s:{server.Id}")">@server.HostName</option> }</optgroup>
                    </select>
                </label>
                <label class="field"><span>Version</span>
                    <select name="Version">
                        <option value="">Newest released version</option>
                        @foreach (var version in _versions) { <option value="@version.Version">@version.Version</option> }
                    </select>
                </label>
                <label class="check"><input type="checkbox" name="UninstallOnRemoval" value="true" /> Uninstall when the assignment is removed</label>
                <p class="help">The servers install the package when the version is released for their ring: start the rollout on the update page of the version, or release it to all rings at once. Servers that have the package installed already keep their version; holds of the version win over assignments.</p>
            </div>
            <div class="dialog-foot"><a class="btn" href="@PackagePage.Link(PackageId)">Cancel</a><button type="submit" class="primary">Assign</button></div>
        </form>
    </Dialog>
}
else if (_package is not null && Dialog == "unassign" && _assignments.FirstOrDefault(a => a.Id == DialogNumber) is { } doomed)
{
    <Dialog Title="Remove assignment?" CloseHref="@PackagePage.Link(PackageId)" Help="package-detail#assignments">
        <form method="post" @formname="package-unassign" @onsubmit="UnassignAsync">
            <AntiforgeryToken />
            <input type="hidden" name="AssignmentId" value="@doomed.Id" />
            <div class="dialog-body"><p>@TargetName(doomed) no longer gets @_package.Name as a new installation. @(doomed.UninstallOnRemoval ? "The servers it covered uninstall the package in their next maintenance window, unless another assignment still covers them." : "Where it is installed it stays installed and keeps getting new versions.")</p></div>
            <div class="dialog-foot"><a class="btn" href="@PackagePage.Link(PackageId)">Cancel</a><button type="submit" class="danger">Remove assignment</button></div>
        </form>
    </Dialog>
}

@code {
    [SupplyParameterFromQuery(Name = "dialog")] private string? Dialog { get; set; }
    [SupplyParameterFromQuery(Name = "id")] private string? DialogId { get; set; }
    [SupplyParameterFromForm(FormName = "package-assign")] private string? Target { get; set; }
    [SupplyParameterFromForm(FormName = "package-assign")] private string? Version { get; set; }
    [SupplyParameterFromForm(FormName = "package-assign")] private string? UninstallOnRemoval { get; set; }
    [SupplyParameterFromForm(FormName = "package-unassign")] private int? AssignmentId { get; set; }

    private List<PackageAssignmentEntity> _assignments = [];
    private List<GroupEntity> _groups = [];
    private List<ClientEntity> _servers = [];

    private int? DialogNumber => int.TryParse(DialogId, System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out var id) ? id : null;

    private string TargetName(PackageAssignmentEntity assignment) => assignment.GroupId is { } group
        ? $"Group {_groups.FirstOrDefault(g => g.Id == group)?.Name ?? group.ToString(System.Globalization.CultureInfo.InvariantCulture)}"
        : $"Server {_servers.FirstOrDefault(s => s.Id == assignment.ClientId)?.HostName ?? assignment.ClientId.ToString()}";

    private async Task AssignAsync()
    {
        Outcome outcome;
        if (!await IsAuthorizedAsync(AdminRoles.Policies.Administer))
        {
            outcome = new Outcome("Only administrators assign packages.");
        }
        else
        {
            int? group = Target is ['g', ':', .. var g] && int.TryParse(g, System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out var gid) ? gid : null;
            Guid? server = Target is ['s', ':', .. var s] && Guid.TryParse(s, out var sid) ? sid : null;
            outcome = await Assignments.AddAsync(PackageId, group, server, Version, UninstallOnRemoval == "true", await GetActorAsync(), CancellationToken.None);
        }

        ShowResult(outcome.Error, "The package was assigned.");
        await LoadAsync();
    }

    private async Task UnassignAsync()
    {
        var outcome = !await IsAuthorizedAsync(AdminRoles.Policies.Administer) ? new Outcome("Only administrators remove assignments.")
            : AssignmentId is { } id ? await Assignments.RemoveAsync(id, await GetActorAsync(), CancellationToken.None)
            : new Outcome("Invalid request.");
        ShowResult(outcome.Error, "The assignment was removed.");
        await LoadAsync();
    }
    [Parameter] public string PackageId { get; set; } = string.Empty;

    private PackageEntity? _package;
    private bool _enabled = true;
    private List<PackageVersionEntity> _versions = [];
    private Dictionary<Guid, RolloutState> _rollouts = [];
    private List<(Guid ClientId, string HostName, string? Version, SoftwareMatch Match)> _installed = [];

    /// <summary>Whether the installation accepts licence terms, with "Accept agreements" for administrators while open.</summary>
    private IReadOnlyList<StatusRow> AgreementRows => _package is null ? []
        : !_package.HasAgreements ? [new StatusRow("ok", "none", "Agreements", "none", "versions can start automatically")]
        : _package.AgreementsAcceptedAtUtc is { } accepted ? [new StatusRow("ok", "accepted", "Agreements", $"accepted by {_package.AgreementsAcceptedBy}", $"on {DisplayTime.Format(accepted)}")]
        : [new StatusRow("queue", "not accepted", "Agreements", "versions never start automatically until an administrator accepts them", "the installation accepts the publisher's licence terms on every server; read them on the publisher's page first", @<AuthorizeView Policy="@AdminRoles.Policies.Administer"><form method="post" @formname="package-accept" @onsubmit="AcceptAsync"><AntiforgeryToken /><button type="submit" class="primary"><Icon Name="check" Size="16" />Accept agreements</button></form></AuthorizeView>)];
    private IReadOnlyList<(string Label, string Url)> Links => _package is null ? [] : new[]
    {
        ("Product page", _package.PackageUrl),
        ("Publisher", _package.PublisherUrl),
        ("Release notes", _package.ReleaseNotesUrl),
        ("License", _package.LicenseUrl),
    }.Where(l => l.Item2 is not null).Select(l => (l.Item1, l.Item2!)).ToList();

    protected override Task OnInitializedAsync() => LoadAsync();

    private SoftwareTrustState _trust = SoftwareTrustState.None;

    private async Task LoadAsync()
    {
        _enabled = await Feature.IsEnabledAsync(CancellationToken.None);
        _trust = await Trust.GetAsync(null, CancellationToken.None);
        _package = await Db.Packages.AsNoTracking().SingleOrDefaultAsync(p => p.PackageId == PackageId);
        if (_package is null)
        {
            return;
        }

        _versions = [.. (await Db.PackageVersions.AsNoTracking().Where(v => v.PackageId == PackageId).ToListAsync()).OrderByDescending(v => v.Version, VersionComparer.Instance)];
        var ids = _versions.Select(v => v.UpdateId).ToList();
        _rollouts = await Db.Rollouts.AsNoTracking().Where(r => ids.Contains(r.UpdateId)).ToDictionaryAsync(r => r.UpdateId, r => r.State);
        _assignments = await Db.PackageAssignments.AsNoTracking().Where(a => a.PackageId == PackageId).OrderBy(a => a.CreatedAtUtc).ToListAsync();
        _groups = await Db.Groups.AsNoTracking().OrderBy(g => g.Name).ToListAsync();
        _servers = await Db.Clients.AsNoTracking().Where(c => c.State == SUSyphos.Contracts.Agents.RegistrationState.Approved && c.SoftwareState != SUSyphos.Contracts.Agents.SoftwareSupportState.NotSupported).OrderBy(c => c.HostName).ToListAsync();
        _installed = [.. (await (from s in Db.ClientSoftware.AsNoTracking()
                                 join c in Db.Clients.AsNoTracking() on s.ClientId equals c.Id
                                 where s.PackageId == PackageId && c.State == SUSyphos.Contracts.Agents.RegistrationState.Approved
                                 select new { s.ClientId, c.HostName, s.InstalledVersion, s.MatchKind }).ToListAsync())
            .OrderBy(i => i.HostName, StringComparer.OrdinalIgnoreCase)
            .Select(i => (i.ClientId, i.HostName, i.InstalledVersion, i.MatchKind))];
    }

    private async Task AcceptAsync()
    {
        var outcome = !await Feature.IsEnabledAsync(CancellationToken.None) ? new Outcome("Software management is switched off.")
            : await IsAuthorizedAsync(AdminRoles.Policies.Administer)
            ? await Catalog.AcceptAgreementsAsync(PackageId, await GetActorAsync(), CancellationToken.None)
            : new Outcome("Only administrators accept agreements.");
        ShowResult(outcome.Error, "The agreements were accepted; versions of the package can now start automatically.");
        await LoadAsync();
    }
}
