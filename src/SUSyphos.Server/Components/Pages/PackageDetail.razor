@page "/software/{PackageId}"
@attribute [Authorize(Policy = AdminRoles.Policies.Read)]
@inherits DashboardPageBase
@using Microsoft.EntityFrameworkCore
@using SUSyphos.Server.Software
@using SUSyphos.WinGet.Catalog.RestSource
@inject ServerDbContext Db
@inject SoftwareCatalog Catalog
@inject SoftwareFeature Feature
@inject SoftwareTrust Trust
@inject SoftwareAssignments Assignments
@inject SoftwareUninstall Uninstall
@inject NavigationManager Navigation

@if (_package is null)
{
    <PageTitle>Package</PageTitle>
    <PageHeader Icon="@PageIcons.Software" Title="Package not found" Help="package-detail" Crumbs="@([("Software", "/software"), ("Package", null)])" />
    <p class="note">The catalog has no package @PackageId.</p>
}
else
{
    <PageTitle>@_package.Name</PageTitle>
    <PageHeader Icon="@PageIcons.Software" Title="@_package.Name" Subtitle="@($"{_package.Publisher ?? "Unknown publisher"} · {_package.PackageId}")" Help="package-detail" Crumbs="@([("Software", "/software"), (_package.Name, null)])" />
    <SoftwareTrustBanner State="@_trust" />
    <StatusMessage Text="@Message" IsError="@MessageIsError" />

    <FeatureOff Off="@(!_enabled)" Title="Software management is switched off" Help="software#switch" Text="An administrator switched off software with WinGet on the Software page. The data stays, but nothing is updated or installed until it is switched on again.">
    <AuthorizeView Policy="@AdminRoles.Policies.Administer">
        <ActionBand>
            <a class="btn primary" href="@($"/administration/release-rules?dialog=rule-new&kind=software&package={Uri.EscapeDataString(_package.PackageId)}")"><Icon Name="list-plus" Size="16" />Create release rule…</a>
            <div class="spacer"></div>
            @if (UninstallBlocker is { } notNow)
            {
                <button type="button" class="danger" disabled title="@notNow"><Icon Name="undo-2" Size="16" />Uninstall from servers…</button>
            }
            else
            {
                <a class="btn danger" href="@($"{PackagePage.Link(PackageId)}?dialog=uninstall")"><Icon Name="undo-2" Size="16" />Uninstall from servers…</a>
            }
            @if (RemoveBlocker is { } blocker)
            {
                <button type="button" class="danger" disabled title="@blocker"><Icon Name="trash-2" Size="16" />Remove from catalog…</button>
            }
            else
            {
                <a class="btn danger" href="@($"{PackagePage.Link(PackageId)}?dialog=remove")"><Icon Name="trash-2" Size="16" />Remove from catalog…</a>
            }
        </ActionBand>
    </AuthorizeView>
    <Box Title="Rollout" Help="package-detail#rollout" Hint="how new versions of this package reach the servers" Flush="true">
        <StatusList Rows="@RolloutRows" ShowLabel="false" />
    </Box>
    <Box Title="About this package" Help="package-detail#about" Flush="true">
        <div class="box-body">
            <div class="pkg-name"><PackageLogo Name="@_package.Name" LogoFile="@_package.LogoFile" Large="true" /><p>@(_package.ShortDescription ?? _package.Name)</p></div>
        </div>
        <StatusList Rows="@AgreementRows" ShowLabel="false" />
        <FactGrid>
            <Fact Label="Publisher">@(_package.Publisher ?? "–")</Fact>
            <Fact Label="License">@(_package.License ?? "–")</Fact>
            <Fact Label="In the catalog" Note="@(_package.CheckedAtUtc is { } checkedAt ? $"checked for new versions {DisplayTime.Format(checkedAt)}" : null)">@(_package.AddedBy == SoftwareCatalog.InventoryActor ? "from the software inventory of the servers" : $"added by {_package.AddedBy}") on <span class="nowrap">@DisplayTime.Format(_package.AddedAtUtc)</span></Fact>
            @if (Links.Count > 0)
            {
                <Fact Label="Links" Wide="true">@for (var i = 0; i < Links.Count; i++) { if (i > 0) { <span class="note"> · </span> } <a href="@Links[i].Url" target="_blank" rel="noopener noreferrer">@Links[i].Label</a> }</Fact>
            }
            @if (_package.Tags is { Length: > 0 } tags)
            {
                <Fact Label="Tags" Wide="true">@foreach (var tag in DistinctTags(tags)) { <span class="tag">@tag</span> }</Fact>
            }
        </FactGrid>
    </Box>
    <Box Title="Versions" Help="package-detail#versions" Flush="true" Hint="Each version is an update of its own: open it to start, follow or stop its rollout">
        <div class="scroll">
            <table>
                <thead><tr><th>Version</th><th>Released</th><th>Rollout</th><th>Virus scan</th><th>In the source</th></tr></thead>
                <tbody>
                    @if (_versions.Count == 0)
                    {
                        <tr><td colspan="5" class="note">No version known yet.</td></tr>
                    }
                    @foreach (var version in _versions)
                    {
                        var rollout = SoftwareOverview.RolloutState(_package, version, _rollouts.TryGetValue(version.UpdateId, out var state) ? state : null);
                        if (_installed.Count > 0 && rollout.Class is "neutral" or "pend" && _installed.All(i => i.Version is not null && SUSyphos.WinGet.Catalog.RestSource.VersionComparer.Instance.Compare(i.Version, version.Version) >= 0))
                        {
                            // Every server with the package has this version or a newer one: nothing to roll out (Marc, 2026-11-13).
                            rollout = ("Installed everywhere", "ok");
                        }
                        var scan = SoftwareOverview.ScanLabel(version.ScanState);
                        <tr>
                            <td class="nowrap"><a href="/updates/@version.UpdateId/@SoftwarePackages.SoftwareRevision">@version.Version</a></td>
                            <td class="nowrap">@(version.ReleaseDate?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture) ?? "–")</td>
                            <td><span class="pill @rollout.Class">@rollout.Label</span></td>
                            <td><span class="pill @scan.Class" title="@version.ScanDetail">@scan.Label</span></td>
                            <td class="nowrap">@if (version.CachedAtUtc is { } cached) { <span class="pill ok">yes</span><div class="note">since @DisplayTime.Format(cached)</div> } else { <span class="pill neutral">no</span> }</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </Box>

    <Box Title="Assignments" Anchor="assignments" Help="package-detail#assignments" Flush="true" Hint="New installations: the package is installed on these servers when its version is released for their ring">
        <AuthorizeView Policy="@AdminRoles.Policies.Administer">
            <div class="box-body"><a class="btn" href="@($"{PackagePage.Link(PackageId)}?dialog=assign")"><Icon Name="plus" Size="16" />Assign package…</a></div>
        </AuthorizeView>
        <div class="scroll">
            <table>
                <thead><tr><th>Target</th><th>Version</th><th>On removal</th><th>Assigned</th><th class="n">Actions</th></tr></thead>
                <tbody>
                    @if (_assignments.Count == 0)
                    {
                        <tr><td colspan="5" class="note">Not assigned: only servers that have the package installed get its new versions.</td></tr>
                    }
                    @foreach (var assignment in _assignments)
                    {
                        <tr>
                            <td>@TargetName(assignment)</td>
                            <td class="nowrap">@(assignment.FixedVersion ?? "newest released")</td>
                            <td>@(assignment.UninstallOnRemoval ? "uninstall" : "keep installed")</td>
                            <td class="nowrap">@assignment.CreatedBy, @DisplayTime.Format(assignment.CreatedAtUtc)</td>
                            <td class="n"><span class="row-actions">
                                <AuthorizeView Policy="@AdminRoles.Policies.Administer">
                                    <ActionMenu Label="More" Icon="ellipsis" Compact="true" Align="right" Title="@($"More for {TargetName(assignment)}")">
                                        <MenuItem Href="@($"{PackagePage.Link(PackageId)}?dialog=unassign&id={assignment.Id}")" Icon="trash-2" Danger="true">Remove assignment…</MenuItem>
                                    </ActionMenu>
                                </AuthorizeView>
                            </span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </Box>

    <Box Title="Installed on" Anchor="installed" Help="package-detail#installed" Flush="true" Hint="Approved servers that report the package installed">
        <div class="scroll">
            <table>
                <thead><tr><th>Server</th><th>Installed version</th><th>State</th><th>Matched by</th></tr></thead>
                <tbody>
                    @if (_installed.Count == 0)
                    {
                        <tr><td colspan="4" class="note">No server reports the package installed.</td></tr>
                    }
                    @foreach (var item in _installed)
                    {
                        <tr>
                            <td><a href="@ServerPage.Link(item.ClientId, "software")">@item.HostName</a></td>
                            <td class="nowrap">@(item.Version ?? "–")</td>
                            <td>@{ var installedState = _uninstalling.Contains(item.ClientId) ? ("Uninstalling", "pend") : InstalledState(item.Version); }<span class="pill @installedState.Item2">@installedState.Item1</span></td>
                            <td>@if (item.Match == SoftwareMatch.WinGet) { <CategoryTag Text="WinGet" Index="8" /> } else { <CategoryTag Text="Product code" Index="0" /> }</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </Box>
    </FeatureOff>
}

@if (_package is not null && _enabled && Dialog == "uninstall" && UninstallBlocker is null)
{
    <Dialog Title="@($"Uninstall {_package.Name} from servers?")" CloseHref="@PackagePage.Link(PackageId)" Help="package-detail#uninstall" Wide="true">
        <form method="post" @formname="package-uninstall" @onsubmit="UninstallFromServersAsync">
            <AntiforgeryToken />
            <div class="dialog-body">
                <UninstallWhere Servers="@([.. _targets.Select(t => (t.ClientId, t.HostName))])" RingChoices="@SUSyphos.Server.Agents.UninstallScope.RingChoices(_targets, _rings)" GroupChoices="@SUSyphos.Server.Agents.UninstallScope.GroupChoices(_targets, _groups)" AllNote=" Only servers where WinGet works are listed." />
                <UninstallTiming Software="true" />
                @if (SoftwareUninstall.IsRuntime(_package.PackageId))
                {
                    <p class="warning">This is a runtime that other programs may need. Make sure nothing on the servers depends on it.</p>
                }
                @if (_assignments.Count > 0)
                {
                    <label class="check"><input type="checkbox" name="UninstallEndAssignments" value="true" checked data-help-term="End the assignments" /> End the @DisplayNumber.Count(_assignments.Count, "assignment", "assignments") of this package <span class="note">(otherwise they install it again with the next release)</span></label>
                }
                @if (_targets.Count > 1)
                {
                    <label class="check"><input type="checkbox" name="UninstallConfirmed" value="true" data-help-term="I understand" /> I understand that the chosen servers will lose this program <span class="note">(needed when more than one server is chosen)</span></label>
                }
                <p class="note">The agents uninstall with WinGet as SYSTEM and send their inventory right after; a server counts as done once its inventory no longer lists the package. Software takes no lease of a coordinated group.</p>
            </div>
            <div class="dialog-foot"><a class="btn" href="@PackagePage.Link(PackageId)">Cancel</a><button type="submit" class="danger">Uninstall from servers</button></div>
        </form>
    </Dialog>
}
else if (_package is not null && _enabled && Dialog == "assign")
{
    <Dialog Title="@($"Assign {_package.Name}")" CloseHref="@PackagePage.Link(PackageId)" Help="package-detail#assign">
        <form method="post" @formname="package-assign" @onsubmit="AssignAsync">
            <AntiforgeryToken />
            <div class="dialog-body">
                <label class="field"><span>Group or server</span>
                    <select name="Target" required>
                        <option value="">Choose…</option>
                        <optgroup label="Groups">@foreach (var group in _groups) { <option value="@($"g:{group.Id}")">@group.Name</option> }</optgroup>
                        <optgroup label="Servers">@foreach (var server in _servers) { <option value="@($"s:{server.Id}")">@server.HostName</option> }</optgroup>
                    </select>
                </label>
                <label class="field"><span>Version</span>
                    <select name="Version">
                        <option value="">Newest released version</option>
                        @foreach (var version in _versions) { <option value="@version.Version">@version.Version</option> }
                    </select>
                </label>
                <label class="check"><input type="checkbox" name="UninstallOnRemoval" value="true" /> Uninstall when the assignment is removed</label>
                <p class="help">The servers install the package when the version is released for their ring: start the rollout on the update page of the version, or release it to all rings at once. Servers that have the package installed already keep their version; holds of the version win over assignments.</p>
            </div>
            <div class="dialog-foot"><a class="btn" href="@PackagePage.Link(PackageId)">Cancel</a><button type="submit" class="primary">Assign</button></div>
        </form>
    </Dialog>
}
else if (_package is not null && Dialog == "remove" && RemoveBlocker is null)
{
    <Dialog Title="@($"Remove {_package.Name} from the catalog?")" CloseHref="@PackagePage.Link(PackageId)" Help="package-detail#remove">
        <form method="post" @formname="package-remove" @onsubmit="RemoveAsync">
            <AntiforgeryToken />
            <input type="hidden" name="RemoveConfirmed" value="true" />
            <div class="dialog-body">
                <p>SUSyphos stops managing @_package.Name: the package and its versions leave the catalog, with their rollouts and installation history. Servers that have it keep it as an installed program unless you also uninstall it. The removal is recorded in the audit log; you can add the package again any time.</p>
                @if (_targets.Count > 0)
                {
                    <label class="check"><input type="checkbox" name="RemoveUninstall" value="true" data-help-term="Also uninstall it" /> Also uninstall it from @DisplayNumber.Count(_targets.Count, "server", "servers") <span class="note">(with WinGet, in their next software window)</span></label>
                }
            </div>
            <div class="dialog-foot"><a class="btn" href="@PackagePage.Link(PackageId)">Cancel</a><button type="submit" class="danger">Remove from catalog</button></div>
        </form>
    </Dialog>
}
else if (_package is not null && Dialog == "unassign" && _assignments.FirstOrDefault(a => a.Id == DialogNumber) is { } doomed)
{
    <Dialog Title="Remove assignment?" CloseHref="@PackagePage.Link(PackageId)" Help="package-detail#assignments">
        <form method="post" @formname="package-unassign" @onsubmit="UnassignAsync">
            <AntiforgeryToken />
            <input type="hidden" name="AssignmentId" value="@doomed.Id" />
            <div class="dialog-body">
                <p>@TargetName(doomed) no longer gets @_package.Name as a new installation.</p>
                <fieldset class="choices">
                    <legend>On the servers</legend>
                    <label class="choice"><input type="radio" name="UnassignUninstall" value="keep" checked="@(!doomed.UninstallOnRemoval)" data-help-term="Keep installed" /> <span><b>Keep installed</b><span class="note">Where it is installed it stays and keeps getting new versions.</span></span></label>
                    <label class="choice"><input type="radio" name="UnassignUninstall" value="uninstall" checked="@doomed.UninstallOnRemoval" data-help-term="Uninstall in the next software window" /> <span><b>Uninstall in the next software window</b><span class="note">@(_removalPreview is { } preview ? $"{DisplayNumber.Count(preview.Uninstall, "server", "servers")} uninstall it{(preview.KeptByOther > 0 ? $"; {DisplayNumber.Count(preview.KeptByOther, "more keeps", "more keep")} it through another assignment" : string.Empty)}." : null)</span></span></label>
                    <p class="note">Preselected as chosen when the assignment was created (uninstall when removed: @(doomed.UninstallOnRemoval ? "yes" : "no")).</p>
                </fieldset>
            </div>
            <div class="dialog-foot"><a class="btn" href="@PackagePage.Link(PackageId)">Cancel</a><button type="submit" class="danger">Remove assignment</button></div>
        </form>
    </Dialog>
}

@code {
    [SupplyParameterFromQuery(Name = "dialog")] private string? Dialog { get; set; }
    [SupplyParameterFromQuery(Name = "id")] private string? DialogId { get; set; }
    [SupplyParameterFromForm(FormName = "package-assign")] private string? Target { get; set; }
    [SupplyParameterFromForm(FormName = "package-assign")] private string? Version { get; set; }
    [SupplyParameterFromForm(FormName = "package-assign")] private string? UninstallOnRemoval { get; set; }
    [SupplyParameterFromForm(FormName = "package-unassign")] private int? AssignmentId { get; set; }
    [SupplyParameterFromForm(FormName = "package-remove")] private string? RemoveConfirmed { get; set; }
    [SupplyParameterFromForm(FormName = "package-remove")] private string? RemoveUninstall { get; set; }
    [SupplyParameterFromForm(FormName = "package-unassign")] private string? UnassignUninstall { get; set; }
    [SupplyParameterFromForm(FormName = "package-uninstall")] private string? UninstallWhen { get; set; }
    [SupplyParameterFromForm(FormName = "package-uninstall")] private string? UninstallTarget { get; set; }
    [SupplyParameterFromForm(FormName = "package-uninstall")] private int[]? UninstallRings { get; set; }
    [SupplyParameterFromForm(FormName = "package-uninstall")] private int[]? UninstallGroups { get; set; }
    [SupplyParameterFromForm(FormName = "package-uninstall")] private Guid? UninstallServer { get; set; }
    [SupplyParameterFromForm(FormName = "package-uninstall")] private string? UninstallEndAssignments { get; set; }
    [SupplyParameterFromForm(FormName = "package-uninstall")] private string? UninstallConfirmed { get; set; }

    /// <summary>Servers where WinGet works that have the package: the targets of an uninstallation.</summary>
    private List<SUSyphos.Server.Agents.UninstallTarget> _targets = [];
    private List<RingEntity> _rings = [];
    private SoftwareUninstallStatus? _uninstallStatus;

    /// <summary>Servers whose uninstallation of the package waits.</summary>
    private HashSet<Guid> _uninstalling = [];
    private SoftwareAssignments.RemovalPreview? _removalPreview;

    /// <summary>Why "Uninstall from servers…" is not offered now; null when it is.</summary>
    private string? UninstallBlocker => !_enabled ? "Software management is switched off"
        : _targets.Count == 0 ? "No server with WinGet working reports it installed"
        : null;

    /// <summary>Uninstalls the package from the chosen servers (administrators only, Marc 2026-11-14).</summary>
    private async Task UninstallFromServersAsync()
    {
        var kind = SUSyphos.Server.Agents.AgentActionService.UninstallKind(UninstallWhen);
        var scope = SUSyphos.Server.Agents.UninstallScope.Parse(UninstallTarget, UninstallRings, UninstallGroups, UninstallServer);
        var chosen = scope is null ? 0 : _targets.Count(scope.Contains);
        var error = !await IsAuthorizedAsync(AdminRoles.Policies.Administer) ? "Only administrators uninstall software."
            : scope is null ? "Choose where: all servers that have it, at least one ring or group, or one server."
            : kind is null ? "Choose when the servers uninstall it."
            : chosen > 1 && UninstallConfirmed != "true" ? $"Confirm that {chosen} servers will lose this program."
            : null;
        if (error is not null)
        {
            ShowResult(error, string.Empty);
            await LoadAsync();
            return;
        }

        var (queued, ended, outcome) = await Uninstall.QueueAsync(PackageId, kind!.Value, scope!, UninstallEndAssignments == "true", await GetActorAsync(), CancellationToken.None);
        ShowResultAndReload(outcome.Error, $"{DisplayNumber.Count(queued, "server uninstalls", "servers uninstall")} the package {(kind == SUSyphos.Contracts.Agents.AgentActionKind.UninstallInWindow ? "in the next software window" : "with the next heartbeat")}{(ended > 0 ? $"; {DisplayNumber.Count(ended, "assignment", "assignments")} ended" : string.Empty)}.");
        await LoadAsync();
    }

    /// <summary>Why the package cannot be removed now; null when it can (added by hand, not installed, not assigned, no rollout running).</summary>
    private string? RemoveBlocker => _package is null ? null
        : _package.AddedBy == SoftwareCatalog.InventoryActor ? "It comes from the software inventory and would come back with the next inventory"
        : _assignments.Count > 0 ? "Remove its assignments first"
        : _rollouts.Values.Any(r => r == RolloutState.Active) ? "A version is rolling out; stop the rollout first"
        : null;

    private async Task RemoveAsync()
    {
        var outcome = !await IsAuthorizedAsync(AdminRoles.Policies.Administer) ? new Outcome("Only administrators remove packages.")
            : RemoveConfirmed != "true" ? new Outcome("Invalid request.")
            : RemoveBlocker is { } blocker ? new Outcome(blocker + ".")
            : Outcome.Ok;
        if (outcome.Succeeded && RemoveUninstall == "true")
        {
            // Queued before the package leaves the catalog; the agents uninstall it by its WinGet ID.
            outcome = (await Uninstall.QueueAsync(PackageId, SUSyphos.Contracts.Agents.AgentActionKind.UninstallInWindow, SUSyphos.Server.Agents.UninstallScope.All, false, await GetActorAsync(), CancellationToken.None)).Outcome;
        }

        if (outcome.Succeeded)
        {
            outcome = await Catalog.RemovePackageAsync(PackageId, await GetActorAsync(), CancellationToken.None);
        }
        if (outcome.Succeeded)
        {
            Navigation.NavigateTo("/software");
            return;
        }

        ShowResult(outcome.Error, string.Empty);
        await LoadAsync();
    }

    private List<PackageAssignmentEntity> _assignments = [];
    private List<GroupEntity> _groups = [];
    private List<ClientEntity> _servers = [];

    private int? DialogNumber => int.TryParse(DialogId, System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out var id) ? id : null;

    private string TargetName(PackageAssignmentEntity assignment) => assignment.GroupId is { } group
        ? $"Group {_groups.FirstOrDefault(g => g.Id == group)?.Name ?? group.ToString(System.Globalization.CultureInfo.InvariantCulture)}"
        : $"Server {_servers.FirstOrDefault(s => s.Id == assignment.ClientId)?.HostName ?? assignment.ClientId.ToString()}";

    private async Task AssignAsync()
    {
        Outcome outcome;
        if (!await IsAuthorizedAsync(AdminRoles.Policies.Administer))
        {
            outcome = new Outcome("Only administrators assign packages.");
        }
        else
        {
            int? group = Target is ['g', ':', .. var g] && int.TryParse(g, System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out var gid) ? gid : null;
            Guid? server = Target is ['s', ':', .. var s] && Guid.TryParse(s, out var sid) ? sid : null;
            outcome = await Assignments.AddAsync(PackageId, group, server, Version, UninstallOnRemoval == "true", await GetActorAsync(), CancellationToken.None);
        }

        ShowResult(outcome.Error, "The package was assigned.");
        await LoadAsync();
    }

    private async Task UnassignAsync()
    {
        var outcome = !await IsAuthorizedAsync(AdminRoles.Policies.Administer) ? new Outcome("Only administrators remove assignments.")
            : AssignmentId is { } id ? await Assignments.RemoveAsync(id, await GetActorAsync(), CancellationToken.None, UnassignUninstall switch { "uninstall" => true, "keep" => false, _ => null })
            : new Outcome("Invalid request.");
        ShowResult(outcome.Error, "The assignment was removed.");
        await LoadAsync();
    }
    [Parameter] public string PackageId { get; set; } = string.Empty;

    private PackageEntity? _package;
    private bool _enabled = true;
    private List<PackageVersionEntity> _versions = [];
    private Dictionary<Guid, RolloutState> _rollouts = [];
    private List<(Guid ClientId, string HostName, string? Version, SoftwareMatch Match)> _installed = [];

    private StartRuleEntity? _startRule;

    /// <summary>
    /// How new versions reach the servers, at a glance (Marc, 2026-11-13): the start rule that decides for this package
    /// and its assignments for new installations.
    /// </summary>
    private IReadOnlyList<StatusRow> RolloutRows
    {
        get
        {
            if (_package is null)
            {
                return [];
            }

            var rows = new List<StatusRow>
            {
                _startRule is not { } rule
                    ? new StatusRow("queue", "none", "Start rule", "no start rule matches", "new versions wait for a manual start on their update page")
                    : rule.Mode == StartMode.Automatic
                        ? new StatusRow(_package.HasAgreements && _package.AgreementsAcceptedAtUtc is null ? "queue" : "ok", "automatic", "Start rule", $"start rule with priority {rule.Priority} starts new versions automatically{(rule.Delay > TimeSpan.Zero ? $", delay {rule.Delay.TotalHours:0} h" : string.Empty)}", _package.HasAgreements && _package.AgreementsAcceptedAtUtc is null ? "not before an administrator accepts the agreements" : RuleConditions(rule), RuleLink(rule))
                        : new StatusRow("queue", "manual", "Start rule", $"start rule with priority {rule.Priority}: new versions wait for a manual start", RuleConditions(rule), RuleLink(rule)),
                _assignments.Count == 0
                    ? new StatusRow("neutral", "none", "Assignments", "not assigned", "only servers that have the package installed get its new versions")
                    : new StatusRow("ok", DisplayNumber.Format(_assignments.Count), "Assignments", $"assigned to {DisplayNumber.Count(_assignments.Count, "group or server", "groups or servers")}", "servers without the package install it when its version is released for their ring", @<a href="@($"{PackagePage.Link(_package.PackageId)}#assignments")">Assignments →</a>),
            };
            if (_uninstallStatus is { } uninstall)
            {
                // The last "Uninstall from servers…" while it runs and for a week after (Marc, 2026-11-14).
                var kind = uninstall.Waiting > 0 ? "pend" : uninstall.Failed + uninstall.StillPresent > 0 ? "fail" : "ok";
                var label = uninstall.Waiting > 0 ? "uninstalling" : uninstall.Failed + uninstall.StillPresent > 0 ? "with errors" : "uninstalled";
                var parts = new List<string> { $"{DisplayNumber.Format(uninstall.Done)} of {DisplayNumber.Count(uninstall.Total, "server", "servers")} done" };
                if (uninstall.Waiting > 0) { parts.Add($"{DisplayNumber.Format(uninstall.Waiting)} waiting for their software window or the next inventory"); }
                if (uninstall.Failed > 0) { parts.Add($"{DisplayNumber.Format(uninstall.Failed)} failed"); }
                if (uninstall.StillPresent > 0) { parts.Add($"{DisplayNumber.Format(uninstall.StillPresent)} still list it after uninstalling"); }
                rows.Add(new StatusRow(kind, label, "Uninstall", string.Join(", ", parts), $"started by {uninstall.StartedBy} on {DisplayTime.Format(uninstall.StartedAtUtc)}", @<a href="@($"{PackagePage.Link(_package.PackageId)}#installed")">Servers →</a>));
            }
            return rows;
        }
    }

    private static string RuleConditions(StartRuleEntity rule) =>
        $"package {rule.PackageIdPattern ?? "any"}, publisher {rule.Publisher ?? "any"}";

    private RenderFragment? RuleLink(StartRuleEntity rule) => _canAdminister ? @<a href="@($"/administration/release-rules?dialog=rule&id={rule.Id}")">Edit rule →</a> : null;

    private bool _canAdminister;

    /// <summary>Whether the installation accepts licence terms, with "Accept agreements" for administrators while open.</summary>
    private IReadOnlyList<StatusRow> AgreementRows => _package is null ? []
        : !_package.HasAgreements ? [new StatusRow("ok", "none", "Agreements", "none", "versions can start automatically")]
        : _package.AgreementsAcceptedAtUtc is { } accepted ? [new StatusRow("ok", "accepted", "Agreements", $"accepted by {_package.AgreementsAcceptedBy}", $"on {DisplayTime.Format(accepted)}")]
        : [new StatusRow("queue", "not accepted", "Agreements", "versions never start automatically until an administrator accepts them", "the installation accepts the publisher's licence terms on every server; read them on the publisher's page first", @<AuthorizeView Policy="@AdminRoles.Policies.Administer"><form method="post" @formname="package-accept" @onsubmit="AcceptAsync"><AntiforgeryToken /><button type="submit" class="primary"><Icon Name="check" Size="16" />Accept agreements</button></form></AuthorizeView>)];
    private IReadOnlyList<(string Label, string Url)> Links => _package is null ? [] : new[]
    {
        ("Product page", _package.PackageUrl),
        ("Publisher", _package.PublisherUrl),
        ("Release notes", _package.ReleaseNotesUrl),
        ("License", _package.LicenseUrl),
    }.Where(l => l.Item2 is not null).Select(l => (l.Item1, l.Item2!)).ToList();

    protected override Task OnInitializedAsync() => LoadAsync();

    private SoftwareTrustState _trust = SoftwareTrustState.None;

    private async Task LoadAsync()
    {
        _enabled = await Feature.IsEnabledAsync(CancellationToken.None);
        _trust = await Trust.GetAsync(null, CancellationToken.None);
        _package = await Db.Packages.AsNoTracking().SingleOrDefaultAsync(p => p.PackageId == PackageId);
        if (_package is null)
        {
            return;
        }

        _versions = [.. (await Db.PackageVersions.AsNoTracking().Where(v => v.PackageId == PackageId).ToListAsync()).OrderByDescending(v => v.Version, VersionComparer.Instance)];
        var ids = _versions.Select(v => v.UpdateId).ToList();
        _rollouts = await Db.Rollouts.AsNoTracking().Where(r => ids.Contains(r.UpdateId)).ToDictionaryAsync(r => r.UpdateId, r => r.State);
        _assignments = await Db.PackageAssignments.AsNoTracking().Where(a => a.PackageId == PackageId).OrderBy(a => a.CreatedAtUtc).ToListAsync();
        _canAdminister = await IsAuthorizedAsync(AdminRoles.Policies.Administer);
        var newest = _versions.Count > 0 ? await Db.Updates.AsNoTracking().FirstOrDefaultAsync(u => u.UpdateId == _versions[0].UpdateId) : null;
        _startRule = newest is null ? null : SUSyphos.Server.Rollouts.RolloutService.FindStartRule(await Db.StartRules.AsNoTracking().ToListAsync(), newest, _package.Publisher);
        _groups = await Db.Groups.AsNoTracking().OrderBy(g => g.Name).ToListAsync();
        _servers = await Db.Clients.AsNoTracking().Where(c => c.State == SUSyphos.Contracts.Agents.RegistrationState.Approved && c.SoftwareState != SUSyphos.Contracts.Agents.SoftwareSupportState.NotSupported).OrderBy(c => c.HostName).ToListAsync();
        _targets = await Uninstall.TargetsAsync(PackageId, CancellationToken.None);
        _rings = await Db.Rings.AsNoTracking().OrderBy(r => r.Order).ToListAsync();
        _uninstallStatus = await Uninstall.StatusAsync(PackageId, CancellationToken.None);
        _uninstalling = [.. await Db.AgentActions.AsNoTracking().Where(a => a.PackageId == PackageId && (a.State == AgentActionState.Queued || a.State == AgentActionState.Delivered)).Select(a => a.ClientId).ToListAsync()];
        _removalPreview = Dialog == "unassign" && DialogNumber is { } unassign ? await Assignments.PreviewRemovalAsync(unassign, CancellationToken.None) : null;
        _installed = [.. (await (from s in Db.ClientSoftware.AsNoTracking()
                                 join c in Db.Clients.AsNoTracking() on s.ClientId equals c.Id
                                 where s.PackageId == PackageId && c.State == SUSyphos.Contracts.Agents.RegistrationState.Approved
                                 select new { s.ClientId, c.HostName, s.InstalledVersion, s.MatchKind }).ToListAsync())
            .OrderBy(i => i.HostName, StringComparer.OrdinalIgnoreCase)
            .Select(i => (i.ClientId, i.HostName, i.InstalledVersion, i.MatchKind))];
    }

    private async Task AcceptAsync()
    {
        var outcome = !await Feature.IsEnabledAsync(CancellationToken.None) ? new Outcome("Software management is switched off.")
            : await IsAuthorizedAsync(AdminRoles.Policies.Administer)
            ? await Catalog.AcceptAgreementsAsync(PackageId, await GetActorAsync(), CancellationToken.None)
            : new Outcome("Only administrators accept agreements.");
        ShowResult(outcome.Error, "The agreements were accepted; versions of the package can now start automatically.");
        await LoadAsync();
    }

    /// <summary>The tags without repeats that differ only in "-" or "." (microsoft-iis-url-rewrite = microsoftiisurlrewrite).</summary>
    internal static IReadOnlyList<string> DistinctTags(string tags) =>
        [.. tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .GroupBy(t => new string([.. t.Where(char.IsLetterOrDigit)]), StringComparer.OrdinalIgnoreCase)
            .Select(g => g.First())];

    /// <summary>A server's version against the newest one: up to date, older or newer than the source.</summary>
    private (string Label, string Class) InstalledState(string? installed)
    {
        var newest = _versions.Select(v => v.Version).OrderByDescending(v => v, SUSyphos.WinGet.Catalog.RestSource.VersionComparer.Instance).FirstOrDefault();
        if (installed is null || newest is null)
        {
            return ("unknown", "neutral");
        }

        var compared = SUSyphos.WinGet.Catalog.RestSource.VersionComparer.Instance.Compare(installed, newest);
        return compared < 0 ? ("older", "queue") : compared > 0 ? ("newer than the source", "neutral") : ("up to date", "ok");
    }
}
