@page "/approvals"
@attribute [Authorize(Policy = AdminRoles.Policies.Operate)]
@using SUSyphos.Contracts.Agents
@using SUSyphos.Server.Agents
@using SUSyphos.Server.Approval
@inject ServerDbContext Db
@inject ClientApprovalService Approvals
@inject SUSyphos.Server.Rollouts.RolloutAdministration Rollouts
@inject SUSyphos.Server.Assignment.LeaseService Leases
@inject SUSyphos.Server.Approval.ClientLifecycle Lifecycle
@inject SUSyphos.Server.Approval.ApprovalDomains Domains
@inject IAuthorizationService Authorization
@inject NavigationManager Navigation

@* New servers appear without script: the page reloads every 30 seconds. *@
<LiveRefresh Seconds="30" />
<PageTitle>Approvals</PageTitle>

<PageHeader Title="Approvals" Icon="@PageIcons.Approvals" Subtitle="Decisions that wait for an operator: new servers, ring transitions, stopped groups and clone suspicions" Help="approvals" />

@if (_message is not null)
{
    <p class="notice" role="status">@_message</p>
}

<ActionBand>
    <button type="submit" form="decision" name="Action" value="approve-selected" class="primary"><Icon Name="check" Size="16" />Approve selected servers</button>
    <div class="spacer"></div>
    <span class="note">Approve only servers you expect</span>
    <button type="submit" form="decision" name="Action" value="reject-selected" class="danger"><Icon Name="x" Size="16" />Reject selected servers</button>
</ActionBand>

@* One form that is always rendered, so a decision posted after the list changed still reaches the handler. The list
   is outside it (its search and filters are forms of their own); checkboxes and buttons belong to it by form="decision". *@
<form id="decision" method="post" @formname="decision" @onsubmit="DecideAsync" class="detached">
    <AntiforgeryToken />
</form>
<section class="box">
    <header class="box-head">
        <h2>New servers<HelpLink To="approvals#pending" Label="New servers" /> @if (_pending.Count > 0) { <span class="pill pend">@_pending.Count</span> }</h2>
        <span class="hint">Registered without any secret; rejected servers send nothing until they are deleted</span>
    </header>
    @if (_pending.Count == 0)
    {
        <div class="empty-state">No server is waiting for approval.</div>
    }
    else
    {
        <ListTable Table="_pendingTable" Page="_pendingPage" Columns="PendingColumns" Search="Search name, domain or address" Noun="servers" ExtraColumns="2">
            <Leading><th class="select"><input type="checkbox" data-select-all="Selected" data-help="tables#select" data-help-term="Select all" aria-label="Select all servers shown" hidden /></th></Leading>
            <ExtraHeader><th class="n">Decide</th></ExtraHeader>
            <Row Context="client">
                        <tr>
                            <td><input type="checkbox" form="decision" data-help-term="Select" name="Selected" value="@client.Id" aria-label="Select @client.HostName" /></td>
                            <td class="nowrap">@client.HostName@if (client.DomainName is { Length: > 0 } domain) { <div class="note">@domain</div> }</td>
                            <td class="mono">@client.RegisteredFromAddress</td>
                            <td class="nowrap">@OperatingSystems.Name(client.OsProductName, client.OsVersion, client.OsEditionId) <span class="note mono">@OperatingSystems.Build(client.OsVersion)</span></td>
                            <td>@string.Join(", ", client.Roles)</td>
                            <td class="nowrap">@DisplayTime.FormatDate(client.RegisteredAtUtc)</td>
                            <td class="nowrap">@Format(client.LastHeartbeatAtUtc)</td>
                            <td class="n"><span class="row-actions">
                                <button type="submit" form="decision" name="Action" value="approve:@client.Id"><Icon Name="check" Size="16" />Approve</button>
                                <button type="submit" form="decision" name="Action" value="reject:@client.Id" class="danger"><Icon Name="x" Size="16" />Reject</button>
                            </span></td>
                        </tr>
            </Row>
        </ListTable>
    }
</section>

<form id="transition" method="post" @formname="transition" @onsubmit="DecideTransitionAsync" class="detached">
    <AntiforgeryToken />
</form>
<section class="box">
    <header class="box-head">
        <h2>Ring transitions<HelpLink To="approvals#transitions" Label="Ring transitions" /> @if (_gates.Count > 0) { <span class="pill queue">@_gates.Count</span> }</h2>
        <span class="hint">Approving releases the update for the ring; stopping withdraws it from servers that have not installed it</span>
    </header>
    @if (_gates.Count == 0)
    {
        <div class="empty-state">No update waits at a manual gate or stopped on an alarm.</div>
    }
    else
    {
        <ListTable Table="_gateTable" Page="_gatePage" Columns="GateColumns" Search="Search update" Noun="transitions" ExtraColumns="1">
            <ExtraHeader><th class="n">Decide</th></ExtraHeader>
            <Row Context="gate">
                    @{
                        var key = $"{gate.Ring.UpdateId:D}:{gate.Ring.Revision}";
                    }
                        <tr>
                            <td class="wrap"><a href="/updates/@gate.Ring.UpdateId/@gate.Ring.Revision">@gate.Title</a></td>
                            <td>@gate.RingName</td>
                            <td>@if (gate.Ring.State == RingRolloutState.Alarm) { <span class="pill fail">Alarm</span> <span class="note">@gate.Ring.Reason</span> } else { <span class="pill queue">Awaiting approval</span> }</td>
                            <td class="nowrap">@Format(gate.Ring.StateChangedAtUtc)</td>
                            <td class="n"><span class="row-actions">
                                <button type="submit" form="transition" name="Transition" value="approve:@key:@gate.Ring.RingId" class="primary">@(gate.Ring.State == RingRolloutState.Alarm ? "Release anyway" : "Approve")</button>
                                <button type="submit" form="transition" name="Transition" value="stop:@key:0" class="danger">Stop rollout</button>
                            </span></td>
                        </tr>
            </Row>
        </ListTable>
    }
</section>

<div class="grid-2">
    <form method="post" @formname="halted" @onsubmit="ResumeGroupAsync" class="box">
        <AntiforgeryToken />
        <header class="box-head">
            <h2>Stopped coordinated groups<HelpLink To="approvals#groups" Label="Stopped coordinated groups" /> @if (_halted.Count > 0) { <span class="pill fail">@_halted.Count</span> }</h2>
            <span class="hint">Check the servers of the group, then resume it</span>
        </header>
        @if (_halted.Count == 0)
        {
            <div class="empty-state">No coordinated group is stopped.</div>
        }
        else
        {
            <table>
                <thead><tr><th>Group</th><th class="n">Failed leases in a row</th><th class="n"></th></tr></thead>
                <tbody>
                    @foreach (var group in _halted)
                    {
                        <tr>
                            <td>@group.Name</td>
                            <td class="n">@group.ConsecutiveLeaseFailures</td>
                            <td class="n"><span class="row-actions"><button type="submit" name="ResumeGroup" value="@group.Id">Resume</button></span></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </form>

    <form method="post" @formname="blocked" @onsubmit="UnblockAsync" class="box">
        <AntiforgeryToken />
        <header class="box-head">
            <h2>Clone suspicions<HelpLink To="approvals#blocked" Label="Clone suspicions" /> @if (_blocked.Count > 0) { <span class="pill fail">@_blocked.Count</span> }</h2>
            <span class="hint">Credentials used by two hosts in turn; unblock if only one host uses them, else delete the server</span>
        </header>
        @if (_blocked.Count == 0)
        {
            <div class="empty-state">No clone suspicion.</div>
        }
        else
        {
            <table>
                <thead><tr><th>Server</th><th>Host names seen</th><th>Last heartbeat</th><th class="n"></th></tr></thead>
                <tbody>
                    @foreach (var client in _blocked)
                    {
                        <tr>
                            <td><a href="/servers/@client.Id">@client.HostName</a></td>
                            <td>@client.LastHeartbeatHostName, @client.PreviousHostName</td>
                            <td class="nowrap">@Format(client.LastHeartbeatAtUtc)</td>
                            <td class="n"><span class="row-actions"><button type="submit" name="UnblockClient" value="@client.Id">Unblock</button></span></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </form>
</div>

<form method="post" @formname="approval-domains" @onsubmit="ChangeDomainAsync" class="box">
    <AntiforgeryToken />
    <header class="box-head"><h2>Automatic approval<HelpLink To="approvals#domains" Label="Automatic approval" /></h2><span class="hint">New servers of these domains are approved once their computer account is found enabled in Active Directory and they registered from an address DNS lists for them</span></header>
    <div class="box-body form">
        <div>
            @if (_domains.Count == 0)
            {
                <span class="note">No domain: every new server waits for a manual decision.</span>
            }
            @foreach (var domain in _domains)
            {
                <span class="tag">@domain.Name</span>
                @if (domain.Source == SUSyphos.Server.Approval.ApprovalDomainSource.Configuration)
                {
                    <span class="note">(configuration)</span>
                }
                else
                {
                    <AuthorizeView Policy="@AdminRoles.Policies.Administer" Context="admin">
                        <button type="submit" name="DomainAction" value="remove:@domain.Name" class="danger">Remove</button>
                    </AuthorizeView>
                }
            }
        </div>
        <AuthorizeView Policy="@AdminRoles.Policies.Administer" Context="admin">
            <AddEntry>
                <ChildContent>
                    <label class="field"><span>Add domain</span><input name="Domain" maxlength="253" placeholder="corp.example.com" /></label>
                    <button type="submit" name="DomainAction" value="add"><Icon Name="plus" Size="16" />Add domain</button>
                </ChildContent>
                <Note>Changes are audited; the central server must reach the domain controllers (LDAP with signing) and DNS.</Note>
            </AddEntry>
        </AuthorizeView>
    </div>
</form>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    /// <summary>Value of the pressed button: "approve:{client id}" or "reject:{client id}".</summary>
    [SupplyParameterFromForm(FormName = "decision")]
    private string? Action { get; set; }

    /// <summary>Value of the pressed transition button: "{approve|stop}:{update id}:{revision}:{ring id}".</summary>
    [SupplyParameterFromForm(FormName = "transition")]
    private string? Transition { get; set; }

    private List<ClientEntity> _pending = [];
    private List<(RolloutRingEntity Ring, string Title, string RingName)> _gates = [];
    private TableQuery _pendingTable = default!;
    private TablePage<ClientEntity> _pendingPage = default!;
    private TableQuery _gateTable = default!;
    private TablePage<(RolloutRingEntity Ring, string Title, string RingName)> _gatePage = default!;

    private static readonly IReadOnlyList<TableColumn<ClientEntity>> PendingColumns =
    [
        new("name", "Server", c => c.HostName, c => [c.DomainName ?? string.Empty]),
        new("from", "Registered from", c => c.RegisteredFromAddress),
        new("os", "Operating system", c => OperatingSystems.Name(c.OsProductName, c.OsVersion, c.OsEditionId), c => [OperatingSystems.Name(c.OsProductName, c.OsVersion, c.OsEditionId)]),
        new("roles", "Roles", c => string.Join(", ", c.Roles), c => c.Roles.Count == 0 ? [string.Empty] : [.. c.Roles]),
        new("registered", "Registered", c => c.RegisteredAtUtc),
        new("seen", "Last seen", c => c.LastHeartbeatAtUtc),
    ];

    private static readonly IReadOnlyList<TableColumn<(RolloutRingEntity Ring, string Title, string RingName)>> GateColumns =
    [
        new("update", "Update", g => g.Title),
        new("ring", "Ring", g => g.RingName, g => [g.RingName]),
        new("state", "State", g => g.Ring.State.ToString(), g => [g.Ring.State == RingRolloutState.Alarm ? "Alarm" : "Awaiting approval"]),
        new("since", "Since", g => g.Ring.StateChangedAtUtc),
    ];
    private List<GroupEntity> _halted = [];
    private List<ClientEntity> _blocked = [];

    [SupplyParameterFromForm(FormName = "blocked")]
    private string? UnblockClient { get; set; }

    [SupplyParameterFromForm(FormName = "halted")]
    private string? ResumeGroup { get; set; }
    private string? _message;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    [SupplyParameterFromForm(FormName = "decision")]
    private Guid[]? Selected { get; set; }

    private async Task DecideAsync()
    {
        if (Action is "approve-selected" or "reject-selected")
        {
            await DecideSelectedAsync(Action == "approve-selected");
            return;
        }

        var parts = Action?.Split(':', 2);
        var decision = parts?[0];
        if (parts is not { Length: 2 } || decision is not ("approve" or "reject") || !Guid.TryParse(parts[1], out var id))
        {
            _message = "Invalid request.";
            return;
        }

        var actor = AuthenticationState is null ? "unknown" : (await AuthenticationState).User.Identity?.Name ?? "unknown";
        var result = decision == "approve"
            ? await Approvals.ApproveAsync(id, actor, null, CancellationToken.None)
            : await Approvals.RejectAsync(id, actor, null, CancellationToken.None);

        _message = result switch
        {
            ApprovalResult.Done => decision == "approve" ? "The server was approved." : "The server was rejected.",
            ApprovalResult.NotPending => "The server was already decided by someone else.",
            _ => "The server no longer exists.",
        };
        await LoadAsync();
    }

    private async Task DecideSelectedAsync(bool approve)
    {
        var selected = (Selected ?? []).Distinct().Take(500).ToList();
        if (selected.Count == 0)
        {
            _message = "Select at least one server in the list first.";
            await LoadAsync();
            return;
        }

        var actor = AuthenticationState is null ? "unknown" : (await AuthenticationState).User.Identity?.Name ?? "unknown";
        var done = 0;
        foreach (var id in selected)
        {
            var result = approve
                ? await Approvals.ApproveAsync(id, actor, null, CancellationToken.None)
                : await Approvals.RejectAsync(id, actor, null, CancellationToken.None);
            done += result == ApprovalResult.Done ? 1 : 0;
        }

        _message = $"{(approve ? "Approved" : "Rejected")} {done} servers.{(done < selected.Count ? $" {selected.Count - done} were already decided or no longer exist." : string.Empty)}";
        await LoadAsync();
    }

    [SupplyParameterFromForm(FormName = "approval-domains")]
    private string? DomainAction { get; set; }

    [SupplyParameterFromForm(FormName = "approval-domains")]
    private string? Domain { get; set; }

    private IReadOnlyList<SUSyphos.Server.Approval.ApprovalDomain> _domains = [];

    private async Task ChangeDomainAsync()
    {
        // The page is open to operators; the domains are for administrators, checked again in the handler.
        var user = AuthenticationState is null ? null : (await AuthenticationState).User;
        if (user is null || !(await Authorization.AuthorizeAsync(user, AdminRoles.Policies.Administer)).Succeeded)
        {
            _message = "Only administrators can change automatic approval.";
            await LoadAsync();
            return;
        }

        var actor = user.Identity?.Name ?? "unknown";
        var outcome = DomainAction switch
        {
            "add" => await Domains.AddAsync(Domain, actor, CancellationToken.None),
            { } remove when remove.StartsWith("remove:", StringComparison.Ordinal) => await Domains.RemoveAsync(remove["remove:".Length..], actor, CancellationToken.None),
            _ => new Outcome("Invalid request."),
        };
        _message = outcome.Error ?? (DomainAction == "add" ? "The domain is approved automatically from now on." : "The domain was removed from automatic approval.");
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _domains = await Domains.ListAsync(CancellationToken.None);
        _pending = await Db.Clients.AsNoTracking()
            .Where(c => c.State == RegistrationState.Pending)
            .OrderBy(c => c.RegisteredAtUtc)
            .Take(500)
            .ToListAsync();

        _pendingTable = TableQuery.From(Navigation, "registered", prefix: "new.");
        _pendingPage = TablePaging.Apply(_pending, _pendingTable, PendingColumns, c => $"{c.HostName} {c.DomainName} {c.RegisteredFromAddress}");

        _halted = await Db.Groups.AsNoTracking().Where(g => g.LeasesHalted).OrderBy(g => g.Name).ToListAsync();
        _blocked = await Db.Clients.AsNoTracking().Where(c => c.State == RegistrationState.Blocked).OrderBy(c => c.HostName).Take(500).ToListAsync();

        var waiting = await Db.RolloutRings.AsNoTracking()
            .Where(r => r.State == RingRolloutState.AwaitingApproval || r.State == RingRolloutState.Alarm)
            .Join(Db.Rollouts.Where(o => o.State == RolloutState.Active), r => new { r.UpdateId, r.Revision }, o => new { o.UpdateId, o.Revision }, (r, _) => r)
            .OrderBy(r => r.StateChangedAtUtc)
            .Take(500)
            .ToListAsync();
        var ids = waiting.Select(r => r.UpdateId).Distinct().ToList();
        var updates = await Db.Updates.AsNoTracking().Where(u => ids.Contains(u.UpdateId)).ToListAsync();
        var rings = await Db.Rings.AsNoTracking().ToDictionaryAsync(r => r.Id, r => r.Name);
        _gates = [.. waiting.Select(r =>
        {
            var update = updates.FirstOrDefault(u => u.UpdateId == r.UpdateId && u.Revision == r.Revision);
            var title = SUSyphos.Server.Rollouts.UpdateText.Title(update, r.UpdateId);
            return (r, title, rings.GetValueOrDefault(r.RingId) ?? "?");
        })];
        _gateTable = TableQuery.From(Navigation, "since", prefix: "gate.");
        _gatePage = TablePaging.Apply(_gates, _gateTable, GateColumns, g => g.Title);
    }

    private async Task UnblockAsync()
    {
        var actor = AuthenticationState is null ? "unknown" : (await AuthenticationState).User.Identity?.Name ?? "unknown";
        var outcome = Guid.TryParse(UnblockClient, out var clientId)
            ? await Lifecycle.UnblockAsync(clientId, actor, CancellationToken.None)
            : new Outcome("Invalid request.");
        _message = outcome.Error ?? "The server was unblocked.";
        await LoadAsync();
    }

    private async Task ResumeGroupAsync()
    {
        var actor = AuthenticationState is null ? "unknown" : (await AuthenticationState).User.Identity?.Name ?? "unknown";
        var outcome = int.TryParse(ResumeGroup, System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out var groupId)
            ? await Leases.ResumeAsync(groupId, actor, CancellationToken.None)
            : new Outcome("Invalid request.");
        _message = outcome.Error ?? "The group issues leases again.";
        await LoadAsync();
    }

    private async Task DecideTransitionAsync()
    {
        var parts = Transition?.Split(':');
        if (parts is not [var action and ("approve" or "stop"), var id, var rev, var ring]
            || !Guid.TryParse(id, out var updateId)
            || !int.TryParse(rev, System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out var revision)
            || !int.TryParse(ring, System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out var ringId))
        {
            _message = "Invalid request.";
            await LoadAsync();
            return;
        }

        var actor = AuthenticationState is null ? "unknown" : (await AuthenticationState).User.Identity?.Name ?? "unknown";
        var outcome = action == "approve"
            ? await Rollouts.ApproveRingAsync(updateId, revision, ringId, actor, CancellationToken.None)
            : await Rollouts.StopAsync(updateId, revision, actor, CancellationToken.None);
        _message = outcome.Error ?? (action == "approve" ? "The update was released for the ring." : "The rollout was stopped.");
        await LoadAsync();
    }

    private static string Format(DateTime? value) => DisplayTime.Format(value);
}
