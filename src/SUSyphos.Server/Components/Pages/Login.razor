@page "/login"
@inject SignInManager<IdentityUser> SignInManager
@inject AuditLog Audit
@inject SetupService Setup
@inject NavigationManager Navigation
@inject WindowsSignIn Windows

<PageTitle>Sign in</PageTitle>

<div class="auth-page">
    <section class="auth-card box">
        <header class="box-head"><span class="auth-brand"><img src="susyphos-icon.svg" alt="" width="28" height="28" />SUSyphos</span><span class="hint">Central server</span></header>
        <div class="box-body form">
            <h1>Sign in<HelpLink To="sign-in#sign-in" Label="Sign in" /></h1>
            @if (Setup.IsAvailable)
            {
                <p class="notice">No account exists yet. <a href="@DashboardServiceCollectionExtensions.SetupPath">Create the first administrator</a> with the one-time token from <code>@Setup.TokenPath</code> on the central server (readable by administrators only), or open the setup from the last page of the installer.</p>
            }
            @if (_error is not null)
            {
                <p class="error" role="alert">@_error</p>
            }
            <EditForm Model="Input" method="post" OnValidSubmit="SignInAsync" FormName="login" class="form">
                <DataAnnotationsValidator />
                <label class="field"><span>User name</span><InputText @bind-Value="Input!.UserName" autocomplete="username" /></label>
                <label class="field"><span>Password</span><InputText type="password" @bind-Value="Input!.Password" autocomplete="current-password" /></label>
                <ValidationSummary />
                <button type="submit" class="primary">Sign in</button>
            </EditForm>
            @if (_windowsEnabled)
            {
                <a class="btn" href="@WindowsLink">Sign in with Windows</a>
            }
        </div>
    </section>
</div>

@code {
    [SupplyParameterFromForm]
    private LoginInput? Input { get; set; }

    protected override void OnInitialized() => Input ??= new();

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private string? _error;
    private bool _windowsEnabled;

    /// <summary>Why the last Windows sign-in failed, from the redirect of the Windows sign-in route.</summary>
    [SupplyParameterFromQuery(Name = "windows")]
    private string? WindowsFailure { get; set; }

    private string WindowsLink => string.IsNullOrEmpty(ReturnUrl)
        ? WindowsSignIn.Route
        : $"{WindowsSignIn.Route}?returnUrl={Uri.EscapeDataString(LocalReturnUrl.Sanitize(ReturnUrl))}";

    protected override async Task OnParametersSetAsync()
    {
        _windowsEnabled = await Windows.IsEnabledAsync(CancellationToken.None);
        _error ??= WindowsFailure switch
        {
            "norole" => "Your Windows account is in none of the AD groups that may use the dashboard. Ask an administrator; the audit log names the account that signed in.",
            "filteredgroup" => "Your Windows account is in a mapped group (such as Domain Admins) only as a group filtered by User Account Control (\"deny only\"), which gives no role. Ask an administrator to map a dedicated group instead.",
            "locked" => "Your account is locked in the dashboard. Ask an administrator.",
            "disabled" => "Sign-in with Windows is switched off.",
            "invalid" => "Windows did not identify your account. Sign in with a local account or ask an administrator.",
            _ => null,
        };
    }

    private async Task SignInAsync()
    {
        var result = await SignInManager.PasswordSignInAsync(Input!.UserName, Input.Password, isPersistent: false, lockoutOnFailure: true);
        if (result.Succeeded)
        {
            await Audit.WriteAsync(Input.UserName, "Login.Succeeded");
            Navigation.NavigateTo(LocalReturnUrl.Sanitize(ReturnUrl), forceLoad: true);
            return;
        }

        await Audit.WriteAsync(Input.UserName, result.IsLockedOut ? "Login.LockedOut" : "Login.Failed");

        // Same message for unknown users and wrong passwords, so user names cannot be probed.
        _error = result.IsLockedOut
            ? "The account is locked because of too many failed attempts. Try again later."
            : "Invalid user name or password.";
    }

    private sealed class LoginInput
    {
        [Required]
        [StringLength(256)]
        public string UserName { get; set; } = string.Empty;

        [Required]
        [StringLength(256)]
        public string Password { get; set; } = string.Empty;
    }
}
