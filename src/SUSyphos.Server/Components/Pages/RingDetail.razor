@page "/rings/{RingId:int}"
@attribute [Authorize(Policy = AdminRoles.Policies.Read)]
@using SUSyphos.Server.Agents
@using SUSyphos.Server.Assignment
@inject ServerDbContext Db
@inject DeploymentStatus Deployment
@inject RolloutService Rollouts
@inject NavigationManager Navigation
@inject TimeProvider Time
@inject AssignmentAdministration Administration
@inherits DashboardPageBase

<PageTitle>Ring @_ring?.Name</PageTitle>

@if (_ring is null)
{
    <PageHeader Title="Ring not found" />
    <Box><p>The ring does not exist. <a href="/rings/@RingEntity.PilotId">Show the first ring</a></p></Box>
}
else
{
    <nav class="steps" aria-label="Rings">
        @for (var i = 0; i < _rings.Count; i++)
        {
            var ring = _rings[i];
            <a class="@(ring.Id == _ring.Id ? "current" : null)" href="/rings/@ring.Id" aria-current="@(ring.Id == _ring.Id ? "page" : null)">@ring.Order · @ring.Name · @_serverCounts.GetValueOrDefault(ring.Id)</a>
            @if (i < _rings.Count - 1)
            {
                @if (_transitions.GetValueOrDefault(ring.Id) is { } transition)
                {
                    <span class="arrow" aria-hidden="true">→ @string.Create(System.Globalization.CultureInfo.InvariantCulture, $"{transition.MinimumWait.TotalDays:0}–{transition.MaximumWait.TotalDays:0} days") →</span>
                    @if (transition.ManualGate)
                    {
                        <span class="gate">manual gate</span><span class="arrow" aria-hidden="true">→</span>
                    }
                }
                else
                {
                    <span class="arrow" aria-hidden="true">→</span>
                }
            }
        }
    </nav>

    <PageHeader Title="@($"Ring {_ring.Order} · {_ring.Name}")" Subtitle="@($"{_servers} servers · {TransitionText}")" Help="rings" />
    <StatusMessage Text="@Message" IsError="@MessageIsError" />

    <ActionBand>
        <a class="btn primary" href="@Servers.Link("ring", _ring.Name)">Open servers of this ring</a>
        <AuthorizeView Policy="@AdminRoles.Policies.Administer">
            <a class="btn" href="/rings/@_ring.Id?dialog=add">Add servers…</a>
            <a class="btn" href="/administration/release-rules">Edit ring rules</a>
            <a class="btn" href="/administration/rules">Edit assignment rules</a>
        </AuthorizeView>
    </ActionBand>

    <div class="grid-side wide-only">
        <Box Title="Updates in this ring" Help="rings#updates" Hint="Select an update to see its status per server" Flush="true">
            <div class="scroll">
                <table>
                    <thead><tr><th>Update</th><th>Classification</th><th>State</th><th>Installs from</th><th>Day</th><th class="n">Feedback</th><th class="n">Success</th><th>Servers</th></tr></thead>
                    <tbody>
                        @if (_active.Count == 0)
                        {
                            <tr><td colspan="8" class="note">No update is released for this ring or waiting before it.</td></tr>
                        }
                        @foreach (var update in _active)
                        {
                            <tr class="@(update.Key == _selected?.Key && Tab == "update" ? "selected" : null)">
                                <td class="wrap"><a href="@UpdateLink(update)">@update.Title</a></td>
                                <td>@(update.Classification ?? "–")</td>
                                <td><span class="pill @update.StateClass">@update.State</span></td>
                                <td class="nowrap">@update.Released</td>
                                <td class="nowrap">@(update.Wait ?? "–")</td>
                                <td class="n">@Percent(update.Statistics.FeedbackPercent) <span class="note">(@update.Statistics.Reported/@update.Statistics.Targeted)</span></td>
                                <td class="n">@Percent(update.Statistics.SuccessPercent)</td>
                                <td><StackedBar Counts="@update.Counts" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </Box>

        <Box Title="Ring status" Help="rings#status" Hint="servers × updates">
            <div class="ring-status">
                <Donut Counts="@_ringCounts" />
                <Legend Counts="@_ringCounts" Vertical="true" />
            </div>
            <p class="note">Every server of the ring for every update released here. Pending: released, waiting for the maintenance window or installing. Queued: reported as missing, not released for this ring yet. Not needed: already installed otherwise or not applicable to the server.</p>
        </Box>
    </div>

    <Box Flush="true">
        <Header>
            <nav class="tabs" aria-label="Ring details">
                <a class="@(Tab != "update" ? "current" : null)" href="@TabLink("servers")">Servers in this ring (@_servers)</a>
                @if (_selected is not null)
                {
                    <a class="@(Tab == "update" ? "current" : null)" href="@TabLink("update")">Status of @_selected.ShortTitle per server</a>
                }
            </nav>
            <HelpLink To="rings#servers" Label="Servers in this ring" />
            @if (Tab == "update" && _selected is not null)
            {
                <a href="/updates/@(_selected.Key.Replace(":", "/", StringComparison.Ordinal))">Update details ›</a>
            }
        </Header>
        <ChildContent>
            @if (Tab == "update" && _selected is not null)
            {
                <div class="scroll">
                    <table>
                        <thead><tr><th>Server</th><th>Maintenance windows (server time)</th><th>Earliest installation</th><th>Status</th><th>Result</th></tr></thead>
                        <tbody>
                            @if (_serverRows.Count == 0)
                            {
                                <tr><td colspan="5" class="note">No server of this ring reported this update as missing.</td></tr>
                            }
                            @foreach (var row in _serverRows)
                            {
                                <tr>
                                    <td><a href="/servers/@row.ClientId">@row.HostName</a></td>
                                    <td>@row.Windows</td>
                                    <td class="nowrap">@Format(row.Entry.EarliestInstallAtUtc)</td>
                                    <td><span class="pill @DeploymentText.PillClass(row.Entry.State)">@row.Entry.State</span></td>
                                    <td>@DeploymentText.Result(row.Entry)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <TableTools Table="_table" Placeholder="Search server" Labels="MemberLabels" />
                <div class="scroll">
                    <table>
                        <thead>
                            <tr>
                                <SortHeader Table="_table" Column="name" Label="Server" />
                                <SortHeader Table="_table" Column="os" Label="Operating system" Options="@_members.Options.GetValueOrDefault("os")" />
                                <SortHeader Table="_table" Column="build" Label="Build" />
                                <SortHeader Table="_table" Column="assigned" Label="Assigned by" Options="@_members.Options.GetValueOrDefault("assigned")" />
                                <SortHeader Table="_table" Column="status" Label="Status" Options="@_members.Options.GetValueOrDefault("status")" />
                                <SortHeader Table="_table" Column="pending" Label="Pending updates" Class="n" />
                            </tr>
                        </thead>
                        <tbody>
                            @if (_members.Rows.Count == 0)
                            {
                                <tr><td colspan="6" class="note">No server matches.</td></tr>
                            }
                            @foreach (var member in _members.Rows)
                            {
                                <tr>
                                    <td><a href="/servers/@member.Id">@member.HostName</a></td>
                                    <td class="nowrap">@member.Os</td>
                                    <td class="mono">@member.Build</td>
                                    <td>@member.AssignedBy</td>
                                    <td><span class="pill @ServerHealth.PillClass(member.Health)">@ServerHealth.Label(member.Health)</span></td>
                                    <td class="n">@member.Pending</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <Pager Table="_table" Page="PageInfo.Of(_members)" Noun="servers" />
            }
        </ChildContent>
    </Box>
}

@if (_ring is not null && Dialog == "add")
{
    <Dialog Title="@($"Add servers to {_ring.Name}")" CloseHref="@($"/rings/{_ring.Id}")" Wide="true" Help="rings#add-servers">
        <form method="post" @formname="ring-add" @onsubmit="AddServersAsync">
            <AntiforgeryToken />
            <div class="dialog-body">
                <p class="help">The selected servers are assigned to this ring manually; assignment rules no longer move them. Groups and maintenance windows stay.</p>
                @if (_candidates.Count == 0)
                {
                    <p class="note">Every approved server is already in this ring.</p>
                }
                else
                {
                    <div class="scroll">
                        <table>
                            <thead><tr><th></th><th>Server</th><th>Current ring</th><th>Assigned by</th></tr></thead>
                            <tbody>
                                @foreach (var candidate in _candidates)
                                {
                                    <tr>
                                        <td><input type="checkbox" data-help-term="Move" name="Move" value="@candidate.Id" aria-label="Move @candidate.HostName" /></td>
                                        <td>@candidate.HostName</td>
                                        <td><span class="tag">@candidate.RingName</span></td>
                                        <td class="note">@(candidate.Manual ? "manual" : "assignment rule or fallback")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
            <div class="dialog-foot"><a class="btn" href="/rings/@_ring.Id">Cancel</a><button type="submit" class="primary" disabled="@(_candidates.Count == 0)" data-help-term="Move to">Move to @_ring.Name</button></div>
        </form>
    </Dialog>
}

@code {
    private const int MaxServerRows = 500;

    private sealed record ActiveUpdate(string Key, string Title, string ShortTitle, string? Classification, string State, string StateClass, DeploymentCounts Counts, RingStatistics Statistics, string Released, string? Wait);

    private sealed record Member(Guid Id, string HostName, string Os, string Build, int BuildNumber, string AssignedBy, ServerHealthState Health, int Pending);

    private static readonly IReadOnlyDictionary<string, string> MemberLabels = new Dictionary<string, string> { ["os"] = "Operating system", ["assigned"] = "Assigned by", ["status"] = "Status" };

    private static readonly IReadOnlyList<TableColumn<Member>> MemberColumns =
    [
        new("name", "Server", m => m.HostName),
        new("os", "Operating system", m => m.BuildNumber, m => [m.Os]),
        new("build", "Build", m => m.Build),
        new("assigned", "Assigned by", m => m.AssignedBy, m => [m.AssignedBy]),
        new("status", "Status", m => (int)m.Health, m => [ServerHealth.Label(m.Health)]),
        new("pending", "Pending updates", m => m.Pending),
    ];

    /// <summary>Lower box: "servers" (members of the ring) or "update" (status of the selected update per server).</summary>
    [SupplyParameterFromQuery(Name = "tab")]
    public string? Tab { get; set; }

    private Dictionary<int, int> _serverCounts = [];
    private TableQuery _table = default!;
    private TablePage<Member> _members = new([], 0, 0, 1, 1, new Dictionary<string, IReadOnlyList<FilterOption>>());

    private string UpdateLink(ActiveUpdate update) => $"/rings/{RingId}?update={Uri.EscapeDataString(update.Key)}&tab=update";

    private string TabLink(string tab) => _selected is null ? $"/rings/{RingId}?tab={tab}" : $"/rings/{RingId}?update={Uri.EscapeDataString(_selected.Key)}&tab={tab}";

    private sealed record ServerRow(Guid ClientId, string HostName, string Windows, DeploymentEntry Entry);

    [Parameter]
    public int RingId { get; set; }

    /// <summary>Selected update as "{update id}:{revision}".</summary>
    [SupplyParameterFromQuery(Name = "update")]
    public string? UpdateKey { get; set; }

    private RingEntity? _ring;
    private List<RingEntity> _rings = [];
    private Dictionary<int, RingTransitionEntity> _transitions = [];
    private int _servers;
    private DeploymentCounts _ringCounts = DeploymentCounts.Empty;
    private List<ActiveUpdate> _active = [];
    private ActiveUpdate? _selected;
    private List<ServerRow> _serverRows = [];

    private string TransitionText => _transitions.GetValueOrDefault(_ring!.Id) is { } t
        ? string.Create(System.Globalization.CultureInfo.InvariantCulture,
            $"next ring {t.MinimumWait.TotalDays:0}–{t.MaximumWait.TotalDays:0} days after an update's release here, with feedback ≥ {t.MinimumFeedbackPercent} % and success ≥ {t.MinimumSuccessPercent} %{(t.ManualGate ? ", manual gate" : string.Empty)}")
        : "last ring, deployed last";

    [SupplyParameterFromQuery(Name = "dialog")]
    private string? Dialog { get; set; }

    [SupplyParameterFromForm(FormName = "ring-add")]
    private Guid[]? Move { get; set; }

    private sealed record Candidate(Guid Id, string HostName, string RingName, bool Manual);

    private List<Candidate> _candidates = [];

    private async Task AddServersAsync()
    {
        // The page is open to readers; moving servers is for administrators, checked again in the handler.
        if (!await IsAuthorizedAsync(AdminRoles.Policies.Administer))
        {
            ShowResult("Only administrators can move servers between rings.", string.Empty);
            return;
        }

        var selected = (Move ?? []).Distinct().Take(1000).ToList();
        var outcome = await Administration.MoveClientsToRingAsync(selected, RingId, await GetActorAsync(), CancellationToken.None);
        ShowResult(outcome.Error, $"{selected.Count} server(s) moved to {_ring?.Name}.");
        await OnParametersSetAsync();
    }

    protected override async Task OnParametersSetAsync()
    {        _rings = await Db.Rings.AsNoTracking().OrderBy(r => r.Order).ToListAsync();
        _ring = _rings.FirstOrDefault(r => r.Id == RingId);
        if (_ring is null)
        {
            return;
        }

        _transitions = await Db.RingTransitions.AsNoTracking().ToDictionaryAsync(t => t.FromRingId);
        if (Dialog == "add")
        {
            var ringNames = _rings.ToDictionary(r => r.Id, r => (r.Order, r.Name));
            _candidates = [.. (await Db.Clients.AsNoTracking()
                    .Where(c => c.State == SUSyphos.Contracts.Agents.RegistrationState.Approved && c.RingId != RingId)
                    .Select(c => new { c.Id, c.HostName, c.RingId, c.ManualRingId })
                    .Take(1000)
                    .ToListAsync())
                .OrderBy(c => c.RingId is { } r && ringNames.TryGetValue(r, out var ring) ? ring.Order : int.MaxValue)
                .ThenBy(c => c.HostName, StringComparer.OrdinalIgnoreCase)
                .Select(c => new Candidate(c.Id, c.HostName, c.RingId is { } r && ringNames.TryGetValue(r, out var ring) ? ring.Name : "none", c.ManualRingId is not null))];
        }
        _serverCounts = await Db.Clients.Where(c => c.State == SUSyphos.Contracts.Agents.RegistrationState.Approved && c.RingId != null).GroupBy(c => c.RingId!.Value).ToDictionaryAsync(g => g.Key, g => g.Count());
        _servers = _serverCounts.GetValueOrDefault(RingId);
        var entries = await Deployment.GetAsync(RingId, null, null, CancellationToken.None);
        _ringCounts = DeploymentCounts.Of(entries);

        var states = await Db.RolloutRings.AsNoTracking()
            .Where(r => r.RingId == RingId && r.State != RingRolloutState.Waiting)
            .Join(Db.Rollouts.Where(o => o.State == RolloutState.Active), r => new { r.UpdateId, r.Revision }, o => new { o.UpdateId, o.Revision }, (r, _) => r)
            .OrderByDescending(r => r.StateChangedAtUtc)
            .Take(100)
            .ToListAsync();
        var ids = states.Select(s => s.UpdateId).Distinct().ToList();
        var updates = await Db.Updates.AsNoTracking().Where(u => ids.Contains(u.UpdateId)).ToListAsync();
        var now = Time.GetUtcNow().UtcDateTime;

        _active = [];
        foreach (var state in states)
        {
            var update = updates.FirstOrDefault(u => u.UpdateId == state.UpdateId && u.Revision == state.Revision);
            var statistics = await Rollouts.GetStatisticsAsync(state.UpdateId, state.Revision, RingId, CancellationToken.None);
            var counts = DeploymentCounts.Of(entries.Where(e => e.UpdateId == state.UpdateId && e.Revision == state.Revision), _servers);
            var (label, cls) = state.State switch
            {
                RingRolloutState.Alarm => ($"Alarm: {state.Reason}", "fail"),
                RingRolloutState.AwaitingApproval => ("Waiting for manual release", "queue"),
                _ => counts.Pending > 0 ? ("Rolling out", "pend") : ("Released", "ok"),
            };
            var released = state.ReleasedAtUtc is { } at ? Format(at) : "not released yet";
            _active.Add(new ActiveUpdate(
                Key(state.UpdateId, state.Revision),
                UpdateText.Title(update, state.UpdateId),
                update?.KbArticle is { } kb ? $"KB{kb}" : Shorten(update?.Title ?? state.UpdateId.ToString("D")),
                update?.Classification,
                label,
                cls,
                counts,
                statistics,
                released,
                WaitText(state, now)));
        }

        // Updates servers of this ring report as missing that are not released here yet: listed too, so the list shows
        // everything the ring status counts (queued: no rollout or not started; waiting: the rollout has not reached the ring).
        var listed = _active.Select(a => a.Key).ToHashSet();
        var waiting = entries.Where(e => !listed.Contains(Key(e.UpdateId, e.Revision))).GroupBy(e => (e.UpdateId, e.Revision)).Take(100).ToList();
        if (waiting.Count > 0)
        {
            var waitingIds = waiting.Select(w => w.Key.UpdateId).Distinct().ToList();
            var waitingUpdates = await Db.Updates.AsNoTracking().Where(u => waitingIds.Contains(u.UpdateId)).ToListAsync();
            var running = (await Db.Rollouts.AsNoTracking().Where(o => waitingIds.Contains(o.UpdateId) && o.State == RolloutState.Active).Select(o => new { o.UpdateId, o.Revision }).ToListAsync())
                .Select(o => (o.UpdateId, o.Revision)).ToHashSet();
            foreach (var group in waiting.OrderBy(w => waitingUpdates.FirstOrDefault(u => u.UpdateId == w.Key.UpdateId && u.Revision == w.Key.Revision)?.Title, StringComparer.CurrentCulture))
            {
                var update = waitingUpdates.FirstOrDefault(u => u.UpdateId == group.Key.UpdateId && u.Revision == group.Key.Revision);
                var statistics = await Rollouts.GetStatisticsAsync(group.Key.UpdateId, group.Key.Revision, RingId, CancellationToken.None);
                _active.Add(new ActiveUpdate(
                    Key(group.Key.UpdateId, group.Key.Revision),
                    UpdateText.Title(update, group.Key.UpdateId),
                    update?.KbArticle is { } kb ? $"KB{kb}" : Shorten(update?.Title ?? group.Key.UpdateId.ToString("D")),
                    update?.Classification,
                    running.Contains(group.Key) ? "Waiting for the ring before" : "Queued: no rollout yet",
                    "queue",
                    DeploymentCounts.Of(group),
                    statistics,
                    "not released yet",
                    null));
            }
        }

        // Every server of the ring for every listed update, plus anything else reported (none after the list above), so the
        // donut accounts for all updates including servers that do not need them.
        var activeKeys = _active.Select(a => a.Key).ToHashSet();
        _ringCounts = _active.Aggregate(DeploymentCounts.Empty, (sum, a) => sum + a.Counts)
            + DeploymentCounts.Of(entries.Where(e => !activeKeys.Contains(Key(e.UpdateId, e.Revision))));

        _selected = _active.FirstOrDefault(a => a.Key == UpdateKey) ?? _active.FirstOrDefault();
        await LoadServersAsync(entries);
        await LoadMembersAsync(entries, now);
    }

    private async Task LoadServersAsync(IReadOnlyList<DeploymentEntry> entries)
    {
        _serverRows = [];
        if (_selected is null)
        {
            return;
        }

        var selected = entries.Where(e => Key(e.UpdateId, e.Revision) == _selected.Key).Take(MaxServerRows).ToList();
        var ids = selected.Select(e => e.ClientId).ToList();
        var clients = await Db.Clients.AsNoTracking()
            .Where(c => ids.Contains(c.Id))
            .Select(c => new { c.Id, c.HostName, c.EffectiveWindowsJson })
            .ToDictionaryAsync(c => c.Id);
        _serverRows = [.. selected
            .Where(e => clients.ContainsKey(e.ClientId))
            .Select(e => new ServerRow(e.ClientId, clients[e.ClientId].HostName, MaintenanceWindowFormat.Format(MaintenanceWindowFormat.FromJson(clients[e.ClientId].EffectiveWindowsJson) ?? []).Replace("\n", "; ", StringComparison.Ordinal), e))
            .OrderBy(r => r.Entry.State).ThenBy(r => r.HostName)];
    }

    private async Task LoadMembersAsync(IReadOnlyList<DeploymentEntry> entries, DateTime now)
    {
        _table = TableQuery.From(Navigation, "name");
        var failed = entries.Where(e => e.State == DeploymentState.Failed).Select(e => e.ClientId).ToHashSet();
        var pending = entries.Where(e => e.EarliestInstallAtUtc is not null && e.State != DeploymentState.Successful).GroupBy(e => e.ClientId).ToDictionary(g => g.Key, g => g.Count());
        var clients = await Db.Clients.AsNoTracking().Where(c => c.RingId == RingId && c.State == SUSyphos.Contracts.Agents.RegistrationState.Approved).ToListAsync();
        List<Member> members = [.. clients.Select(c => new Member(
            c.Id,
            c.HostName,
            OperatingSystems.Name(c.OsProductName, c.OsVersion),
            OperatingSystems.Build(c.OsVersion),
            OperatingSystems.BuildNumber(c.OsVersion) ?? 0,
            c.ManualRingId is not null ? "Manual" : "Assignment rule or fallback",
            ServerHealth.Evaluate(c, failed.Contains(c.Id), now),
            pending.GetValueOrDefault(c.Id)))];
        _members = TablePaging.Apply(members, _table, MemberColumns, m => m.HostName);
    }

    private static string Shorten(string title) => title.Length <= 40 ? title : title[..39] + "…";

    private string? WaitText(RolloutRingEntity state, DateTime now)
    {
        if (state.State != RingRolloutState.Released || state.ReleasedAtUtc is not { } releasedAt || !_transitions.TryGetValue(RingId, out var rule))
        {
            return null;
        }

        var days = (now - releasedAt).TotalDays;
        return days < 0
            ? "Delayed start"
            : string.Create(System.Globalization.CultureInfo.InvariantCulture, $"Day {Math.Floor(days) + 1:0} of {rule.MinimumWait.TotalDays:0}–{rule.MaximumWait.TotalDays:0}");
    }

    private static string Key(Guid updateId, int revision) =>
        string.Create(System.Globalization.CultureInfo.InvariantCulture, $"{updateId:D}:{revision}");

    private static string Percent(int? value) => value is null ? "n/a" : $"{value} %";

    private static string Format(DateTime? value) => DisplayTime.Format(value);
}
