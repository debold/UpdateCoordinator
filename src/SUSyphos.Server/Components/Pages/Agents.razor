@page "/agents"
@attribute [Authorize(Policy = AdminRoles.Policies.Operate)]
@inherits DashboardPageBase
@using SUSyphos.Contracts.Agents
@using SUSyphos.Server.AgentPackages
@inject ServerDbContext Db
@inject AgentPackageStore Store
@inject AgentPackageAdministration Administration
@inject AgentUpdateService Updates
@inject NavigationManager Navigation

<PageTitle>Agents</PageTitle>

<PageHeader Title="Agents" Icon="@PageIcons.Agents" Subtitle="Install the agent on new servers and keep the agents up to date. New versions come from the GitHub releases of the project and reach the agents only after an administrator released them." Help="agents" Crumbs="@([("Agents", null)])" />
<StatusMessage Text="@Message" IsError="@MessageIsError" />

<AuthorizeView Policy="@AdminRoles.Policies.Administer" Context="admin">
    <ActionBand>
        <form method="post" @formname="agents-check" @onsubmit="CheckAsync">
            <AntiforgeryToken />
            <button type="submit" class="primary"><Icon Name="refresh-cw" Size="16" />Check for new versions now</button>
        </form>
    </ActionBand>
</AuthorizeView>

<section class="tiles" aria-label="Agent versions">
    <Tile Title="Agents on the servers" Href="/servers" Edge="@(_agentParts.Any(p => p.Class == "fail" && p.Value > 0) ? "fail" : null)" Footer="approved servers by agent version state">
        <TileDonut Parts="@_agentParts" />
    </Tile>
    <Tile Title="Newest agent version" Href="#versions" Footer="@(_lastCheck is { } check ? $"last check {Format(check.AtUtc)}, {check.Describe()}" : "not checked yet")">
        <TileValue Value="@DisplayNumber.Version(_newest?.Version)" Caption="@ReleaseCaption" />
    </Tile>
    <CentralServerTile Update="@_serverUpdate" Href="#server" />
</section>

<div class="grid-side">
    <Box Title="Agent versions" Anchor="versions" Help="agents#versions" Hint="Agents update to the newest version released for their ring" Flush="true">
        <form method="post" @formname="agents-release" @onsubmit="ReleaseAsync" class="scroll">
            <AntiforgeryToken />
            <table>
                <thead><tr><th>Version</th><th>Source</th><th>Added</th><th>Released for</th><th class="n">Servers</th><th class="n">Actions</th></tr></thead>
                <tbody>
                    @if (_packages.Count == 0)
                    {
                        <tr><td colspan="6" class="note">No agent package yet. The central server installer ships one; a check finds newer ones.</td></tr>
                    }
                    @foreach (var package in _packages.Where(p => ShowOlder || !IsSuperseded(p)))
                    {
                        <tr>
                            <td class="mono">@package.Version</td>
                            <td><span class="tag">@(package.Source == AgentPackageSource.Bundled ? "with central server" : "GitHub")</span></td>
                            <td class="nowrap">@Format(package.AddedAtUtc)</td>
                            <td>
                                @if (package.ReleasedThroughRingOrder is null)
                                {
                                    <span class="pill neutral">not released</span>
                                }
                                else
                                {
                                    @foreach (var ring in _rings.Where(r => r.Order <= package.ReleasedThroughRingOrder))
                                    {
                                        <span class="tag">@ring.Name</span>
                                    }
                                    @if (package.ReleasedThroughRingOrder == AgentPackageEntity.AllRings)
                                    {
                                        <span class="pill ok">all rings</span>
                                    }
                                }
                            </td>
                            <td class="n">@if (_serversByVersion.GetValueOrDefault(package.Version) is > 0 and var onVersion) { <a href="@Servers.Link("agent", AgentVersion.ShortForm(package.Version))">@onVersion</a> } else { <span>0</span> }</td>
                            <td class="n">
                                <AuthorizeView Policy="@AdminRoles.Policies.Administer" Context="admin">
                                    <span class="row-actions">
                                        @if (package.ReleasedThroughRingOrder != AgentPackageEntity.AllRings && !IsOlderThanReleased(package))
                                        {
                                            @if (NextRing(package) is { } next)
                                            {
                                                <button type="submit" name="Action" value="next:@package.Version" data-help-term="Release to">Release to @next</button>
                                            }
                                            <button type="submit" name="Action" value="all:@package.Version" class="primary">Release to all rings now</button>
                                        }
                                        @if (package.ReleasedThroughRingOrder is not null)
                                        {
                                            <button type="submit" name="Action" value="withdraw:@package.Version" class="danger">Withdraw</button>
                                        }
                                    </span>
                                </AuthorizeView>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </form>
        @if (_packages.Count(IsSuperseded) is > 0 and var older)
        {
            <div class="box-body"><a href="@(ShowOlder ? "/agents" : "/agents?older=1")">@(ShowOlder ? "Hide older versions" : $"Show older versions ({older})")</a> <span class="note">older than the newest released version and on no server</span></div>
        }
    </Box>

    <form method="get" action="@AgentInstallerEndpoints.Route" class="box">
        <header class="box-head"><h2>Install new agents<HelpLink To="agents#install" Label="Install new agents" /></h2></header>
        <div class="box-body form">
            <label class="field"><span>Central server address for the agents</span><input name="address" type="url" required maxlength="2048" value="@_address" /><span class="help">How the servers reach this central server</span></label>
            <p class="note">
                The installer is the unchanged agent MSI (@(_newest?.Version ?? "none yet")). Its file name carries the address and the
                fingerprint of the trust anchor, so the agent trusts only this central server from the first contact. Run it
                interactively (the address is pre-filled) or silently:
            </p>
            <pre>msiexec /i &lt;file&gt;.msi /qn</pre>
            <p class="note">With another file name, give the address as <code>SERVERURL=@_address</code>.</p>
        </div>
        <footer class="box-foot"><span class="note">Recorded in the audit log.</span><button type="submit" class="primary" disabled="@(_newest is null)">Download installer</button></footer>
    </form>
</div>

<Box Title="Central server" Anchor="server" Help="agents#server" Hint="The central server never updates itself; an administrator installs a new version">
    <ChildContent>
        @if (_serverUpdate is not null)
        {
            <div class="upgrade-steps">
                <h3>How to upgrade</h3>
                <ol>
                    <li>Download the package and check it against <code>SHA256SUMS.txt</code> of the release.</li>
                    <li>Run it as administrator on the central server.</li>
                    <li>The dashboard is unavailable for about a minute while the service restarts. Database, trust anchor, settings, port and certificate stay; the agents keep working and report again afterwards.</li>
                </ol>
            </div>
            <div class="actions box-actions">
                @if (_serverUpdate.Page is { } releasePage)
                {
                    <a class="btn" href="@releasePage" target="_blank" rel="noopener noreferrer">Release notes</a>
                }
                @if (_serverUpdate.Package is { } serverMsi)
                {
                    <a class="btn primary" href="@serverMsi" target="_blank" rel="noopener noreferrer">Download SUSyphos.Server-@(_serverUpdate.Version).msi</a>
                }
            </div>
        }
        else
        {
            <p class="note">This central server runs the newest release. New versions are found by the daily check of the GitHub releases (or "Check for new versions now").</p>
        }
    </ChildContent>
</Box>

@if (_failed.Count > 0)
{
    <Box Title="Failed agent updates" Help="agents#failed" Hint="The agent tries again after six hours; the msiexec log is on the server" Flush="true">
        <ListTable Table="_failedTable" Page="_failedPage" Columns="FailedColumns" Search="Search server or error" Noun="servers">
            <Row Context="client">
                <tr><td><a href="/servers/@client.Id">@client.HostName</a></td><td class="mono" title="@client.AgentVersion">@AgentVersion.ShortForm(client.AgentVersion)</td><td>@client.AgentUpdateError</td></tr>
            </Row>
        </ListTable>
    </Box>
}

<Box Title="Agent versions on the servers" Help="agents#on-servers" Flush="true">
    <div class="scroll">
        <table>
            <thead><tr><th>Version</th><th class="n">Servers</th><th>State</th></tr></thead>
            <tbody>
                @if (_serversByVersion.Count == 0)
                {
                    <tr><td colspan="3" class="note">No approved server yet.</td></tr>
                }
                @foreach (var (version, count) in _serversByVersion.OrderByDescending(v => AgentVersion.TryParse(v.Key, out var parsed) ? parsed : null))
                {
                    <tr>
                        <td class="mono"><a href="@Servers.Link("agent", AgentVersion.ShortForm(version))" title="Show the servers with agent @AgentVersion.ShortForm(version)">@version</a></td>
                        <td class="n">@count</td>
                        <td>
                            @if (Updates.IsBelowMinimum(version))
                            {
                                <span class="pill fail">below the minimum version @Updates.Minimum</span>
                            }
                            else if (_newestReleased is { } released && AgentVersion.TryParse(version, out var parsed) && AgentVersion.TryParse(released.Version, out var target) && parsed < target)
                            {
                                <span class="pill queue">older than the newest released version</span>
                            }
                            else
                            {
                                <span class="pill ok">current</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</Box>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    /// <summary>"next:&lt;version&gt;", "all:&lt;version&gt;" or "withdraw:&lt;version&gt;" from the pressed button.</summary>
    [SupplyParameterFromForm(FormName = "agents-release")]
    private string? Action { get; set; }

    private List<AgentPackageEntity> _packages = [];

    /// <summary>Also lists superseded versions (?older=1).</summary>
    [SupplyParameterFromQuery(Name = "older")]
    private string? Older { get; set; }

    private bool ShowOlder => Older == "1";

    /// <summary>Older than the newest released version: agents never go back to it, so it cannot be released any more.</summary>
    private bool IsOlderThanReleased(AgentPackageEntity package) =>
        _newestReleased is not null
        && AgentVersion.TryParse(package.Version, out var version)
        && AgentVersion.TryParse(_newestReleased.Version, out var released)
        && version < released;

    /// <summary>Older than the newest released version and on no server: hidden unless asked for.</summary>
    private bool IsSuperseded(AgentPackageEntity package) =>
        IsOlderThanReleased(package) && _serversByVersion.GetValueOrDefault(package.Version) == 0;
    private List<RingEntity> _rings = [];
    private Dictionary<string, int> _serversByVersion = [];
    private AgentPackageEntity? _newest;
    private ServerUpdate? _serverUpdate;
    private AgentPackageEntity? _newestReleased;
    private AgentPackageCheck? _lastCheck;
    private IReadOnlyList<SUSyphos.Server.Rollouts.DonutPart> _agentParts = [];

    /// <summary>How far the newest package is released.</summary>
    private string ReleaseCaption => _newest?.ReleasedThroughRingOrder switch
    {
        null => "not released",
        AgentPackageEntity.AllRings => "released to all rings",
        { } order => $"released up to ring {_rings.FirstOrDefault(r => r.Order == order)?.Name ?? order.ToString(System.Globalization.CultureInfo.InvariantCulture)}",
    };
    private string _address = string.Empty;
    private List<ClientEntity> _failed = [];
    private TableQuery _failedTable = default!;
    private TablePage<ClientEntity> _failedPage = default!;

    private static readonly IReadOnlyList<TableColumn<ClientEntity>> FailedColumns =
    [
        new("name", "Server", c => c.HostName),
        new("agent", "Agent", c => AgentVersion.SortKey(c.AgentVersion), c => [AgentVersion.ShortForm(c.AgentVersion)]),
        new("error", "Error", c => c.AgentUpdateError, Sortable: false),
    ];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task CheckAsync()
    {
        if (!await IsAuthorizedAsync(AdminRoles.Policies.Administer))
        {
            ShowResult("Only administrators can check for new agent versions.", string.Empty);
            return;
        }

        var result = await Administration.CheckAsync(await GetActorAsync(), CancellationToken.None);
        ShowResult(result.Error is null ? null : $"The check {result.Describe()}.", $"Check finished: {result.Describe()}.");
        await LoadAsync();
    }

    private async Task ReleaseAsync()
    {
        // The page is open to operators; releasing is for administrators, checked again in the handler.
        if (!await IsAuthorizedAsync(AdminRoles.Policies.Administer))
        {
            ShowResult("Only administrators can release agent versions.", string.Empty);
            return;
        }

        var actor = await GetActorAsync();
        var (scope, version) = Action?.Split(':', 2) is [var s, var v] ? (s, v) : (null, null);
        var outcome = scope switch
        {
            "next" => await Administration.ReleaseAsync(version, AgentPackageAdministration.ReleaseScope.NextRing, actor, CancellationToken.None),
            "all" => await Administration.ReleaseAsync(version, AgentPackageAdministration.ReleaseScope.AllRings, actor, CancellationToken.None),
            "withdraw" => await Administration.WithdrawAsync(version, actor, CancellationToken.None),
            _ => new Outcome("Unknown action."),
        };
        ShowResult(outcome.Error, scope == "withdraw" ? "The agent version was withdrawn; agents already on it stay there." : "The agent version was released; agents update after their next heartbeat.");
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _packages = [.. (await Store.ListAsync(CancellationToken.None)).OrderByDescending(p => AgentVersion.TryParse(p.Version, out var v) ? v : null)];
        _rings = await Db.Rings.AsNoTracking().OrderBy(r => r.Order).ToListAsync();
        _newest = AgentPackageStore.Newest(_packages);
        _newestReleased = AgentPackageStore.Newest(_packages.Where(p => p.ReleasedThroughRingOrder is not null));
        _lastCheck = await Administration.GetLastCheckAsync(CancellationToken.None);
        _serverUpdate = await Administration.GetServerUpdateAsync(CancellationToken.None);
        _failed = await Db.Clients.AsNoTracking().Where(c => c.State == RegistrationState.Approved && c.AgentUpdateError != null).OrderBy(c => c.HostName).Take(1000).ToListAsync();
        _failedTable = TableQuery.From(Navigation, "name", prefix: "fail.", defaultPageSize: 10);
        _failedPage = TablePaging.Apply(_failed, _failedTable, FailedColumns, c => $"{c.HostName} {c.AgentUpdateError}");
        var approved = await Db.Clients.AsNoTracking().Where(c => c.State == RegistrationState.Approved).ToListAsync();
        var states = await Updates.StatesAsync(approved, _rings.ToDictionary(r => r.Id, r => r.Order), CancellationToken.None);
        _agentParts = [.. new[] { SUSyphos.Server.Administration.AgentState.Current, SUSyphos.Server.Administration.AgentState.UpdateAvailable, SUSyphos.Server.Administration.AgentState.Failed, SUSyphos.Server.Administration.AgentState.Other }
            .Select(s => new SUSyphos.Server.Rollouts.DonutPart(SUSyphos.Server.Administration.ServerIndicators.Class(s), SUSyphos.Server.Administration.ServerIndicators.Label(s), states.Values.Count(v => v.State == s)))];
        var versions = approved.Select(c => c.AgentVersion).ToList();
        _serversByVersion = versions
            .GroupBy(v => AgentVersion.TryParse(v, out var parsed) ? parsed.ToString() : v)
            .ToDictionary(g => g.Key, g => g.Count());
        if (HttpContext is not null)
        {
            _address = await AgentInstallerEndpoints.SuggestAddressAsync(HttpContext.Request, CancellationToken.None);
        }
    }

    private string? NextRing(AgentPackageEntity package) =>
        _rings.FirstOrDefault(r => package.ReleasedThroughRingOrder is not { } current || r.Order > current)?.Name;

    private static string Format(DateTime value) => DisplayTime.Format(value);
}
