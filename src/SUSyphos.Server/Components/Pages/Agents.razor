@page "/agents"
@attribute [Authorize(Policy = AdminRoles.Policies.Operate)]
@inherits DashboardPageBase
@using SUSyphos.Contracts.Agents
@using SUSyphos.Server.AgentPackages
@inject ServerDbContext Db
@inject AgentPackageStore Store
@inject AgentPackageAdministration Administration
@inject AgentUpdateService Updates

<PageTitle>Agents</PageTitle>

<PageHeader Title="Agents" Subtitle="Install the agent on new servers and keep the agents up to date. New versions come from the GitHub releases of the project and reach the agents only after an administrator released them." Crumbs="@([("Agents", null)])" />
<StatusMessage Text="@Message" IsError="@MessageIsError" />

<AuthorizeView Policy="@AdminRoles.Policies.Administer" Context="admin">
    <ActionBand>
        <form method="post" @formname="agents-check" @onsubmit="CheckAsync">
            <AntiforgeryToken />
            <button type="submit" class="primary">Check for new versions now</button>
        </form>
        <div class="spacer"></div>
        <span class="note">Last check: @(_lastCheck is { } check ? $"{Format(check.AtUtc)}, {check.Describe()}" : "not yet")</span>
    </ActionBand>
</AuthorizeView>

<div class="grid-side">
    <Box Title="Agent versions" Hint="Agents update to the newest version released for their ring" Flush="true">
        <form method="post" @formname="agents-release" @onsubmit="ReleaseAsync" class="scroll">
            <AntiforgeryToken />
            <table>
                <thead><tr><th>Version</th><th>Source</th><th>Added</th><th>Released for</th><th class="n">Servers</th><th class="n">Actions</th></tr></thead>
                <tbody>
                    @if (_packages.Count == 0)
                    {
                        <tr><td colspan="6" class="note">No agent package yet. The central server installer ships one; a check finds newer ones.</td></tr>
                    }
                    @foreach (var package in _packages)
                    {
                        <tr>
                            <td class="mono">@package.Version</td>
                            <td><span class="tag">@(package.Source == AgentPackageSource.Bundled ? "with central server" : "GitHub")</span></td>
                            <td class="nowrap">@Format(package.AddedAtUtc)</td>
                            <td>
                                @if (package.ReleasedThroughRingOrder is null)
                                {
                                    <span class="pill neutral">not released</span>
                                }
                                else
                                {
                                    @foreach (var ring in _rings.Where(r => r.Order <= package.ReleasedThroughRingOrder))
                                    {
                                        <span class="tag">@ring.Name</span>
                                    }
                                    @if (package.ReleasedThroughRingOrder == AgentPackageEntity.AllRings)
                                    {
                                        <span class="pill ok">all rings</span>
                                    }
                                }
                            </td>
                            <td class="n">@if (_serversByVersion.GetValueOrDefault(package.Version) is > 0 and var onVersion) { <a href="@Servers.Link("agent", AgentVersion.Short(package.Version))">@onVersion</a> } else { <span>0</span> }</td>
                            <td class="n">
                                <AuthorizeView Policy="@AdminRoles.Policies.Administer" Context="admin">
                                    <span class="row-actions">
                                        @if (package.ReleasedThroughRingOrder != AgentPackageEntity.AllRings)
                                        {
                                            @if (NextRing(package) is { } next)
                                            {
                                                <button type="submit" name="Action" value="next:@package.Version">Release to @next</button>
                                            }
                                            <button type="submit" name="Action" value="all:@package.Version" class="primary">Release to all rings now</button>
                                        }
                                        @if (package.ReleasedThroughRingOrder is not null)
                                        {
                                            <button type="submit" name="Action" value="withdraw:@package.Version" class="danger">Withdraw</button>
                                        }
                                    </span>
                                </AuthorizeView>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </form>
    </Box>

    <form method="get" action="@AgentInstallerEndpoints.Route" class="box">
        <header class="box-head"><h2>Install new agents</h2></header>
        <div class="box-body form">
            <label class="field"><span>Central server address for the agents</span><input name="address" type="url" required maxlength="2048" value="@_address" /><span class="help">How the servers reach this central server</span></label>
            <p class="note">
                The installer is the unchanged agent MSI (@(_newest?.Version ?? "none yet")). Its file name carries the address and the
                fingerprint of the trust anchor, so the agent trusts only this central server from the first contact. Run it
                interactively (the address is pre-filled) or silently:
            </p>
            <pre>msiexec /i &lt;file&gt;.msi /qn</pre>
            <p class="note">With another file name, give the address as <code>SERVERURL=@_address</code>.</p>
        </div>
        <footer class="box-foot"><span class="note">Recorded in the audit log.</span><button type="submit" class="primary" disabled="@(_newest is null)">Download installer</button></footer>
    </form>
</div>

@if (_failed.Count > 0)
{
    <Box Title="Failed agent updates" Hint="The agent tries again after six hours; the msiexec log is on the server" Flush="true">
        <div class="scroll">
            <table>
                <thead><tr><th>Server</th><th>Agent</th><th>Error</th></tr></thead>
                <tbody>
                    @foreach (var client in _failed)
                    {
                        <tr><td><a href="/servers/@client.Id">@client.HostName</a></td><td class="mono" title="@client.AgentVersion">@AgentVersion.Short(client.AgentVersion)</td><td>@client.AgentUpdateError</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </Box>
}

<Box Title="Agent versions on the servers" Flush="true">
    <div class="scroll">
        <table>
            <thead><tr><th>Version</th><th class="n">Servers</th><th>State</th></tr></thead>
            <tbody>
                @if (_serversByVersion.Count == 0)
                {
                    <tr><td colspan="3" class="note">No approved server yet.</td></tr>
                }
                @foreach (var (version, count) in _serversByVersion.OrderByDescending(v => AgentVersion.TryParse(v.Key, out var parsed) ? parsed : null))
                {
                    <tr>
                        <td class="mono"><a href="@Servers.Link("agent", AgentVersion.Short(version))" title="Show the servers with agent @AgentVersion.Short(version)">@version</a></td>
                        <td class="n">@count</td>
                        <td>
                            @if (Updates.IsBelowMinimum(version))
                            {
                                <span class="pill fail">below the minimum version @Updates.Minimum</span>
                            }
                            else if (_newestReleased is { } released && AgentVersion.TryParse(version, out var parsed) && AgentVersion.TryParse(released.Version, out var target) && parsed < target)
                            {
                                <span class="pill queue">older than the newest released version</span>
                            }
                            else
                            {
                                <span class="pill ok">current</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</Box>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    /// <summary>"next:&lt;version&gt;", "all:&lt;version&gt;" or "withdraw:&lt;version&gt;" from the pressed button.</summary>
    [SupplyParameterFromForm(FormName = "agents-release")]
    private string? Action { get; set; }

    private List<AgentPackageEntity> _packages = [];
    private List<RingEntity> _rings = [];
    private Dictionary<string, int> _serversByVersion = [];
    private AgentPackageEntity? _newest;
    private AgentPackageEntity? _newestReleased;
    private AgentPackageCheck? _lastCheck;
    private string _address = string.Empty;
    private List<ClientEntity> _failed = [];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task CheckAsync()
    {
        if (!await IsAuthorizedAsync(AdminRoles.Policies.Administer))
        {
            ShowResult("Only administrators can check for new agent versions.", string.Empty);
            return;
        }

        var result = await Administration.CheckAsync(await GetActorAsync(), CancellationToken.None);
        ShowResult(result.Error is null ? null : $"The check {result.Describe()}.", $"Check finished: {result.Describe()}.");
        await LoadAsync();
    }

    private async Task ReleaseAsync()
    {
        // The page is open to operators; releasing is for administrators, checked again in the handler.
        if (!await IsAuthorizedAsync(AdminRoles.Policies.Administer))
        {
            ShowResult("Only administrators can release agent versions.", string.Empty);
            return;
        }

        var actor = await GetActorAsync();
        var (scope, version) = Action?.Split(':', 2) is [var s, var v] ? (s, v) : (null, null);
        var outcome = scope switch
        {
            "next" => await Administration.ReleaseAsync(version, AgentPackageAdministration.ReleaseScope.NextRing, actor, CancellationToken.None),
            "all" => await Administration.ReleaseAsync(version, AgentPackageAdministration.ReleaseScope.AllRings, actor, CancellationToken.None),
            "withdraw" => await Administration.WithdrawAsync(version, actor, CancellationToken.None),
            _ => new Outcome("Unknown action."),
        };
        ShowResult(outcome.Error, scope == "withdraw" ? "The agent version was withdrawn; agents already on it stay there." : "The agent version was released; agents update after their next heartbeat.");
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _packages = [.. (await Store.ListAsync(CancellationToken.None)).OrderByDescending(p => AgentVersion.TryParse(p.Version, out var v) ? v : null)];
        _rings = await Db.Rings.AsNoTracking().OrderBy(r => r.Order).ToListAsync();
        _newest = AgentPackageStore.Newest(_packages);
        _newestReleased = AgentPackageStore.Newest(_packages.Where(p => p.ReleasedThroughRingOrder is not null));
        _lastCheck = await Administration.GetLastCheckAsync(CancellationToken.None);
        _failed = await Db.Clients.AsNoTracking().Where(c => c.State == RegistrationState.Approved && c.AgentUpdateError != null).OrderBy(c => c.HostName).Take(200).ToListAsync();
        var versions = await Db.Clients.AsNoTracking().Where(c => c.State == RegistrationState.Approved).Select(c => c.AgentVersion).ToListAsync();
        _serversByVersion = versions
            .GroupBy(v => AgentVersion.TryParse(v, out var parsed) ? parsed.ToString() : v)
            .ToDictionary(g => g.Key, g => g.Count());
        if (HttpContext is not null)
        {
            _address = await AgentInstallerEndpoints.SuggestAddressAsync(HttpContext.Request, CancellationToken.None);
        }
    }

    private string? NextRing(AgentPackageEntity package) =>
        _rings.FirstOrDefault(r => package.ReleasedThroughRingOrder is not { } current || r.Order > current)?.Name;

    private static string Format(DateTime value) => DisplayTime.Format(value);
}
