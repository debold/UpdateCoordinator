@page "/updates/{UpdateId:guid}/{Revision:int}"
@attribute [Authorize(Policy = AdminRoles.Policies.Read)]
@inherits DashboardPageBase
@using SUSyphos.Server.Agents
@inject ServerDbContext Db
@inject DeploymentStatus Deployment
@inject RolloutService Rollouts
@inject UpdateHolds Holds
@inject RolloutAdministration Administration
@inject NavigationManager Navigation
@inject SUSyphos.Server.Security.SecurityBaseline Baseline
@inject TimeProvider Time
@inject SUSyphos.Server.Agents.AgentActionService Actions

<PageTitle>@(_update is null ? "Update" : UpdateText.Title(_update, UpdateId))</PageTitle>

@if (_update is null)
{
    <PageHeader Title="Update not found" Crumbs="@([("Updates", "/updates"), ("Not found", null)])" />
    <Box><p>The update is not in the catalog. <a href="/updates">Back to the update list</a></p></Box>
}
else
{
    <PageHeader Title="@UpdateText.Title(_update, UpdateId)" Icon="@PageIcons.Updates" Subtitle="@($"{_update.Classification ?? "Unclassified"}{(_update.MsrcSeverity is null ? null : $" · {_update.MsrcSeverity}")} · revision {Revision} · {UpdateText.Restart(_update.RebootBehavior).ToLowerInvariant()} · first reported {Format(_update.FirstSeenAtUtc)}")" Help="update-detail" Crumbs="@([("Updates", "/updates"), (_update.KbArticle is null ? "Update" : $"KB{_update.KbArticle}", null)])">
        <span class="pill @_stateClass">@_stateLabel</span>
        <KbLinks Kb="@_update.KbArticle" Label="Release notes" />
    </PageHeader>
    <StatusMessage Text="@Message" IsError="@MessageIsError" />
    <form id="update-actions" method="post" @formname="update" @onsubmit="HandleAsync" class="detached"><AntiforgeryToken /></form>
    @if (_update.BlockedAtUtc is { } blockedAt)
    {
        <Banner Label="Blocked" Severity="fail" Help="update-detail#block">
            <ChildContent>Blocked by @_update.BlockedBy on @Format(blockedAt): the rollout is stopped and the update does not start again, neither by a start rule nor by hand, until it is unblocked.</ChildContent>
            <Action>@if (_canOperate) { <button type="submit" form="update-actions" name="Action" value="unblock">Unblock</button> }</Action>
        </Banner>
    }
    @if (_update.WithdrawnAtUtc is { } withdrawnAt)
    {
        <Banner Label="Withdrawn" Severity="fail" Help="update-detail#block">
            <ChildContent>Probably withdrawn by Microsoft (noticed @Format(withdrawnAt)): servers that had it released no longer get it offered from Windows Update, did not install it, and no newer update or revision replaces it. Check Microsoft's release notes; block the update to keep it from coming back.</ChildContent>
            <Action>@if (_canOperate && _update.BlockedAtUtc is null) { <button type="submit" form="update-actions" name="Action" value="block" class="danger">Block</button> }</Action>
        </Banner>
    }
    @if (_holds.Count > 0)
    {
        <Banner Label="On hold" Severity="queue" Help="update-detail#hold">
            <ChildContent>
                @foreach (var hold in _holds)
                {
                    <div class="hold-line">
                        On hold for @(hold.Target switch { SUSyphos.Server.Rollouts.HoldTarget.Ring => "ring", SUSyphos.Server.Rollouts.HoldTarget.Group => "group", _ => "server" }) <b>@hold.TargetName</b> since @Format(hold.CreatedAtUtc), by @hold.CreatedBy@(hold.Reason is null ? null : $": {hold.Reason}")@(hold.UntilUtc is { } until ? $" (until {Format(until)})" : null).
                        @if (_canOperate) { <button type="submit" form="update-actions" name="Action" value="@($"resume:{hold.Id}")" data-help-term="Resume">Resume</button> }
                    </div>
                }
            </ChildContent>
        </Banner>
    }
    @if (_supersededBy is not null && (_update.BlockedAtUtc is null || _update.WithdrawnAtUtc is null))
    {
        <Banner Label="Superseded" Severity="pend" Help="update-detail#block">
            <ChildContent>Superseded by <a href="/updates/@_supersededBy.UpdateId/@_supersededBy.Revision">@_supersededBy.Name</a>: Windows Update offers the newer update instead. Each ring gets the newer one as soon as it is released there, and this rollout stops once the newer one reached every ring this one reached.</ChildContent>
        </Banner>
    }

    <ActionBand>
        @if (_canOperate)
        {
            @foreach (var ring in _ringRows.Where(r => r.State is RingRolloutState.AwaitingApproval or RingRolloutState.Alarm))
            {
                <button type="submit" form="update-actions" class="primary" name="Action" value="approve:@ring.RingId" data-help-term="@(ring.State == RingRolloutState.Alarm ? "Release anyway for" : "Approve for")"><Icon Name="check" Size="16" />@(ring.State == RingRolloutState.Alarm ? "Release anyway" : "Approve") for @ring.Name</button>
            }
            var waiting = _ringRows.Any(r => r.State is RingRolloutState.AwaitingApproval or RingRolloutState.Alarm);
            var blocked = _update.BlockedAtUtc is not null;
            var running = _rollout is { State: not RolloutState.Stopped };
            <ActionMenu Label="Rollout" Icon="git-branch" Kind="@(waiting ? null : "primary")">
                <MenuItem Form="update-actions" Name="Action" Value="start" Icon="play" Disabled="@(blocked || running)" Reason="@(blocked ? "Unblock the update first" : running ? "The rollout is running" : null)">@(_rollout is null ? "Start rollout" : "Resume rollout")</MenuItem>
                <MenuItem Form="update-actions" Name="Action" Value="override" Icon="send" Disabled="@(blocked || _rollout is { Override: true, State: not RolloutState.Stopped })" Reason="@(blocked ? "Unblock the update first" : _rollout is { Override: true, State: not RolloutState.Stopped } ? "Already released to every ring" : "Release to every ring at once, without waiting for the transitions")">Release to all rings</MenuItem>
                <MenuItem Href="@($"/updates/{UpdateId}/{Revision}?dialog=hold")" Icon="pause" Reason="Hold the update for a ring, a group or a server">Hold…</MenuItem>
                <MenuSeparator />
                <MenuItem Form="update-actions" Name="Action" Value="stop" Icon="circle-stop" Danger="true" Disabled="@(!running)" Reason="@(running ? "Withdraw the releases not installed yet" : "No rollout is running")">Stop rollout</MenuItem>
            </ActionMenu>
        }
        <AuthorizeView Policy="@AdminRoles.Policies.Administer">
            <a class="btn" href="@ReleaseRuleLink"><Icon Name="list-plus" Size="16" />Create release rule…</a>
        </AuthorizeView>
        @if (_canOperate)
        {
            <div class="spacer"></div>
            <ActionMenu Label="Block" Icon="ban" Kind="danger" Align="right">
                <MenuItem Form="update-actions" Name="Action" Value="block" Icon="ban" Danger="true" Disabled="@(_update.BlockedAtUtc is not null)" Reason="@(_update.BlockedAtUtc is null ? "Stop the rollout and keep the update from starting again" : "The update is blocked already")">Block</MenuItem>
                <MenuItem Href="@($"/updates/{UpdateId}/{Revision}?dialog=uninstall")" Icon="undo-2" Danger="true" Disabled="@(!_canAdminister)" Reason="@(_canAdminister ? "Uninstall it on all, some rings, groups or one server" : "Only administrators can do this")">Uninstall…</MenuItem>
            </ActionMenu>
        }
    </ActionBand>

    @if (Dialog == "hold" && _canOperate)
    {
        <Dialog Title="@($"Hold {(_update.KbArticle is null ? "this update" : $"KB{_update.KbArticle}")}?")" CloseHref="@($"/updates/{UpdateId}/{Revision}")" Help="update-detail#hold">
            <form method="post" @formname="hold" @onsubmit="HoldAsync">
                <AntiforgeryToken />
                <div class="dialog-body">
                    <p>Servers of the target do not get the update while the hold lasts; where it is installed already it stays. A ring on hold does not count as done, so the next ring waits. Elsewhere the rollout goes on.</p>
                    <fieldset class="choices">
                        <legend>For</legend>
                        <div class="choice"><input type="radio" id="hold-target-ring" name="HoldTarget" value="Ring" checked data-help-term="Ring" /> <span><label for="hold-target-ring"><b>Ring</b></label><select name="HoldRing" aria-label="Ring">@foreach (var ring in _rings) { <option value="@ring.Id">@ring.Order @ring.Name</option> }</select></span></div>
                        @if (_allGroups.Count > 0)
                        {
                            <div class="choice"><input type="radio" id="hold-target-group" name="HoldTarget" value="Group" data-help-term="Server group" /> <span><label for="hold-target-group"><b>Server group</b></label><select name="HoldGroup" aria-label="Server group">@foreach (var group in _allGroups) { <option value="@group.Id">@group.Name</option> }</select></span></div>
                        }
                        <div class="choice"><input type="radio" id="hold-target-server" name="HoldTarget" value="Server" data-help-term="Server" /> <span><label for="hold-target-server"><b>Server</b></label><select name="HoldServer" aria-label="Server">@foreach (var (id, name) in _holdServers) { <option value="@id">@name</option> }</select></span></div>
                    </fieldset>
                    <label class="field"><span>Reason <span class="note">optional</span></span><input name="HoldReason" maxlength="@UpdateHoldEntity.MaxReasonLength" autocomplete="off" placeholder="e.g. Exchange crashes after installing it" /></label>
                    <DateTimeField Label="Hold until" DateName="HoldUntilDate" TimeName="HoldUntilTime" Optional="true" />
                    <p class="help">Time of the central server. Without a date the hold lasts until someone selects Resume.</p>
                </div>
                <div class="dialog-foot"><a class="btn" href="/updates/@UpdateId/@Revision">Cancel</a><button type="submit" class="primary">Hold update</button></div>
            </form>
        </Dialog>
    }
    @if (Dialog == "uninstall")
    {
        <Dialog Title="@($"Uninstall {(_update.KbArticle is null ? "this update" : $"KB{_update.KbArticle}")}?")" CloseHref="@($"/updates/{UpdateId}/{Revision}")" Help="update-detail#uninstall" Wide="true">
            <form method="post" @formname="uninstall" @onsubmit="UninstallAsync">
                <AntiforgeryToken />
                <div class="dialog-body">
                    @if (_targets.Count == 0)
                    {
                        <p>No approved server reports this update as installed; there is nothing to uninstall.</p>
                    }
                    else
                    {
                        <fieldset class="choices">
                            <legend>Where</legend>
                            <label class="choice"><input type="radio" name="UninstallTarget" value="all" checked data-help-term="All servers that have it" /> <span><b>All servers that have it</b><span class="note">@DisplayNumber.Format(_targets.Count) servers report it as installed.</span></span></label>
                            @if (TargetRings.Count > 0)
                            {
                                <div class="choice"><input type="radio" id="uninstall-target-rings" name="UninstallTarget" value="rings" data-help-term="Rings" /> <span><label for="uninstall-target-rings"><b>Rings</b></label><span class="choice-list">@foreach (var (ring, count) in TargetRings) { <label><input type="checkbox" name="UninstallRings" value="@ring.Id" /> @ring.Order @ring.Name <span class="note">(@count)</span></label> }</span></span></div>
                            }
                            @if (TargetGroups.Count > 0)
                            {
                                <div class="choice"><input type="radio" id="uninstall-target-groups" name="UninstallTarget" value="groups" data-help-term="Server groups" /> <span><label for="uninstall-target-groups"><b>Server groups</b></label><span class="choice-list">@foreach (var (group, count) in TargetGroups) { <label><input type="checkbox" name="UninstallGroups" value="@group.Id" /> @group.Name <span class="note">(@count)</span></label> }</span></span></div>
                            }
                            <div class="choice"><input type="radio" id="uninstall-target-server" name="UninstallTarget" value="server" data-help-term="One server" /> <span><label for="uninstall-target-server"><b>One server</b></label><select name="UninstallServer" aria-label="Server">@foreach (var target in _targets) { <option value="@target.ClientId">@target.HostName</option> }</select></span></div>
                        </fieldset>
                        <UninstallTiming />
                        <label class="check"><input type="checkbox" name="UninstallBlock" value="yes" checked="@(_update.BlockedAtUtc is null)" disabled="@(_update.BlockedAtUtc is not null)" data-help-term="Block the update" /> @(_update.BlockedAtUtc is null ? "Block the update, so its rollout stops and it does not come back (recommended when it goes everywhere)" : "The update is blocked already")</label>
                        <p class="note">The agent uninstalls through Windows Update, or with DISM by the KB number where Windows Update cannot; some packages cannot be removed, the remote action on each server then reports why.</p>
                    }
                </div>
                <div class="dialog-foot"><a class="btn" href="/updates/@UpdateId/@Revision">Cancel</a><button type="submit" class="danger" disabled="@(_targets.Count == 0)">Uninstall update</button></div>
            </form>
        </Dialog>
    }

    <TabBar Tabs="@TabItems" Current="@_tab" Link="@(tab => TabLink(tab))" />

    @if (_tab == "overview")
    {
    <Box Title="Start rule" Help="update-detail#start-rule" Hint="Which start rule decides how this update enters the rings">
        @if (_rollout is { } started)
        {
            <p>
                @if (started.StartRuleSummary is { } summary)
                {
                    <span>Rollout started @Format(started.StartedAtUtc) by start rule @(started.StartRuleId) (@summary).</span>
                }
                else
                {
                    <span>Rollout started @Format(started.StartedAtUtc) by @started.StartedBy@(started.StartedBy == RolloutService.RuleActor ? " (before the starting rule was recorded)" : string.Empty).</span>
                }
                <span class="note">Start rules decide only once, when the rollout starts; later changes to rules do not change running rollouts.</span>
            </p>
        }
        @if (_startRule is { } rule)
        {
            <p>
                @(_rollout is null ? "Decided by" : "Would decide now:") <a href="/administration/release-rules?dialog=rule&id=@rule.Id">start rule with priority @rule.Priority</a>
                (@(rule.Classification ?? "any classification"), @(rule.MsrcSeverity ?? "any severity"), title @(rule.TitlePattern ?? "any"))
                <span class="pill @(rule.Mode == StartMode.Automatic ? "ok" : "queue")">@(rule.Mode == StartMode.Automatic ? $"starts automatically, delay {rule.Delay.TotalHours:0} h" : "manual start")</span>
            </p>
        }
        else
        {
            <p><span class="pill queue">no start rule matches</span> The update stays queued until an operator starts it or a matching rule is created.</p>
        }
    </Box>

    <div class="grid-side">
        <Box Title="Progress by ring" Help="update-detail#progress" Flush="true">            <div class="scroll">
                <table>
                    <thead><tr><th>Ring</th><th>State</th><th>Released</th><th class="n">Feedback</th><th class="n">Success</th><th>Status (servers)</th></tr></thead>
                    <tbody>
                        @foreach (var ring in _ringRows)
                        {
                            <tr>
                                <td class="nowrap"><RingTag Name="@ring.Name" Order="@ring.Order" Href="@($"{TabLink("servers")}&f.ring={Uri.EscapeDataString(ring.Name)}#servers")" Title="Show the servers of this ring for this update" /></td>
                                <td><span class="pill @RingStateClass(ring.State)">@RingStateLabel(ring)</span></td>
                                <td class="nowrap">
                                    @if (ring.ReleasedAtUtc is not null || ring.Forecast is null)
                                    {
                                        @Format(ring.ReleasedAtUtc)
                                    }
                                    else
                                    {
                                        <div class="note" title="Estimate from the wait times of the ring transitions; low feedback, alarms and gates change it">expected from @Format(ring.Forecast.Value.EarliestUtc)@if (ring.Forecast.Value.LatestUtc != ring.Forecast.Value.EarliestUtc) { <br />@($"at the latest {Format(ring.Forecast.Value.LatestUtc)}") }</div>
                                        @if (ring.Forecast.Value.ManualApproval)
                                        {
                                            <div><span class="pill queue">manual approval</span></div>
                                        }
                                    }
                                </td>
                                <td class="n">@if (ring.State is not null && ring.Statistics.Targeted == 0) { <span class="note">no server needs it</span> } else { @Percent(ring.Statistics.FeedbackPercent) <span class="note">(@ring.Statistics.Reported/@ring.Statistics.Targeted)</span> }</td>
                                <td class="n">@Percent(ring.Statistics.SuccessPercent)</td>
                                <td><StackedBar Counts="@ring.Counts" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </Box>

        <Box Title="All servers" Help="update-detail#all-servers" Hint="servers that reported this update">
            <div class="ring-status">
                <Donut Parts="@(Charts.Sorted(Charts.Labeled(_total)).Select(p => (p.Class, p.Value)).ToList())" />
                <DonutLegend Parts="@Charts.Labeled(_total)" />
            </div>
        </Box>
    </div>

    @if (_fixes.Count > 0)
    {
        <Box Title="Fixes vulnerabilities" Anchor="vulnerabilities" Help="update-detail#vulnerabilities" Hint="@($"{DisplayNumber.Format(_fixes.Count)} CVEs on Windows Server, from Microsoft (MSRC); exploited first")" Flush="true">
            <ListTable Table="_cveTable" Page="_cvePage" Columns="VulnerabilityTable" Search="Search CVE or title" Noun="vulnerabilities">
                <Row Context="vulnerability">
                    <tr><VulnerabilityCells Vulnerability="@vulnerability" /></tr>
                </Row>
            </ListTable>
        </Box>
    }
    }
    else if (_tab == "servers")
    {
    <Box Title="Servers" Help="update-detail#servers" Flush="true">
        <TableTools Table="_table" Placeholder="Search server" Labels="ServerLabels" />
        <div class="scroll">
            <table>
                <thead>
                    <tr>
                        <SortHeader Table="_table" Column="name" Label="Server" />
                        <SortHeader Table="_table" Column="ring" Label="Ring" Options="@_serverPage.Options.GetValueOrDefault("ring")" />
                        <SortHeader Table="_table" Column="status" Label="Status" Options="@_serverPage.Options.GetValueOrDefault("status")" />
                        <SortHeader Table="_table" Column="earliest" Label="Earliest installation" />
                        <th>Result</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_serverPage.Rows.Count == 0)
                    {
                        <tr><td colspan="5" class="note">No server matches.</td></tr>
                    }
                    @foreach (var row in _serverPage.Rows)
                    {
                        <tr>
                            <td><a href="/servers/@row.ClientId">@row.HostName</a></td>
                            <td>@row.Ring</td>
                            <td><span class="pill @StatusClass(row.Status)">@StatusLabel(row.Status)</span></td>
                            <td class="nowrap">@Format(row.Entry?.EarliestInstallAtUtc)</td>
                            <td>@(row.Entry is { } entry ? DeploymentText.Result(entry) : row.Status == ServerUpdateStatus.Installed ? "Installed outside a release (reported by the inventory)" : null)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <Pager Table="_table" Page="PageInfo.Of(_serverPage)" Noun="servers" />
    </Box>

    @if (_outside.Count > 0)
    {
        <Box Title="Installed outside SUSyphos" Help="update-detail#outside" Hint="@(DefinitionUpdates.IsClassification(_update.Classification) ? "definition update: Defender or Windows installing it before SUSyphos is expected" : "from the Windows Update history of the servers: installations Windows itself or an administrator started")" Flush="true">
            <div class="scroll">
                <table>
                    <thead><tr><th>Server</th><th>Date</th><th>Started by</th></tr></thead>
                    <tbody>
                        @foreach (var item in _outside)
                        {
                            <tr><td><a href="@ServerPage.Link(item.ClientId, "windows-history")">@item.HostName</a></td><td class="nowrap">@Format(item.DateUtc)</td><td>@{ var started = UpdateHistoryText.StartedByTag(item.ClientApplicationId, DefinitionUpdates.IsClassification(_update.Classification)); }<StatusTag Text="@started.Text" Kind="@started.Kind" Detail="@started.Detail" /></td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </Box>
    }
    }
    else
    {
    <Box Title="Timeline" Help="update-detail#timeline" Flush="true">
        <ListTable Table="_timelineTable" Page="_timelinePage" Columns="TimelineColumns" Search="Search event" Noun="events" Empty="No rollout yet: the update is queued.">
            <Row Context="item">
                <tr><td class="nowrap">@Format(item.AtUtc)</td><td>@item.Text</td><td>@item.Actor</td></tr>
            </Row>
        </ListTable>
    </Box>
    }
}

@code {
    private sealed record OutsideInstallation(Guid ClientId, string HostName, DateTime DateUtc, string? ClientApplicationId);

    private List<OutsideInstallation> _outside = [];

    private sealed record RingRow(int RingId, int Order, string Name, RingRolloutState? State, string? Reason, DateTime? ReleasedAtUtc, RingStatistics Statistics, DeploymentCounts Counts, RingForecast? Forecast = null);

    /// <summary>State of the update on one server, as the server table shows it.</summary>
    private enum ServerUpdateStatus
    {
        Failed,
        Pending,
        Planned,
        WaitingForRelease,
        Installed,
        NotNeeded,
    }

    private sealed record ServerRow(Guid ClientId, string HostName, string Ring, ServerUpdateStatus Status, DeploymentEntry? Entry);

    private static string StatusLabel(ServerUpdateStatus status) => status switch
    {
        ServerUpdateStatus.Failed => "Failed",
        ServerUpdateStatus.Pending => "Pending: window or installing",
        ServerUpdateStatus.Planned => "Planned",
        ServerUpdateStatus.WaitingForRelease => "Waiting for release",
        ServerUpdateStatus.Installed => "Installed",
        _ => "Not needed",
    };

    private static string StatusClass(ServerUpdateStatus status) => status switch
    {
        ServerUpdateStatus.Failed => "fail",
        ServerUpdateStatus.Pending or ServerUpdateStatus.Planned => "pend",
        ServerUpdateStatus.WaitingForRelease => "queue",
        ServerUpdateStatus.Installed => "ok",
        _ => "neutral",
    };

    private sealed record TimelineItem(DateTime AtUtc, string Text, string Actor);

    private static readonly IReadOnlyList<TableColumn<TimelineItem>> TimelineColumns =
    [
        new("time", "Time", t => t.AtUtc),
        new("event", "Event", t => t.Text, Sortable: false),
        new("by", "By", t => t.Actor, t => [t.Actor]),
    ];

    private TableQuery _timelineTable = default!;
    private TablePage<TimelineItem> _timelinePage = default!;

    [Parameter]
    public Guid UpdateId { get; set; }

    [Parameter]
    public int Revision { get; set; }

    private static readonly IReadOnlyDictionary<string, string> ServerLabels = new Dictionary<string, string> { ["ring"] = "Ring", ["status"] = "Status" };

    private static readonly IReadOnlyList<TableColumn<ServerRow>> ServerColumns =
    [
        new("status", "Status", r => (int)r.Status, r => [StatusLabel(r.Status)]),
        new("name", "Server", r => r.HostName),
        new("ring", "Ring", r => r.Ring, r => [r.Ring]),
        new("earliest", "Earliest installation", r => r.Entry?.EarliestInstallAtUtc),
    ];

    private TableQuery _table = default!;
    private TablePage<ServerRow> _serverPage = new([], 0, 0, 1, 1, new Dictionary<string, IReadOnlyList<FilterOption>>());

    /// <summary>Opens the new release rule dialog pre-filled with this update's classification, severity and title.</summary>
    private string ReleaseRuleLink => _update is null
        ? "/administration/release-rules"
        : "/administration/release-rules?dialog=rule-new"
            + (_update.Classification is { } classification ? $"&classification={Uri.EscapeDataString(classification)}" : string.Empty)
            + (_update.MsrcSeverity is { } severity ? $"&severity={Uri.EscapeDataString(severity)}" : string.Empty)
            + $"&title={Uri.EscapeDataString(StartRulePatterns.FromTitle(_update.Title))}";

    [SupplyParameterFromForm(FormName = "update")]
    private string? Action { get; set; }

    [SupplyParameterFromQuery(Name = "tab")]
    private string? Tab { get; set; }

    private string _tab = "overview";
    private IReadOnlyList<SecurityVulnerabilityEntity> _fixes = [];
    private TableQuery _cveTable = default!;
    private TablePage<SecurityVulnerabilityEntity> _cvePage = new([], 0, 0, 1, 1, new Dictionary<string, IReadOnlyList<FilterOption>>());
    private static readonly IReadOnlyList<TableColumn<SecurityVulnerabilityEntity>> VulnerabilityTable = SUSyphos.Server.Security.VulnerabilityColumns.Of<SecurityVulnerabilityEntity>(v => v);
    private bool _canAdminister;

    private static readonly IReadOnlyList<(string Key, string Label)> Tabs = [("overview", "Overview"), ("servers", "Servers"), ("timeline", "Timeline")];

    private string TabLink(string tab) => tab == "overview" ? $"/updates/{UpdateId}/{Revision}" : $"/updates/{UpdateId}/{Revision}?tab={tab}";

    /// <summary>The tabs; the servers tab counts the failed installations.</summary>
    private IReadOnlyList<TabItem> TabItems => [.. Tabs.Select(t => t.Key == "servers" && _total.Failed > 0 ? new TabItem(t.Key, t.Label, DisplayNumber.Format(_total.Failed), "fail") : new TabItem(t.Key, t.Label))];

    [SupplyParameterFromQuery(Name = "dialog")]
    private string? Dialog { get; set; }

    [SupplyParameterFromForm(FormName = "uninstall")]
    private string? UninstallWhen { get; set; }

    [SupplyParameterFromForm(FormName = "uninstall")]
    private string? UninstallTarget { get; set; }

    [SupplyParameterFromForm(FormName = "uninstall")]
    private int[]? UninstallRings { get; set; }

    [SupplyParameterFromForm(FormName = "uninstall")]
    private int[]? UninstallGroups { get; set; }

    [SupplyParameterFromForm(FormName = "uninstall")]
    private Guid? UninstallServer { get; set; }

    [SupplyParameterFromForm(FormName = "uninstall")]
    private string? UninstallBlock { get; set; }

    [SupplyParameterFromForm(FormName = "hold")]
    private string? HoldTarget { get; set; }

    [SupplyParameterFromForm(FormName = "hold")]
    private string? HoldRing { get; set; }

    [SupplyParameterFromForm(FormName = "hold")]
    private string? HoldGroup { get; set; }

    [SupplyParameterFromForm(FormName = "hold")]
    private string? HoldServer { get; set; }

    [SupplyParameterFromForm(FormName = "hold")]
    private string? HoldReason { get; set; }

    [SupplyParameterFromForm(FormName = "hold")]
    private string? HoldUntilDate { get; set; }

    [SupplyParameterFromForm(FormName = "hold")]
    private string? HoldUntilTime { get; set; }

    private List<HoldView> _holds = [];

    /// <summary>Approved servers that report the update, missing or installed: the servers a hold can be for.</summary>
    private List<(Guid Id, string Name)> _holdServers = [];

    /// <summary>Holds the update for one ring, group or server (operators and administrators).</summary>
    private async Task HoldAsync()
    {
        var target = Enum.TryParse<SUSyphos.Server.Rollouts.HoldTarget>(HoldTarget, out var parsed) && Enum.IsDefined(parsed) ? parsed : (SUSyphos.Server.Rollouts.HoldTarget?)null;
        var until = DateTimeField.ParseUtc(HoldUntilDate, HoldUntilTime);
        var outcome = !await IsAuthorizedAsync(AdminRoles.Policies.Operate) ? new Outcome("Only operators and administrators can hold updates.")
            : target is null ? new Outcome("Choose the ring, group or server to hold the update for.")
            : !string.IsNullOrWhiteSpace(HoldUntilDate) && until is null ? new Outcome("Enter the end of the hold as a date YYYY-MM-DD, or leave it empty.")
            : await Holds.HoldAsync(UpdateId, Revision, target.Value, target switch { SUSyphos.Server.Rollouts.HoldTarget.Ring => HoldRing, SUSyphos.Server.Rollouts.HoldTarget.Group => HoldGroup, _ => HoldServer },
                HoldReason, until, await GetActorAsync(), CancellationToken.None);
        ShowResultAndReload(outcome.Error, "The update is on hold; the servers there do not get it until it is resumed.");
        if (outcome.Succeeded)
        {
            Dialog = null;
        }

        await LoadAsync();
    }

    /// <summary>The servers that have the update installed, for the uninstall dialog.</summary>
    private List<SUSyphos.Server.Agents.UninstallTarget> _targets = [];

    private List<GroupEntity> _allGroups = [];

    private List<RingEntity> _rings = [];

    private IReadOnlyList<(RingEntity Ring, int Count)> TargetRings =>
        [.. _rings.Select(r => (r, _targets.Count(t => t.RingId == r.Id))).Where(r => r.Item2 > 0)];

    private IReadOnlyList<(GroupEntity Group, int Count)> TargetGroups =>
        [.. _allGroups.Select(g => (g, _targets.Count(t => t.GroupIds.Contains(g.Id)))).Where(g => g.Item2 > 0)];

    /// <summary>Queues the uninstallation on the chosen servers and blocks the update if asked (administrators only).</summary>
    private async Task UninstallAsync()
    {
        var kind = SUSyphos.Server.Agents.AgentActionService.UninstallKind(UninstallWhen);
        SUSyphos.Server.Agents.UninstallScope? scope = UninstallTarget switch
        {
            "all" => SUSyphos.Server.Agents.UninstallScope.All,
            "rings" when UninstallRings is { Length: > 0 } rings => new(Rings: rings),
            "groups" when UninstallGroups is { Length: > 0 } groups => new(Groups: groups),
            "server" when UninstallServer is { } server => new(Clients: [server]),
            _ => null,
        };
        var error = !await IsAuthorizedAsync(AdminRoles.Policies.Administer) ? "Only administrators can uninstall updates."
            : scope is null ? "Choose where the update goes: all servers, at least one ring or group, or one server."
            : kind is null ? "Choose when the servers uninstall it."
            : null;
        if (error is not null)
        {
            ShowResult(error, string.Empty);
            await LoadAsync();
            return;
        }

        var actor = await GetActorAsync();
        var outcome = Outcome.Ok;
        if (UninstallBlock == "yes" && !await Db.Updates.AnyAsync(u => u.UpdateId == UpdateId && u.Revision == Revision && u.BlockedAtUtc != null))
        {
            outcome = await Administration.BlockAsync(UpdateId, Revision, actor, CancellationToken.None);
        }

        var queued = outcome.Succeeded ? await Actions.QueueUninstallForAsync(UpdateId, kind!.Value, scope!, actor, CancellationToken.None) : 0;
        var when = kind == SUSyphos.Contracts.Agents.AgentActionKind.UninstallInWindow ? "in their next maintenance window" : "with their next heartbeat";
        ShowResultAndReload(outcome.Error, $"{(UninstallBlock == "yes" ? "The update is blocked; " : string.Empty)}{queued} servers uninstall it {when}, in coordinated groups one after another (see the remote actions on each server).");
        Dialog = null;
        await LoadAsync();
    }

    private bool _canOperate;
    private UpdateEntity? _update;
    private RolloutEntity? _rollout;
    private NewerUpdate? _supersededBy;
    private string _stateLabel = string.Empty;
    private string _stateClass = "neutral";
    private DeploymentCounts _total = DeploymentCounts.Empty;
    private List<RingRow> _ringRows = [];
    private List<TimelineItem> _timeline = [];

    private string Key => string.Create(System.Globalization.CultureInfo.InvariantCulture, $"{UpdateId:D}:{Revision}");

    protected override async Task OnParametersSetAsync()
    {
        _canOperate = await IsAuthorizedAsync(AdminRoles.Policies.Operate);
        _canAdminister = await IsAuthorizedAsync(AdminRoles.Policies.Administer);
        _tab = Tabs.Any(t => t.Key == Tab) ? Tab! : "overview";
        await LoadAsync();
    }

    private async Task HandleAsync()
    {
        if (!await IsAuthorizedAsync(AdminRoles.Policies.Operate))
        {
            ShowResult("Only operators and administrators can change rollouts.", string.Empty);
            await LoadAsync();
            return;
        }

        var parts = Action?.Split(':', 2);
        if (parts is ["resume", var holdText])
        {
            var resumed = int.TryParse(holdText, System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out var holdId)
                ? await Holds.ResumeAsync(UpdateId, Revision, holdId, await GetActorAsync(), CancellationToken.None)
                : new Outcome("Invalid request.");
            ShowResult(resumed.Error, "The hold was lifted; the servers get the update again.");
            await LoadAsync();
            return;
        }

        int? ringId = null;
        if (parts is ["approve", var ring])
        {
            if (!int.TryParse(ring, System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out var parsed))
            {
                ShowResult("Invalid request.", string.Empty);
                await LoadAsync();
                return;
            }

            ringId = parsed;
        }

        var (outcome, success) = await RolloutActions.RunAsync(Administration, parts?[0], UpdateId, Revision, ringId, await GetActorAsync(), CancellationToken.None);
        ShowResult(outcome.Error, success);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _update = await Db.Updates.AsNoTracking().SingleOrDefaultAsync(u => u.UpdateId == UpdateId && u.Revision == Revision);
        if (_update is null)
        {
            return;
        }

        _rollout = await Db.Rollouts.AsNoTracking().SingleOrDefaultAsync(r => r.UpdateId == UpdateId && r.Revision == Revision);
        _fixes = (await Baseline.LoadAsync(CancellationToken.None)).FixedBy(_update.KbArticle).OrderByDescending(v => v.Exploited).ThenByDescending(v => v.CvssScore ?? 0).ToList();
        _cveTable = TableQuery.From(Navigation, SUSyphos.Server.Security.VulnerabilityColumns.DefaultSort, defaultDescending: true, prefix: "cve.", defaultPageSize: 10);
        _cvePage = TablePaging.Apply(_fixes, _cveTable, VulnerabilityTable, SUSyphos.Server.Security.VulnerabilityColumns.SearchText);
        _supersededBy = (await Supersedence.NewerAsync(Db, [UpdateId])).GetValueOrDefault(UpdateId);
        _holds = await Holds.GetAsync(UpdateId, Revision, CancellationToken.None);
        if (Dialog is "uninstall" or "hold")
        {
            _targets = await Actions.UninstallTargetsAsync(UpdateId, CancellationToken.None);
            _rings = await Db.Rings.AsNoTracking().OrderBy(r => r.Order).ToListAsync();
            _allGroups = await Db.Groups.AsNoTracking().OrderBy(g => g.Name).ToListAsync();
        }

        if (Dialog == "hold")
        {
            var reporting = Db.ClientAvailableUpdates.Where(a => a.UpdateId == UpdateId).Select(a => a.ClientId)
                .Concat(Db.ClientUpdates.Where(u => u.UpdateId == UpdateId).Select(u => u.ClientId));
            _holdServers = [.. (await Db.Clients.AsNoTracking()
                    .Where(c => c.State == SUSyphos.Contracts.Agents.RegistrationState.Approved && reporting.Contains(c.Id))
                    .Select(c => new { c.Id, c.HostName })
                    .ToListAsync())
                .OrderBy(c => c.HostName, StringComparer.OrdinalIgnoreCase)
                .Select(c => (c.Id, c.HostName))];
        }

        var outside = await Db.ClientUpdateHistory.AsNoTracking()
            .Where(h => h.UpdateId == UpdateId && h.Operation == SUSyphos.Contracts.Agents.UpdateOperation.Installation
                && (h.ResultCode == SUSyphos.Contracts.Agents.InstallResultCode.Succeeded || h.ResultCode == SUSyphos.Contracts.Agents.InstallResultCode.SucceededWithErrors)
                && h.ClientApplicationId != SUSyphos.Contracts.Agents.UpdateHistoryEntry.AgentClientApplicationId)
            .OrderByDescending(h => h.DateUtc)
            .Take(500)
            .Join(Db.Clients.Where(c => c.State == SUSyphos.Contracts.Agents.RegistrationState.Approved), h => h.ClientId, c => c.Id, (h, c) => new { c.Id, c.HostName, h.DateUtc, h.ClientApplicationId })
            .ToListAsync();
        _outside = [.. outside.Select(o => new OutsideInstallation(o.Id, o.HostName, o.DateUtc, o.ClientApplicationId)).OrderByDescending(o => o.DateUtc)];
        (_stateLabel, _stateClass) = _rollout switch
        {
            _ when _update.BlockedAtUtc is not null => ("Blocked", "fail"),
            _ when _update.WithdrawnAtUtc is not null => ("Withdrawn by Microsoft", "fail"),
            null => ("Queued: no rollout", "queue"),
            { State: RolloutState.Stopped } => ("Stopped", "fail"),
            { Override: true } => ("Released to all rings", "pend"),
            _ => ("Rolling out", "pend"),
        };

        var rings = await Db.Rings.AsNoTracking().OrderBy(r => r.Order).ToListAsync();
        var states = await Db.RolloutRings.AsNoTracking().Where(r => r.UpdateId == UpdateId && r.Revision == Revision).ToDictionaryAsync(r => r.RingId);
        var entries = await Deployment.GetAsync(null, null, [UpdateId], CancellationToken.None);
        entries = [.. entries.Where(e => e.Revision == Revision)];
        // Every approved server: those that need no installation (installed otherwise or not applicable) count as not needed.
        _total = DeploymentCounts.Of(entries, await Db.Clients.CountAsync(c => c.State == SUSyphos.Contracts.Agents.RegistrationState.Approved));

        var transitions = await Db.RingTransitions.AsNoTracking().ToDictionaryAsync(t => t.FromRingId);
        var forecasts = _rollout?.State == RolloutState.Active ? RolloutForecast.Estimate(rings, transitions, states) : new Dictionary<int, RingForecast>();
        _ringRows = [];
        foreach (var ring in rings)
        {
            var state = states.GetValueOrDefault(ring.Id);
            var statistics = await Rollouts.GetStatisticsAsync(UpdateId, Revision, ring.Id, CancellationToken.None);
            _ringRows.Add(new RingRow(ring.Id, ring.Order, ring.Name, state?.State, state?.Reason, state?.ReleasedAtUtc, statistics, DeploymentCounts.Of(entries.Where(e => e.RingId == ring.Id)), forecasts.TryGetValue(ring.Id, out var forecast) ? forecast : null));
        }

        // Every approved server gets a row: from its deployment entry, else installed per inventory, else not needed.
        var clients = await Db.Clients.AsNoTracking()
            .Where(c => c.State == SUSyphos.Contracts.Agents.RegistrationState.Approved)
            .Select(c => new { c.Id, c.HostName, c.RingId })
            .ToListAsync();
        var installed = (await Db.ClientUpdates.AsNoTracking().Where(u => u.UpdateId == UpdateId && u.Revision == Revision).Select(u => u.ClientId).ToListAsync()).ToHashSet();
        var byClient = entries.ToDictionary(e => e.ClientId);
        var ringNames = rings.ToDictionary(r => r.Id, r => r.Name);
        var now = Time.GetUtcNow().UtcDateTime;
        _table = TableQuery.From(Navigation, "status");
        List<ServerRow> servers = [.. clients.Select(c =>
        {
            var entry = byClient.GetValueOrDefault(c.Id);
            var status = entry?.State switch
            {
                DeploymentState.Successful => ServerUpdateStatus.Installed,
                DeploymentState.Failed => ServerUpdateStatus.Failed,
                DeploymentState.Pending => entry.EarliestInstallAtUtc > now ? ServerUpdateStatus.Planned : ServerUpdateStatus.Pending,
                DeploymentState.Queued => ServerUpdateStatus.WaitingForRelease,
                _ => installed.Contains(c.Id) ? ServerUpdateStatus.Installed : ServerUpdateStatus.NotNeeded,
            };
            return new ServerRow(c.Id, c.HostName, c.RingId is { } r ? ringNames.GetValueOrDefault(r) ?? "–" : "–", status, entry);
        })];
        _serverPage = TablePaging.Apply(servers, _table, ServerColumns, s => s.HostName);

        _startRule = RolloutService.FindStartRule(await Db.StartRules.AsNoTracking().ToListAsync(), _update);
        await LoadTimelineAsync(rings, states);
    }

    private StartRuleEntity? _startRule;

    private async Task LoadTimelineAsync(List<RingEntity> rings, Dictionary<int, RolloutRingEntity> states)
    {
        _timeline = [];
        _timelineTable = TableQuery.From(Navigation, "time", defaultDescending: true, prefix: "tl.", defaultPageSize: 10);
        _timelinePage = TablePaging.Apply(_timeline, _timelineTable, TimelineColumns, t => t.Text);
        if (_rollout is null)
        {
            return;
        }

        foreach (var ring in rings)
        {
            if (states.GetValueOrDefault(ring.Id) is not { } state)
            {
                continue;
            }

            if (state.ReleasedAtUtc is { } released)
            {
                _timeline.Add(new TimelineItem(released, released > Time.GetUtcNow().UtcDateTime ? $"Installation in ring {ring.Name} allowed from here (start delay)" : $"Released for ring {ring.Name}", string.Empty));
            }

            if (state.State == RingRolloutState.AwaitingApproval)
            {
                _timeline.Add(new TimelineItem(state.StateChangedAtUtc, $"Waits for manual release to ring {ring.Name}", string.Empty));
            }
            else if (state.State == RingRolloutState.Alarm)
            {
                _timeline.Add(new TimelineItem(state.StateChangedAtUtc, $"Alarm before ring {ring.Name}: {state.Reason}", string.Empty));
            }
        }

        // Manual actions come from the audit log; its target names the update ID and revision.
        var marker = string.Create(System.Globalization.CultureInfo.InvariantCulture, $"({UpdateId:D}, revision {Revision})");
        var audited = await Db.AuditEntries.AsNoTracking()
            .Where(e => (e.Action.StartsWith("Rollout.") || e.Action.StartsWith("Update.")) && e.Target != null && e.Target.EndsWith(marker))
            .OrderByDescending(e => e.Id)
            .Take(100)
            .ToListAsync();
        _timeline.AddRange(audited.Select(e => new TimelineItem(e.AtUtc, AuditText(e), e.Actor)));
        _timeline = [.. _timeline.OrderByDescending(t => t.AtUtc)];
        _timelinePage = TablePaging.Apply(_timeline, _timelineTable, TimelineColumns, t => t.Text);
    }

    private static string AuditText(AuditEntryEntity entry) => entry.Action switch
    {
        "Rollout.Started" => $"Rollout started{(entry.Details is null ? null : $" ({entry.Details})")}",
        "Rollout.Resumed" => "Rollout resumed",
        "Rollout.Stopped" => "Rollout stopped",
        "Rollout.Override" => "Released to every ring (manual override)",
        "Rollout.RingApproved" => $"Approved: {entry.Details}",
        "Rollout.Superseded" => $"Rollout stopped: {entry.Details}",
        "Rollout.Withdrawn" => $"Rollout stopped: {entry.Details}",
        "Update.Blocked" => "Blocked",
        "Update.Unblocked" => "Unblocked",
        _ => entry.Action,
    };

    private static string RingStateLabel(RingRow ring) => ring.State == RingRolloutState.Alarm ? $"Alarm: {ring.Reason}" : RingStage.Of(ring.State).Label;

    private static string RingStateClass(RingRolloutState? state) => RingStage.Of(state).Class;

    private static string Percent(int? value) => value is null ? "n/a" : $"{value} %";

    private static string Format(DateTime? value) => DisplayTime.Format(value);
