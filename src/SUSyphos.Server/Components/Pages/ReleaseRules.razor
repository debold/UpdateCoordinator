@page "/administration/release-rules"
@attribute [Authorize(Policy = AdminRoles.Policies.Administer)]
@inherits DashboardPageBase
@using SUSyphos.Contracts.Agents
@using SUSyphos.Server.Rollouts
@inject ServerDbContext Db
@inject RolloutAdministration Administration
@inject RingAdministration Rings
@inject NavigationManager Navigation
@inject SUSyphos.Server.Assignment.SchedulePreview SchedulePreview

<PageTitle>Release rules</PageTitle>

<PageHeader Title="Release rules" Icon="@PageIcons.ReleaseRules" Subtitle="How updates enter the rings (start rules) and when they move on to the next ring (transitions)" Help="release-rules" Crumbs="@([("Administration", null), ("Release rules", null)])" />
<StatusMessage Text="@Message" IsError="@MessageIsError" />

<ActionBand>
    <ActionMenu Label="New" Icon="plus" Kind="primary">
        <MenuItem Href="@($"{Path}?dialog=rule-new")" Icon="list-plus">New start rule…</MenuItem>
        <MenuItem Href="@($"{RingsPath}&dialog=ring-new")" Icon="target">New ring…</MenuItem>
    </ActionMenu>
</ActionBand>

<TabBar Tabs="@TabItems" Current="@_tab" Link="@(tab => tab == "rings" ? RingsPath : Path)" />

@if (_tab == "rings")
{

<Box Title="Rings and transitions" Help="release-rules#transitions" Flush="true" Hint="The next ring gets an update after the minimum wait when enough servers reported and enough succeeded; at the maximum wait a good success rate is enough; a poor success rate raises an alarm">
    <div class="scroll">
        <table>
            <thead><tr><th>Ring</th><th class="n">Servers</th><th>Transition to the next ring</th><th class="n">Actions</th></tr></thead>
            <tbody>
                @for (var i = 0; i < _rings.Count; i++)
                {
                    var ring = _rings[i];
                    var final = i == _rings.Count - 1;
                    <tr>
                        <td class="nowrap"><RingTag Name="@ring.Name" Order="@ring.Order" Href="@Servers.Link("ring", ring.Name)" Title="Show the servers of this ring" /></td>
                        <td class="n">@_servers.GetValueOrDefault(ring.Id)</td>
                        <td>
                            @if (final)
                            {
                                <span class="note">Final ring; servers without manual or rule-based assignment land here</span>
                            }
                            else if (_transitions.GetValueOrDefault(ring.Id) is { } t)
                            {
                                <span>to @_rings[i + 1].Name @Days(t.MinimumWait)–@Days(t.MaximumWait) days after its release in @ring.Name, feedback ≥ @t.MinimumFeedbackPercent %, success ≥ @t.MinimumSuccessPercent %</span>
                                @if (t.ManualGate)
                                {
                                    <span class="pill queue">manual gate</span>
                                }
                            }
                            @if (ring.SpreadHours > 0)
                            {
                                <span class="tag">spread over @ring.SpreadHours h</span>
                            }
                        </td>
                        <td class="n"><span class="row-actions">
                            <a class="btn icon-button" href="@($"{RingsPath}&dialog=ring&id={ring.Id}")" title="Edit @ring.Name" aria-label="Edit @ring.Name" data-help-term="Edit"><Icon Name="pencil" Size="16" /></a>
                            <ActionMenu Label="More" Icon="ellipsis" Compact="true" Align="right" Title="@($"More for {ring.Name}")">
                                <MenuItem Href="@($"{RingsPath}&dialog=preview&id={ring.Id}")" Icon="calendar-clock">Next @SUSyphos.Server.Assignment.SchedulePreview.Days days</MenuItem>
                                <MenuSeparator />
                                <MenuItem Href="@($"{RingsPath}&dialog=ring-delete&id={ring.Id}")" Icon="trash-2" Danger="true" Disabled="@final" Reason="@(final ? "The final ring cannot be deleted" : null)">Delete ring…</MenuItem>
                            </ActionMenu>
                        </span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</Box>
}
else
{
<Box Title="Start rules" Help="release-rules#start-rules" Flush="true" Hint="The matching rule with the lowest priority number decides how a newly reported update starts; without a matching rule it stays queued">
    <ListTable Table="_ruleTable" Page="_rulePage" Columns="RuleColumns" Search="Search title pattern" Noun="rules" Empty="No start rule: every update waits for a manual start." ExtraColumns="1">
        <ExtraHeader><th class="n">Actions</th></ExtraHeader>
        <Row Context="rule">
                    <tr>
                        <td class="n">@rule.Priority</td>
                        <td>@(rule.Classification ?? "any")</td>
                        <td>@(rule.MsrcSeverity ?? "any")</td>
                        <td class="mono">@(rule.TitlePattern ?? "any")</td>
                        <td>@(rule.RebootBehavior is null ? "any" : UpdateText.Restart(rule.RebootBehavior))</td>
                        <td>@StartText(rule)</td>
                        <td>@foreach (var ring in RingsOf(rule)) { <RingTag Name="@ring.Name" Order="@ring.Order" /> }</td>
                        <td class="n"><span class="row-actions">
                            <a class="btn icon-button" href="@Path?dialog=rule&id=@rule.Id" title="Edit start rule @rule.Priority" aria-label="Edit start rule @rule.Priority" data-help-term="Edit"><Icon Name="pencil" Size="16" /></a>
                            <ActionMenu Label="More" Icon="ellipsis" Compact="true" Align="right" Title="@($"More for start rule {rule.Priority}")">
                                <MenuItem Href="@($"{Path}?dialog=rule-delete&id={rule.Id}")" Icon="trash-2" Danger="true">Delete start rule…</MenuItem>
                            </ActionMenu>
                        </span></td>
                    </tr>
        </Row>
    </ListTable>
</Box>

<form method="post" @formname="withdrawn" @onsubmit="SaveWithdrawnAsync" class="box">
    <AntiforgeryToken />
    <header class="box-head"><h2>Updates withdrawn by Microsoft<HelpLink To="release-rules#withdrawn" Label="Updates withdrawn by Microsoft" /></h2><span class="hint">When servers no longer get a released update offered and no newer update or revision explains it</span></header>
    <div class="box-body form">
        <div class="form-row">
            <label class="field"><span>When an update looks withdrawn</span>
                <select name="WithdrawnAction">
                    <option value="stop" selected="@_stopWithdrawn">Stop its rollout and notify</option>
                    <option value="notify" selected="@(!_stopWithdrawn)">Only notify</option>
                </select>
            </label>
        </div>
        <p class="help">A stopped rollout can be resumed on the update page; servers never install an update Windows Update no longer offers. Block the update there to keep it from coming back.</p>
    </div>
    <footer class="box-foot"><span></span><button type="submit" class="primary">Save</button></footer>
</form>
}

@if (_dialog is "rule-new" or "rule" && (_dialog == "rule-new" || EditingRule is not null))
{
    var rule = _dialog == "rule" ? EditingRule : null;
    var classification = Classification ?? rule?.Classification ?? (_dialog == "rule-new" ? PrefillClassification : null);
    var severity = Severity ?? rule?.MsrcSeverity ?? (_dialog == "rule-new" ? PrefillSeverity : null);
    var restart = RestartOf(rule);
    var selected = StartRingsSelected?.ToList() ?? (rule is null ? [] : [.. StartRings.Parse(rule.StartRingIds)]);
    <Dialog Title="@(rule is null ? "New start rule" : "Edit start rule")" CloseHref="@Path" Wide="true" Help="release-rules#start-rule-dialog">
        <form method="post" @formname="release-dialog" @onsubmit="SaveAsync">
            <AntiforgeryToken />
            <input type="hidden" name="Mode" value="@(rule is null ? "rule-create" : "rule-edit")" />
            <input type="hidden" name="Id" value="@rule?.Id" />
            <div class="dialog-body">
                @if (MessageIsError)
                {
                    <p class="error" role="alert">@Message</p>
                }
                @if (rule is null && PrefillTitle is not null)
                {
                    <p class="notice">Pre-filled from the update; narrow the title pattern with * and ? as needed.</p>
                }
                <div class="form-row">
                    <label class="field"><span>Classification</span>
                        <select name="Classification">
                            <option value="" selected="@string.IsNullOrEmpty(classification)">Any classification</option>
                            @foreach (var value in Classifications(classification))
                            {
                                <option value="@value" selected="@(value == classification)">@value</option>
                            }
                        </select>
                    </label>
                    <label class="field"><span>Severity</span>
                        <select name="Severity">
                            <option value="" selected="@string.IsNullOrEmpty(severity)">Any severity</option>
                            @foreach (var value in Severities(severity))
                            {
                                <option value="@value" selected="@(value == severity)">@value</option>
                            }
                        </select>
                    </label>
                    <label class="field"><span>Restart</span>
                        <select name="Restart">
                            <option value="" selected="@(restart is null)">Any restart behaviour</option>
                            @foreach (var behavior in Enum.GetValues<RebootBehavior>())
                            {
                                <option value="@behavior" selected="@(restart == behavior)">@UpdateText.Restart((int)behavior)</option>
                            }
                        </select>
                    </label>
                    <label class="field"><span>Priority (lower wins)</span><input name="Priority" type="number" min="0" max="10000" value="@(Priority ?? (rule?.Priority ?? NextPriority).ToString(System.Globalization.CultureInfo.InvariantCulture))" /></label>
                </div>
                <label class="field"><span>Title pattern (* and ? allowed)</span><input name="TitlePattern" maxlength="128" value="@(TitlePattern ?? rule?.TitlePattern ?? (_dialog == "rule-new" ? PrefillTitle : null))" placeholder="e.g. *Cumulative Update*" /></label>
                <label class="check"><input type="checkbox" name="OutsideWindows" value="true" checked="@(Mode is "rule-create" or "rule-edit" ? OutsideWindows == "true" : rule?.OutsideWindows == true)" /> Install outside the maintenance windows</label>
                <p class="help">Only with the restart condition "No restart": servers install these updates as soon as they are released, also outside their windows (e.g. definition updates). Updates that restart always wait for a window.</p>
                <div class="gated-select">
                <div class="form-row">
                    <label class="field"><span>Start</span>
                        <select name="StartMode" class="gate">
                            <option value="automatic" selected="@((StartModeText ?? rule?.Mode.ToString().ToLowerInvariant() ?? "automatic") == "automatic")">Automatically</option>
                            <option value="manual" selected="@((StartModeText ?? rule?.Mode.ToString().ToLowerInvariant()) == "manual")">Manually (stays queued until an operator starts it)</option>
                        </select>
                    </label>
                    <label class="field gated-body"><span>Delay before the first installation (hours)</span><input name="Delay" type="number" min="0" max="@StartRuleEntity.MaxDelayHours" value="@(Delay ?? ((int)(rule?.Delay.TotalHours ?? 0)).ToString(System.Globalization.CultureInfo.InvariantCulture))" /></label>
                </div>
                <fieldset class="gated-body">
                    <legend>Starts in</legend>
                    @for (var i = 0; i < _rings.Count; i++)
                    {
                        var ring = _rings[i];
                        @if (i == 0)
                        {
                            <label class="check"><input type="checkbox" data-help-term="Starts in" checked disabled /> @ring.Name (always)</label>
                        }
                        else
                        {
                            <label class="check"><input type="checkbox" data-help-term="Starts in" name="StartRingsSelected" value="@ring.Id" checked="@selected.Contains(ring.Id)" /> @ring.Name</label>
                        }
                    }
                    <p class="help">Further rings get the update at once, e.g. definition updates in every ring. Rings not selected follow their transition rules.</p>
                </fieldset>
                </div>
                @{
                    var preview = PreviewMatches(rule, classification, severity, TitlePattern ?? rule?.TitlePattern ?? (_dialog == "rule-new" ? PrefillTitle : null), restart);
                }
                <fieldset>
                    <legend>Matching updates (@preview.Count of @_previewUpdates.Count known, not archived)</legend>
                    @if (preview.Count == 0)
                    {
                        <p class="help">No known update matches these conditions. Check classification, severity and the title pattern (it must match the whole title; use * for the varying parts).</p>
                    }
                    <ul class="plain">
                        @foreach (var (update, taken) in preview.Take(15))
                        {
                            <li>
                                <a href="/updates/@update.UpdateId/@update.Revision">@UpdateText.Title(update, update.UpdateId)</a>
                                @if (taken)
                                {
                                    <span class="pill neutral">a rule with a lower priority number decides</span>
                                }
                                else if (_started.Contains((update.UpdateId, update.Revision)))
                                {
                                    <span class="pill ok">already started</span>
                                }
                                else
                                {
                                    <span class="pill queue">waiting: starts when saved (automatic)</span>
                                }
                            </li>
                        }
                    </ul>
                    @if (preview.Count > 15)
                    {
                        <p class="help">and @(preview.Count - 15) more.</p>
                    }
                    <p class="help">Rules are applied when a server reports an update, when a rule is saved and every minute to all waiting updates.</p>
                </fieldset>
            </div>
            <div class="dialog-foot"><a class="btn" href="@Path">Cancel</a><button type="submit" name="Preview" value="yes">Preview matches</button><button type="submit" class="primary">@(rule is null ? "Create start rule" : "Save")</button></div>
        </form>
    </Dialog>
}
else if (_dialog is "ring-new" or "ring" && (_dialog == "ring-new" || EditingRing is not null))
{
    var ring = _dialog == "ring" ? EditingRing : null;
    var transition = ring is null ? null : _transitions.GetValueOrDefault(ring.Id);
    var final = ring is not null && ring.Id == _rings[^1].Id;
    <Dialog Title="@(ring is null ? "New ring" : $"Edit ring {ring.Name}")" CloseHref="@RingsPath" Help="release-rules#ring-dialog">
        <form method="post" @formname="release-dialog" @onsubmit="SaveAsync">
            <AntiforgeryToken />
            <input type="hidden" name="Mode" value="@(ring is null ? "ring-create" : "ring-edit")" />
            <input type="hidden" name="Id" value="@ring?.Id" />
            <div class="dialog-body">
                @if (MessageIsError)
                {
                    <p class="error" role="alert">@Message</p>
                }
                <label class="field"><span>Name</span><input name="Name" maxlength="32" required value="@(Name ?? ring?.Name)" /></label>
                @if (ring is not null)
                {
                    <label class="field"><span>Spread installations over (hours)</span><input name="Spread" type="number" min="0" max="@RingEntity.MaxSpreadHours" value="@(Spread ?? ring.SpreadHours.ToString(System.Globalization.CultureInfo.InvariantCulture))" /><span class="help">Each server gets a fixed offset within this time after the release, so not all install at once; 0 = no spread. Applies to new releases.</span></label>
                }
                @if (ring is null)
                {
                    <p class="help">The new ring is added before @_rings[^1].Name, the final ring. Its transition to the final ring starts with 2–7 days, feedback ≥ 80 % and success ≥ 95 %; edit it afterwards.</p>
                }
                else if (final)
                {
                    <p class="help">The final ring has no transition: servers without manual or rule-based assignment land here.</p>
                }
                else if (transition is not null)
                {
                    <div class="form-row">
                        <label class="field"><span>Minimum wait (days after the release in this ring)</span><input name="MinWait" type="number" min="0" max="@RingTransitionEntity.MaxWaitDays" value="@Days(transition.MinimumWait)" /></label>
                        <label class="field"><span>Maximum wait (days after the release in this ring)</span><input name="MaxWait" type="number" min="0" max="@RingTransitionEntity.MaxWaitDays" value="@Days(transition.MaximumWait)" /></label>
                    </div>
                    <div class="form-row">
                        <label class="field"><span>Feedback rate (%)</span><input name="Feedback" type="number" min="0" max="100" value="@transition.MinimumFeedbackPercent" /></label>
                        <label class="field"><span>Success rate (%)</span><input name="Success" type="number" min="0" max="100" value="@transition.MinimumSuccessPercent" /></label>
                    </div>
                    <label class="check"><input type="checkbox" data-help-term="Manual gate" name="Gate" value="true" checked="@transition.ManualGate" /> Manual gate: an operator approves the transition under Approvals</label>
                }
            </div>
            <div class="dialog-foot"><a class="btn" href="@RingsPath">Cancel</a><button type="submit" class="primary">@(ring is null ? "Create ring" : "Save")</button></div>
        </form>
    </Dialog>
}
else if (_dialog == "preview" && _schedulePreview is not null)
{
    <SchedulePreviewDialog Preview="@_schedulePreview" CloseHref="@RingsPath" />
}
else if (_dialog == "ring-delete" && EditingRing is { } doomedRing)
{
    <Dialog Title="@($"Delete ring {doomedRing.Name}?")" CloseHref="@RingsPath" Help="release-rules#transitions">
        <form method="post" @formname="release-dialog" @onsubmit="SaveAsync">
            <AntiforgeryToken />
            <input type="hidden" name="Mode" value="ring-delete" />
            <input type="hidden" name="Id" value="@doomedRing.Id" />
            <div class="dialog-body"><p>Only a ring without servers and without assignment rules can be deleted. Running rollouts skip it from now on.</p></div>
            <div class="dialog-foot"><a class="btn" href="@RingsPath">Cancel</a><button type="submit" class="danger">Delete ring</button></div>
        </form>
    </Dialog>
}
else if (_dialog == "rule-delete" && EditingRule is { } doomedRule)
{
    <Dialog Title="Delete start rule?" CloseHref="@Path" Help="release-rules#start-rules">
        <form method="post" @formname="release-dialog" @onsubmit="SaveAsync">
            <AntiforgeryToken />
            <input type="hidden" name="Mode" value="rule-delete" />
            <input type="hidden" name="Id" value="@doomedRule.Id" />
            <div class="dialog-body"><p>Updates this rule would start are handled by the next matching rule, or stay queued.</p></div>
            <div class="dialog-foot"><a class="btn" href="@Path">Cancel</a><button type="submit" class="danger">Delete start rule</button></div>
        </form>
    </Dialog>
}

@code {
    private const string Path = "/administration/release-rules";
    private const string RingsPath = Path + "?tab=rings";

    [SupplyParameterFromQuery(Name = "tab")] private string? Tab { get; set; }

    /// <summary>"rules" (start rules and withdrawn updates) or "rings" (rings and transitions); ring dialogs open on the rings tab.</summary>
    private string _tab => Tab == "rings" || (DialogName?.StartsWith("ring", StringComparison.Ordinal) ?? false) ? "rings" : "rules";

    private IReadOnlyList<TabItem> TabItems => [new("rules", "Start rules", DisplayNumber.Format(_rulePage?.Total ?? 0)), new("rings", "Rings", DisplayNumber.Format(_rings.Count))];

    /// <summary>Classifications Windows Update uses; values seen in the catalog are added.</summary>
    private static readonly string[] KnownClassifications = ["Critical Updates", "Definition Updates", "Drivers", "Feature Packs", "Security Updates", "Service Packs", "Tools", "Update Rollups", "Updates", "Upgrades"];

    private static readonly string[] KnownSeverities = ["Critical", "Important", "Moderate", "Low"];

    [SupplyParameterFromForm(FormName = "release-dialog")] private string? Mode { get; set; }
    [SupplyParameterFromForm(FormName = "release-dialog")] private string? Spread { get; set; }
    [SupplyParameterFromForm(FormName = "release-dialog")] private string? Id { get; set; }
    [SupplyParameterFromForm(FormName = "release-dialog")] private string? Name { get; set; }
    [SupplyParameterFromForm(FormName = "release-dialog")] private string? MinWait { get; set; }
    [SupplyParameterFromForm(FormName = "release-dialog")] private string? MaxWait { get; set; }
    [SupplyParameterFromForm(FormName = "release-dialog")] private string? Feedback { get; set; }
    [SupplyParameterFromForm(FormName = "release-dialog")] private string? Success { get; set; }
    [SupplyParameterFromForm(FormName = "release-dialog")] private string? Gate { get; set; }
    [SupplyParameterFromForm(FormName = "release-dialog")] private string? Priority { get; set; }
    [SupplyParameterFromForm(FormName = "release-dialog")] private string? Classification { get; set; }
    [SupplyParameterFromForm(FormName = "release-dialog")] private string? Severity { get; set; }
    [SupplyParameterFromForm(FormName = "release-dialog")] private string? TitlePattern { get; set; }
    [SupplyParameterFromForm(FormName = "release-dialog", Name = "StartMode")] private string? StartModeText { get; set; }
    [SupplyParameterFromForm(FormName = "release-dialog")] private string? Delay { get; set; }
    [SupplyParameterFromForm(FormName = "release-dialog")] private int[]? StartRingsSelected { get; set; }
    [SupplyParameterFromForm(FormName = "release-dialog")] private string? Restart { get; set; }
    [SupplyParameterFromForm(FormName = "withdrawn")] private string? WithdrawnAction { get; set; }

    private bool _stopWithdrawn = true;

    private async Task SaveWithdrawnAsync()
    {
        var outcome = WithdrawnAction is "stop" or "notify"
            ? await Administration.SetStopWithdrawnAsync(WithdrawnAction == "stop", await GetActorAsync(), CancellationToken.None)
            : new Outcome("Choose what happens with withdrawn updates.");
        ShowResult(outcome.Error, "The setting for withdrawn updates was saved.");
        await LoadAsync();
    }
    [SupplyParameterFromForm(FormName = "release-dialog")] private string? OutsideWindows { get; set; }

    /// <summary>Restart condition from the posted form, else from the rule; null for any.</summary>
    private RebootBehavior? RestartOf(StartRuleEntity? rule) =>
        Mode is "rule-create" or "rule-edit"
            ? Enum.TryParse<RebootBehavior>(Restart, ignoreCase: false, out var posted) && Enum.IsDefined(posted) && !int.TryParse(Restart, out _) ? posted : null
            : (RebootBehavior?)rule?.RebootBehavior;

    [SupplyParameterFromQuery(Name = "dialog")] private string? DialogName { get; set; }
    [SupplyParameterFromQuery(Name = "id")] private string? DialogId { get; set; }

    /// <summary>Pre-filled values when the dialog is opened from an update ("Create release rule from this update").</summary>
    [SupplyParameterFromQuery(Name = "classification")] private string? PrefillClassification { get; set; }
    [SupplyParameterFromQuery(Name = "severity")] private string? PrefillSeverity { get; set; }
    [SupplyParameterFromQuery(Name = "title")] private string? PrefillTitle { get; set; }

    private string? _dialog;
    private List<RingEntity> _rings = [];
    private Dictionary<int, RingTransitionEntity> _transitions = [];
    private List<StartRuleEntity> _startRules = [];
    private TableQuery _ruleTable = default!;
    private TablePage<StartRuleEntity> _rulePage = default!;
    private IReadOnlyList<TableColumn<StartRuleEntity>>? _ruleColumns;

    private IReadOnlyList<TableColumn<StartRuleEntity>> RuleColumns => _ruleColumns ??=
    [
        new("priority", "Priority", r => r.Priority, Class: "n"),
        new("classification", "Classification", r => r.Classification, r => [r.Classification ?? "any"]),
        new("severity", "Severity", r => r.MsrcSeverity, r => [r.MsrcSeverity ?? "any"]),
        new("pattern", "Title pattern", r => r.TitlePattern),
        new("restart", "Restart", r => r.RebootBehavior, r => [r.RebootBehavior is null ? "any" : UpdateText.Restart(r.RebootBehavior)]),
        new("start", "Start", r => StartText(r), r => [r.Mode == StartMode.Automatic ? "Automatically" : "Manually"]),
        new("rings", "Starts in", r => r.StartRingIds, r => [.. StartRingNames(r)], Sortable: false),
    ];

    private static string StartText(StartRuleEntity rule) =>
        (rule.Mode == StartMode.Automatic ? (rule.Delay == TimeSpan.Zero ? "Automatically" : $"Automatically after {(int)rule.Delay.TotalHours} hours") : "Manually")
        + (rule.OutsideWindows ? ", outside maintenance windows" : string.Empty);
    private Dictionary<int, int> _servers = [];
    private List<string> _catalogClassifications = [];

    private int? DialogNumber => int.TryParse(DialogId, System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out var id) ? id : null;

    private RingEntity? EditingRing => _rings.FirstOrDefault(r => r.Id == DialogNumber);

    private StartRuleEntity? EditingRule => _startRules.FirstOrDefault(r => r.Id == DialogNumber);

    protected override async Task OnInitializedAsync()
    {
        _dialog = DialogName;
        await LoadAsync();
    }

    private IEnumerable<string> Classifications(string? current) =>
        KnownClassifications.Concat(_catalogClassifications).Append(current ?? string.Empty).Where(c => c.Length > 0).Distinct(StringComparer.OrdinalIgnoreCase).Order(StringComparer.OrdinalIgnoreCase);

    private static IEnumerable<string> Severities(string? current) =>
        KnownSeverities.Append(current ?? string.Empty).Where(s => s.Length > 0).Distinct(StringComparer.OrdinalIgnoreCase);

    private IEnumerable<RingEntity> RingsOf(StartRuleEntity rule) =>
        _rings.Where((r, i) => i == 0 || StartRings.Parse(rule.StartRingIds).Contains(r.Id));

    private IEnumerable<string> StartRingNames(StartRuleEntity rule) => RingsOf(rule).Select(r => r.Name);

    private static string Days(TimeSpan value) => ((int)value.TotalDays).ToString(System.Globalization.CultureInfo.InvariantCulture);

    [SupplyParameterFromForm(FormName = "release-dialog")] private string? Preview { get; set; }

    private List<UpdateEntity> _previewUpdates = [];

    /// <summary>Priority a new rule gets by default: counts on from the existing rules and avoids conflicts.</summary>
    private int NextPriority => RolloutAdministration.NextFreePriority([.. _startRules.Select(r => (r.Id, r.Priority))]);
    private HashSet<(Guid, int)> _started = [];

    /// <summary>Known updates a rule with these conditions decides, and whether another rule with a lower priority number takes them first.</summary>
    private IReadOnlyList<(UpdateEntity Update, bool TakenByOtherRule)> PreviewMatches(StartRuleEntity? rule, string? classification, string? severity, string? pattern, RebootBehavior? restart)
    {
        var priority = int.TryParse(Priority, System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out var p) ? p : rule?.Priority ?? NextPriority;
        var candidate = new StartRuleEntity
        {
            Id = rule?.Id ?? int.MaxValue,
            Priority = priority,
            Classification = string.IsNullOrEmpty(classification) ? null : classification,
            MsrcSeverity = string.IsNullOrEmpty(severity) ? null : severity,
            TitlePattern = string.IsNullOrWhiteSpace(pattern) ? null : pattern.Trim(),
            RebootBehavior = (int?)restart,
        };
        return StartRulePatterns.Matches(candidate, _startRules, _previewUpdates);
    }

    private async Task SaveAsync()
    {
        if (Preview == "yes" && Mode is "rule-create" or "rule-edit")
        {
            // Show the matches for the entered values without saving; the dialog stays open with them.
            _dialog = DialogName;
            return;
        }
        var actor = await GetActorAsync();
        var invariant = System.Globalization.CultureInfo.InvariantCulture;
        int? id = int.TryParse(Id, System.Globalization.NumberStyles.None, invariant, out var parsedId) ? parsedId : null;
        int Number(string? value) => int.TryParse(value, System.Globalization.NumberStyles.None, invariant, out var number) ? number : -1;
        Outcome outcome;
        string success;
        switch (Mode)
        {
            case "ring-create":
                (outcome, success) = (await Rings.CreateAsync(Name, actor, CancellationToken.None), "The ring was created.");
                break;
            case "ring-edit" when id is { } ringId:
                outcome = await Rings.RenameAsync(ringId, Name, actor, CancellationToken.None);
                if (outcome.Succeeded && Spread is not null)
                {
                    outcome = int.TryParse(Spread, System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out var spread)
                        ? await Rings.SetSpreadAsync(ringId, spread, actor, CancellationToken.None)
                        : new Outcome("The spread must be a whole number of hours.");
                }

                if (outcome.Succeeded && MinWait is not null)
                {
                    outcome = await Administration.SetTransitionAsync(ringId, Number(MinWait), Number(MaxWait), Number(Feedback), Number(Success), Gate == "true", actor, CancellationToken.None);
                }

                success = "The ring was saved.";
                break;
            case "ring-delete" when id is { } ringId:
                (outcome, success) = (await Rings.DeleteAsync(ringId, actor, CancellationToken.None), "The ring was deleted.");
                break;
            case "rule-create" or "rule-edit":
                var mode = StartModeText switch { "automatic" => StartMode.Automatic, "manual" => StartMode.Manual, _ => (StartMode)(-1) };
                var rings = (StartRingsSelected ?? []).Distinct().Take(20).ToList();
                if (Mode == "rule-create")
                {
                    (outcome, success) = (await Administration.CreateStartRuleAsync(Number(Priority), Classification, Severity, TitlePattern, mode, mode == StartMode.Manual ? 0 : Number(Delay), actor, CancellationToken.None, rings, RestartOf(null), OutsideWindows == "true"), "The start rule was created.");
                }
                else
                {
                    (outcome, success) = id is { } ruleId
                        ? (await Administration.UpdateStartRuleAsync(ruleId, Number(Priority), Classification, Severity, TitlePattern, mode, mode == StartMode.Manual ? 0 : Number(Delay), rings, actor, CancellationToken.None, RestartOf(null), OutsideWindows == "true"), "The start rule was saved.")
                        : (new Outcome("Invalid request."), string.Empty);
                }

                break;
            case "rule-delete" when id is { } ruleId:
                (outcome, success) = (await Administration.DeleteStartRuleAsync(ruleId, actor, CancellationToken.None), "The start rule was deleted.");
                break;
            default:
                (outcome, success) = (new Outcome("Invalid request."), string.Empty);
                break;
        }

        ShowResult(outcome.Error, success);
        _dialog = outcome.Succeeded ? null : DialogName;
        await LoadAsync();
    }

    private SUSyphos.Server.Assignment.SchedulePreviewResult? _schedulePreview;

    private async Task LoadAsync()
    {
        _schedulePreview = _dialog == "preview" && int.TryParse(DialogId, System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out var previewId) ? await SchedulePreview.ForRingAsync(previewId, CancellationToken.None) : null;
        _rings = await Db.Rings.AsNoTracking().OrderBy(r => r.Order).ToListAsync();
        _transitions = await Db.RingTransitions.AsNoTracking().ToDictionaryAsync(t => t.FromRingId);
        _startRules = await Db.StartRules.AsNoTracking().OrderBy(r => r.Priority).ThenBy(r => r.Id).ToListAsync();
        _ruleTable = TableQuery.From(Navigation, "priority");
        _rulePage = TablePaging.Apply(_startRules, _ruleTable, RuleColumns, r => $"{r.TitlePattern} {r.Classification} {r.MsrcSeverity}");
        _servers = await Db.Clients.Where(c => c.RingId != null && c.State == RegistrationState.Approved).GroupBy(c => c.RingId!.Value).ToDictionaryAsync(g => g.Key, g => g.Count());
        _stopWithdrawn = await Administration.GetStopWithdrawnAsync(CancellationToken.None);
        _catalogClassifications = await Db.Updates.AsNoTracking().Where(u => u.Classification != null).Select(u => u.Classification!).Distinct().Take(50).ToListAsync();
        if (DialogName is "rule" or "rule-new")
        {
            _previewUpdates = await Db.Updates.AsNoTracking().Where(u => u.ArchivedAtUtc == null).OrderByDescending(u => u.FirstSeenAtUtc).Take(5000).ToListAsync();
            _started = [.. (await Db.Rollouts.AsNoTracking().Select(r => new { r.UpdateId, r.Revision }).ToListAsync()).Select(r => (r.UpdateId, r.Revision))];
        }
    }
}
