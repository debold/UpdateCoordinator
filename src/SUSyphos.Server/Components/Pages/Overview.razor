@page "/"
@attribute [Authorize(Policy = AdminRoles.Policies.Read)]
@inherits DashboardPageBase
@using SUSyphos.Contracts.Agents
@using SUSyphos.Server.Agents
@using SUSyphos.Server.Rollouts
@inject ServerDbContext Db
@inject DeploymentStatus Deployment
@inject DashboardStatistics Statistics
@inject GlobalPause Pause
@inject BlackoutPeriods Blackouts
@inject TimeProvider Time
@inject NavigationManager Navigation
@inject SUSyphos.Server.Approval.DirectoryCoverage CoverageReader
@inject SUSyphos.Server.AgentPackages.AgentPackageAdministration ServerUpdates

<PageTitle>Overview</PageTitle>

<PageHeader Title="Overview" Icon="@PageIcons.Overview" Subtitle="@($"As of {Format(_now)}")" Help="overview" />
<StatusMessage Text="@Message" IsError="@MessageIsError" />

@* The form is always rendered (the handler checks the role again); only operators see the buttons. *@
<form id="pause" method="post" @formname="pause" @onsubmit="TogglePauseAsync"><AntiforgeryToken /></form>
@if (_paused)
{
    <Banner Label="Paused" Severity="fail" Help="overview#pause">
        <ChildContent>Agents start no new installations until an operator resumes them.</ChildContent>
        <Action>@if (_canOperate) { <button type="submit" form="pause" name="Pause" value="off" class="primary">Resume installations</button> }</Action>
    </Banner>
}
@if (_blackout is { } blackout)
{
    <Banner Label="Blackout" Severity="queue" Help="overview#pause">
        <ChildContent>No installations until @Format(blackout.EndUtc): @blackout.Reason</ChildContent>
        <Action><a class="btn" href="/administration/maintenance">Show blackouts</a></Action>
    </Banner>
}

<ActionBand>
    <a class="btn" href="/" title="Load the page again with the latest state"><Icon Name="refresh-cw" Size="16" />Refresh</a>
    @if (_canOperate && !_paused)
    {
        <div class="spacer"></div>
        <button type="submit" form="pause" name="Pause" value="on" class="danger"><Icon Name="pause" Size="16" />Pause all installations</button>
    }
</ActionBand>

<section class="tiles" aria-label="Key figures">
    <Tile Title="Servers reporting" Href="@Servers.Link("status", ReportingStates)" Edge="@(_reporting < _approved ? "queue" : null)" Footer="approved servers with a heartbeat within the last hour">
        <TileValue>@DisplayNumber.Format(_reporting) <small>/ @DisplayNumber.Format(_approved)</small></TileValue>
    </Tile>
    <Tile Title="Pending updates" Href="@Servers.Link("pending", Servers.PendingYes)" Footer="released, not installed yet; installed in the next maintenance window">
        <TileValue Value="@DisplayNumber.Format(_pendingUpdates)" Caption="installations" />
        <TileValue Value="@DisplayNumber.Format(_pendingServers)" Caption="servers" />
    </Tile>
    <Tile Title="Server status" Href="/servers" Edge="@(_failedServers > 0 || _offlineServers > 0 ? "fail" : _warningServers > 0 ? "queue" : null)" Footer="@WarningFooter">
        <TileDonut Parts="@_statusParts" />
    </Tile>
    <Tile Title="Compliance" Href="@Servers.Link("pending", Servers.PendingNo)" Footer="share of approved servers">
        <TileValue Value="@DisplayNumber.Percent(_compliancePercent)" Caption="released installed" />
        <TileValue Value="@DisplayNumber.Percent(_fullyPatchedPercent)" Caption="fully patched" />
    </Tile>
    @if (_coverage.ReadAtUtc is not null)
    {
        <Tile Title="AD coverage" Href="/coverage" Edge="@(_coverage.Missing.Count > 0 ? "queue" : null)" Footer="@($"server accounts running an agent; {DisplayNumber.Format(_coverage.Missing.Count)} without")">
            <TileValue>@DisplayNumber.Format(_coverage.Covered) <small>/ @DisplayNumber.Format(_coverage.Supported)</small></TileValue>
        </Tile>
    }
    <Tile Title="Central server" Href="/agents#server" Edge="@(_serverUpdate is null ? null : "queue")" Footer="@(_serverUpdate is { } available ? $"{DisplayNumber.Version(available.Version)} is available" : "the newest release on GitHub")">
        <TileValue Caption="@DisplayNumber.Version(SUSyphos.Server.Administration.ServerVersion.Display)"><StatusTag Text="@(_serverUpdate is null ? "Up to date" : "Update available")" Kind="@(_serverUpdate is null ? "ok" : "queue")" /></TileValue>
    </Tile>
</section>

<div class="grid-side">
    <Box Title="Deployment by ring" Help="overview#rings" Flush="true">
        <div class="scroll">
            <table>
                <thead><tr><th>Ring</th><th class="n">Servers</th><th class="n">Active updates</th><th>Status (server × update)</th><th>State</th></tr></thead>
                <tbody>
                    @foreach (var ring in _rings)
                    {
                        <tr>
                            <td class="nowrap"><RingTag Name="@ring.Name" Order="@ring.Order" Href="@Servers.Link("ring", ring.Name)" Title="Show the servers of this ring" /></td>
                            <td class="n">@ring.Servers</td>
                            <td class="n">@ring.ActiveUpdates</td>
                            <td><StackedBar Counts="@ring.Counts" /></td>
                            <td><span class="pill @ring.HealthClass">@ring.Health</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="box-body"><Legend /></div>
    </Box>

    <Box Title="Needs attention" Help="overview#attention" Flush="true">
        <div class="attention">
            @if (_attention.Count == 0)
            {
                <div class="empty">Nothing waits for a human decision.</div>
            }
            @foreach (var item in _attention)
            {
                <div class="item">
                    <span class="pill @item.PillClass">@item.Kind</span>
                    <div class="text">
                        <div class="title">@item.Title</div>
                        @if (item.Detail is not null)
                        {
                            <div class="sub">@item.Detail</div>
                        }
                    </div>
                    <a class="btn" href="@item.Link">@item.LinkText</a>
                </div>
            }
        </div>
    </Box>
</div>

<Box Title="Next installations" Help="overview#next" Hint="Released updates not installed yet, by earliest installation; each server installs within its maintenance window" Flush="true">
    <ListTable Table="_nextTable" Page="_nextPage" Columns="NextColumns" Search="Search update" Noun="updates" Empty="No released update is waiting for installation.">
        <Row Context="next">
            <tr>
                <td class="wrap"><a href="/updates/@next.UpdateId/@next.Revision">@next.Title</a></td>
                <td class="nowrap">@(next.EarliestUtc <= _now ? "due now" : Format(next.EarliestUtc))</td>
                <td class="n">@next.Servers</td>
                <td>@foreach (var ring in next.Rings) { <RingTag Name="@ring.Name" Order="@ring.Order" /> }</td>
            </tr>
        </Row>
    </ListTable>
</Box>

<Box Title="Statistics" Anchor="statistics" Help="overview#statistics" Hint="@_chart.Note">
    <ChildContent>
        <form method="get" action="#statistics" class="chart-picker">
            <label class="field inline"><span>Show</span>
                <select name="stat" data-auto-submit data-help-term="Statistic">
                    @foreach (var (kind, key, label) in DashboardStatistics.Kinds)
                    {
                        <option value="@key" selected="@(kind == _chart.Kind)">@label</option>
                    }
                </select>
            </label>
            <label class="field inline"><span>Period</span>
                <select name="days" data-auto-submit data-help-term="Period">
                    @foreach (var period in DashboardStatistics.Periods)
                    {
                        <option value="@period" selected="@(period == _days)">last @period days</option>
                    }
                </select>
            </label>
            <button type="submit" class="ghost">Show</button>
        </form>
        <StatisticsChart Data="@_chart" />
    </ChildContent>
</Box>

@code {
    private sealed record AttentionItem(string Kind, string PillClass, string Title, string? Detail, string Link, string LinkText);

    private sealed record RingRow(int Id, int Order, string Name, int Servers, int ActiveUpdates, DeploymentCounts Counts, string Health, string HealthClass);

    [SupplyParameterFromForm(FormName = "pause")]
    private string? PauseRequest { get; set; }

    private DateTime _now;
    private bool _paused;
    private BlackoutPeriod? _blackout;
    private List<NextInstallation> _next = [];

    private sealed record NextInstallation(Guid UpdateId, int Revision, string Title, DateTime EarliestUtc, int Servers, IReadOnlyList<(int Order, string Name)> Rings);

    private static readonly IReadOnlyList<TableColumn<NextInstallation>> NextColumns =
    [
        new("update", "Update", n => n.Title),
        new("earliest", "Earliest installation", n => n.EarliestUtc),
        new("servers", "Servers", n => n.Servers, Class: "n"),
        new("rings", "Rings", n => string.Join(", ", n.Rings.Select(r => r.Name)), n => n.Rings.Count == 0 ? [string.Empty] : [.. n.Rings.Select(r => r.Name)], Sortable: false),
    ];

    private TableQuery _nextTable = default!;
    private TablePage<NextInstallation> _nextPage = default!;
    private bool _canOperate;
    private List<AttentionItem> _attention = [];
    private List<RingRow> _rings = [];
    private ChartData _chart = new(StatisticKind.Compliance, ChartForm.Lines, [], [], string.Empty, null, string.Empty);
    private int _days = 90;
    private int _fullyPatchedPercent;

    [SupplyParameterFromQuery(Name = "stat")]
    private string? StatisticKey { get; set; }

    [SupplyParameterFromQuery(Name = "days")]
    private string? Days { get; set; }
    private int _approved;
    private int _reporting;
    private int _pendingUpdates;
    private int _pendingServers;
    private int _wsus;
    private int _selfInstalling;
    private int _diskWarnings;
    private int _rebootPending;
    private int _compliancePercent;
    private int _failedServers;
    private int _warningServers;
    private int _offlineServers;
    private IReadOnlyList<DonutPart> _statusParts = [];
    private SUSyphos.Server.AgentPackages.ServerUpdate? _serverUpdate;

    /// <summary>What the warnings are, below the status donut.</summary>
    private string WarningFooter => $"{DisplayNumber.Format(_wsus)} WSUS source · {DisplayNumber.Format(_selfInstalling)} Windows installs itself · {DisplayNumber.Format(_diskWarnings)} low disk · {DisplayNumber.Format(_rebootPending)} reboot pending";

    /// <summary>Health states of approved servers that sent a heartbeat within the last hour.</summary>
    private static readonly string[] ReportingStates = [.. Enum.GetValues<ServerHealthState>().Where(s => s is not (ServerHealthState.Offline or ServerHealthState.NotApproved)).Select(ServerHealth.Label)];
    private SUSyphos.Server.Approval.CoverageReport _coverage = new(null, 0, 0, [], []);

    protected override async Task OnInitializedAsync()
    {
        _canOperate = await IsAuthorizedAsync(AdminRoles.Policies.Operate);
        await LoadAsync();
    }

    private async Task TogglePauseAsync()
    {
        if (!await IsAuthorizedAsync(AdminRoles.Policies.Operate))
        {
            ShowResult("Only operators and administrators can pause installations.", string.Empty);
        }
        else if (Request.Form["Pause"].ToString() is "on" or "off")
        {
            var on = Request.Form["Pause"].ToString() == "on";
            var outcome = await Pause.SetAsync(on, await GetActorAsync(), CancellationToken.None);
            ShowResult(outcome.Error, on ? "Installations are paused. Agents start no new installations." : "Installations run again.");
        }
        else
        {
            ShowResult("Invalid request.", string.Empty);
        }

        await LoadAsync();
    }

    [CascadingParameter]
    private Microsoft.AspNetCore.Http.HttpContext? HttpContext { get; set; }

    private Microsoft.AspNetCore.Http.HttpRequest Request => HttpContext!.Request;

    private async Task LoadAsync()
    {
        _now = Time.GetUtcNow().UtcDateTime;
        _paused = await Pause.IsSwitchedOnAsync(CancellationToken.None);
        _blackout = await Blackouts.GetActiveAsync(CancellationToken.None);

        var clients = await Db.Clients.AsNoTracking().Where(c => c.State == RegistrationState.Approved).ToListAsync();
        var entries = await Deployment.GetAsync(null, null, null, CancellationToken.None);
        var failedClients = entries.Where(e => e.State == DeploymentState.Failed).Select(e => e.ClientId).ToHashSet();
        var health = clients.ToDictionary(c => c.Id, c => ServerHealth.Evaluate(c, failedClients.Contains(c.Id), _now));

        _approved = clients.Count;
        _reporting = health.Values.Count(h => h != ServerHealthState.Offline);
        var released = entries.Where(e => e.EarliestInstallAtUtc is not null && e.State != DeploymentState.Successful).ToList();
        // The next installations: per update, the earliest pending time, how many servers and in which rings.
        var ringNames = await Db.Rings.AsNoTracking().ToDictionaryAsync(r => r.Id, r => (r.Order, r.Name));
        var nextKeys = released
            .Where(e => e.State == DeploymentState.Pending)
            .GroupBy(e => (e.UpdateId, e.Revision))
            .Select(g => (Key: g.Key, Earliest: g.Min(e => e.EarliestInstallAtUtc!.Value), Servers: g.Select(e => e.ClientId).Distinct().Count(),
                Rings: g.Where(e => e.RingId is not null && ringNames.ContainsKey(e.RingId.Value)).Select(e => ringNames[e.RingId!.Value]).Distinct().OrderBy(r => r.Order).ToList()))
            .OrderBy(n => n.Earliest)
            .Take(1000)
            .ToList();
        var nextIds = nextKeys.Select(n => n.Key.UpdateId).ToList();
        var nextUpdates = await Db.Updates.AsNoTracking().Where(u => nextIds.Contains(u.UpdateId)).ToListAsync();
        _next = [.. nextKeys.Select(n => new NextInstallation(n.Key.UpdateId, n.Key.Revision, UpdateText.Title(nextUpdates.FirstOrDefault(u => u.UpdateId == n.Key.UpdateId && u.Revision == n.Key.Revision), n.Key.UpdateId), n.Earliest, n.Servers, n.Rings))];
        _nextTable = TableQuery.From(Navigation, "earliest", prefix: "next.", defaultPageSize: 10);
        _nextPage = TablePaging.Apply(_next, _nextTable, NextColumns, n => n.Title);
        _pendingUpdates = released.Count;
        _pendingServers = released.Select(e => e.ClientId).Distinct().Count();
        _wsus = clients.Count(c => c.WsusServer is not null);
        _selfInstalling = clients.Count(c => c.AutomaticUpdatesBypass);
        _diskWarnings = clients.Count(c => c.HealthChecks.Any(h => h.Name == "DiskSpace" && h.Status != (int)HealthStatus.Ok));
        _rebootPending = clients.Count(c => c.RebootPending);
        _failedServers = health.Values.Count(h => h == ServerHealthState.Failed);
        _warningServers = health.Values.Count(h => h is ServerHealthState.Warning or ServerHealthState.RebootPending);
        _offlineServers = health.Values.Count(h => h == ServerHealthState.Offline);
        _statusParts = ServerHealth.Parts(health.Values, s => Servers.Link("status", ServerHealth.Label(s)));
        _serverUpdate = await ServerUpdates.GetServerUpdateAsync(CancellationToken.None);
        _compliancePercent = _approved == 0 ? 100 : (int)Math.Floor(100.0 * clients.Count(c => !released.Any(e => e.ClientId == c.Id)) / _approved);

        await LoadAttentionAsync(health);
        await LoadRingsAsync(clients, entries);
        _coverage = await CoverageReader.GetReportAsync(CancellationToken.None);
        _days = DashboardStatistics.ParsePeriod(Days);
        _chart = await Statistics.GetAsync(DashboardStatistics.ParseKind(StatisticKey), _days, CancellationToken.None);
        var missingAnything = (await Db.ClientAvailableUpdates.AsNoTracking().Select(a => a.ClientId).Distinct().ToListAsync()).ToHashSet();
        _fullyPatchedPercent = _approved == 0 ? 100 : (int)Math.Floor(100.0 * clients.Count(c => !missingAnything.Contains(c.Id)) / _approved);
    }

    private async Task LoadAttentionAsync(Dictionary<Guid, ServerHealthState> health)
    {
        _attention = [];
        var waiting = await Db.RolloutRings.AsNoTracking()
            .Where(r => r.State == RingRolloutState.Alarm || r.State == RingRolloutState.AwaitingApproval)
            .Where(r => Db.Rollouts.Any(o => o.UpdateId == r.UpdateId && o.Revision == r.Revision && o.State == RolloutState.Active))
            .OrderByDescending(r => r.State).ThenBy(r => r.StateChangedAtUtc)
            .Take(50)
            .ToListAsync();
        var ids = waiting.Select(r => r.UpdateId).Distinct().ToList();
        var updates = await Db.Updates.AsNoTracking().Where(u => ids.Contains(u.UpdateId)).ToListAsync();
        var rings = await Db.Rings.AsNoTracking().ToDictionaryAsync(r => r.Id, r => r.Name);

        foreach (var ring in waiting)
        {
            var title = UpdateText.Title(updates.FirstOrDefault(u => u.UpdateId == ring.UpdateId && u.Revision == ring.Revision), ring.UpdateId);
            var ringName = rings.GetValueOrDefault(ring.RingId) ?? "?";
            _attention.Add(ring.State == RingRolloutState.Alarm
                ? new AttentionItem("Alarm", "fail", $"{title} stopped before ring {ringName}", ring.Reason, $"/updates/{ring.UpdateId:D}/{ring.Revision}", "Open update")
                : new AttentionItem("Release gate", "queue", $"{title} waits for manual release to ring {ringName}", $"Since {Format(ring.StateChangedAtUtc)}", $"/updates/{ring.UpdateId:D}/{ring.Revision}", "Open update"));
        }

        var blocked = await Db.Clients.CountAsync(c => c.State == RegistrationState.Blocked);
        if (blocked > 0)
        {
            _attention.Add(new AttentionItem("Clone", "fail", $"{blocked} servers blocked on clone suspicion", "The same credentials were used by two hosts in turn.", "/approvals", "Review"));
        }

        if (_serverUpdate is { } serverUpdate)
        {
            _attention.Add(new AttentionItem("Update", "queue", $"Central server {serverUpdate.Version} is available", $"This central server runs {SUSyphos.Server.Administration.ServerVersion.Display}.", "/agents#server", "Show"));
        }

        var pending = await Db.Clients.CountAsync(c => c.State == RegistrationState.Pending);
        if (pending > 0)
        {
            _attention.Add(new AttentionItem("Registration", "pend", $"{pending} new servers wait for approval", null, "/approvals", "Review"));
        }

        foreach (var group in await Db.Groups.AsNoTracking().Where(g => g.LeasesHalted).ToListAsync())
        {
            _attention.Add(new AttentionItem("Lease", "fail", $"Group {group.Name}: {group.ConsecutiveLeaseFailures} leases in a row failed or expired", "The central server issues no leases for this group until an operator resumes it.", "/approvals", "Review"));
        }

        AddServers(health, ServerHealthState.Failed, "Failed", "fail", "servers with a failed installation or pre-flight check");
        AddServers(health, ServerHealthState.Offline, "Offline", "fail", "servers without heartbeat for over an hour");
    }

    private void AddServers(Dictionary<Guid, ServerHealthState> health, ServerHealthState state, string kind, string pill, string text)
    {
        var count = health.Values.Count(h => h == state);
        if (count > 0)
        {
            _attention.Add(new AttentionItem(kind, pill, $"{count} {text}", null, Servers.Link("status", ServerHealth.Label(state)), "Show servers"));
        }
    }

    private async Task LoadRingsAsync(List<ClientEntity> clients, IReadOnlyList<DeploymentEntry> entries)
    {
        var rings = await Db.Rings.AsNoTracking().OrderBy(r => r.Order).ToListAsync();
        var states = await Db.RolloutRings.AsNoTracking()
            .Where(r => Db.Rollouts.Any(o => o.UpdateId == r.UpdateId && o.Revision == r.Revision && o.State == RolloutState.Active))
            .Select(r => new { r.RingId, r.State })
            .ToListAsync();

        _rings = [.. rings.Select(ring =>
        {
            var counts = DeploymentCounts.Of(entries.Where(e => e.RingId == ring.Id));
            var mine = states.Where(s => s.RingId == ring.Id).ToList();
            var (label, cls) = mine.Any(s => s.State == RingRolloutState.Alarm) ? ("Alarm", "fail")
                : mine.Any(s => s.State == RingRolloutState.AwaitingApproval) ? ("Awaiting approval", "queue")
                : counts.Failed > 0 ? ("Failures", "fail")
                : counts.Pending > 0 ? ("Rolling out", "pend")
                : ("Healthy", "ok");
            return new RingRow(ring.Id, ring.Order, ring.Name, clients.Count(c => c.RingId == ring.Id), mine.Count(s => s.State == RingRolloutState.Released), counts, label, cls);
        })];
    }

    private static string Format(DateTime value) => DisplayTime.Format(value);
}
