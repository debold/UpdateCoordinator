@page "/administration/agent-settings"
@attribute [Authorize(Policy = AdminRoles.Policies.Administer)]
@inherits DashboardPageBase
@using SUSyphos.Contracts.Agents
@using SUSyphos.Server.Assignment
@inject AssignmentAdministration Administration

<PageTitle>Agent settings</PageTitle>

<PageHeader Title="Agent settings" Icon="@PageIcons.AgentSettings" Subtitle="Defaults for every agent; groups and single servers can set other values. Empty fields keep the agent's own value." Help="agent-settings" Crumbs="@([("Administration", null), ("Agent settings", null)])" />
<StatusMessage Text="@Message" IsError="@MessageIsError" />

<form id="agent-settings" method="post" @formname="agent-settings" @onsubmit="SaveAsync" class="detached">
    <AntiforgeryToken />
</form>

<ActionBand>
    <button type="submit" form="agent-settings" class="primary"><Icon Name="check" Size="16" />Save agent settings</button>
    <a class="btn" href="/administration/agent-settings"><Icon Name="rotate-ccw" Size="16" />Discard changes</a>
    <div class="spacer"></div>
    <span class="note">Agents apply changes with their next heartbeat; logging and priority restart the agent service.</span>
</ActionBand>

<Box Title="Agent settings" Help="agent-settings" Hint="dashed: the agent's own value applies; solid: set here">
    @foreach (var section in AgentSettings.All.GroupBy(d => d.Section))
    {
        <h3 class="settings-section" id="@Anchor(section.Key)">@section.Key</h3>
        <div class="setting-rows">
            @foreach (var definition in section)
            {
                <label for="@($"setting-{definition.Key}")">@definition.Label</label>
                <span class="setting-value @(definition.Kind == AgentSettingKind.Text ? "wide" : null)">
                    <AgentSettingField Definition="definition" Name="@AgentSettingValues.FieldName(definition.Key)" Id="@($"setting-{definition.Key}")" Form="agent-settings" Value="@ValueOf(definition.Key)" Placeholder="@(definition.Kind is AgentSettingKind.Duration or AgentSettingKind.Number ? definition.AgentDefault : AgentSettingValues.Display(definition, definition.AgentDefault))" />
                    @if (definition.Unit.Length > 0) { <span class="unit">@definition.Unit</span> }
                </span>
                @if (definition.Kind != AgentSettingKind.Text)
                {
                    <span class="setting-aside">@AgentSettingDialog.Range(definition)</span>
                }
            }
        </div>
    }
</Box>

@code {
    private Dictionary<string, string> _values = [];
    private Dictionary<string, string?>? _posted;

    protected override async Task OnInitializedAsync() => _values = await Administration.GetSystemAgentSettingsAsync(CancellationToken.None);

    /// <summary>After a refused save the posted values stay in the fields.</summary>
    private string? ValueOf(string key) => _posted is not null ? _posted.GetValueOrDefault(key) : _values.GetValueOrDefault(key);

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private async Task SaveAsync()
    {
        if (HttpContext?.Request.HasFormContentType != true)
        {
            return;
        }

        var values = AgentSettingValues.ReadForm(HttpContext.Request.Form);
        var outcome = await Administration.SetSystemAgentSettingsAsync(values, await GetActorAsync(), CancellationToken.None);
        if (!outcome.Succeeded)
        {
            _posted = values;
        }

        ShowResultAndReload(outcome.Error, "The agent settings were saved; agents apply them with their next heartbeat.");
        _values = await Administration.GetSystemAgentSettingsAsync(CancellationToken.None);
    }

    private static string Anchor(string section) => section.ToLowerInvariant().Replace(' ', '-').Replace("pre-flight-check", "pre-flight", StringComparison.Ordinal);

}
