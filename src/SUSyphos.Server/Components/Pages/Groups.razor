@page "/administration/groups"
@attribute [Authorize(Policy = AdminRoles.Policies.Administer)]
@inherits DashboardPageBase
@using SUSyphos.Server.Assignment
@inject ServerDbContext Db
@inject AssignmentAdministration Administration
@inject NavigationManager Navigation

<PageTitle>Server groups</PageTitle>

<PageHeader Title="Server groups" Icon="@PageIcons.ServerGroups" Subtitle="Server groups bundle servers, e.g. domain controllers or a cluster, with their own maintenance windows, reboot policy and coordination. Without settings, members use the system default." Help="groups" Crumbs="@([("Administration", null), ("Server groups", null)])" />
<StatusMessage Text="@Message" IsError="@MessageIsError" />

<ActionBand>
    <a class="btn primary" href="@Path?dialog=new">New group</a>
</ActionBand>

<Box Title="Server groups" Help="groups#list" Hint="A new group is empty: add servers in the server list (select, then Add to group) or on a server's page, or let an assignment rule add them" Flush="true">
    <ListTable Table="_table" Page="_page" Columns="Columns" Search="Search name or description" Noun="groups" Empty="No group yet." ExtraColumns="1">
        <ExtraHeader><th class="n">Actions</th></ExtraHeader>
        <Row Context="group">
                    @{
                        var windows = MaintenanceWindowFormat.FromJson(group.MaintenanceWindowsJson) ?? [];
                    }
                    <tr>
                        <td><a href="@Servers.Link("group", group.Name)">@group.Name</a></td>
                        <td>@group.Description</td>
                        <td class="n">@if (_members.GetValueOrDefault(group.Id) is > 0 and var members) { <span>@members</span> } else { <span class="note">none yet: <a href="/servers">add servers</a> or <a href="@($"/administration/rules?dialog=new&target=group:{group.Id}")">create a rule</a></span> }</td>
                        <td>@(windows.Count > 0 ? WindowPickerForm.Describe(windows) : "system default")</td>
                        <td>@(group.RebootPolicy is { } policy ? RebootPolicyText.Label(policy) : "inherit")</td>
                        <td>
                            @if (group.Coordinated)
                            {
                                <span>@group.LeasePercent %, at most @group.LeaseMaximum at once</span>
                                @if (group.LeasesHalted)
                                {
                                    <span class="pill fail">Stopped</span>
                                }
                            }
                            else
                            {
                                <span class="note">not coordinated</span>
                            }
                        </td>
                        <td class="n"><span class="row-actions">
                            <a class="btn icon-button" href="@Path?dialog=edit&id=@group.Id" title="Edit @group.Name" aria-label="Edit @group.Name" data-help-term="Edit"><Icon Name="pencil" Size="16" /></a>
                            <ActionMenu Label="More" Icon="ellipsis" Compact="true" Align="right" Title="@($"More for {group.Name}")">
                                <MenuItem Href="@Servers.Link("group", group.Name)" Icon="server">Show members</MenuItem>
                                <MenuSeparator />
                                <MenuItem Href="@($"{Path}?dialog=delete&id={group.Id}")" Icon="trash-2" Danger="true">Delete group…</MenuItem>
                            </ActionMenu>
                        </span></td>
                    </tr>
        </Row>
    </ListTable>
</Box>

@if (_dialog is "new" or "edit" && (_dialog == "new" || Editing is not null))
{
    var group = Editing;
    <Dialog Title="@(group is null ? "New group" : $"Edit group {group.Name}")" CloseHref="@Path" Wide="true" Help="groups#dialog">
        <form method="post" @formname="group-dialog" @onsubmit="SaveAsync">
            <AntiforgeryToken />
            <input type="hidden" name="Mode" value="@(group is null ? "create" : "edit")" />
            <input type="hidden" name="Id" value="@group?.Id" />
            <div class="dialog-body dialog-split"><div class="dialog-main">
                @if (MessageIsError)
                {
                    <p class="error" role="alert">@Message</p>
                }
                <div class="form-row">
                    <label class="field"><span>Name</span>
                        @if (group is null)
                        {
                            <input name="Name" maxlength="64" required value="@Name" />
                        }
                        else
                        {
                            <input value="@group.Name" disabled />
                        }
                    </label>
                    <label class="field"><span>Description</span><input name="Description" maxlength="256" value="@(Description ?? group?.Description)" /></label>
                </div>
                <div class="field">
                    <span class="field-label">Maintenance windows</span>
                    <WindowPicker Prefix="Windows" Draft="@_windowDraft" Windows="@(MaintenanceWindowFormat.FromJson(group?.MaintenanceWindowsJson) ?? [])" InheritedWindows="@_systemWindows" AllowInherit="true" Inherited="@(group?.MaintenanceWindowsJson is null)" InheritLabel="Use the system default" />
                </div>
                <div class="form-row">
                    <label class="field"><span>Reboots</span>
                        <select name="Reboot">
                            <option value="" selected="@(group?.RebootPolicy is null)">Inherit from the system default</option>
                            @foreach (var policy in Enum.GetValues<SUSyphos.Contracts.Agents.RebootPolicy>())
                            {
                                <option value="@policy" selected="@(group?.RebootPolicy == policy)">@RebootPolicyText.Label(policy)</option>
                            }
                        </select>
                    </label>
                    <label class="field"><span>Windows Automatic Updates</span>
                        <select name="AutomaticUpdates">
                            <option value="" selected="@(group?.ManageAutomaticUpdates is null)">Inherit from the system default</option>
                            <option value="leave" selected="@(group?.ManageAutomaticUpdates == false)">Leave unchanged, only warn</option>
                            <option value="prevent" selected="@(group?.ManageAutomaticUpdates == true)">Keep Windows from installing on its own</option>
                        </select>
                    </label>
                    <label class="field"><span>Other Microsoft products</span>
                        <select name="MicrosoftUpdate">
                            <option value="" selected="@(group?.UseMicrosoftUpdate is null)">Inherit from the system default</option>
                            <option value="windows" selected="@(group?.UseMicrosoftUpdate == false)">Windows Update only</option>
                            <option value="microsoft" selected="@(group?.UseMicrosoftUpdate == true)">Microsoft Update</option>
                        </select>
                    </label>
                </div>
                <div class="form-row">
                    <fieldset class="gated">
                        <legend>Coordination (leases)</legend>
                        <label class="check gate"><input type="checkbox" name="Coordinated" value="true" checked="@(group?.Coordinated == true)" /> Only part of the group installs at the same time</label>
                        <div class="form-row gated-body">
                            <label class="field"><span>Share of members</span><input name="Percent" type="number" min="1" max="100" value="@(group?.LeasePercent ?? 25)" /></label>
                            <label class="field"><span>At most at once</span><input name="Max" type="number" min="1" max="1000" value="@(group?.LeaseMaximum ?? 5)" /></label>
                        </div>
                    </fieldset>
                </div>
                <AgentSettingOverrides Explained="@GroupAgentSettings(group)" Own="@SUSyphos.Server.Assignment.AgentSettingValues.Parse(group?.AgentSettingsJson)" EditHref="@(group is null ? null : key => SettingHref(group.Id, key))" Help="groups#agent-settings" />
                </div>
                <fieldset class="preview">
                    <legend>Applies to (@DisplayNumber.Format(_memberNames.Count) @(_memberNames.Count == 1 ? "server" : "servers"))</legend>
                    @if (_memberNames.Count == 0)
                    {
                        <p class="help">No member yet: add servers in the server list (Assign) or create an assignment rule for this group.</p>
                    }
                    else
                    {
                        <ul class="plain">@foreach (var (id, name) in _memberNames.Take(15)) { <li><a href="/servers/@id">@name</a></li> }</ul>
                        @if (_memberNames.Count > 15) { <p class="help">and @(_memberNames.Count - 15) more.</p> }
                    }
                    <p class="help">Saving changes maintenance windows, restarts, coordination and agent settings of these servers with their next heartbeat; a value set on a server itself wins.</p>
                </fieldset>
            </div>
            <div class="dialog-foot"><a class="btn" href="@Path">Cancel</a><button type="submit" class="primary">@(group is null ? "Create group" : "Save")</button></div>
        </form>
    </Dialog>
}
else if (_dialog == "agent-setting" && Editing is { } settingGroup && SUSyphos.Contracts.Agents.AgentSettings.Find(SettingKey) is { } settingDefinition)
{
    var inherited = AgentSettingValues.Explain(_systemAgentSettings, [], new Dictionary<string, string>(), "this group").First(e => e.Definition.Key == settingDefinition.Key);
    <AgentSettingDialog Definition="settingDefinition" Scope="@($"group {settingGroup.Name}")" Own="@AgentSettingValues.Parse(settingGroup.AgentSettingsJson).GetValueOrDefault(settingDefinition.Key)"
                        InheritedValue="@inherited.Value" InheritedSource="@inherited.Source" CancelHref="@EditGroupHref(settingGroup.Id)" Error="@_settingError" Help="groups#agent-settings" OnSave="SaveSettingAsync" />
}
else if (_dialog == "delete" && Editing is { } doomed)
{
    <Dialog Title="@($"Delete group {doomed.Name}?")" CloseHref="@Path" Help="groups#list">
        <form method="post" @formname="group-dialog" @onsubmit="SaveAsync">
            <AntiforgeryToken />
            <input type="hidden" name="Mode" value="delete" />
            <input type="hidden" name="Id" value="@doomed.Id" />
            <div class="dialog-body"><p>Members leave the group and fall back to the system default; assignment rules pointing to this group are removed too.</p></div>
            <div class="dialog-foot"><a class="btn" href="@Path">Cancel</a><button type="submit" class="danger">Delete group</button></div>
        </form>
    </Dialog>
}

@* Resets one agent setting of the group in the edit dialog; its buttons sit in the group form but belong to this form. *@
<form id="agent-setting-reset" method="post" @formname="agent-setting-reset" @onsubmit="ResetSettingAsync" class="detached">
    <AntiforgeryToken />
    <input type="hidden" name="GroupId" value="@DialogId" />
</form>

@code {
    private const string Path = "/administration/groups";

    private string? _settingError;

    [SupplyParameterFromQuery(Name = "key")]
    private string? SettingKey { get; set; }

    private static string EditGroupHref(int groupId) => string.Create(System.Globalization.CultureInfo.InvariantCulture, $"{Path}?dialog=edit&id={groupId}");

    private static string SettingHref(int groupId, string key) => string.Create(System.Globalization.CultureInfo.InvariantCulture, $"{Path}?dialog=agent-setting&id={groupId}&key={Uri.EscapeDataString(key)}");

    private async Task SaveSettingAsync()
    {
        var form = HttpContext?.Request.HasFormContentType == true ? HttpContext.Request.Form : null;
        var key = form?["SettingKey"].ToString();
        if (Editing is not { } group || form is null || string.IsNullOrEmpty(key))
        {
            ShowResult("Invalid request.", string.Empty);
            await LoadAsync();
            return;
        }

        var value = form["Inherit"] == "yes" ? null : form["Value"].ToString();
        var outcome = await Administration.SetGroupAgentSettingAsync(group.Id, key, value, await GetActorAsync(), CancellationToken.None);
        if (outcome.Succeeded)
        {
            Navigation.NavigateTo(EditGroupHref(group.Id));
            return;
        }

        _settingError = outcome.Error;
        _dialog = "agent-setting";
        await LoadAsync();
    }

    private async Task ResetSettingAsync()
    {
        var form = HttpContext?.Request.HasFormContentType == true ? HttpContext.Request.Form : null;
        var key = form?["ResetKey"].ToString();
        if (Editing is not { } group || string.IsNullOrEmpty(key))
        {
            ShowResult("Invalid request.", string.Empty);
            await LoadAsync();
            return;
        }

        var outcome = await Administration.SetGroupAgentSettingAsync(group.Id, key, null, await GetActorAsync(), CancellationToken.None);
        if (outcome.Succeeded)
        {
            Navigation.NavigateTo(EditGroupHref(group.Id));
            return;
        }

        ShowResult(outcome.Error, string.Empty);
        await LoadAsync();
    }

    private Dictionary<string, string> _systemAgentSettings = [];

    private IReadOnlyList<(SUSyphos.Contracts.Agents.AgentSettingDefinition Definition, string Value, string Source)> GroupAgentSettings(GroupEntity? group) =>
        SUSyphos.Server.Assignment.AgentSettingValues.Explain(_systemAgentSettings, [], SUSyphos.Server.Assignment.AgentSettingValues.Parse(group?.AgentSettingsJson), "this group");

    [SupplyParameterFromForm(FormName = "group-dialog")]
    private string? Mode { get; set; }

    [SupplyParameterFromForm(FormName = "group-dialog")]
    private string? Id { get; set; }

    [SupplyParameterFromForm(FormName = "group-dialog")]
    private string? Name { get; set; }

    [SupplyParameterFromForm(FormName = "group-dialog")]
    private string? Description { get; set; }

    [SupplyParameterFromForm(FormName = "group-dialog")]
    private string? Reboot { get; set; }

    [SupplyParameterFromForm(FormName = "group-dialog")]
    private string? AutomaticUpdates { get; set; }

    [SupplyParameterFromForm(FormName = "group-dialog")]
    private string? MicrosoftUpdate { get; set; }

    [SupplyParameterFromForm(FormName = "group-dialog")]
    private string? Coordinated { get; set; }

    [SupplyParameterFromForm(FormName = "group-dialog")]
    private string? Percent { get; set; }

    [SupplyParameterFromForm(FormName = "group-dialog")]
    private string? Max { get; set; }

    [SupplyParameterFromQuery(Name = "dialog")]
    private string? DialogName { get; set; }

    [SupplyParameterFromQuery(Name = "id")]
    private string? DialogId { get; set; }

    [CascadingParameter]
    private Microsoft.AspNetCore.Http.HttpContext? HttpContext { get; set; }

    [Inject]
    private AssignmentService Assignment { get; set; } = default!;

    private string? _dialog;

    /// <summary>Members of the group in the edit dialog, for the preview of what a change affects.</summary>
    private List<(Guid Id, string Name)> _memberNames = [];
    private List<GroupEntity> _groups = [];
    private Dictionary<int, int> _members = [];
    private TableQuery _table = default!;
    private TablePage<GroupEntity> _page = default!;
    private IReadOnlyList<TableColumn<GroupEntity>>? _columns;

    private IReadOnlyList<TableColumn<GroupEntity>> Columns => _columns ??=
    [
        new("name", "Name", g => g.Name),
        new("description", "Description", g => g.Description, Sortable: false),
        new("members", "Members", g => _members.GetValueOrDefault(g.Id), g => [_members.GetValueOrDefault(g.Id) > 0 ? "With members" : "Empty"], Class: "n"),
        new("windows", "Maintenance windows", g => (MaintenanceWindowFormat.FromJson(g.MaintenanceWindowsJson) ?? []).Count > 0 ? "own" : "system default", g => [(MaintenanceWindowFormat.FromJson(g.MaintenanceWindowsJson) ?? []).Count > 0 ? "Own windows" : "System default"], Sortable: false),
        new("reboots", "Reboots", g => g.RebootPolicy is { } policy ? RebootPolicyText.Label(policy) : "inherit", g => [g.RebootPolicy is { } policy ? RebootPolicyText.Label(policy) : "inherit"]),
        new("coordination", "Coordination", g => g.Coordinated, g => [!g.Coordinated ? "Not coordinated" : g.LeasesHalted ? "Stopped" : "Coordinated"]),
    ];
    private IReadOnlyList<SUSyphos.Contracts.Agents.MaintenanceWindow> _systemWindows = [];

    private GroupEntity? Editing => int.TryParse(DialogId, System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out var id) ? _groups.FirstOrDefault(g => g.Id == id) : null;

    protected override async Task OnInitializedAsync()
    {
        _dialog = DialogName;
        await LoadAsync();
    }

    private async Task SaveAsync()
    {
        var actor = await GetActorAsync();
        var invariant = System.Globalization.CultureInfo.InvariantCulture;
        var form = HttpContext?.Request.HasFormContentType == true ? HttpContext.Request.Form : null;
        Outcome outcome;
        string success;
        if (Mode == "delete" && int.TryParse(Id, System.Globalization.NumberStyles.None, invariant, out var deleteId))
        {
            (outcome, success) = (await Administration.DeleteGroupAsync(deleteId, actor, CancellationToken.None), "The group was deleted.");
        }
        else if (Mode is "create" or "edit" && form is not null && WindowPickerForm.ReadEdit(form, "Windows") is { } draft)
        {
            // Add, remove and preview of the picker show the dialog again without saving.
            _windowDraft = draft;
            _dialog = DialogName;
            await LoadAsync();
            return;
        }
        else if (Mode is "create" or "edit" && form is not null)
        {
            var windows = WindowPickerForm.Read(form, "Windows", out _);
            if (!RebootPolicyText.TryParse(Reboot, out var reboot))
            {
                outcome = new Outcome("The reboot policy is invalid.");
            }
            else if (AutomaticUpdates is not (null or "" or "leave" or "prevent"))
            {
                outcome = new Outcome("The Automatic Updates setting is invalid.");
            }
            else if (MicrosoftUpdate is not (null or "" or "windows" or "microsoft"))
            {
                outcome = new Outcome("The Microsoft Update setting is invalid.");
            }
            else if (!int.TryParse(Percent, System.Globalization.NumberStyles.None, invariant, out var percent) || !int.TryParse(Max, System.Globalization.NumberStyles.None, invariant, out var maximum))
            {
                outcome = new Outcome("Share and maximum must be whole numbers.");
            }
            else
            {
                int? groupId = null;
                if (Mode == "create")
                {
                    outcome = await Administration.CreateGroupAsync(Name?.Trim(), Description, windows, actor, CancellationToken.None);
                    if (outcome.Succeeded)
                    {
                        groupId = await Db.Groups.Where(g => g.Name == Name!.Trim()).Select(g => (int?)g.Id).SingleOrDefaultAsync();
                    }
                }
                else
                {
                    groupId = int.TryParse(Id, System.Globalization.NumberStyles.None, invariant, out var editId) ? editId : null;
                    outcome = groupId is { } id
                        ? await Administration.SetGroupWindowsAsync(id, windows, actor, CancellationToken.None)
                        : new Outcome("Invalid request.");
                    if (outcome.Succeeded && groupId is { } described)
                    {
                        outcome = await Administration.SetGroupDescriptionAsync(described, Description, actor, CancellationToken.None);
                    }
                }

                if (outcome.Succeeded && groupId is { } target)
                {
                    outcome = await Administration.SetGroupRebootPolicyAsync(target, reboot, actor, CancellationToken.None);
                }

                if (outcome.Succeeded && groupId is { } automaticGroup)
                {
                    bool? manage = AutomaticUpdates switch { "prevent" => true, "leave" => false, _ => null };
                    outcome = await Administration.SetGroupManageAutomaticUpdatesAsync(automaticGroup, manage, actor, CancellationToken.None);
                }

                if (outcome.Succeeded && groupId is { } sourceGroup)
                {
                    bool? use = MicrosoftUpdate switch { "microsoft" => true, "windows" => false, _ => null };
                    outcome = await Administration.SetGroupMicrosoftUpdateAsync(sourceGroup, use, actor, CancellationToken.None);
                }

                if (outcome.Succeeded && groupId is { } coordinatedGroup)
                {
                    outcome = await Administration.SetGroupCoordinationAsync(coordinatedGroup, Coordinated == "true", percent, maximum, actor, CancellationToken.None);
                }
            }

            success = Mode == "create" ? "The group was created." : "The group was saved.";
        }
        else
        {
            (outcome, success) = (new Outcome("Invalid request."), string.Empty);
        }

        ShowResult(outcome.Error, success);
        _dialog = outcome.Succeeded ? null : DialogName;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _groups = await Db.Groups.AsNoTracking().OrderBy(g => g.Name).ToListAsync();
        _systemAgentSettings = await Administration.GetSystemAgentSettingsAsync(CancellationToken.None);
        _members = await Db.ClientGroups.AsNoTracking().GroupBy(m => m.GroupId).Select(g => new { g.Key, Count = g.Count() }).ToDictionaryAsync(g => g.Key, g => g.Count);
        _memberNames = Editing is { } editing
            ? [.. (await Db.ClientGroups.AsNoTracking().Where(m => m.GroupId == editing.Id).Join(Db.Clients, m => m.ClientId, c => c.Id, (m, c) => new { c.Id, c.HostName }).OrderBy(c => c.HostName).Take(1000).ToListAsync()).Select(c => (c.Id, c.HostName))]
            : [];
        _table = TableQuery.From(Navigation, "name");
        _page = TablePaging.Apply(_groups, _table, Columns, g => $"{g.Name} {g.Description}");
        _systemWindows = await Assignment.GetSystemWindowsAsync(CancellationToken.None);
    }

    private WindowPickerState? _windowDraft;
}
