@page "/administration/groups"
@attribute [Authorize(Policy = AdminRoles.Policies.Administer)]
@inherits DashboardPageBase
@using SUSyphos.Server.Assignment
@inject ServerDbContext Db
@inject AssignmentAdministration Administration
@inject NavigationManager Navigation
@inject SUSyphos.Server.Assignment.SchedulePreview Preview

<PageTitle>Server groups</PageTitle>

<PageHeader Title="Server groups" Icon="@PageIcons.ServerGroups" Subtitle="Server groups bundle servers, e.g. domain controllers or a cluster, with their own maintenance windows, reboot policy and coordination. Without settings, members use the system default." Help="groups" Crumbs="@([("Administration", null), ("Server groups", null)])" />
<StatusMessage Text="@Message" IsError="@MessageIsError" />

<ActionBand>
    <a class="btn primary" href="@Path?dialog=new"><Icon Name="plus" Size="16" />New group</a>
</ActionBand>

<Box Title="Server groups" Help="groups#list" Hint="A new group is empty: add servers in the server list (select, then Add to group) or on a server's page, or let an assignment rule add them" Flush="true">
    <ListTable Table="_table" Page="_page" Columns="Columns" Search="Search name or description" Noun="groups" Empty="No group yet." ExtraColumns="1">
        <ExtraHeader><th class="n">Actions</th></ExtraHeader>
        <Row Context="group">
                    @{
                        var windows = MaintenanceWindowFormat.FromJson(group.MaintenanceWindowsJson) ?? [];
                    }
                    <tr>
                        <td><a href="@GroupPage.Link(group.Id)">@group.Name</a></td>
                        <td>@group.Description</td>
                        <td class="n">@if (_members.GetValueOrDefault(group.Id) is > 0 and var members) { <a href="@Servers.Link("group", group.Name)" title="Show the members in the server list">@members</a> } else { <span class="note">none yet: <a href="/servers">add servers</a> or <a href="@($"/administration/rules?dialog=new&target=group:{group.Id}")">create a rule</a></span> }</td>
                        <td>@if (windows.Count > 0) { <span class="pill neutral" title="@WindowPickerForm.Describe(windows)">@DisplayNumber.Count(windows.Count, "window", "windows")</span> } else { <span class="pill neutral inherited">inherited</span> }</td>
                        <td>@if (group.RebootPolicy is { } policy) { <span class="pill neutral">@RebootPolicyText.Label(policy)</span> } else { <span class="pill neutral inherited">inherited</span> }</td>
                        <td>@if (group.Coordinated) { <span class="pill ok">Coordinated</span><div class="note">@group.LeasePercent %, at most @group.LeaseMaximum at once</div> } else { <span class="pill neutral">Not coordinated</span> }</td>
                        <td>@if (group.LeasesHalted) { <span class="pill fail">Stopped</span> } else if (_holders.GetValueOrDefault(group.Id) is { Count: > 0 } holders) { <span class="pill pend">@holders[0].HostName holds the lease</span><div class="note">until @DisplayTime.Format(holders[0].ExpiresAtUtc)</div> } else { <span class="note">–</span> }</td>
                        <td class="n"><span class="row-actions">
                            <a class="btn icon-button" href="@GroupPage.Link(group.Id)" title="Open @group.Name" aria-label="Open @group.Name" data-help-term="Edit"><Icon Name="pencil" Size="16" /></a>
                            <ActionMenu Label="More" Icon="ellipsis" Compact="true" Align="right" Title="@($"More for {group.Name}")">
                                <MenuItem Href="@Servers.Link("group", group.Name)" Icon="server">Show members</MenuItem>
                                <MenuItem Href="@($"{Path}?dialog=preview&id={group.Id}")" Icon="calendar-clock">Next @SUSyphos.Server.Assignment.SchedulePreview.Days days</MenuItem>
                                @if (group.LeasesHalted)
                                {
                                    <MenuItem Name="ResumeGroup" Value="@group.Id.ToString(System.Globalization.CultureInfo.InvariantCulture)" Form="group-resume" Icon="play">Resume group</MenuItem>
                                }
                                <MenuSeparator />
                                <MenuItem Href="@($"{Path}?dialog=delete&id={group.Id}")" Icon="trash-2" Danger="true">Delete group…</MenuItem>
                            </ActionMenu>
                        </span></td>
                    </tr>
        </Row>
    </ListTable>
</Box>

@if (_dialog == "new")
{
    <Dialog Title="New group" CloseHref="@Path" Help="groups#dialog">
        <form method="post" @formname="group-dialog" @onsubmit="SaveAsync">
            <AntiforgeryToken />
            <input type="hidden" name="Mode" value="create" />
            <div class="dialog-body form">
                @if (MessageIsError)
                {
                    <p class="error" role="alert">@Message</p>
                }
                <label class="field"><span>Name</span><input name="Name" maxlength="64" required value="@Name" /></label>
                <label class="field"><span>Description</span><input name="Description" maxlength="256" value="@Description" /></label>
                <label class="check"><input type="checkbox" name="Coordinated" value="true" checked="@(Coordinated == "true")" /> Coordinated: only part of the group installs and restarts at the same time (25 %, at most 1 at once; changeable on the group page)</label>
                <p class="help">Windows, reboots and agent settings start as inherited. After creating, the group page opens: add the members and set what differs there.</p>
            </div>
            <div class="dialog-foot"><a class="btn" href="@Path">Cancel</a><button type="submit" class="primary">Create and open</button></div>
        </form>
    </Dialog>
}
else if (_dialog == "preview" && _schedulePreview is not null)
{
    <SchedulePreviewDialog Preview="@_schedulePreview" CloseHref="@Path" />
}
else if (_dialog == "delete" && Editing is { } doomed)
{
    <Dialog Title="@($"Delete group {doomed.Name}?")" CloseHref="@Path" Help="groups#list">
        <form method="post" @formname="group-dialog" @onsubmit="SaveAsync">
            <AntiforgeryToken />
            <input type="hidden" name="Mode" value="delete" />
            <input type="hidden" name="Id" value="@doomed.Id" />
            <div class="dialog-body"><p>Members leave the group and fall back to the system default; assignment rules pointing to this group are removed too.</p></div>
            <div class="dialog-foot"><a class="btn" href="@Path">Cancel</a><button type="submit" class="danger">Delete group</button></div>
        </form>
    </Dialog>
}

<form id="group-resume" method="post" @formname="group-resume" @onsubmit="ResumeAsync" class="detached"><AntiforgeryToken /></form>

@code {
    private const string Path = "/administration/groups";

    [SupplyParameterFromForm(FormName = "group-dialog")]
    private string? Mode { get; set; }

    [SupplyParameterFromForm(FormName = "group-dialog")]
    private string? Id { get; set; }

    [SupplyParameterFromForm(FormName = "group-dialog")]
    private string? Name { get; set; }

    [SupplyParameterFromForm(FormName = "group-dialog")]
    private string? Description { get; set; }

    [SupplyParameterFromForm(FormName = "group-dialog")]
    private string? Coordinated { get; set; }

    [SupplyParameterFromForm(FormName = "group-resume")]
    private string? ResumeGroup { get; set; }

    [SupplyParameterFromQuery(Name = "dialog")]
    private string? DialogName { get; set; }

    [SupplyParameterFromQuery(Name = "id")]
    private string? DialogId { get; set; }

    [Inject]
    private LeaseService Leases { get; set; } = default!;

    private string? _dialog;
    private List<GroupEntity> _groups = [];
    private Dictionary<int, int> _members = [];
    private Dictionary<int, List<LeaseHolder>> _holders = [];
    private TableQuery _table = default!;
    private TablePage<GroupEntity> _page = default!;
    private IReadOnlyList<TableColumn<GroupEntity>>? _columns;

    private IReadOnlyList<TableColumn<GroupEntity>> Columns => _columns ??=
    [
        new("name", "Name", g => g.Name),
        new("description", "Description", g => g.Description, Sortable: false),
        new("members", "Members", g => _members.GetValueOrDefault(g.Id), g => [_members.GetValueOrDefault(g.Id) > 0 ? "With members" : "Empty"], Class: "n"),
        new("windows", "Maintenance windows", g => (MaintenanceWindowFormat.FromJson(g.MaintenanceWindowsJson) ?? []).Count > 0 ? "own" : "inherited", g => [(MaintenanceWindowFormat.FromJson(g.MaintenanceWindowsJson) ?? []).Count > 0 ? "Own windows" : "Inherited"], Sortable: false),
        new("reboots", "Reboots", g => g.RebootPolicy is { } policy ? RebootPolicyText.Label(policy) : "inherited", g => [g.RebootPolicy is { } policy ? RebootPolicyText.Label(policy) : "Inherited"]),
        new("coordination", "Coordination", g => g.Coordinated, g => [g.Coordinated ? "Coordinated" : "Not coordinated"]),
        new("state", "State", g => g.LeasesHalted ? 0 : _holders.ContainsKey(g.Id) ? 1 : 2, g => [g.LeasesHalted ? "Stopped" : _holders.ContainsKey(g.Id) ? "Lease held" : "Free"]),
    ];

    private GroupEntity? Editing => int.TryParse(DialogId, System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out var id) ? _groups.FirstOrDefault(g => g.Id == id) : null;

    protected override async Task OnInitializedAsync()
    {
        _dialog = DialogName;
        await LoadAsync();
    }

    /// <summary>Creates a group with name, description and coordination and opens its page, or deletes one.</summary>
    private async Task SaveAsync()
    {
        var actor = await GetActorAsync();
        Outcome outcome;
        string success;
        if (Mode == "delete" && int.TryParse(Id, System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out var deleteId))
        {
            (outcome, success) = (await Administration.DeleteGroupAsync(deleteId, actor, CancellationToken.None), "The group was deleted.");
        }
        else if (Mode == "create")
        {
            outcome = await Administration.CreateGroupAsync(Name?.Trim(), Description, null, actor, CancellationToken.None);
            var groupId = outcome.Succeeded ? await Db.Groups.Where(g => g.Name == Name!.Trim()).Select(g => (int?)g.Id).SingleOrDefaultAsync() : null;
            if (outcome.Succeeded && groupId is { } created && Coordinated == "true")
            {
                outcome = await Administration.SetGroupCoordinationAsync(created, true, 25, 1, actor, CancellationToken.None);
            }

            if (outcome.Succeeded && groupId is { } opened)
            {
                Navigation.NavigateTo(GroupPage.Link(opened));
                return;
            }

            success = "The group was created.";
        }
        else
        {
            (outcome, success) = (new Outcome("Invalid request."), string.Empty);
        }

        ShowResult(outcome.Error, success);
        _dialog = outcome.Succeeded ? null : DialogName;
        await LoadAsync();
    }

    private async Task ResumeAsync()
    {
        var outcome = int.TryParse(ResumeGroup, System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out var groupId)
            ? await Leases.ResumeAsync(groupId, await GetActorAsync(), CancellationToken.None)
            : new Outcome("Invalid request.");
        ShowResult(outcome.Error, "The group was resumed; its servers get leases again.");
        await LoadAsync();
    }

    private SUSyphos.Server.Assignment.SchedulePreviewResult? _schedulePreview;

    private async Task LoadAsync()
    {
        _schedulePreview = _dialog == "preview" && int.TryParse(DialogId, System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out var previewId) ? await Preview.ForGroupAsync(previewId, CancellationToken.None) : null;
        _groups = await Db.Groups.AsNoTracking().OrderBy(g => g.Name).ToListAsync();
        _members = await Db.ClientGroups.AsNoTracking().GroupBy(m => m.GroupId).Select(g => new { g.Key, Count = g.Count() }).ToDictionaryAsync(g => g.Key, g => g.Count);
        _holders = await GroupLeaseStatus.HoldersAsync(Db, null, CancellationToken.None);
        _table = TableQuery.From(Navigation, "name");
        _page = TablePaging.Apply(_groups, _table, Columns, g => $"{g.Name} {g.Description}");
    }
}