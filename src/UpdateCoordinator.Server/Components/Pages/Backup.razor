@page "/administration/backup"
@attribute [Authorize(Policy = AdminRoles.Policies.Administer)]

<PageTitle>Backup</PageTitle>

<PageHeader Title="Backup" Subtitle="Database and trust anchor in one archive, encrypted with your password" Crumbs="@([("Administration", null), ("Backup", null)])" />

@if (Error is { Length: > 0 and <= 300 })
{
    <p class="error" role="alert">@Error</p>
}

<Box Title="What the backup contains">
<p>
    The backup archive contains a consistent copy of the database (servers, history, rules, accounts, audit log) and the trust anchor,
    encrypted with the password you choose. Keep archive and password apart: with both, a central server can be restored on new hardware
    and every agent keeps trusting it; without the password the trust anchor cannot be used.
</p>
</Box>

<section class="card">
    <h2>Download a backup</h2>
    <form method="post" action="@BackupEndpoints.Route">
        <AntiforgeryToken />
        <label>Backup password (at least @BackupService.MinimumPasswordLength characters) <input name="password" type="password" autocomplete="new-password" required minlength="@BackupService.MinimumPasswordLength" /></label>
        <label>Repeat password <input name="passwordRepeat" type="password" autocomplete="new-password" required /></label>
        <button type="submit" class="primary">Create and download</button>
    </form>
</section>

<section class="card">
    <h2>Restore</h2>
    <p>
        Install the central server, stop its service, then run as administrator in the installation folder:
    </p>
    <pre>UpdateCoordinator.Server.exe restore &lt;backup.zip&gt;</pre>
    <p>
        It asks for the backup password (or reads it from the environment variable <code>UPDATECOORDINATOR_BACKUP_PASSWORD</code>),
        checks the archive and only then replaces the database and the trust anchor. Start the service afterwards.
    </p>
</section>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }
}
