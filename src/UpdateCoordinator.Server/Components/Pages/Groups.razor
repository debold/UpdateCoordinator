@page "/administration/groups"
@attribute [Authorize(Policy = AdminRoles.Policies.Administer)]
@inherits DashboardPageBase
@using UpdateCoordinator.Server.Assignment
@inject ServerDbContext Db
@inject AssignmentAdministration Administration

<PageTitle>Groups</PageTitle>

<h1>Groups</h1>
<StatusMessage Text="@Message" IsError="@MessageIsError" />

<p>Groups bundle servers, e.g. domain controllers, and may have their own maintenance windows (one per line, e.g. "Mon-Fri 19:00-05:00") and reboot policy. Without them, members use the system default.</p>

<form method="post" @formname="groups" @onsubmit="HandleAsync">
    <AntiforgeryToken />
    <table>
        <thead>
            <tr><th>Name</th><th>Description</th><th>Members</th><th>Maintenance windows</th><th>Reboots</th><th>Coordination (leases)</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var group in _groups)
            {
                <tr>
                    <td>@group.Name</td>
                    <td>@group.Description</td>
                    <td>@_members.GetValueOrDefault(group.Id)</td>
                    <td><textarea name="Windows_@group.Id" rows="2">@MaintenanceWindowFormat.Format(MaintenanceWindowFormat.FromJson(group.MaintenanceWindowsJson) ?? [])</textarea></td>
                    <td>
                        <select name="Reboot_@group.Id" aria-label="Reboot policy of @group.Name">
                            <option value="" selected="@(group.RebootPolicy is null)">Inherit</option>
                            @foreach (var policy in Enum.GetValues<UpdateCoordinator.Contracts.Agents.RebootPolicy>())
                            {
                                <option value="@policy" selected="@(group.RebootPolicy == policy)">@RebootPolicyText.Label(policy)</option>
                            }
                        </select>
                    </td>
                    <td>
                        <label class="inline"><input type="checkbox" name="Coordinated_@group.Id" value="true" checked="@group.Coordinated" /> coordinated</label>
                        <label class="inline">% <input name="Percent_@group.Id" type="number" min="1" max="100" value="@group.LeasePercent" aria-label="Share of members at once" /></label>
                        <label class="inline">max <input name="Max_@group.Id" type="number" min="1" max="1000" value="@group.LeaseMaximum" aria-label="Most members at once" /></label>
                        @if (group.LeasesHalted)
                        {
                            <span class="pill fail">Stopped</span>
                        }
                    </td>
                    <td class="actions">
                        <button type="submit" name="Action" value="save:@group.Id">Save</button>
                        <button type="submit" name="Action" value="delete:@group.Id">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <h2>New group</h2>
    <label>Name <input name="NewName" maxlength="64" /></label>
    <label>Description <input name="NewDescription" maxlength="256" /></label>
    <label>Maintenance windows <textarea name="NewWindows" rows="2"></textarea></label>
    <button type="submit" name="Action" value="create">Create group</button>
</form>

@code {
    [SupplyParameterFromForm(FormName = "groups")]
    private string? Action { get; set; }

    [SupplyParameterFromForm(FormName = "groups")]
    private string? NewName { get; set; }

    [SupplyParameterFromForm(FormName = "groups")]
    private string? NewDescription { get; set; }

    [SupplyParameterFromForm(FormName = "groups")]
    private string? NewWindows { get; set; }

    [CascadingParameter]
    private Microsoft.AspNetCore.Http.HttpContext? HttpContext { get; set; }

    private List<GroupEntity> _groups = [];
    private Dictionary<int, int> _members = [];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task HandleAsync()
    {
        var actor = await GetActorAsync();
        var parts = Action?.Split(':', 2) ?? [];
        Outcome outcome;
        string success;
        if (parts is ["create"])
        {
            outcome = await Administration.CreateGroupAsync(NewName?.Trim(), NewDescription, NewWindows, actor, CancellationToken.None);
            success = "The group was created.";
        }
        else if (parts is ["save", var saveId] && int.TryParse(saveId, System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out var groupId))
        {
            var windows = HttpContext?.Request.HasFormContentType == true ? HttpContext.Request.Form[$"Windows_{groupId}"].ToString() : null;
            var rebootValue = HttpContext?.Request.HasFormContentType == true ? HttpContext.Request.Form[$"Reboot_{groupId}"].ToString() : null;
            outcome = !RebootPolicyText.TryParse(rebootValue, out var reboot)
                ? new Outcome("The reboot policy is invalid.")
                : await Administration.SetGroupWindowsAsync(groupId, windows, actor, CancellationToken.None);
            if (outcome.Succeeded)
            {
                outcome = await Administration.SetGroupRebootPolicyAsync(groupId, reboot, actor, CancellationToken.None);
            }

            var form = HttpContext?.Request.HasFormContentType == true ? HttpContext.Request.Form : null;
            if (outcome.Succeeded && form is not null && form.ContainsKey($"Percent_{groupId}"))
            {
                var invariant = System.Globalization.CultureInfo.InvariantCulture;
                outcome = int.TryParse(form[$"Percent_{groupId}"].ToString(), System.Globalization.NumberStyles.None, invariant, out var percent)
                    && int.TryParse(form[$"Max_{groupId}"].ToString(), System.Globalization.NumberStyles.None, invariant, out var maximum)
                    ? await Administration.SetGroupCoordinationAsync(groupId, form[$"Coordinated_{groupId}"].ToString() == "true", percent, maximum, actor, CancellationToken.None)
                    : new Outcome("Share and maximum must be whole numbers.");
            }

            success = "The group settings were saved.";
        }
        else if (parts is ["delete", var deleteId] && int.TryParse(deleteId, System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out var deleteGroupId))
        {
            outcome = await Administration.DeleteGroupAsync(deleteGroupId, actor, CancellationToken.None);
            success = "The group was deleted.";
        }
        else
        {
            outcome = new Outcome("Invalid request.");
            success = string.Empty;
        }

        ShowResult(outcome.Error, success);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _groups = await Db.Groups.AsNoTracking().OrderBy(g => g.Name).ToListAsync();
        _members = await Db.ClientGroups.AsNoTracking().GroupBy(m => m.GroupId).Select(g => new { g.Key, Count = g.Count() }).ToDictionaryAsync(g => g.Key, g => g.Count);
    }
}
