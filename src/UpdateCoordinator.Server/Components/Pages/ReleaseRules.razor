@page "/administration/release-rules"
@attribute [Authorize(Policy = AdminRoles.Policies.Administer)]
@inherits DashboardPageBase
@using UpdateCoordinator.Server.Rollouts
@inject ServerDbContext Db
@inject RolloutAdministration Administration

<PageTitle>Release rules</PageTitle>

<h1>Release rules</h1>
<StatusMessage Text="@Message" IsError="@MessageIsError" />

<h2>Ring transitions</h2>
<p>
    The next ring gets an update when the minimum wait time has passed, enough servers reported (feedback rate) and enough of the reports
    were successful (success rate). At the maximum wait time a good success rate is enough. A poor success rate raises an alarm instead.
    With a manual gate, an operator approves the transition under Pending approvals.
</p>

<form method="post" @formname="transition" @onsubmit="SaveTransitionAsync">
    <AntiforgeryToken />
    <table>
        <thead>
            <tr><th>Transition</th><th>Minimum wait (days)</th><th>Maximum wait (days)</th><th>Feedback rate (%)</th><th>Success rate (%)</th><th>Manual gate</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var transition in _transitions)
            {
                var id = transition.FromRingId;
                <tr>
                    <td>@RingName(id) → @NextRingName(id)</td>
                    <td><input name="MinWait_@id" type="number" min="0" max="@RingTransitionEntity.MaxWaitDays" value="@((int)transition.MinimumWait.TotalDays)" /></td>
                    <td><input name="MaxWait_@id" type="number" min="0" max="@RingTransitionEntity.MaxWaitDays" value="@((int)transition.MaximumWait.TotalDays)" /></td>
                    <td><input name="Feedback_@id" type="number" min="0" max="100" value="@transition.MinimumFeedbackPercent" /></td>
                    <td><input name="Success_@id" type="number" min="0" max="100" value="@transition.MinimumSuccessPercent" /></td>
                    <td><input name="Gate_@id" type="checkbox" value="true" checked="@transition.ManualGate" /></td>
                    <td><button type="submit" name="FromRing" value="@id">Save</button></td>
                </tr>
            }
        </tbody>
    </table>
</form>

<h2>Start rules</h2>
<p>
    Decide how a newly reported update enters the first ring. The matching rule with the lowest priority number applies; all filled conditions must match,
    a rule without conditions matches every update. "Automatic" starts the rollout, optionally with a delay before servers of the first ring may install it;
    "Manual" keeps the update queued until an operator starts it. Without a matching rule the update stays queued.
</p>

<form method="post" @formname="startrules" @onsubmit="HandleStartRuleAsync">
    <AntiforgeryToken />
    <table>
        <thead>
            <tr><th>Priority</th><th>Classification</th><th>Severity</th><th>Title pattern</th><th>Start</th><th>Delay (hours)</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var rule in _startRules)
            {
                <tr>
                    <td>@rule.Priority</td>
                    <td>@(rule.Classification ?? "any")</td>
                    <td>@(rule.MsrcSeverity ?? "any")</td>
                    <td>@(rule.TitlePattern ?? "any")</td>
                    <td>@rule.Mode</td>
                    <td>@((int)rule.Delay.TotalHours)</td>
                    <td><button type="submit" name="StartAction" value="delete:@rule.Id">Delete</button></td>
                </tr>
            }
        </tbody>
    </table>

    <h3>New start rule</h3>
    <label>Priority <input name="StartPriority" type="number" min="0" max="10000" value="100" /></label>
    <label>Classification (e.g. Security Updates) <input name="StartClassification" maxlength="64" /></label>
    <label>Severity (e.g. Critical) <input name="StartSeverity" maxlength="32" /></label>
    <label>Title pattern (* and ? allowed) <input name="StartTitle" maxlength="128" /></label>
    <label>
        Start
        <select name="StartMode">
            <option value="automatic">Automatic</option>
            <option value="manual">Manual</option>
        </select>
    </label>
    <label>Delay (hours) <input name="StartDelay" type="number" min="0" max="@StartRuleEntity.MaxDelayHours" value="0" /></label>
    <button type="submit" name="StartAction" value="create">Create rule</button>
</form>

@code {
    [SupplyParameterFromForm(FormName = "transition")]
    private string? FromRing { get; set; }

    [SupplyParameterFromForm(FormName = "startrules")]
    private string? StartAction { get; set; }

    [SupplyParameterFromForm(FormName = "startrules")]
    private string? StartPriority { get; set; }

    [SupplyParameterFromForm(FormName = "startrules")]
    private string? StartClassification { get; set; }

    [SupplyParameterFromForm(FormName = "startrules")]
    private string? StartSeverity { get; set; }

    [SupplyParameterFromForm(FormName = "startrules")]
    private string? StartTitle { get; set; }

    [SupplyParameterFromForm(FormName = "startrules", Name = "StartMode")]
    private string? StartModeText { get; set; }

    [SupplyParameterFromForm(FormName = "startrules")]
    private string? StartDelay { get; set; }


    [CascadingParameter]
    private Microsoft.AspNetCore.Http.HttpContext? HttpContext { get; set; }

    private List<RingEntity> _rings = [];
    private List<RingTransitionEntity> _transitions = [];
    private List<StartRuleEntity> _startRules = [];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task SaveTransitionAsync()
    {
        var invariant = System.Globalization.CultureInfo.InvariantCulture;
        var form = HttpContext?.Request.HasFormContentType == true ? HttpContext.Request.Form : null;
        int? Number(string name) =>
            form is not null && int.TryParse(form[name].ToString(), System.Globalization.NumberStyles.None, invariant, out var value) ? value : null;

        Outcome outcome;
        if (form is null || !int.TryParse(FromRing, System.Globalization.NumberStyles.None, invariant, out var id)
            || Number($"MinWait_{id}") is not { } minWait || Number($"MaxWait_{id}") is not { } maxWait
            || Number($"Feedback_{id}") is not { } feedback || Number($"Success_{id}") is not { } success)
        {
            outcome = new Outcome("Every value must be a whole number.");
        }
        else
        {
            var gate = form[$"Gate_{id}"].ToString() == "true";
            outcome = await Administration.SetTransitionAsync(id, minWait, maxWait, feedback, success, gate, await GetActorAsync(), CancellationToken.None);
        }

        ShowResult(outcome.Error, "The transition rule was saved.");
        await LoadAsync();
    }


    private async Task HandleStartRuleAsync()
    {
        var invariant = System.Globalization.CultureInfo.InvariantCulture;
        var actor = await GetActorAsync();
        Outcome outcome;
        string success;
        if (StartAction == "create")
        {
            StartMode? mode = StartModeText switch { "automatic" => StartMode.Automatic, "manual" => StartMode.Manual, _ => null };
            if (!int.TryParse(StartPriority, System.Globalization.NumberStyles.None, invariant, out var priority)
                || !int.TryParse(string.IsNullOrEmpty(StartDelay) ? "0" : StartDelay, System.Globalization.NumberStyles.None, invariant, out var delay)
                || mode is null)
            {
                outcome = new Outcome("Priority and delay must be whole numbers and the start mode Automatic or Manual.");
                success = string.Empty;
            }
            else
            {
                outcome = await Administration.CreateStartRuleAsync(priority, StartClassification, StartSeverity, StartTitle, mode.Value, delay, actor, CancellationToken.None);
                success = "The start rule was created.";
            }
        }
        else if (StartAction?.Split(':', 2) is ["delete", var deleteId] && int.TryParse(deleteId, System.Globalization.NumberStyles.None, invariant, out var ruleId))
        {
            outcome = await Administration.DeleteStartRuleAsync(ruleId, actor, CancellationToken.None);
            success = "The start rule was deleted.";
        }
        else
        {
            outcome = new Outcome("Invalid request.");
            success = string.Empty;
        }

        ShowResult(outcome.Error, success);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _rings = await Db.Rings.AsNoTracking().OrderBy(r => r.Order).ToListAsync();
        _transitions = await Db.RingTransitions.AsNoTracking().ToListAsync();
        _transitions = [.. _transitions.OrderBy(t => _rings.FindIndex(r => r.Id == t.FromRingId))];
        _startRules = await Db.StartRules.AsNoTracking().OrderBy(r => r.Priority).ThenBy(r => r.Id).ToListAsync();
    }

    private string RingName(int id) => _rings.FirstOrDefault(r => r.Id == id)?.Name ?? "?";

    private string NextRingName(int id)
    {
        var index = _rings.FindIndex(r => r.Id == id);
        return index >= 0 && index + 1 < _rings.Count ? _rings[index + 1].Name : "?";
    }
}
