<Project Sdk="WixToolset.Sdk/7.0.0">
  <!-- MSI of the central server (docs/admin/README.md, installation). Built from the self-contained publish output, see build/Build-Installers.ps1. -->
  <PropertyGroup>
    <OutputName>UpdateCoordinator.Server</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <!-- Open Source Maintenance Fee EULA of WiX v7 accepted by Marc on 2026-10-19 (no revenue from this project). -->
    <AcceptEula>wix7</AcceptEula>
    <SuppressValidation>false</SuppressValidation>
    <!-- ICE61 flags AllowSameVersionUpgrades, which is intended: rebuilt packages of the same version replace each other. -->
    <!-- ICE60 flags versioned native libraries (e.g. SQLite) that carry no language; they are not language specific. -->
    <!-- ICE38/ICE43/ICE57 treat the Start menu as a user profile; this per-machine package installs to the all-users Start menu with an HKLM key path. -->
    <SuppressIces>ICE61;ICE60;ICE38;ICE43;ICE57</SuppressIces>
    <PublishDir Condition="'$(PublishDir)' == ''">..\..\artifacts\publish\server</PublishDir>
    <ProductVersion Condition="'$(ProductVersion)' == ''">0.0.0</ProductVersion>
    <!-- A new product code for every build. Without it WiX derives the same code for every version, so an "upgrade" becomes
         a reconfiguration of the installed product that looks for the package under its original file name and fails
         when the download was renamed (e.g. "... (1).msi"). -->
    <ProductCode Condition="'$(ProductCode)' == ''">$([System.Guid]::NewGuid().ToString("B").ToUpperInvariant())</ProductCode>
    <DefineConstants>PublishDir=$(PublishDir);ProductVersion=$(ProductVersion);ProductCode=$(ProductCode)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" />
    <PackageReference Include="WixToolset.Firewall.wixext" />
    <PackageReference Include="WixToolset.UI.wixext" />
  </ItemGroup>
</Project>
