<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:fw="http://wixtoolset.org/schemas/v4/wxs/firewall">

  <!--
    Central server installer. Installs the self-contained central server as a Windows service running as LocalSystem.
    CERTTHUMBPRINT selects the TLS certificate in LocalMachine\My (optional: without it the central server creates a
    self-signed one) and HTTPSPORT the port (default 8443); both are kept in HKLM\SOFTWARE\SUSyphos\Server,
    which the central server reads as configuration and upgrades keep.
    The database, trust anchor and logs under %ProgramData%\SUSyphos\Server are kept on uninstall and upgrade.
  -->
  <Package Name="SUSyphos Central Server"
           Manufacturer="SUSyphos"
           Version="$(var.ProductVersion)"
           UpgradeCode="F8E3FCF7-6CF5-4113-8F2A-9CDAD522B559"
           Scope="perMachine"
           InstallerVersion="500"
           Compressed="yes">

    <SummaryInformation Description="SUSyphos central server: rings, releases and dashboard." />
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of the SUSyphos central server is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!--
      Windows Server 2016 (build 14393) or newer. WindowsBuild reports 9600 on every newer Windows (version lie for
      compatibility), so the real build number is read from the registry.
    -->
    <Property Id="CURRENTBUILD">
      <RegistrySearch Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion" Name="CurrentBuildNumber" Type="raw" Bitness="always64" />
    </Property>
    <Launch Condition="Installed OR CURRENTBUILD &gt;= 14393" Message="The SUSyphos central server requires Windows Server 2016 or newer." />

    <!-- Values from the command line win; otherwise an upgrade keeps the installed ones. -->
    <Property Id="CERTTHUMBPRINT" Secure="yes" />
    <Property Id="HTTPSPORT" Secure="yes" />
    <Property Id="INSTALLEDTHUMBPRINT" Secure="yes">
      <RegistrySearch Root="HKLM" Key="SOFTWARE\SUSyphos\Server" Name="CertificateThumbprint" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="INSTALLEDPORT" Secure="yes">
      <RegistrySearch Root="HKLM" Key="SOFTWARE\SUSyphos\Server" Name="HttpsPort" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Id="CERTTHUMBPRINT" Value="[INSTALLEDTHUMBPRINT]" After="AppSearch" Sequence="both" Condition="NOT CERTTHUMBPRINT AND INSTALLEDTHUMBPRINT" />
    <SetProperty Id="HTTPSPORT" Value="[INSTALLEDPORT]" After="AppSearch" Sequence="both" Condition="NOT HTTPSPORT AND INSTALLEDPORT" />
    <SetProperty Id="HTTPSPORT" Action="SetDefaultHttpsPort" Value="8443" After="SetHTTPSPORT" Sequence="both" Condition="NOT HTTPSPORT" />

    <!--
      One-time token for the first administrator, so nobody has to look for the token file: the interactive first
      installation creates it (or SETUPTOKEN comes from the command line), shows it on the port page to copy, opens the
      setup with it from the final page, and hands it to the central server through a registry key that only SYSTEM and
      administrators can read (protected ACL). The central server deletes the key once the first administrator exists.
      Hidden: the value never appears in the installer log.
    -->
    <Property Id="SETUPTOKEN" Secure="yes" Hidden="yes" />
    <Property Id="SETUPTOKENCOPY" Hidden="yes" />
    <Property Id="WixShellExecTarget" Hidden="yes" />
    <Binary Id="InstallerCustomActions" SourceFile="$(var.SUSyphos.Installer.CustomActions.TargetDir)SUSyphos.Installer.CustomActions.CA.dll" />
    <CustomAction Id="CreateSetupToken" BinaryRef="InstallerCustomActions" DllEntry="CreateSetupToken" Return="ignore" />
    <InstallUISequence>
      <Custom Action="CreateSetupToken" After="AppSearch" Condition="NOT Installed AND NOT INSTALLEDPORT" />
    </InstallUISequence>
    <Component Id="SetupToken" Directory="INSTALLFOLDER" Condition="SETUPTOKEN" Guid="6D2A4F81-3B9C-4E57-A0D8-1C7E5B9F2A43">
      <RegistryKey Root="HKLM" Key="SOFTWARE\SUSyphos\Server\Setup" ForceCreateOnInstall="yes">
        <PermissionEx Sddl="D:PAI(A;;KA;;;SY)(A;;KA;;;BA)" />
        <RegistryValue Name="Token" Type="string" Value="[SETUPTOKEN]" KeyPath="yes" />
      </RegistryKey>
    </Component>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="ProductFolder" Name="SUSyphos">
        <Directory Id="INSTALLFOLDER" Name="Server">
          <Directory Id="AgentPackageFolder" Name="agent" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <Feature Id="Server" Title="SUSyphos central server">
      <ComponentGroupRef Id="ServerFiles" />
      <ComponentRef Id="ServerService" />
      <ComponentRef Id="ServerSettings" />
      <ComponentRef Id="ServerCertificate" />
      <ComponentRef Id="ServerServiceStart" />
      <ComponentRef Id="DashboardShortcut" />
      <ComponentRef Id="DashboardShortcutIcon" />
      <ComponentRef Id="SetupToken" />
      <?if $(var.AgentMsi) != "" ?>
      <ComponentRef Id="BundledAgentPackage" />
      <?endif?>
    </Feature>

    <?if $(var.AgentMsi) != "" ?>
    <!-- The agent installer of the same release: offered for download in the dashboard and the first agent package for updates. -->
    <Component Id="BundledAgentPackage" Directory="AgentPackageFolder">
      <File Id="BundledAgentMsi" Source="$(var.AgentMsi)" Name="SUSyphos.Agent-$(var.AgentVersion).msi" KeyPath="yes" />
    </Component>
    <?endif?>

    <ComponentGroup Id="ServerFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\**">
        <Exclude Files="$(var.PublishDir)\SUSyphos.Server.exe" />
        <Exclude Files="$(var.PublishDir)\**\*.pdb" />
        <Exclude Files="$(var.PublishDir)\appsettings.Development.json" />
      </Files>
    </ComponentGroup>

    <Component Id="ServerService" Directory="INSTALLFOLDER">
      <File Id="ServerExe" Source="$(var.PublishDir)\SUSyphos.Server.exe" KeyPath="yes">
        <!-- Agents and administrators connect over HTTPS on the configured port. -->
        <fw:FirewallException Id="ServerHttps" Name="SUSyphos Central Server (HTTPS)" Port="[HTTPSPORT]" Protocol="tcp" Scope="any" />
      </File>
      <ServiceInstall Id="ServerServiceInstall"
                      Name="SUSyphos.Server"
                      DisplayName="SUSyphos Central Server"
                      Description="Coordinates Windows updates of the registered servers: rings, releases, reporting and the web dashboard."
                      Type="ownProcess"
                      Start="auto"
                      Account="LocalSystem"
                      ErrorControl="normal"
                      Vital="yes">
        <util:ServiceConfig FirstFailureActionType="restart" SecondFailureActionType="restart" ThirdFailureActionType="restart"
                            RestartServiceDelayInSeconds="60" ResetPeriodInDays="1" />
      </ServiceInstall>
      <ServiceControl Id="ServerServiceStop" Name="SUSyphos.Server" Stop="both" Remove="uninstall" Wait="yes" />
    </Component>

    <!-- Installer options, read by the central server as configuration (ServerRegistry) and by later upgrades. -->
    <Component Id="ServerSettings" Directory="INSTALLFOLDER" Guid="5E0B9C1A-3F2D-4B8E-A7C6-1D4E9F2B6A30">
      <RegistryValue Root="HKLM" Key="SOFTWARE\SUSyphos\Server" Name="HttpsPort" Type="string" Value="[HTTPSPORT]" KeyPath="yes" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\SUSyphos\Server" Name="HttpsUrl" Type="string" Value="https://*:[HTTPSPORT]" />
    </Component>

    <Component Id="ServerCertificate" Directory="INSTALLFOLDER" Condition="CERTTHUMBPRINT" Guid="0B6E4D2F-9A3C-4E71-8D5B-2C7F1A9E3D60">
      <RegistryValue Root="HKLM" Key="SOFTWARE\SUSyphos\Server" Name="CertificateThumbprint" Type="string" Value="[CERTTHUMBPRINT]" KeyPath="yes" />
    </Component>

    <!-- Always started: without CERTTHUMBPRINT the central server creates and renews a self-signed certificate itself. -->
    <Component Id="ServerServiceStart" Directory="INSTALLFOLDER" Guid="8C3D7E52-1A9B-4F0C-B6D2-7E5A3C9F1B48">
      <RegistryValue Root="HKLM" Key="SOFTWARE\SUSyphos\Server" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
      <ServiceControl Id="ServerServiceStartControl" Name="SUSyphos.Server" Start="install" Wait="no" />
    </Component>

    <!--
      Address of this machine for the Start menu link and the final page: the DNS host name and primary DNS suffix as
      Windows keeps them for TCP/IP (the fully qualified name), or the computer name when they are missing.
    -->
    <Property Id="DNSHOSTNAME">
      <RegistrySearch Root="HKLM" Key="SYSTEM\CurrentControlSet\Services\Tcpip\Parameters" Name="Hostname" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="DNSDOMAIN">
      <RegistrySearch Root="HKLM" Key="SYSTEM\CurrentControlSet\Services\Tcpip\Parameters" Name="Domain" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Id="DASHBOARDHOST" Value="[ComputerName]" After="AppSearch" Sequence="both" Condition="NOT DNSHOSTNAME" />
    <SetProperty Action="SetDashboardHostName" Id="DASHBOARDHOST" Value="[DNSHOSTNAME]" After="SetDASHBOARDHOST" Sequence="both" Condition="DNSHOSTNAME" />
    <SetProperty Action="SetDashboardHostDomain" Id="DASHBOARDHOST" Value="[DASHBOARDHOST].[DNSDOMAIN]" After="SetDashboardHostName" Sequence="both" Condition="DNSDOMAIN" />

    <!-- Start menu entry that opens the dashboard on this machine, with the SUSyphos icon (also in Programs and Features). -->
    <Icon Id="ProductIcon.ico" SourceFile="..\..\assets\logo\susyphos.ico" />
    <Property Id="ARPPRODUCTICON" Value="ProductIcon.ico" />
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProductMenuFolder" Name="SUSyphos" />
    </StandardDirectory>
    <Component Id="DashboardShortcut" Directory="ProductMenuFolder" Guid="3B7E9A41-6C2D-4F85-9E1A-5D8C2B7F4E63">
      <util:InternetShortcut Id="DashboardLink" Name="SUSyphos Dashboard" Target="[DASHBOARDURL]" Type="url" IconFile="[#DashboardIcon]" IconIndex="0" />
      <RemoveFolder Id="RemoveProductMenuFolder" On="uninstall" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\SUSyphos\Server" Name="DashboardShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <Component Id="DashboardShortcutIcon" Directory="INSTALLFOLDER">
      <File Id="DashboardIcon" Source="..\..\assets\logo\susyphos.ico" Name="susyphos.ico" KeyPath="yes" />
    </Component>

    <!--
      The dashboard address follows the port, which the dialog may change: computed for the execute sequence, and again
      in the user interface after the installation ran (before the final page), for its text and the option to open the dashboard.
    -->
    <SetProperty Id="DASHBOARDURL" Value="https://[DASHBOARDHOST]:[HTTPSPORT]/" After="SetDashboardHostDomain" Sequence="execute" />
    <SetProperty Action="SetDashboardUrlUi" Id="DASHBOARDURL" Value="https://[DASHBOARDHOST]:[HTTPSPORT]/" After="ExecuteAction" Sequence="ui" />
    <SetProperty Id="WixShellExecTarget" Value="[DASHBOARDURL]" After="SetDashboardUrlUi" Sequence="ui" Condition="NOT SETUPTOKEN" />
    <SetProperty Action="SetSetupShellExecTarget" Id="WixShellExecTarget" Value="[DASHBOARDURL]setup#token=[SETUPTOKEN]" After="SetWixShellExecTarget" Sequence="ui" Condition="SETUPTOKEN" />
    <SetProperty Id="WIXUI_EXITDIALOGOPTIONALTEXT" After="SetDashboardUrlUi" Sequence="ui" Condition="NOT SETUPTOKEN"
                 Value="The dashboard is at [DASHBOARDURL]. On the first visit, create the first administrator with the one-time token from %ProgramData%\SUSyphos\Server\setup-token.txt (readable by administrators only)." />
    <SetProperty Action="SetSetupExitText" Id="WIXUI_EXITDIALOGOPTIONALTEXT" After="SetWIXUI_EXITDIALOGOPTIONALTEXT" Sequence="ui" Condition="SETUPTOKEN"
                 Value="The dashboard is at [DASHBOARDURL]. Opening it now starts the setup of the first administrator with the one-time token from the previous page filled in." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Open the dashboard" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <CustomAction Id="OpenDashboard" BinaryRef="Wix4UtilCA_X64" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />

    <!--
      Interactive installation: welcome, license, HTTPS port (first installation only: an upgrade keeps the installed
      port without asking), ready, and a final page with the dashboard address. The certificate stays a command line
      option; without it the central server creates its own. msiexec /qn needs no dialog.
    -->
    <WixVariable Id="WixUILicenseRtf" Value="..\License.rtf" />
    <UI Id="ServerUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />
      <TextStyle Id="ServerUI_Font_Error" FaceName="Tahoma" Size="8" Red="200" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />
      <Property Id="WixUI_Mode" Value="Minimal" />

      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />

      <!-- The edit field takes digits only (Integer, at most five); the range is checked before going on. -->
      <Dialog Id="HttpsPortDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="250" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}HTTPS port and first sign-in" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="The port agents and administrators connect to." />
        <Control Id="Intro" Type="Text" X="20" Y="60" Width="330" Height="30" NoPrefix="yes"
                 Text="The central server accepts the agents and the dashboard over HTTPS on this port. Setup opens it in Windows Firewall." />
        <Control Id="PortLabel" Type="Text" X="20" Y="96" Width="330" Height="10" NoPrefix="yes" Text="&amp;Port (1 to 65535, default 8443):" />
        <Control Id="PortEdit" Type="Edit" X="20" Y="108" Width="60" Height="18" Property="HTTPSPORT" Integer="yes" Text="{5}" />
        <Control Id="Invalid" Type="Text" X="20" Y="130" Width="330" Height="20" NoPrefix="yes" Hidden="yes"
                 Text="{\ServerUI_Font_Error}Enter a port from 1 to 65535." ShowCondition="HTTPSPORTVALID = &quot;0&quot;" />
        <Control Id="LaterHint" Type="Text" X="20" Y="150" Width="330" Height="20" NoPrefix="yes"
                 Text="Agents keep the address they were installed with, so choose the port before installing the first agents. Upgrades keep it." />
        <!-- The token is shown in an edit field so it can be selected and copied; changing it there changes nothing. -->
        <Control Id="TokenLabel" Type="Text" X="20" Y="176" Width="330" Height="10" NoPrefix="yes" Hidden="yes" ShowCondition="SETUPTOKEN"
                 Text="One-time token for the first administrator:" />
        <Control Id="TokenEdit" Type="Edit" X="20" Y="188" Width="330" Height="18" Property="SETUPTOKENCOPY" Hidden="yes" ShowCondition="SETUPTOKEN" Text="{128}" />
        <Control Id="TokenHint" Type="Text" X="20" Y="209" Width="330" Height="20" NoPrefix="yes" Hidden="yes" ShowCondition="SETUPTOKEN"
                 Text="Opening the dashboard at the end of the setup fills it in. It is also stored in setup-token.txt under %ProgramData%\SUSyphos\Server." />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <Publish Property="HTTPSPORTVALID" Value="0" Order="1" />
          <Publish Property="HTTPSPORTVALID" Value="1" Order="2" Condition="HTTPSPORT &gt;= 1 AND HTTPSPORT &lt;= 65535" />
          <Publish Event="NewDialog" Value="VerifyReadyDlg" Order="3" Condition="HTTPSPORTVALID = &quot;1&quot;" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="LicenseAgreementDlg" Condition="NOT Installed" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Condition="Installed AND PATCH" />
      <Publish Dialog="LicenseAgreementDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" />
      <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog" Value="HttpsPortDlg" Condition="LicenseAccepted = &quot;1&quot; AND NOT INSTALLEDPORT" />
      <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Condition="LicenseAccepted = &quot;1&quot; AND INSTALLEDPORT" />
      <Publish Dialog="HttpsPortDlg" Control="Back" Event="NewDialog" Value="LicenseAgreementDlg" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="HttpsPortDlg" Order="1" Condition="NOT Installed AND NOT INSTALLEDPORT" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="LicenseAgreementDlg" Order="1" Condition="NOT Installed AND INSTALLEDPORT" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2" Condition="Installed AND NOT PATCH" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" Condition="Installed AND PATCH" />
      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="OpenDashboard" Order="1" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />

      <Property Id="ARPNOMODIFY" Value="1" />
    </UI>
    <UIRef Id="WixUI_Common" />
  </Package>
</Wix>
