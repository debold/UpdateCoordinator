<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:fw="http://wixtoolset.org/schemas/v4/wxs/firewall">

  <!--
    Central server installer. Installs the self-contained central server as a Windows service running as LocalSystem.
    CERTTHUMBPRINT selects the TLS certificate in LocalMachine\My and HTTPSPORT the port (default 8443); both are kept in
    HKLM\SOFTWARE\UpdateCoordinator\Server, which the central server reads as configuration and upgrades keep.
    The database, trust anchor and logs under %ProgramData%\UpdateCoordinator\Server are kept on uninstall and upgrade.
  -->
  <Package Name="UpdateCoordinator Central Server"
           Manufacturer="UpdateCoordinator"
           Version="$(var.ProductVersion)"
           UpgradeCode="F8E3FCF7-6CF5-4113-8F2A-9CDAD522B559"
           Scope="perMachine"
           InstallerVersion="500"
           Compressed="yes">

    <SummaryInformation Description="UpdateCoordinator central server: rings, releases and dashboard." />
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of the UpdateCoordinator central server is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Launch Condition="Installed OR WindowsBuild &gt;= 14393" Message="The UpdateCoordinator central server requires Windows Server 2016 or newer." />

    <!-- Values from the command line win; otherwise an upgrade keeps the installed ones. -->
    <Property Id="CERTTHUMBPRINT" Secure="yes" />
    <Property Id="HTTPSPORT" Secure="yes" />
    <Property Id="INSTALLEDTHUMBPRINT" Secure="yes">
      <RegistrySearch Root="HKLM" Key="SOFTWARE\UpdateCoordinator\Server" Name="CertificateThumbprint" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="INSTALLEDPORT" Secure="yes">
      <RegistrySearch Root="HKLM" Key="SOFTWARE\UpdateCoordinator\Server" Name="HttpsPort" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Id="CERTTHUMBPRINT" Value="[INSTALLEDTHUMBPRINT]" After="AppSearch" Sequence="both" Condition="NOT CERTTHUMBPRINT AND INSTALLEDTHUMBPRINT" />
    <SetProperty Id="HTTPSPORT" Value="[INSTALLEDPORT]" After="AppSearch" Sequence="both" Condition="NOT HTTPSPORT AND INSTALLEDPORT" />
    <SetProperty Id="HTTPSPORT" Action="SetDefaultHttpsPort" Value="8443" After="SetHTTPSPORT" Sequence="both" Condition="NOT HTTPSPORT" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="ProductFolder" Name="UpdateCoordinator">
        <Directory Id="INSTALLFOLDER" Name="Server" />
      </Directory>
    </StandardDirectory>

    <Feature Id="Server" Title="UpdateCoordinator central server">
      <ComponentGroupRef Id="ServerFiles" />
      <ComponentRef Id="ServerService" />
      <ComponentRef Id="ServerSettings" />
      <ComponentRef Id="ServerCertificate" />
      <ComponentRef Id="ServerServiceStart" />
    </Feature>

    <ComponentGroup Id="ServerFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\**">
        <Exclude Files="$(var.PublishDir)\UpdateCoordinator.Server.exe" />
        <Exclude Files="$(var.PublishDir)\**\*.pdb" />
        <Exclude Files="$(var.PublishDir)\appsettings.Development.json" />
      </Files>
    </ComponentGroup>

    <Component Id="ServerService" Directory="INSTALLFOLDER">
      <File Id="ServerExe" Source="$(var.PublishDir)\UpdateCoordinator.Server.exe" KeyPath="yes">
        <!-- Agents and administrators connect over HTTPS on the configured port. -->
        <fw:FirewallException Id="ServerHttps" Name="UpdateCoordinator Central Server (HTTPS)" Port="[HTTPSPORT]" Protocol="tcp" Scope="any" />
      </File>
      <ServiceInstall Id="ServerServiceInstall"
                      Name="UpdateCoordinator.Server"
                      DisplayName="UpdateCoordinator Central Server"
                      Description="Coordinates Windows updates of the registered servers: rings, releases, reporting and the web dashboard."
                      Type="ownProcess"
                      Start="auto"
                      Account="LocalSystem"
                      ErrorControl="normal"
                      Vital="yes">
        <util:ServiceConfig FirstFailureActionType="restart" SecondFailureActionType="restart" ThirdFailureActionType="restart"
                            RestartServiceDelayInSeconds="60" ResetPeriodInDays="1" />
      </ServiceInstall>
      <ServiceControl Id="ServerServiceStop" Name="UpdateCoordinator.Server" Stop="both" Remove="uninstall" Wait="yes" />
    </Component>

    <!-- Installer options, read by the central server as configuration (ServerRegistry) and by later upgrades. -->
    <Component Id="ServerSettings" Directory="INSTALLFOLDER" Guid="5E0B9C1A-3F2D-4B8E-A7C6-1D4E9F2B6A30">
      <RegistryValue Root="HKLM" Key="SOFTWARE\UpdateCoordinator\Server" Name="HttpsPort" Type="string" Value="[HTTPSPORT]" KeyPath="yes" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\UpdateCoordinator\Server" Name="HttpsUrl" Type="string" Value="https://*:[HTTPSPORT]" />
    </Component>

    <Component Id="ServerCertificate" Directory="INSTALLFOLDER" Condition="CERTTHUMBPRINT" Guid="0B6E4D2F-9A3C-4E71-8D5B-2C7F1A9E3D60">
      <RegistryValue Root="HKLM" Key="SOFTWARE\UpdateCoordinator\Server" Name="CertificateThumbprint" Type="string" Value="[CERTTHUMBPRINT]" KeyPath="yes" />
    </Component>

    <!-- Started only when a certificate is configured; without one the central server cannot serve HTTPS. -->
    <Component Id="ServerServiceStart" Directory="INSTALLFOLDER" Condition="CERTTHUMBPRINT" Guid="8C3D7E52-1A9B-4F0C-B6D2-7E5A3C9F1B48">
      <RegistryValue Root="HKLM" Key="SOFTWARE\UpdateCoordinator\Server" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
      <ServiceControl Id="ServerServiceStartControl" Name="UpdateCoordinator.Server" Start="install" Wait="no" />
    </Component>
  </Package>
</Wix>
