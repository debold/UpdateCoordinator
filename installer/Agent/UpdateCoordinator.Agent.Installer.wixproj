<Project Sdk="WixToolset.Sdk/7.0.0">
  <!-- MSI of the agent (docs/admin/README.md, installation). Built from the self-contained publish output, see build/Build-Installers.ps1. -->
  <PropertyGroup>
    <OutputName>UpdateCoordinator.Agent</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <!-- Open Source Maintenance Fee EULA of WiX v7 accepted by Marc on 2026-10-19 (no revenue from this project). -->
    <AcceptEula>wix7</AcceptEula>
    <SuppressValidation>false</SuppressValidation>
    <!-- ICE61 flags AllowSameVersionUpgrades, which is intended: rebuilt packages of the same version replace each other. -->
    <SuppressIces>ICE61</SuppressIces>
    <!-- Supplied by the build script: published files and the product version derived from the git tag agent/vX.Y.Z. -->
    <PublishDir Condition="'$(PublishDir)' == ''">..\..\artifacts\publish\agent</PublishDir>
    <ProductVersion Condition="'$(ProductVersion)' == ''">0.0.0</ProductVersion>
    <DefineConstants>PublishDir=$(PublishDir);ProductVersion=$(ProductVersion)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" />
  </ItemGroup>
</Project>
